                                                                                                             },
                                                                                        "region":  {
                                                                                                       "startLine":  1,
                                                                                                       "endLine":  1470
                                                                                                   }
                                                                                    }
                                                           }
                                                       ]
                                     },
                                     {
                                         "message":  {
                                                         "text":  "[AUD-TC-004] LSP server main loop (JSON-RPC handshake, dispatch, debounced diagnostics) has zero tests -- buff-lsp has a single integration test file (tests/capabilities.rs, 442 lines) which drives the pure handlers:: functions directly on DocumentState - good coverage of hover/completion/goto-def/symbols/formatting/diagnostics. However, no test references Connection, initialize, or server::run_stdio (grep across tests returns zero matches). The server.rs main loop - capability registration, request dispatch arms, didChange full-reparse plumbing, and the 300ms debounced diagnostics select loop - is completely untested, and server.rs carries no inline #[cfg(test)] module."
                                                     },
                                         "ruleId":  "BUFF-test-coverage",
                                         "level":  "warning",
                                         "locations":  [
                                                           {
                                                               "physicalLocation":  {
