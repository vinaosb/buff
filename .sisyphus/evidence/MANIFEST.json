{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Schema for .sisyphus/evidence/ artifacts. Each CI run uploads evidence/ as artifact `evidence-${{ github.sha }}` (retention 30 days). This file documents the schema; per-run instances may be generated by future tooling.",
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "ci_run": {
      "type": "object",
      "properties": {
        "sha": { "type": "string" },
        "ref": { "type": "string" },
        "run_number": { "type": "integer" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": { "type": "string", "description": "Audit finding ID (lms-001, cicd-001, etc.) from .sisyphus/evidence/audit-remediation-tracker.md" },
          "file": { "type": "string", "description": "Relative path within .sisyphus/evidence/" },
          "task": { "type": "string", "description": "Plan task ID (P0.x, P1.x, etc.)" },
          "status": { "enum": ["FIXED", "DEFERRED", "PENDING", "DISPROVEN"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_files": { "type": "integer" },
        "total_bytes": { "type": "integer" },
        "by_status": { "type": "object" }
      }
    }
  }
}
