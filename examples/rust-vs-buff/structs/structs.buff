// Buff: struct definition and construction with zero boilerplate.
// No #[derive], no pub, no &self, no .clone().
//
// NOTE: This file shows the INTENDED Buff struct syntax. Struct declarations
// are codegen-verified (crates/buff-lang-codegen-rust/tests/struct_codegen.rs)
// but the CLI's single-file parser does NOT yet accept struct/enum/trait
// declarations at the top level. This is a parser gap, not a codegen gap.
// The generated Rust for struct decls is valid and re-parses via syn.
//
// To verify struct codegen, run:
//   cargo test -p buff-lang-codegen-rust --test struct_codegen

// struct Point:
//     x: Float
//     y: Float
//
// struct Person:
//     name: String
//     age: Int
//
// func main():
//     let p = Point { x: 3.0, y: 4.0 }
//     print(p.x)
//     print(p.y)
//
//     let person = Person { name: "Alice", age: 30 }
//     print(person.name)
//     print(person.age)

func main():
    // Until struct declarations land in the CLI parser, Buff programs
    // avoid the struct boilerplate problem entirely. No #[derive],
    // no pub fields, no impl blocks needed in Buff -- the compiler
    // handles all of that automatically.
    print("no derives needed")
    print("no pub on fields")
    print("no impl blocks")
