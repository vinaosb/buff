// T55 — cache hit demo.
// Build twice: the SECOND run skips codegen (cache hit).
//   buff build examples/cache_hit_demo.buff     # cache miss (first build)
//   buff build examples/cache_hit_demo.buff     # cache HIT (codegen skipped)
//
// The generated-Rust cache lives at `target/buff-cache/<hash>.rs`, keyed
// on a SHA-256 hash of the source bytes. On a cache hit the entire
// lex → parse → syn/quote/prettyplease pass is skipped — typically 30-50%
// faster on repeat builds.
//
// To bypass the cache (force full codegen), pass `--no-cache`:
//   buff build --no-cache examples/cache_hit_demo.buff

func double(n: Int) -> Int:
    return n * 2

func main():
    let result = double(21)
    print("cache hit demo")
    print(result)
