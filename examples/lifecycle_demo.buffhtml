<script lang="buff">
    // lifecycle_demo.buffhtml — T134 component-model example 1.
    //
    // Exercises the `on_init` + `on_destroy` lifecycle helpers (see
    // `crates/buff-ui-dioxus/src/lib.rs` §"Lifecycle-hook helpers").
    // When the component mounts, `on_init` fires the once-closure
    // (here: incrementing a mount counter + writing a side-effect).
    // When the component unmounts, `on_destroy` fires the cleanup.
    //
    // Live render (USER ACTION): build with
    //   `cargo run -p buff-lang-cli -- run examples/lifecycle_demo.buffhtml`
    // to see the logs surface in the browser console. The local
    // unit tests assert the codegen shape only.

    // A mount-counter signal so the rendered DOM visibly updates on
    // every mount. Even though `on_init` runs only once per mount,
    // re-mounts (parent toggles) will visibly bump this value.
    let mut mount_count = use_signal(|| 0u32);

    // T134 `on_init` — runs once after mount. Wraps `use_effect`.
    on_init(|| {
        // In a real app: log "mounted", start a timer, fetch data, ...
        // Here: a no-op closure (the value is in the codegen shape).
    });

    // T134 `on_destroy` — runs once on unmount. Wraps `use_drop`.
    on_destroy(|| {
        // In a real app: cancel intervals, close websockets, release
        // GPU buffers, ...
    });

    // The mount_count signal increments on every click so the demo
    // has interactive state — proves both the on_init codegen path
    // AND the existing use_signal pipeline compose cleanly.
    let increment = move |_| {
        mount_count += 1;
    };
</script>

<div class="lifecycle-demo">
    <h2>Lifecycle Demo</h2>
    <p>This component was remounted {mount_count} times via clicks.</p>
    <button on:click={increment}>Bump mount counter</button>
</div>
