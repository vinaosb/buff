// T62 — PGO representative workload: compute-heavy (fibonacci + matrix multiply).
// PGO flow:
//   buff build --pgo examples/pgo_demo.buff
//   ./pgo_demo                              # Phase 2: run the workload
//   buff build --pgo --use examples/pgo_demo.buff
//
// This program is intentionally compute-heavy so the profiling counters
// capture hot loops + recursion paths. The work is pure-std (no GPU,
// no rayon, no async) so the profile maps cleanly onto the final
// release binary without runtime linkage noise.
//
// Workload:
//   - Recursive fibonacci (call-graph + recursion profiling).
//   - Iterative matrix multiply (tight inner-loop block-layout
//     profiling — the classic PGO win).

func fib(n: Int) -> Int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

func matrix_multiply(a: Vector<Vector<Int>>, b: Vector<Vector<Int>>) -> Vector<Vector<Int>>:
    let n = a.len()
    let mut result: Vector<Vector<Int>> = []
    let mut i = 0
    for i < n:
        let mut row: Vector<Int> = []
        let mut j = 0
        for j < n:
            let mut sum = 0
            let mut k = 0
            for k < n:
                sum = sum + a[i][k] * b[k][j]
                k = k + 1
            row.push(sum)
            j = j + 1
        result.push(row)
        i = i + 1
    return result

func main():
    let fib_result = fib(28)
    print("fib(28) =", fib_result)

    let n = 12
    let mut a: Vector<Vector<Int>> = []
    let mut b: Vector<Vector<Int>> = []
    let mut i = 0
    for i < n:
        let mut row_a: Vector<Int> = []
        let mut row_b: Vector<Int> = []
        let mut j = 0
        for j < n:
            row_a.push((i + j) % 7)
            row_b.push((i * j) % 5)
            j = j + 1
        a.push(row_a)
        b.push(row_b)
        i = i + 1

    let product = matrix_multiply(a, b)
    let trace = product[0][0] + product[n - 1][n - 1]
    print("matrix trace =", trace)
