// =============================================================================
// cli_file_manager.buff -- a full CLI file manager built on buff-cli + buff-dataframe.
//
// T17 use-case example. A realistic, single-file CLI application (~800 LOC) that
// demonstrates:
//   * Subcommands wired through `buff-cli` (clap-equivalent builder API):
//       - list    : list directory contents (sortable, filterable, long format)
//       - search  : recursive name/pattern search with regex + glob support
//       - rename  : batch rename (replace, re-extension, prefix/suffix, dry-run)
//       - convert : JSON <-> CSV <-> TOML table conversion via buff-dataframe
//   * Argument parsing via the `App` / `ParsedArgs` surface from `buff-cli`.
//   * Stdin/stdout piping: `--input -` reads from stdin, `--output -` writes to
//     stdout, so the tool composes in unix pipelines (`cat x.json | filemgr
//     convert --input - --from json --to csv --output -`).
//   * Progress indicators: a text progress bar + spinner rendered to stderr so
//     piped stdout stays clean.
//   * Help text: `--help` (auto-generated by buff-cli) + a hand-written
//     `filemgr help` summary.
//
// Framework crates (2, the max allowed for this example):
//   1. buff-cli      -- `App`, `ParsedArgs`, `Args` (argument parsing)
//   2. buff-dataframe-- `DataFrame`, `Series` (CSV load + relational ops for
//                        the `convert` subcommand)
//
// The remaining APIs used (`Filesystem`, `JSON`, `Toml`, `Regex`, `Args`,
// `Stdin`, `Stdout`, `Env`) are STDLIB prelude namespaces/types, not framework
// crates, so they do not count against the 2-crate budget.
//
// -----------------------------------------------------------------------------
// RUNTIME STATUS: parse + type-check only.
//
// Like every framework example in examples/{tensor,pipeline,science,ml,game,
// integration,data-science-workbench}/, this file is PARSE-CLEAN and passes
// `buff check` (lex -> parse -> TypeInferencer). End-to-end execution via
// `buff run` is deferred: the `Type::{App, DataFrame, ...}` codegen lowering
// arms are a coordinated sibling task (see
// `.sisyphus/decisions/api-compat-v20.md`). See examples/use-cases/BUGS-FOUND.md
// for the language bugs surfaced while writing this example.
//
// Validate with:
//   cargo run -p buff-lang-cli -- check examples/use-cases/apps/cli_file_manager.buff
// =============================================================================

// -----------------------------------------------------------------------------
// Constants (Buff only allows func/struct/enum at top level, so these are
// zero-arg functions returning the constant value.)
// -----------------------------------------------------------------------------

func VERSION() -> String:
    return "1.0.0"

func APP_NAME() -> String:
    return "filemgr"

func APP_ABOUT() -> String:
    return "Buff file manager: list, search, rename, and convert JSON/CSV/TOML"

func EXIT_OK() -> Int:
    return 0

func EXIT_USAGE() -> Int:
    return 2

func EXIT_IO() -> Int:
    return 3

func EXIT_CONVERT() -> Int:
    return 4

// -----------------------------------------------------------------------------
// Data types
// -----------------------------------------------------------------------------

// A single directory entry surfaced by `list` / `search`.
struct FileEntry {
    name: String,
    size: Int,
    is_dir: Bool,
    modified: String,
}

// A search hit: the matching name, where it was found, and which fragment matched.
struct SearchHit {
    name: String,
    path: String,
    matched: String,
}

// A planned rename produced by `rename` (applied unless `--dry-run` is set).
struct RenameOp {
    from_path: String,
    to_path: String,
    kind: String,
}

// Outcome of a `convert` operation, surfaced to the user as a one-line summary.
struct ConvertReport {
    rows: Int,
    columns: Int,
    from_format: String,
    to_format: String,
    bytes_written: Int,
}

// A lightweight progress bar state (rendered to stderr so stdout stays clean).
struct Progress {
    total: Int,
    current: Int,
    label: String,
    width: Int,
}

// The supported conversion formats.
enum ConvertFormat { Json, Csv, Toml }

// The supported `list --sort` keys.
enum SortKey { Name, Size, Time }

// =============================================================================
// Progress indicators (rendered to stderr; never stdout).
// =============================================================================

// Build a fresh progress bar tracking `total` units of work under `label`.
func progress_new(total: Int, label: String) -> Progress {
    return Progress { total: total, current: 0, label: label, width: 30 }
}

// Advance the bar by one unit and re-render it (in place, via carriage return).
func progress_tick(bar: Progress) -> Progress:
    bar.current = bar.current + 1
    Stderr.write("\r" + render_bar(bar))
    Stderr.flush()
    return bar

// Render the final 100% line + a trailing newline so subsequent output starts
// on a fresh line.
func progress_finish(bar: Progress) -> Void:
    Stderr.write("\r" + render_bar(bar) + "\n")
    Stderr.flush()

// Render a single frame of the progress bar: `label [####-->] 42%`.
func render_bar(bar: Progress) -> String:
    let pct = percent(bar.current, bar.total)
    let filled = bar.width * pct / 100
    let bar_text = repeat_str("#", filled) + repeat_str("-", bar.width - filled)
    return "${bar.label} [${bar_text}] ${pct}%"

// Render a spinner frame for indeterminate work (e.g. walking a large tree).
func spinner_step(i: Int) -> String:
    let idx = i % 4
    if idx == 0:
        return "|"
    if idx == 1:
        return "/"
    if idx == 2:
        return "-"
    return "\\"

// Compute a 0..100 integer percentage; saturates at 100 for total <= 0.
func percent(current: Int, total: Int) -> Int:
    if total <= 0:
        return 100
    let p = current * 100 / total
    if p > 100:
        return 100
    if p < 0:
        return 0
    return p

// =============================================================================
// Stdin / stdout piping helpers
// =============================================================================

// Read a source. A literal "-" means stdin (pipe support); anything else is a
// file path read via the stdlib Filesystem namespace.
func read_input(path: String) -> String:
    if path == "-":
        return Stdin.read_all()
    return Filesystem.read_text(path: path)

// Write a sink. A literal "-" means stdout (pipe support); anything else is a
// file path written via Filesystem.write_text.
func write_output(path: String, content: String) -> Int:
    if path == "-":
        Stdout.write(content)
        return content.len()
    Filesystem.write_text(path: path, content: content)
    return content.len()

// Read every line of stdin into a Vector<String> (used by `rename --plan -`).
func read_stdin_lines() -> Vector<String>:
    let text = Stdin.read_all()
    return split_lines(text)

// =============================================================================
// String + path helpers (the stdlib String surface is exposed as instance
// methods; these are thin wrappers so the rest of the program reads cleanly).
// =============================================================================

// Repeat `s` exactly `n` times (e.g. repeat_str("#", 4) -> "####").
func repeat_str(s: String, n: Int) -> String:
    let out = ""
    let i = 0
    return repeat_loop(s, n, out, i)

func repeat_loop(s: String, n: Int, out: String, i: Int) -> String:
    if i >= n:
        return out
    return repeat_loop(s, n, out + s, i + 1)

// Pad `s` on the right with spaces until it is at least `width` columns wide.
func pad_right(s: String, width: Int) -> String:
    let gap = width - s.len()
    if gap <= 0:
        return s
    return s + repeat_str(" ", gap)

// Pad `s` on the left with spaces (right-align, used for numeric columns).
func pad_left(s: String, width: Int) -> String:
    let gap = width - s.len()
    if gap <= 0:
        return s
    return repeat_str(" ", gap) + s

// Format a byte count as a human-readable size (e.g. 1536 -> "1.5 KB").
func human_size(bytes: Int) -> String:
    if bytes < 1024:
        return "${bytes} B"
    let kb = bytes / 1024
    if kb < 1024:
        return "${kb} KB"
    let mb = kb / 1024
    if mb < 1024:
        return "${mb} MB"
    let gb = mb / 1024
    return "${gb} GB"

// Lowercase extension of a filename, without the leading dot. "none" if absent.
func file_extension(name: String) -> String:
    let parts = split_on(name, ".")
    if parts.len() < 2:
        return ""
    return parts[parts.len() - 1]

// The final path segment (after the last separator).
func base_name(path: String) -> String:
    let by_slash = split_on(path, "/")
    let last = by_slash[by_slash.len() - 1]
    let by_back = split_on(last, "\\")
    return by_back[by_back.len() - 1]

// Everything except the final path segment.
func dir_name(path: String) -> String:
    let by_slash = split_on(path, "/")
    if by_slash.len() < 2:
        return "."
    return join_take(by_slash, by_slash.len() - 1, "")

// Join two path fragments with exactly one separator.
func join_path(a: String, b: String) -> String:
    if a == "":
        return b
    if ends_with(a, "/") || ends_with(a, "\\"):
        return a + b
    return a + "/" + b

// Split `s` on `sep` into a Vector<String> (wraps the stdlib String.split).
func split_on(s: String, sep: String) -> Vector<String>:
    return s.split(sep)

// Split `s` into lines on \n (trailing empty line from a final \n is dropped).
func split_lines(s: String) -> Vector<String>:
    let raw = s.split("\n")
    let out = []
    for line in raw:
        out.push(line)
    return out

// Join the first `count` elements of `parts` with `sep`.
func join_take(parts: Vector<String>, count: Int, sep: String) -> String:
    let out = ""
    let i = 0
    return join_take_loop(parts, count, sep, out, i)

func join_take_loop(parts: Vector<String>, count: Int, sep: String, out: String, i: Int) -> String:
    if i >= count:
        return out
    let piece = parts[i]
    let next = out
    if i > 0:
        next = out + sep
    return join_take_loop(parts, count, sep, next + piece, i + 1)

// True when `s` ends with `suffix`.
func ends_with(s: String, suffix: String) -> Bool:
    if suffix.len() > s.len():
        return false
    let start = s.len() - suffix.len()
    let tail = slice_from(s, start)
    return tail == suffix

// Substring from `start` to the end.
func slice_from(s: String, start: Int) -> String:
    return s.slice(start, s.len())

// Quote a CSV field, doubling embedded quotes and wrapping in quotes when the
// field contains a comma, quote, or newline.
func csv_quote(field: String) -> String:
    let needs_quote = contains_char(field, ",") || contains_char(field, "\"") || contains_char(field, "\n")
    if not(needs_quote):
        return field
    let escaped = replace_all(field, "\"", "\"\"")
    return "\"" + escaped + "\""

// True when `s` contains the single character `ch`.
func contains_char(s: String, ch: String) -> Bool:
    return s.contains(ch)

// Replace every occurrence of `needle` with `repl` in `s`.
func replace_all(s: String, needle: String, repl: String) -> String:
    return s.replace(needle, repl)

// Logical not (the parser has no prefix `not` keyword; use this wrapper).
func not(b: Bool) -> Bool:
    if b:
        return false
    return true

// =============================================================================
// Format detection + conversion dispatch
// =============================================================================

// Parse a `--from`/`--to` flag value into a ConvertFormat. Returns Json by
// default for an unknown string (never panics).
func parse_format(name: String) -> ConvertFormat:
    let lower = name
    if lower == "csv":
        return ConvertFormat.Csv
    if lower == "toml":
        return ConvertFormat.Toml
    return ConvertFormat.Json

// Render a ConvertFormat as its lowercase canonical name.
func format_name(fmt: ConvertFormat) -> String:
    match fmt {
        Json => "json",
        Csv => "csv",
        Toml => "toml"
    }

// Detect a format from a filename's extension; defaults to Json.
func detect_format_from_name(name: String) -> ConvertFormat:
    let ext = file_extension(name)
    if ext == "csv":
        return ConvertFormat.Csv
    if ext == "toml":
        return ConvertFormat.Toml
    return ConvertFormat.Json

// =============================================================================
// `list` subcommand
// =============================================================================

func cmd_list(args: ParsedArgs) -> Int:
    let path = args.arg("path").or(default: ".")
    let long = args.flag("long")
    let all = args.flag("all")
    let sort_key = parse_sort_key(args.option("sort").or(default: "name"))

    print("listing ${path}")
    let bar = progress_new(1, "scanning")
    let entries = list_directory(path, show_all: all)
    bar = progress_tick(bar)
    progress_finish(bar)

    let sorted = sort_entries(entries, sort_key)
    if long:
        print_entries_long(sorted)
    else:
        print_entries_short(sorted)
    print("total: ${sorted.len()} entries")
    return EXIT_OK()

// Parse the `--sort` value into a SortKey.
func parse_sort_key(value: String) -> SortKey:
    if value == "size":
        return SortKey.Size
    if value == "time":
        return SortKey.Time
    return SortKey.Name

// Enumerate a directory into FileEntry records. Hidden entries (leading dot)
// are dropped unless `show_all` is true.
func list_directory(path: String, show_all: Bool) -> Vector<FileEntry>:
    let names = Filesystem.list_dir(path: path)
    let entries = []
    for name in names:
        if show_all || not(is_hidden(name)):
            entries.push(make_entry(path, name))
    return entries

// True when `name` starts with a dot (unix-style hidden entry).
func is_hidden(name: String) -> Bool:
    if name == "":
        return false
    let first = name.slice(0, 1)
    return first == "."

// Build a FileEntry for `name` under `dir` by stat-ing the full path.
func make_entry(dir: String, name: String) -> FileEntry:
    let full = join_path(dir, name)
    let info = Filesystem.stat(path: full)
    return FileEntry {
        name: name,
        size: info.size(),
        is_dir: info.is_dir(),
        modified: info.modified()
    }

// Sort a Vector<FileEntry> by the requested key (ascending). Implemented as a
// manual selection sort so we avoid multi-param typed-lambda syntax (the parser
// only accepts single-arg `{ x => ... }` closures today).
func sort_entries(entries: Vector<FileEntry>, key: SortKey) -> Vector<FileEntry>:
    return selection_sort(entries, key)

// In-place-ish selection sort: repeatedly pick the smallest remaining element
// by the active key and append it to the output. Uses recursion because Buff
// has no `while` keyword (the front-end ships `for` only).
func selection_sort(entries: Vector<FileEntry>, key: SortKey) -> Vector<FileEntry>:
    let remaining = []
    for e in entries:
        remaining.push(e)
    let out = []
    return drain_sort(remaining, key, out)

// Recursive drain: move the smallest remaining element into `out` each step.
func drain_sort(remaining: Vector<FileEntry>, key: SortKey, out: Vector<FileEntry>) -> Vector<FileEntry>:
    if remaining.len() == 0:
        return out
    let best_idx = find_min_index(remaining, key, 0, 1)
    out.push(remaining[best_idx])
    remaining.remove(best_idx)
    return drain_sort(remaining, key, out)

// Scan `remaining` and return the index of the smallest element under `key`.
func find_min_index(remaining: Vector<FileEntry>, key: SortKey, best: Int, i: Int) -> Int:
    return scan_min(remaining, key, best, i)

func scan_min(remaining: Vector<FileEntry>, key: SortKey, best: Int, i: Int) -> Int:
    if i >= remaining.len():
        return best
    let cur = i
    let next_best = best
    if less_than(remaining[cur], remaining[best], key):
        next_best = cur
    return scan_min(remaining, key, next_best, i + 1)

// True when `a` should sort before `b` under `key`.
func less_than(a: FileEntry, b: FileEntry, key: SortKey) -> Bool:
    if key == SortKey.Size:
        return a.size < b.size
    if key == SortKey.Time:
        return a.modified < b.modified
    return a.name < b.name

// One name per line (the default compact view).
func print_entries_short(entries: Vector<FileEntry>) -> Void:
    for e in entries:
        Stdout.write(label_for(e) + "\n")

// Aligned columns: mode flag, size, modified, name (the `ls -l` view).
func print_entries_long(entries: Vector<FileEntry>) -> Void:
    let header = pad_right("MODE", 5) + " " + pad_left("SIZE", 10) + "  " + pad_right("MODIFIED", 20) + " " + "NAME"
    print(header)
    for e in entries:
        let mode = dir_marker(e)
        let size = pad_left(human_size(e.size), 10)
        let modified = pad_right(e.modified, 20)
        Stdout.write("${mode} ${size}  ${modified} ${label_for(e)}\n")

// "d" for directories, "-" for files (a compact mode column).
func dir_marker(e: FileEntry) -> String:
    if e.is_dir:
        return "d"
    return "-"

// The display name for an entry (directories get a trailing slash).
func label_for(e: FileEntry) -> String:
    if e.is_dir:
        return e.name + "/"
    return e.name

// =============================================================================
// `search` subcommand
// =============================================================================

func cmd_search(args: ParsedArgs) -> Int:
    let pattern = args.arg("pattern").or(default: "")
    let root = args.arg("path").or(default: ".")
    let use_regex = args.flag("regex")
    let case_insensitive = args.flag("ignore-case")

    if pattern == "":
        print("search: empty pattern; try: filemgr search PATTERN [PATH]")
        return EXIT_USAGE()

    let max = 1000
    let hits = search_tree(root, pattern, use_regex: use_regex, ignore_case: case_insensitive, max_results: max)
    print_search_hits(hits)
    print("found ${hits.len()} match(es)")
    return EXIT_OK()

// Walk `root` and collect names matching `pattern` (substring or regex).
func search_tree(root: String, pattern: String, use_regex: Bool, ignore_case: Bool, max_results: Int) -> Vector<SearchHit>:
    let compiled = compile_matcher(pattern, use_regex: use_regex, ignore_case: ignore_case)
    let hits = []
    let names = Filesystem.list_dir(path: root)
    let bar = progress_new(names.len(), "searching")
    for name in names:
        bar = progress_tick(bar)
        let needle = normalize(name, ignore_case: ignore_case)
        if matches_matcher(compiled, needle, use_regex: use_regex):
            hits.push(SearchHit { name: name, path: join_path(root, name), matched: highlight(name, pattern) })
        if hits.len() >= max_results:
            progress_finish(bar)
            return hits
    progress_finish(bar)
    return hits

// Build a matcher object. When `use_regex` is true this is a compiled Regex;
// otherwise it is the plain substring (the .match() helper handles both).
func compile_matcher(pattern: String, use_regex: Bool, ignore_case: Bool) -> Regex:
    let needle = normalize(pattern, ignore_case: ignore_case)
    if use_regex:
        return Regex.compile(needle)
    return Regex.compile(escape_literal(needle))

// Lowercase `s` when matching case-insensitively.
func normalize(s: String, ignore_case: Bool) -> String:
    if ignore_case:
        return s.to_lowercase()
    return s

// Does `needle` match the matcher? Regex uses full search; substring uses find.
func matches_matcher(re: Regex, needle: String, use_regex: Bool) -> Bool:
    let found = re.find(needle)
    return match found {
        Some(_) => true,
        None => false
    }

// The fragment to highlight in the hit summary (just the pattern for now).
func highlight(name: String, pattern: String) -> String:
    return pattern

// Escape regex metacharacters so a literal pattern matches literally.
func escape_literal(s: String) -> String:
    let out = s
    out = replace_all(out, ".", "\\.")
    out = replace_all(out, "*", "\\*")
    out = replace_all(out, "?", "\\?")
    out = replace_all(out, "[", "\\[")
    out = replace_all(out, "]", "\\]")
    return out

// Print each hit as `path` (one per line) so it composes with `xargs`/etc.
func print_search_hits(hits: Vector<SearchHit>) -> Void:
    for h in hits:
        Stdout.write(h.path + "\n")

// =============================================================================
// `rename` subcommand
// =============================================================================

func cmd_rename(args: ParsedArgs) -> Int:
    let dir = args.arg("path").or(default: ".")
    let needle = args.option("from").or(default: "")
    let repl = args.option("to").or(default: "")
    let new_ext = args.option("extension").or(default: "")
    let prefix = args.option("prefix").or(default: "")
    let suffix = args.option("suffix").or(default: "")
    let dry_run = args.flag("dry-run")

    if needle == "" && repl == "" && new_ext == "" && prefix == "" && suffix == "":
        print("rename: nothing to do; supply --from/--to, --extension, --prefix, or --suffix")
        return EXIT_USAGE()

    let ops = plan_renames(dir, needle: needle, repl: repl, extension: new_ext, prefix: prefix, suffix: suffix)
    print_rename_plan(ops, dry_run: dry_run)
    if not(dry_run):
        apply_renames(ops)
    print("renamed ${ops.len()} file(s)${dry_suffix(dry_run)}")
    return EXIT_OK()

// Build the full list of RenameOps by walking `dir` and applying each enabled
// transformation in order: replace -> extension -> prefix -> suffix.
func plan_renames(dir: String, needle: String, repl: String, extension: String, prefix: String, suffix: String) -> Vector<RenameOp>:
    let names = Filesystem.list_dir(path: dir)
    let ops = []
    for name in names:
        let renamed = apply_transforms(name, needle: needle, repl: repl, extension: extension, prefix: prefix, suffix: suffix)
        if renamed != name:
            ops.push(RenameOp {
                from_path: join_path(dir, name),
                to_path: join_path(dir, renamed),
                kind: classify_transform(needle: needle, extension: extension, prefix: prefix, suffix: suffix)
            })
    return ops

// Apply every enabled transform to a single name, returning the new name.
func apply_transforms(name: String, needle: String, repl: String, extension: String, prefix: String, suffix: String) -> String:
    let out = name
    let after_replace = apply_replace(out, needle: needle, repl: repl)
    let after_ext = apply_extension(after_replace, extension: extension)
    let after_prefix = apply_prefix(after_ext, prefix: prefix)
    let after_suffix = apply_suffix(after_prefix, suffix: suffix)
    return after_suffix

func apply_replace(name: String, needle: String, repl: String) -> String:
    if needle == "":
        return name
    return replace_all(name, needle, repl)

func apply_extension(name: String, extension: String) -> String:
    if extension == "":
        return name
    let stem = strip_extension(name)
    return stem + "." + extension

func apply_prefix(name: String, prefix: String) -> String:
    if prefix == "":
        return name
    return prefix + name

func apply_suffix(name: String, suffix: String) -> String:
    if suffix == "":
        return name
    let stem = strip_extension(name)
    let ext = file_extension(name)
    if ext == "":
        return stem + suffix
    return stem + suffix + "." + ext

// Remove the final ".ext" from `name`, if any.
func strip_extension(name: String) -> String:
    let parts = split_on(name, ".")
    if parts.len() < 2:
        return name
    return join_take(parts, parts.len() - 1, ".")

// A human-readable label for which transform drove a rename.
func classify_transform(needle: String, extension: String, prefix: String, suffix: String) -> String:
    if needle != "":
        return "replace"
    if extension != "":
        return "extension"
    if prefix != "":
        return "prefix"
    if suffix != "":
        return "suffix"
    return "rename"

// Echo the plan before applying it (always; with --dry-run this is all we do).
func print_rename_plan(ops: Vector<RenameOp>, dry_run: Bool) -> Void:
    let verb = "DRY-RUN"
    for op in ops:
        Stdout.write("[${verb}] ${op.from_path} -> ${op.to_path} (${op.kind})\n")

// Apply every RenameOp via Filesystem.rename.
func apply_renames(ops: Vector<RenameOp>) -> Void:
    let bar = progress_new(ops.len(), "renaming")
    for op in ops:
        bar = progress_tick(bar)
        Filesystem.rename(src: op.from_path, dst: op.to_path)
    if ops.len() > 0:
        progress_finish(bar)

// "" normally; " (dry-run)" when previewing so the summary line is unambiguous.
func dry_suffix(dry_run: Bool) -> String:
    if dry_run:
        return " (dry-run)"
    return ""

// =============================================================================
// `convert` subcommand: JSON <-> CSV <-> TOML via buff-dataframe + stdlib.
// =============================================================================

func cmd_convert(args: ParsedArgs) -> Int:
    let input = args.option("input").or(default: "-")
    let output = args.option("output").or(default: "-")
    let src = parse_format(args.option("from").or(default: format_name(detect_format_from_name(input))))
    let dst = parse_format(args.option("to").or(default: format_name(detect_format_from_name(output))))
    let pretty = args.flag("pretty")

    let report = convert_dispatch(input, output, src: src, dst: dst, pretty: pretty)
    print("converted ${report.rows} row(s) x ${report.columns} col(s): ${report.from_format} -> ${report.to_format} (${report.bytes_written} bytes)")
    return EXIT_OK()

// Route to the right converter for the (src, dst) pair.
func convert_dispatch(input: String, output: String, src: ConvertFormat, dst: ConvertFormat, pretty: Bool) -> ConvertReport:
    match src {
        Csv => convert_from_csv(input, output, dst: dst, pretty: pretty),
        Json => convert_from_json(input, output, dst: dst, pretty: pretty),
        Toml => convert_from_toml(input, output, dst: dst, pretty: pretty)
    }

// ---- CSV source (buff-dataframe loads + infers the schema) -----------------

func convert_from_csv(input: String, output: String, dst: ConvertFormat, pretty: Bool) -> ConvertReport:
    let df = DataFrame.from_csv(path: input)
    let records = df_to_records(df)
    let text = serialize_records(records, dst: dst, pretty: pretty)
    let bytes = write_output(output, text)
    return ConvertReport {
        rows: df.len(),
        columns: df.ncols(),
        from_format: "csv",
        to_format: format_name(dst),
        bytes_written: bytes
    }

// Walk every row + column of a DataFrame, producing a Vector<Map<String,String> >
// (the universal intermediate for all three target formats).
func df_to_records(df: DataFrame) -> Vector<Map<String, String> >:
    let columns = df.column_names()
    let records = []
    let bar = progress_new(df.len(), "extracting")
    for i in range(0, df.len()):
        bar = progress_tick(bar)
        let record = Map.new()
        for col in columns:
            record[col] = df.get_column(col).as_string_slice()[i]
        records.push(record)
    if df.len() > 0:
        progress_finish(bar)
    return records

// ---- JSON source (stdlib JSON.parse yields Vector<Map>) --------------------

func convert_from_json(input: String, output: String, dst: ConvertFormat, pretty: Bool) -> ConvertReport:
    let text = read_input(input)
    let records = JSON.parse(text)
    let out = serialize_records(records, dst: dst, pretty: pretty)
    let bytes = write_output(output, out)
    return ConvertReport {
        rows: records.len(),
        columns: column_count(records),
        from_format: "json",
        to_format: format_name(dst),
        bytes_written: bytes
    }

// ---- TOML source (stdlib Toml.parse yields a Map) --------------------------

func convert_from_toml(input: String, output: String, dst: ConvertFormat, pretty: Bool) -> ConvertReport:
    let text = read_input(input)
    let table = Toml.parse(text)
    let records = table_to_records(table)
    let out = serialize_records(records, dst: dst, pretty: pretty)
    let bytes = write_output(output, out)
    return ConvertReport {
        rows: records.len(),
        columns: column_count(records),
        from_format: "toml",
        to_format: format_name(dst),
        bytes_written: bytes
    }

// Promote a parsed TOML table (Map<String, Map<String, String> >) into the
// uniform Vector<Map<String, String> > record shape.
func table_to_records(table: TomlTable) -> Vector<Map<String, String> >:
    let out = []
    let keys = table.keys()
    for k in keys:
        let row = table[k]
        row["__key"] = k
        out.push(row)
    return out

// ---- Record serializers ----------------------------------------------------

// Serialize the uniform record list into the requested target format.
func serialize_records(records: Vector<Map<String, String> >, dst: ConvertFormat, pretty: Bool) -> String:
    match dst {
        Json => records_to_json(records, pretty: pretty),
        Csv => records_to_csv(records),
        Toml => records_to_toml(records)
    }

// JSON output via the stdlib JSON namespace.
func records_to_json(records: Vector<Map<String, String> >, pretty: Bool) -> String:
    if pretty:
        return JSON.stringify_pretty(records)
    return JSON.stringify(records)

// CSV output: header row (union of keys, deterministic order) + data rows.
func records_to_csv(records: Vector<Map<String, String> >) -> String:
    let columns = collect_columns(records)
    let lines = []
    lines.push(join_csv_row(columns))
    let bar = progress_new(records.len(), "writing csv")
    for record in records:
        bar = progress_tick(bar)
        let fields = []
        for col in columns:
            fields.push(csv_quote(record.get_or(col, "")))
        lines.push(join_csv_row(fields))
    if records.len() > 0:
        progress_finish(bar)
    return join_lines(lines)

// TOML output: each record becomes a [[row]] array-of-tables element.
func records_to_toml(records: Vector<Map<String, String> >) -> String:
    let columns = collect_columns(records)
    let lines = []
    let bar = progress_new(records.len(), "writing toml")
    for record in records:
        bar = progress_tick(bar)
        lines.push("[[row]]")
        for col in columns:
            lines.push("${col} = \"${record.get_or(col, "")}\"")
    if records.len() > 0:
        progress_finish(bar)
    return join_lines(lines)

// Collect the union of every record's keys (used for CSV/TOML column order).
func collect_columns(records: Vector<Map<String, String> >) -> Vector<String>:
    let columns = []
    for record in records:
        let keys = record.keys()
        for k in keys:
            if not(contains_str(columns, k)):
                columns.push(k)
    return columns

// Count the columns in the first record (0 when there are no records).
func column_count(records: Vector<Map<String, String> >) -> Int:
    if records.len() == 0:
        return 0
    let first = records[0]
    return first.keys().len()

// Join a CSV row's fields with commas (no quoting here; fields are pre-quoted).
func join_csv_row(fields: Vector<String>) -> String:
    return join_with(fields, ",")

// Join lines with a newline between each and a trailing newline at the end.
func join_lines(lines: Vector<String>) -> String:
    return join_with(lines, "\n") + "\n"

// Join `parts` with `sep` (a small stdlib-shaped helper).
func join_with(parts: Vector<String>, sep: String) -> String:
    let out = ""
    let i = 0
    return join_with_loop(parts, sep, out, i)

func join_with_loop(parts: Vector<String>, sep: String, out: String, i: Int) -> String:
    if i >= parts.len():
        return out
    let next = out
    if i > 0:
        next = out + sep
    return join_with_loop(parts, sep, next + parts[i], i + 1)

// Linear membership test for a Vector<String>.
func contains_str(haystack: Vector<String>, needle: String) -> Bool:
    for item in haystack:
        if item == needle:
            return true
    return false

// =============================================================================
// App construction (buff-cli builder API) + dispatch
// =============================================================================

// Build the root `App` and register every subcommand + global flag.
// (Single-line method chains: Buff's offside-rule parser does not accept a
// `.`-continuation on a fresh line.)
func build_app() -> App:
    let app = App.new(APP_NAME()).version(VERSION()).about(APP_ABOUT()).flag("verbose", short: "v", description: "verbose output")
    wire_list(app)
    wire_search(app)
    wire_rename(app)
    wire_convert(app)
    wire_help(app)
    return app

// `filemgr list [PATH] [--long] [--all] [--sort name|size|time]`
func wire_list(app: App) -> Void:
    let list = app.command("list", about: "list directory contents")
    list.arg("path", description: "directory to list (default: .)")
    list.flag("long", short: "l", description: "long format (mode, size, modified, name)")
    list.flag("all", short: "a", description: "show hidden entries")
    list.option("sort", short: "s", description: "sort by: name | size | time")

// `filemgr search PATTERN [PATH] [--regex] [--ignore-case]`
func wire_search(app: App) -> Void:
    let search = app.command("search", about: "search files by name or regex")
    search.arg("pattern", description: "substring or regex pattern")
    search.arg("path", description: "directory to search (default: .)")
    search.flag("regex", short: "r", description: "treat PATTERN as a regex")
    search.flag("ignore-case", short: "i", description: "case-insensitive match")

// `filemgr rename [PATH] [--from S --to T] [--extension EXT] [--prefix P]
//                  [--suffix S] [--dry-run]`
func wire_rename(app: App) -> Void:
    let rename = app.command("rename", about: "batch rename files")
    rename.arg("path", description: "directory whose files to rename (default: .)")
    rename.option("from", short: "f", description: "substring to replace")
    rename.option("to", short: "t", description: "replacement for --from")
    rename.option("extension", short: "e", description: "rewrite the file extension")
    rename.option("prefix", short: "p", description: "prepend to each name")
    rename.option("suffix", short: "x", description: "insert before the extension")
    rename.flag("dry-run", short: "n", description: "print the plan without renaming")

// `filemgr convert [--input FILE] [--output FILE] [--from FMT] [--to FMT]
//                  [--pretty]`
func wire_convert(app: App) -> Void:
    let convert = app.command("convert", about: "convert between JSON, CSV, and TOML")
    convert.option("input", short: "i", description: "input file or - for stdin (default: -)")
    convert.option("output", short: "o", description: "output file or - for stdout (default: -)")
    convert.option("from", short: "F", description: "source format: json | csv | toml")
    convert.option("to", short: "T", description: "target format: json | csv | toml")
    convert.flag("pretty", short: "P", description: "pretty-print the output where supported")

// `filemgr help` -- a friendly summary in addition to clap's `--help`.
func wire_help(app: App) -> Void:
    let help = app.command("help", about: "show a usage summary")
    help.arg("topic", description: "optional subcommand to describe")

// Dispatch the parsed argv to the matching subcommand handler.
func dispatch(parsed: ParsedArgs) -> Int:
    match parsed.subcommand() {
        Some("list") => cmd_list(parsed.subcommand_args()),
        Some("search") => cmd_search(parsed.subcommand_args()),
        Some("rename") => cmd_rename(parsed.subcommand_args()),
        Some("convert") => cmd_convert(parsed.subcommand_args()),
        Some("help") => print_help(parsed.subcommand_args().arg("topic").or(default: "")),
        _ => print_root_help(parsed)
    }

// The root fallback: either run `--help` semantics or print the summary.
func print_root_help(parsed: ParsedArgs) -> Int:
    if parsed.flag("verbose"):
        print("${APP_NAME()} v${VERSION()}")
    print("${APP_NAME()}: ${APP_ABOUT()}")
    print("")
    print("usage: ${APP_NAME()} <subcommand> [options]")
    print("subcommands:")
    print("  list     list directory contents")
    print("  search   search files by name or regex")
    print("  rename   batch rename files")
    print("  convert  convert between JSON, CSV, and TOML")
    print("  help     show this summary")
    print("")
    print("global flags:")
    print("  -v, --verbose   verbose output")
    print("  -h, --help      show help for a subcommand")
    return EXIT_OK()

// Print a focused help block for a single topic (or the summary when empty).
func print_help(topic: String) -> Int:
    if topic == "list":
        print_topic("list", "list directory contents", list_help_lines())
    else if topic == "search":
        print_topic("search", "search files by name or regex", search_help_lines())
    else if topic == "rename":
        print_topic("rename", "batch rename files", rename_help_lines())
    else if topic == "convert":
        print_topic("convert", "convert between JSON, CSV, and TOML", convert_help_lines())
    else:
        return print_root_help(root_args())
    return EXIT_OK()

// Print one topic block: a header line + each body line.
func print_topic(name: String, about: String, lines: Vector<String>) -> Void:
    print("${name} -- ${about}")
    print("usage: ${APP_NAME()} ${name} [options]")
    for line in lines:
        print("  ${line}")

func list_help_lines() -> Vector<String>:
    let out = []
    out.push("[PATH]                  directory to list (default: .)")
    out.push("-l, --long              long format (mode, size, modified, name)")
    out.push("-a, --all               show hidden entries")
    out.push("-s, --sort name|size|time  sort key (default: name)")
    return out

func search_help_lines() -> Vector<String>:
    let out = []
    out.push("PATTERN                 substring or regex pattern")
    out.push("[PATH]                  directory to search (default: .)")
    out.push("-r, --regex             treat PATTERN as a regex")
    out.push("-i, --ignore-case       case-insensitive match")
    return out

func rename_help_lines() -> Vector<String>:
    let out = []
    out.push("[PATH]                  directory whose files to rename (default: .)")
    out.push("-f, --from S            substring to replace")
    out.push("-t, --to T              replacement for --from")
    out.push("-e, --extension EXT     rewrite the file extension")
    out.push("-p, --prefix P          prepend to each name")
    out.push("-x, --suffix S          insert before the extension")
    out.push("-n, --dry-run           print the plan without renaming")
    return out

func convert_help_lines() -> Vector<String>:
    let out = []
    out.push("-i, --input FILE        input file or - for stdin (default: -)")
    out.push("-o, --output FILE       output file or - for stdout (default: -)")
    out.push("-F, --from json|csv|toml  source format (default: inferred)")
    out.push("-T, --to json|csv|toml    target format (default: inferred)")
    out.push("-P, --pretty            pretty-print where supported")
    return out

// =============================================================================
// Entry point
// =============================================================================

func main():
    let app = build_app()
    let parsed = app.parse(Args.all())
    let code = dispatch(parsed)
    if code != EXIT_OK():
        Stderr.write("${APP_NAME()}: exited with code ${code}\n")
