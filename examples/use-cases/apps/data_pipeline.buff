// data_pipeline.buff - v1.26 real-use-case (T18 full app 3).
//
// A full ETL (Extract → Transform → Load) data processing pipeline for
// tabular sales/order data. Exercises:
//   - Extract:  parse CSV from a file, a raw string, or stdin into a
//                header + row structure, with per-row validation that
//                skips malformed records (emitting warnings, not aborting).
//   - Transform: filter by threshold, enrich with derived columns
//                (bucketed size, normalised totals), aggregate by category
//                via group-by, and compute per-column statistics.
//   - Load:     emit results as formatted ASCII table, CSV, or a
//                JSON-lines stream written to stdout (or a sink path).
//   - Streaming: a chunked streaming pass over raw rows via the
//                buff-pipeline DAG (Source → map → filter → Sink) so the
//                full input is never resident in memory at once.
//
// Framework crates (≤2, per task guardrail):
//   - buff-dataframe  → DataFrame.from_csv / filter / select / sort / head /
//                        group_by(...).agg(...) / to_table_string / len
//   - buff-pipeline   → Pipeline.new / .source / .map / .filter / .batch /
//                        .window / .parallel / .run, Source.from_csv,
//                        Sink.to_csv / Sink.to_json
//
// ⚠ FORWARD-DECLARED: `Type::DataFrame` exists in the prelude registry
// (crates/buff-lang-types/src/ty.rs) with codegen lowering arms for its
// instance methods; `Type::Pipeline` / `Source` / `Sink` are NOT yet
// registered (see buff-pipeline/AGENTS.md "Deferred"). `buff check`
// therefore cannot yet resolve `Pipeline.*` calls; `buff run` cannot
// execute the framework path end-to-end. The deterministic core (CSV
// parsing, validation, stats, formatting, table rendering) is exercised
// directly in `demo()` so the logic is observable + testable today. This
// file is a faithful specification of the intended user surface and feeds
// the T8 + T9 framework-codegen tasks.

import DataFrame from buff.dataframe
import AggOp from buff.dataframe
import Pipeline from buff.pipeline
import Source from buff.pipeline
import Sink from buff.pipeline

// ---------------------------------------------------------------------------
// Configuration + domain types
// ---------------------------------------------------------------------------

// How the Load stage renders its output.
enum OutputFormat {
    Table,
    Csv,
    Json,
}

// Bucketed size label for an order amount (used by the enrich transform).
enum SizeBucket {
    Tiny,
    Small,
    Medium,
    Large,
    Huge,
}

// Reason a single raw row was rejected during validation. Carried in the
// warning log so an operator can trace why N rows were dropped. Positional
// tuple-variant fields (parser does not support named variant fields).
enum RowError {
    EmptyRow,
    WrongArity(Int, Int),
    MissingField(String),
    BadNumber(String, String),
}

// One entry in the run's warning log.
struct Warning:
    line: Int
    reason: RowError
    raw: String

// Summary statistics for a single numeric column.
struct ColumnStats:
    count: Int
    sum: Double
    mean: Double
    min: Double
    max: Double

// Everything an operator wants to know after a run.
struct ETLReport:
    rows_read: Int
    rows_valid: Int
    rows_skipped: Int
    warnings: Vector<Warning>

// ---------------------------------------------------------------------------
// Pure CSV parsing primitives  (deterministic — runnable today)
// ---------------------------------------------------------------------------

// Split a single CSV line into fields, honouring double-quoted values that
// may themselves contain commas. No escape handling beyond the quote toggle
// — deliberately minimal so the core is easy to audit.
func parse_csv_line(line: String) -> Vector<String>:
    let fields = []
    let mut current = ""
    let mut in_quotes = false
    let chars = line.chars()
    for ch in chars:
        if in_quotes:
            if ch == "\"":
                in_quotes = false
            else:
                current = current + ch
        else:
            if ch == "\"":
                in_quotes = true
            else:
                if ch == ",":
                    fields.push(current)
                    current = ""
                else:
                    current = current + ch
    // The final field (even if empty) is always emitted.
    fields.push(current)
    return fields

// Split a whole CSV blob into (headers, rows). Blank lines are dropped.
func parse_csv_blob(blob: String) -> (Vector<String>, Vector<Vector<String>>):
    let headers = []
    let rows = []
    let raw_lines = blob.split(separator: "\n")
    let mut seen_header = false
    for raw in raw_lines:
        let trimmed = raw.trim()
        if trimmed.len() == 0:
            continue
        if seen_header == false:
            headers = parse_csv_line(trimmed)
            seen_header = true
        else:
            rows.push(parse_csv_line(trimmed))
    return (headers, rows)

// Parse text into a Double. Returns Err with the offending text so the
// validator can attach the field name and log a precise warning.
//
// NOTE: the natural spelling `Double.from(text)` is blocked because `from`
// is a reserved Buff keyword (KwFrom) and cannot appear as a method name
// after `.` — see BUGS-FOUND.md BUG-T18-003. This stub validates format
// only; real parsing arrives when the keyword conflict is resolved or an
// alternative conversion API (e.g. `Double.parse`) is added.
func parse_number(text: String) -> Result<Double, String>:
    let trimmed = text.trim()
    if trimmed.len() == 0:
        return Err("empty")
    // Reject obvious garbage early: a leading sign or digit is required.
    let first = trimmed[0]
    if is_digit_or_sign(first) == false:
        return Err(trimmed)
    // Forward-declared: actual numeric parsing deferred (keyword conflict).
    // Returns Ok(0.0) for any syntactically-valid numeric string so the
    // pipeline shape is exercised; the demo's threshold comparisons will
    // treat all valid amounts as 0.0 until the real parser lands.
    return Ok(0.0)

// Predicate: is this character a digit or a leading sign?
func is_digit_or_sign(ch: String) -> Bool:
    if ch == "-":
        return true
    if ch == "+":
        return true
    if ch >= "0":
        if ch <= "9":
            return true
    return false

// ---------------------------------------------------------------------------
// Validation  (deterministic — runnable today)
// ---------------------------------------------------------------------------

// Validate one raw field-list against the header schema. Returns either a
// name→value map (the canonical row shape) or a RowError explaining why.
func validate_row(headers: Vector<String>, fields: Vector<String>) -> Result<Map<String, String>, RowError>:
    if fields.len() == 0:
        return Err(RowError.EmptyRow)
    // A row that is all-empty strings is treated as an empty row too.
    let mut all_empty = true
    for f in fields:
        if f.trim().len() > 0:
            all_empty = false
    if all_empty:
        return Err(RowError.EmptyRow)
    if fields.len() != headers.len():
        return Err(RowError.WrongArity(headers.len(), fields.len()))
    let row = {String: ""}
    let mut idx = 0
    for h in headers:
        let value = fields[idx]
        row[h] = value
        if is_numeric_header(h):
            match parse_number(value):
                Ok(_):
                    // numeric field is valid — nothing to do
                    let _ok = ()
                Err(raw):
                    return Err(RowError.BadNumber(h, raw))
        idx = idx + 1
    return Ok(row)

// Heuristic: a header names a numeric column if it contains a known suffix.
func is_numeric_header(header: String) -> Bool:
    let lower = header.lower()
    let numeric_suffixes = ["amount", "units", "price", "total", "qty", "count", "score", "age"]
    for suffix in numeric_suffixes:
        if lower.contains(suffix):
            return true
    return false

// Render a RowError into a single human-readable line for the warning log.
func describe_error(err: RowError) -> String:
    match err:
        RowError.EmptyRow:
            return "empty row"
        RowError.WrongArity(expected, found):
            return "wrong field count: expected {expected}, found {found}"
        RowError.MissingField(field):
            return "missing required field: {field}"
        RowError.BadNumber(field, raw):
            return "bad number in '{field}': '{raw}'"

// ---------------------------------------------------------------------------
// Statistics  (deterministic — runnable today)
// ---------------------------------------------------------------------------

// Compute count/sum/mean/min/max over a vector of doubles. An empty input
// yields a zeroed stats struct so the caller never divides by zero.
func compute_stats(values: Vector<Double>) -> ColumnStats:
    let n = values.len()
    if n == 0:
        return ColumnStats { count: 0, sum: 0.0, mean: 0.0, min: 0.0, max: 0.0 }
    let mut total = 0.0
    let mut lo = values[0]
    let mut hi = values[0]
    for v in values:
        total = total + v
        if v < lo:
            lo = v
        if v > hi:
            hi = v
    let mean = total / n
    return ColumnStats { count: n, sum: total, mean: mean, min: lo, max: hi }

// Extract the numeric values of a named column from a list of validated
// rows. Non-numeric cells are silently skipped.
func column_values(rows: Vector<Map<String, String>>, name: String) -> Vector<Double>:
    let out = []
    for row in rows:
        let raw = row.get_or(name, default: "")
        match parse_number(raw):
            Ok(v):
                out.push(v)
            Err(_):
                // skip non-numeric cell
                let _skip = ()
    return out

// ---------------------------------------------------------------------------
// Enrichment  (deterministic — runnable today)
// ---------------------------------------------------------------------------

// Bucket an order amount into a coarse size label.
func bucket_amount(amount: Double) -> SizeBucket:
    if amount < 10.0:
        return SizeBucket.Tiny
    if amount < 50.0:
        return SizeBucket.Small
    if amount < 100.0:
        return SizeBucket.Medium
    if amount < 500.0:
        return SizeBucket.Large
    return SizeBucket.Huge

// Render a SizeBucket as a lowercase label string.
func bucket_label(bucket: SizeBucket) -> String:
    match bucket:
        SizeBucket.Tiny:
            return "tiny"
        SizeBucket.Small:
            return "small"
        SizeBucket.Medium:
            return "medium"
        SizeBucket.Large:
            return "large"
        SizeBucket.Huge:
            return "huge"

// Build a single enriched row: copy the originals and add a derived
// `size_bucket` + `amount_norm`. Pure (input never mutated).
func enrich_row(row: Map<String, String>) -> Map<String, String>:
    let out = {String: ""}
    for key in row.keys():
        out[key] = row[key]
    let amount_raw = row.get_or("amount", default: "0")
    match parse_number(amount_raw):
        Ok(amount):
            out["size_bucket"] = bucket_label(bucket_amount(amount))
            out["amount_norm"] = format_number(amount, decimals: 2)
        Err(_):
            out["size_bucket"] = "unknown"
            out["amount_norm"] = "0.00"
    return out

// ---------------------------------------------------------------------------
// Formatting  (deterministic — runnable today)
// ---------------------------------------------------------------------------

// Format a double to a fixed number of decimals as a string.
func format_number(value: Double, decimals: Int) -> String:
    if decimals < 0:
        return "{value}"
    return "{value:." + "{decimals}" + "f}"

// Pad a string to an exact width, right-filling with spaces.
func pad_right(text: String, width: Int) -> String:
    let n = text.len()
    if n >= width:
        return text
    let mut out = text
    let need = width - n
    for _ in 0..need:
        out = out + " "
    return out

// Repeat a single character N times.
func repeat_char(ch: String, count: Int) -> String:
    if count <= 0:
        return ""
    let mut out = ""
    for _ in 0..count:
        out = out + ch
    return out

// Escape a string for safe embedding inside a JSON string literal.
func json_escape(text: String) -> String:
    let mut out = ""
    let chars = text.chars()
    for ch in chars:
        if ch == "\"":
            out = out + "\\\""
        else:
            if ch == "\\":
                out = out + "\\\\"
            else:
                if ch == "\n":
                    out = out + "\\n"
                else:
                    if ch == "\t":
                        out = out + "\\t"
                    else:
                        out = out + ch
    return out

// Render one validated+enriched row as a JSON object line (JSON-lines).
func row_to_json(row: Map<String, String>) -> String:
    let parts = []
    for key in row.keys():
        let value = row.get_or(key, default: "")
        parts.push("\"" + json_escape(key) + "\": \"" + json_escape(value) + "\"")
    let body = parts.join(separator: ", ")
    return "{" + body + "}"

// Render a column of stats as a single aligned line for the summary table.
func stats_line(name: String, stats: ColumnStats) -> String:
    let col = pad_right(name, width: 14)
    return "{col} | n={stats.count} | sum={stats.sum:.2} | mean={stats.mean:.2} | min={stats.min:.2} | max={stats.max:.2}"

// Render a full ASCII table from headers + rows.
func render_table(headers: Vector<String>, rows: Vector<Vector<String>>) -> String:
    if headers.len() == 0:
        return "(empty table)"
    // Column widths: start from the header label length.
    let mut widths = []
    for h in headers:
        widths.push(h.len())
    // Grow to fit the widest cell in each column.
    for row in rows:
        let mut j = 0
        for cell in row:
            if j < widths.len():
                if cell.len() > widths[j]:
                    widths[j] = cell.len()
            j = j + 1
    // Rule line: +---+---+ ... (2 padding spaces + width).
    let rule_parts = []
    for w in widths:
        rule_parts.push(repeat_char("-", count: w + 2))
    let rule = "+" + rule_parts.join(separator: "+") + "+"
    // Header line.
    let header_line = "| " + headers.join(separator: " | ") + " |"
    // Body.
    let body_lines = []
    body_lines.push(rule)
    body_lines.push(header_line)
    body_lines.push(rule)
    for row in rows:
        let cells = []
        let mut m = 0
        for cell in row:
            if m < widths.len():
                cells.push(pad_right(cell, width: widths[m]))
            m = m + 1
        body_lines.push("| " + cells.join(separator: " | ") + " |")
    body_lines.push(rule)
    return body_lines.join(separator: "\n")

// Render validated+enriched rows as a CSV blob (header + lines).
func rows_to_csv(headers: Vector<String>, rows: Vector<Map<String, String>>) -> String:
    let lines = []
    lines.push(headers.join(separator: ","))
    for row in rows:
        let cells = []
        for h in headers:
            cells.push(row.get_or(h, default: ""))
        lines.push(cells.join(separator: ","))
    return lines.join(separator: "\n")

// Render validated+enriched rows as a JSON-lines blob (one object/line).
func rows_to_json(rows: Vector<Map<String, String>>) -> String:
    let lines = []
    for row in rows:
        lines.push(row_to_json(row))
    return lines.join(separator: "\n")

// ---------------------------------------------------------------------------
// Extract  (framework-backed: DataFrame + Source — forward-declared)
// ---------------------------------------------------------------------------

// Load a CSV into a DataFrame via the buff-dataframe constructor.
func extract_from_csv(path: String) -> DataFrame:
    return DataFrame.from_csv(path: path)

// Streaming extract: Source.from_csv reads the file in fixed-size chunks.
func extract_stream(path: String, chunk_size: Int) -> Pipeline<Vector<String>>:
    return Source.from_csv(path: path, chunk_size: chunk_size)

// ---------------------------------------------------------------------------
// Transform  (framework-backed: DataFrame — forward-declared)
// ---------------------------------------------------------------------------

// Keep only rows whose `amount` column is at least `min_amount`.
func transform_filter(df: DataFrame, min_amount: Double) -> DataFrame:
    return df.filter(predicate: { row =>
        row.get_float("amount") >= min_amount
    })

// Project to the columns the report cares about.
func transform_select(df: DataFrame, cols: Vector<String>) -> DataFrame:
    return df.select(cols: cols)

// Sort descending by the named column then keep the top N.
func transform_top_n(df: DataFrame, col: String, n: Int) -> DataFrame:
    return df.sort(by: col, descending: true).head(n: n)

// Group by a category column and aggregate a value column with an op.
func transform_aggregate(df: DataFrame, group_col: String, value_col: String, op: String) -> DataFrame:
    let grouped = df.group_by(col: group_col)
    return grouped.agg(col: value_col, op: op)

// ---------------------------------------------------------------------------
// Streaming transform  (framework-backed: Pipeline — forward-declared)
// ---------------------------------------------------------------------------

// A streaming map+filter over raw String rows.
func stream_transform(pipe: Pipeline<Vector<String>>, min_fields: Int) -> Pipeline<Vector<String>>:
    return pipe
        .filter(predicate: { row => row.len() >= min_fields })
        .map(stage: { row =>
            let out = []
            for cell in row:
                out.push(cell.trim())
            out
        })

// Batch raw rows into fixed-size windows and reduce each window to a summary.
func stream_batch_summary(pipe: Pipeline<Vector<String>>, size: Int) -> Pipeline<String>:
    return pipe.batch(size: size).map(stage: { batch =>
        "window: {batch.len()} rows"
    })

// Parallel CPU-bound stage: classify each row's amount bucket across N workers.
func stream_parallel_bucket(pipe: Pipeline<Vector<String>>, workers: Int) -> Pipeline<String>:
    return pipe.parallel(workers: workers, fn: { row =>
        bucket_label(bucket_amount_from_row(row))
    })

// Helper: pull the amount field out of a raw String row (amount is column
// index 2) and bucket it. Defensive against short rows.
func bucket_amount_from_row(row: Vector<String>) -> SizeBucket:
    if row.len() < 3:
        return SizeBucket.Tiny
    match parse_number(row[2]):
        Ok(v):
            return bucket_amount(v)
        Err(_):
            return SizeBucket.Tiny

// ---------------------------------------------------------------------------
// Load  (framework-backed: Sink — forward-declared)
// ---------------------------------------------------------------------------

// Write a vector of String rows back to a CSV file via Sink.to_csv.
func load_to_csv(path: String, rows: Vector<Vector<String>>) -> Void:
    Sink.to_csv(path: path, rows: rows)

// Serialize a value to a JSON file via Sink.to_json.
func load_to_json(path: String, value: DataFrame) -> Void:
    Sink.to_json(path: path, rows: value)

// Render a DataFrame as a pretty ASCII table string for stdout.
func load_to_table(df: DataFrame) -> String:
    return df.to_table_string()

// ---------------------------------------------------------------------------
// Orchestration: pure ETL over in-memory validated rows (runs today)
// ---------------------------------------------------------------------------

// Run the full Extract → Transform → Load over a raw CSV blob using ONLY
// the deterministic pure helpers. Same blob → same report + output.
func run_etl_pure(blob: String, min_amount: Double, format: OutputFormat) -> (ETLReport, String):
    let (headers, raw_rows) = parse_csv_blob(blob)
    let warnings = []
    let valid_rows = []
    let mut line_no = 1
    for raw in raw_rows:
        line_no = line_no + 1
        match validate_row(headers, raw):
            Ok(row):
                let amount_raw = row.get_or("amount", default: "0")
                match parse_number(amount_raw):
                    Ok(amount):
                        if amount >= min_amount:
                            valid_rows.push(enrich_row(row))
                    Err(_):
                        warnings.push(Warning {
                            line: line_no,
                            reason: RowError.BadNumber("amount", amount_raw),
                            raw: raw.join(separator: ","),
                        })
            Err(reason):
                warnings.push(Warning {
                    line: line_no,
                    reason: reason,
                    raw: raw.join(separator: ","),
                })
    let report = ETLReport {
        rows_read: raw_rows.len(),
        rows_valid: valid_rows.len(),
        rows_skipped: warnings.len(),
        warnings: warnings,
    }
    let output = render_output(headers, valid_rows, format)
    return (report, output)

// Render the validated+enriched rows in the chosen format.
func render_output(headers: Vector<String>, rows: Vector<Map<String, String>>, format: OutputFormat) -> String:
    let enriched_headers = extend_headers(headers)
    match format:
        OutputFormat.Table:
            let table_rows = []
            for row in rows:
                let cells = []
                for h in enriched_headers:
                    cells.push(row.get_or(h, default: ""))
                table_rows.push(cells)
            return render_table(enriched_headers, table_rows)
        OutputFormat.Csv:
            return rows_to_csv(enriched_headers, rows)
        OutputFormat.Json:
            return rows_to_json(rows)

// Append the derived column names to the original header list.
func extend_headers(headers: Vector<String>) -> Vector<String>:
    let out = []
    for h in headers:
        out.push(h)
    if out.contains("size_bucket") == false:
        out.push("size_bucket")
    if out.contains("amount_norm") == false:
        out.push("amount_norm")
    return out

// Build the numeric-column statistics block from the validated rows.
func render_stats_block(headers: Vector<String>, rows: Vector<Map<String, String>>) -> String:
    let lines = []
    for h in headers:
        if is_numeric_header(h):
            let values = column_values(rows, h)
            let stats = compute_stats(values)
            lines.push(stats_line(h, stats))
    return lines.join(separator: "\n")

// Render the warning log: one line per skipped row.
func render_warnings(warnings: Vector<Warning>) -> String:
    if warnings.len() == 0:
        return "(no warnings — all rows valid)"
    let lines = []
    for w in warnings:
        lines.push("  line {w.line}: {describe_error(w.reason)}  [{w.raw}]")
    return lines.join(separator: "\n")

// ---------------------------------------------------------------------------
// Orchestration: framework-backed ETL (forward-declared — feeds T8/T9)
// ---------------------------------------------------------------------------

// The framework-path mirror of run_etl_pure. Same logical stages, but
// expressed against the DataFrame + Pipeline APIs so the codegen tasks
// (T8 type variants, T9 instance-method lowering) have a concrete target.
func run_etl_framework(path: String, min_amount: Double) -> String:
    // Extract.
    let df = extract_from_csv(path: path)
    // Transform: filter → select → top-N.
    let filtered = transform_filter(df, min_amount: min_amount)
    let projected = transform_select(filtered, cols: ["region", "product", "amount", "units"])
    let top = transform_top_n(projected, col: "amount", n: 10)
    // Aggregate: mean amount per region.
    let by_region = transform_aggregate(df, group_col: "region", value_col: "amount", op: "mean")
    // Load: render both as a table.
    let body = load_to_table(top)
    let agg_block = load_to_table(by_region)
    return body + "\n\n--- mean amount per region ---\n" + agg_block

// ---------------------------------------------------------------------------
// Demo: deterministic, observable today
// ---------------------------------------------------------------------------

// A tiny embedded dataset so `demo()` produces real output without a file
// on disk. Columns: region, product, amount, units. Includes one bad row
// (non-numeric amount) and one short row to exercise the warning path.
func sample_blob() -> String:
    let lines = []
    lines.push("region,product,amount,units")
    lines.push("north,widget,120.50,3")
    lines.push("south,gadget,45.00,1")
    lines.push("north,widget,8.25,2")
    lines.push("east,gizmo,300.00,12")
    lines.push("south,widget,broken,4")
    lines.push("west,doohickey,75.10,5")
    lines.push("east,gizmo,210.75,8")
    lines.push("north,gadget")
    lines.push("west,widget,99.99,2")
    return lines.join(separator: "\n")

// Run the pure ETL on the embedded sample at three thresholds and three
// output formats, printing the report + rendered output for each.
func demo():
    print("=== ETL Data Pipeline (T18) — deterministic demo ===")
    print("")
    let blob = sample_blob()
    let (headers, raw_rows) = parse_csv_blob(blob)
    print("input: {raw_rows.len()} raw data rows, {headers.len()} columns")
    let header_str = headers.join(separator: ", ")
    print("headers: {header_str}")
    print("")

    // Pass 1: table output, threshold 0 (keep everything that validates).
    print("--- pass 1: format=Table, min_amount=0.0 ---")
    let (report1, table1) = run_etl_pure(blob, min_amount: 0.0, format: OutputFormat.Table)
    print(report_line(report1))
    print(table1)
    print("")

    // Pass 2: CSV output, threshold 50 (drop small orders).
    print("--- pass 2: format=Csv, min_amount=50.0 ---")
    let (report2, csv2) = run_etl_pure(blob, min_amount: 50.0, format: OutputFormat.Csv)
    print(report_line(report2))
    print(csv2)
    print("")

    // Pass 3: JSON output, threshold 100 (only large orders).
    print("--- pass 3: format=Json, min_amount=100.0 ---")
    let (report3, json2) = run_etl_pure(blob, min_amount: 100.0, format: OutputFormat.Json)
    print(report_line(report3))
    print(json2)
    print("")

    // Numeric stats over the full (unfiltered) valid set.
    print("--- numeric column statistics (all valid rows) ---")
    let (_, all_rows_raw) = parse_csv_blob(blob)
    let all_valid = []
    for raw in all_rows_raw:
        match validate_row(headers, raw):
            Ok(row):
                all_valid.push(enrich_row(row))
            Err(_):
                // skip invalid row silently for the stats pass
                let _skip = ()
    print(render_stats_block(headers, all_valid))
    print("")

    // Warning log from pass 1 (most permissive → fewest skipped).
    print("--- warning log (pass 1) ---")
    print(render_warnings(report1.warnings))
    print("")

    // Bucket distribution: count rows per size bucket.
    print("--- size bucket distribution ---")
    let buckets = {String: 0}
    for bucket_name in ["tiny", "small", "medium", "large", "huge", "unknown"]:
        buckets[bucket_name] = 0
    for row in all_valid:
        let label = row.get_or("size_bucket", default: "unknown")
        let prev = buckets.get_or(label, default: 0)
        buckets[label] = prev + 1
    for label in ["tiny", "small", "medium", "large", "huge", "unknown"]:
        let n = buckets.get_or(label, default: 0)
        if n > 0:
            print("  {label}: {n}")
    print("")

    // Framework-path forward-declaration (does not execute today).
    print("--- framework path (forward-declared, feeds T8/T9) ---")
    print("run_etl_framework(\"sales.csv\", min_amount: 50.0) would:")
    print("  1. DataFrame.from_csv(\"sales.csv\")")
    print("  2. .filter(amount >= 50.0) -> .select([region,product,amount,units])")
    print("  3. .sort(amount desc) -> .head(10)")
    print("  4. .group_by(region).agg(amount, \"mean\")")
    print("  5. render both as ASCII tables")
    print("=== done ===")

// One-line summary of an ETLReport for the demo header.
func report_line(report: ETLReport) -> String:
    return "read={report.rows_read} valid={report.rows_valid} skipped={report.rows_skipped}"

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

func main():
    demo()
