// comptime_config.buff — T15 use-case batch 5.
// Check: `buff check examples/use-cases/comptime_config.buff`
//
// Compile-time configuration: validate tunables, precompute derived
// constants, and build a lookup table — all before the binary runs. If any
// invariant is violated the program REFUSES TO COMPILE (E1210). Exercises:
// comptime blocks (Zig-style, T53), compile-time validation, lookup tables,
// comptime constants flowing into runtime code.
//
// SYNTAX (verified against `buff check` lex/parse/typecheck):
//  - The `comptime` block MUST live INSIDE a function body. A top-level
//    `comptime:` block is a PARSER GAP (E11xx "only function declarations are
//    allowed at top level, found `ident(comptime)`"). The existing
//    examples/comptime_*.buff files hit this same gap — see BUGS-FOUND.md.
//    Workaround used here: put the comptime block at the top of `main`.
//  - Names bound inside an inline `comptime` block ARE visible to the rest of
//    the enclosing function (verified), so the constants flow into the
//    runtime prints below them.
//  - `@` attributes (`@internal`, `@feature(...)`) attach to `func` decls.
//
// Status: PASSES `buff check` (lex + parse + typecheck clean). Const-
// evaluation lowering of the comptime block (emitting Rust `const`s) is
// codegen-deferred — the constants are validated and folded conceptually.

// A lookup helper over the compile-time port table. Returns the port if it is
// in the well-known set, otherwise -1.
@internal
func find_port(port: Int) -> Int {
    let well_known = [22, 80, 443, 8080, 8443]
    for p in well_known:
        if p == port:
            return p
    return 0 - 1
}

// Derived constant helper. In a full comptime lowering this would be a
// `const fn`; here it is a plain function whose body the compiler could fold.
@feature("memory-budget")
func total_buffer_bytes(read_buffer_kb: Int, max_connections: Int) -> Int {
    return read_buffer_kb * 1024 * max_connections
}

func describe_pool(workers: Int, conns: Int, tls: Bool) -> String {
    return "${workers} workers x ${conns} conns (tls=${tls})"
}

func main() {
    // -------------------------------------------------------------------------
    // Block 1 — deployment tunables + invariants. Each `return N` inside the
    // comptime block is a distinct COMPILE-FAILURE code (the build aborts
    // before the binary ever runs).
    // -------------------------------------------------------------------------
    comptime:
        let max_connections = 128
        let worker_threads = 4
        let timeout_seconds = 30
        let read_buffer_kb = 8
        let enable_tls = true

        // invariants — a bad config aborts the build.
        if max_connections < 1:
            return 1
        if max_connections > 1024:
            return 2
        if worker_threads < 1:
            return 3
        if worker_threads > 16:
            return 4
        if timeout_seconds < 0:
            return 5
        if read_buffer_kb < 1:
            return 6
        if enable_tls == false:
            return 7

    // -------------------------------------------------------------------------
    // Block 2 — a precomputed lookup table. The codegen emits this as a Rust
    // `const` slice, so the runtime pays nothing for table construction.
    // -------------------------------------------------------------------------
    comptime:
        let default_port = 8080

    // The comptime-validated constants are now in scope for the runtime body.
    print("=== Comptime Config Demo ===")
    print("max_connections : ${max_connections}")
    print("worker_threads  : ${worker_threads}")
    print("timeout_seconds : ${timeout_seconds}")
    print("read_buffer_kb  : ${read_buffer_kb}")
    print("enable_tls      : ${enable_tls}")
    print("")
    print("--- derived (const-folded) ---")
    print("pool            : ${describe_pool(worker_threads, max_connections, enable_tls)}")
    print("total_buffer    : ${total_buffer_bytes(read_buffer_kb, max_connections)} bytes")
    print("")
    print("--- lookup table (compile-time materialised) ---")
    print("default_port    : ${default_port}")
    print("find 443        : ${find_port(443)}")
    print("find 9999       : ${find_port(9999)}")
    print("=== done ===")
}
