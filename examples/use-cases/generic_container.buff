// generic_container.buff - v1.26 real-use-case (T15 batch 5).
//
// Generic Stack<T> / Queue<T> collection types sharing a `Container` trait,
// plus bounded generic helper functions. Exercises:
//   - user-defined generic structs: `struct Stack<T>`, `struct Queue<T>`
//   - generic enums (typed empty-state): `enum Maybe<T>`
//   - trait declarations: required signatures (`;`) + default-method bodies
//     + supertrait inheritance (`trait Peekable : Container`)
//   - trait bounds on generic params: `<T: Clone>`, `<T: Container>`
//   - generic functions: monomorphized per call site (zero-cost static dispatch)
//
// Status: PURE BUFF (no forward-declared framework imports). The lex / parse /
// typecheck phases (what `buff check` runs) are exercised end-to-end here.
// Trait *generics* (`trait Foo<T>`) and trait-impl lowering are NOT yet
// supported by the parser/codegen — see BUGS-FOUND.md — so the `Container`
// trait is declared non-generic and methods are attached to each struct.

// ---------------------------------------------------------------------------
// A small generic Option-like helper (mirrors the built-in Option<T> shape,
// here as a USER-defined generic enum to exercise `<T>` on enums).
// ---------------------------------------------------------------------------

enum Maybe<T> {
    Just(T),
    Empty,
}

// ---------------------------------------------------------------------------
// Core collection trait. Required methods end with `;` (bodyless); default
// methods carry a body that implementors inherit unless they override.
// Declared NON-generic (trait generics are not yet parseable — BUGS-FOUND).
// ---------------------------------------------------------------------------

trait Container {
    func len(self) -> Int;
    func is_empty(self) -> Bool {
        return self.len() == 0
    }
}

// `Peekable` INHERITS from `Container` (supertrait) and adds a default that
// depends on the required `len` method — demonstrating trait inheritance +
// cross-method default dispatch.

trait Peekable : Container {
    func footprint(self) -> Int {
        return self.len()
    }
}

// ---------------------------------------------------------------------------
// Stack<T> — LIFO container backed by a Vector<T>.
// ---------------------------------------------------------------------------

struct Stack<T> {
    data: Vector<T>,
}

// Methods are free functions named `Type.method`; `self` is the receiver.
// `T` is referenced from the struct's type parameter (no method-level `<T>`).

func Stack.push(self, value: T):
    self.data.push(value)

func Stack.pop(self) -> Maybe<T>:
    let taken = self.data.pop()
    return match taken {
        Some(v) => Maybe.Just(v),
        None => Maybe.Empty,
    }

func Stack.len(self) -> Int:
    return self.data.len()

func Stack.peek(self) -> Maybe<T>:
    if self.data.len() == 0:
        return Maybe.Empty
    let last = self.data.len() - 1
    return Maybe.Just(self.data[last])

// ---------------------------------------------------------------------------
// Queue<T> — FIFO container. A `head` index advances on dequeue so we never
// mutate the backing vector mid-iteration (keeps the demo ownership-friendly).
// ---------------------------------------------------------------------------

struct Queue<T> {
    data: Vector<T>,
    head: Int,
}

func Queue.enqueue(self, value: T):
    self.data.push(value)

func Queue.dequeue(self) -> Maybe<T>:
    if self.head >= self.data.len():
        return Maybe.Empty
    let front = self.data[self.head]
    self.head = self.head + 1
    return Maybe.Just(front)

func Queue.len(self) -> Int:
    return self.data.len() - self.head

func Queue.peek(self) -> Maybe<T>:
    if self.head >= self.data.len():
        return Maybe.Empty
    return Maybe.Just(self.data[self.head])

// ---------------------------------------------------------------------------
// Bounded generic helpers. Bounds appear after the param name as
// `: Bound (+ Bound)*` (T38). rustc monomorphizes each call site, so the
// bound is enforced at compile time with zero runtime cost.
// ---------------------------------------------------------------------------

// Shallow-copy a stack's contents into a fresh Vector. `T: Clone` gates the
// copy out of the shared backing vector.

func drain_stack<T: Clone>(stack: Stack<T>) -> Vector<T>:
    let mut out = []
    for v in stack.data:
        out.push(v)
    return out

// First element of a vector, or a caller-supplied default.

func first_or<T: Clone>(items: Vector<T>, default: T) -> T:
    if items.len() == 0:
        return default
    return items[0]

// A bound referencing a USER-DEFINED trait: anything exposing `len()`
// (i.e. implementing `Container`) can be described. Demonstrates `<T: Container>`.

func describe_container<T: Container>(c) -> Int:
    return c.len()

// ---------------------------------------------------------------------------
// Pretty-print a Maybe<T> without depending on a Debug bound.

func show_maybe(m) -> String:
    return match m {
        Maybe.Just(v) => "Just(${v})",
        Maybe.Empty => "Empty",
    }

// ---------------------------------------------------------------------------
// Demo driver.
// ---------------------------------------------------------------------------

func demo_stack():
    print("--- Stack<Int> ---")
    let s = Stack.new(data: [])
    s.push(10)
    s.push(20)
    s.push(30)
    print("len after 3 pushes: ${s.len()}")
    print("peek (top): ${show_maybe(s.peek())}")
    print("pop: ${show_maybe(s.pop())}")
    print("is_empty: ${s.is_empty()}")

func demo_queue():
    print("")
    print("--- Queue<String> ---")
    let q = Queue.new(data: ["a", "b", "c"], head: 0)
    q.enqueue("d")
    print("len after enqueue: ${q.len()}")
    print("dequeue: ${show_maybe(q.dequeue())}")
    print("dequeue: ${show_maybe(q.dequeue())}")
    print("peek (front): ${show_maybe(q.peek())}")

func demo_generic_helpers():
    print("")
    print("--- bounded generic helpers ---")
    let s = Stack.new(data: [1, 2, 3])
    let drained = drain_stack(s)
    print("drained copy: ${drained}")
    let head = first_or([7, 8, 9], default: 0)
    print("first_or (non-empty): ${head}")
    let fallback = first_or([], default: 0)
    print("first_or (empty -> default): ${fallback}")
    let described = describe_container(s)
    print("describe_container<Stack>: ${described}")

func main():
    print("=== Generic Container Demo ===")
    demo_stack()
    demo_queue()
    demo_generic_helpers()
    print("")
    print("=== done ===")
