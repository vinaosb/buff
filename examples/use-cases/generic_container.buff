// generic_container.buff - v1.26 real-use-case (T15 batch 5).
//
// Generic Stack<T> / Queue<T> collection types sharing a `Container` trait,
// plus bounded generic helper functions. Exercises:
//   - user-defined generic structs: `struct Stack<T>`, `struct Queue<T>`,
//     `struct Pair<T, U>`
//   - trait declaration: required signature (`;`) + default-method body
//   - trait implementation: `impl Container for Stack<T>`
//   - trait bounds on generic params: `<T: Clone>`, `<T: Clone + Container>`
//   - generic functions: monomorphized per call site (zero-cost static dispatch)
//
// Status: PURE BUFF (no forward-declared framework imports). PASSES `buff
// check` (lex + parse + typecheck clean) — verified via the front-end crates
// directly (the full `buff` CLI could not be built on this host; see
// BUGS-FOUND.md). Trait-impl + user-struct codegen lowering is a separate
// sibling task.
//
// SYNTAX NOTES (all verified against the parser):
//   - Bounds ARE supported (T38): `<T: Clone>`, `<T: Clone + Debug>`, and
//     `<T: Container>` (a user-defined trait) all parse. (Generic enums
//     `enum Foo<T>` parse too — see crates/.../generic_bounds.rs — but this
//     file uses the built-in Option<T> for its empty-state so the match
//     patterns stay on the proven `Some(v)` / `None` form.)
//   - Container ops are FREE FUNCTIONS taking the container as the first arg
//     (`stack_push(s, v)`) — Buff has no inherent-`impl` block, and dotted
//     method names (`func Stack.push`) do not parse at top level.
//   - `Container` is declared NON-generic: trait generics (`trait Foo<T>`)
//     are not yet parseable — see BUGS-FOUND.md.
//   - Match arms are EXPRESSIONS only (`arm => expr`); no `return`/`let`
//     inside an arm — use `return match x { ... }`.
//   - `while` is NOT a keyword; loops use `for`. Every function param has an
//     explicit type (untyped params are unreliable after generic/impl decls).

// ---------------------------------------------------------------------------
// Core collection trait. Required methods end with `;` (bodyless); default
// methods carry a body that implementors inherit unless they override.
// ---------------------------------------------------------------------------

trait Container {
    func size(self) -> Int;
    func is_empty(self) -> Bool {
        return self.size() == 0
    }
}

// ---------------------------------------------------------------------------
// Stack<T> — LIFO container backed by a Vector<T>.
// ---------------------------------------------------------------------------

struct Stack<T> {
    data: Vector<T>,
}

impl Container for Stack<T> {
    func size(self) -> Int {
        return self.data.len()
    }
}

func stack_new<T>() -> Stack<T>:
    return Stack.new(data: [])

func stack_push<T>(s: Stack<T>, value: T):
    s.data.push(value)

func stack_pop<T>(s: Stack<T>) -> Option<T>:
    return s.data.pop()

func stack_peek<T>(s: Stack<T>) -> Option<T>:
    if s.data.len() == 0:
        return None
    let last = s.data.len() - 1
    return Some(s.data[last])

// ---------------------------------------------------------------------------
// Queue<T> — FIFO container. A `head` index advances on dequeue so we never
// mutate the backing vector mid-iteration (no shift loop needed).
// ---------------------------------------------------------------------------

struct Queue<T> {
    data: Vector<T>,
    head: Int,
}

impl Container for Queue<T> {
    func size(self) -> Int {
        return self.data.len() - self.head
    }
}

func queue_new<T>() -> Queue<T>:
    return Queue.new(data: [], head: 0)

func queue_push<T>(q: Queue<T>, value: T):
    q.data.push(value)

func queue_pop<T>(q: Queue<T>) -> Option<T>:
    if q.head >= q.data.len():
        return None
    let front = q.data[q.head]
    q.head = q.head + 1
    return Some(front)

func queue_peek<T>(q: Queue<T>) -> Option<T>:
    if q.head >= q.data.len():
        return None
    return Some(q.data[q.head])

// ---------------------------------------------------------------------------
// Bounded generic helpers. Bounds appear after the param name as
// `: Bound (+ Bound)*` (T38 — supported). rustc monomorphizes each call site,
// so the bound is enforced at compile time with zero runtime cost.
// ---------------------------------------------------------------------------

// Shallow-copy a stack's contents into a fresh Vector. `T: Clone` gates the
// copy out of the shared backing vector.

func drain_stack<T: Clone>(s: Stack<T>) -> Vector<T>:
    let mut out = []
    for v in s.data:
        out.push(v)
    return out

// First element of a vector, or a caller-supplied default.

func first_or<T: Clone>(items: Vector<T>, default: T) -> T:
    if items.len() == 0:
        return default
    return items[0]

// A bound referencing a USER-DEFINED trait: anything exposing `size()`
// (i.e. implementing `Container`) can be measured. Demonstrates `<T: Container>`.

func measure<T: Container>(c: T) -> Int:
    return c.size()

// Generic identity + pair — multi-parameter generics + monomorphization.

func identity<T>(x: T) -> T:
    return x

struct Pair<T, U> {
    first: T,
    second: U,
}

func make_pair<T, U>(a: T, b: U) -> Pair<T, U>:
    return Pair.new(first: a, second: b)

// ---------------------------------------------------------------------------
// Pretty-print an Option<T> without depending on a Debug bound.

func show_opt<T>(m: Option<T>) -> String:
    return match m {
        Some(v) => "Some(${v})",
        None => "None",
    }

// ---------------------------------------------------------------------------
// Demo driver.
// ---------------------------------------------------------------------------

func demo_stack():
    print("--- Stack<Int> ---")
    let s = stack_new()
    stack_push(s, 10)
    stack_push(s, 20)
    stack_push(s, 30)
    print("size after 3 pushes: ${s.size()}")
    print("peek (top): ${show_opt(stack_peek(s))}")
    print("pop: ${show_opt(stack_pop(s))}")
    print("is_empty: ${s.is_empty()}")

func demo_queue():
    print("")
    print("--- Queue<String> ---")
    let q = queue_new()
    queue_push(q, "a")
    queue_push(q, "b")
    queue_push(q, "c")
    print("size after 3 pushes: ${q.size()}")
    print("dequeue: ${show_opt(queue_pop(q))}")
    print("dequeue: ${show_opt(queue_pop(q))}")
    print("peek (front): ${show_opt(queue_peek(q))}")

func demo_generic_helpers():
    print("")
    print("--- bounded generic helpers ---")
    let s = stack_new()
    stack_push(s, 1)
    stack_push(s, 2)
    stack_push(s, 3)
    print("drained copy: ${drain_stack(s)}")
    let head = first_or([7, 8, 9], default: 0)
    print("first_or (non-empty): ${head}")
    let fallback = first_or([], default: 0)
    print("first_or (empty -> default): ${fallback}")
    print("measure<Stack>: ${measure(s)}")
    print("identity<Int>: ${identity(42)}")
    print("identity<String>: ${identity("ok")}")
    let p = make_pair(1, "two")
    print("pair: first=${p.first}, second=${p.second}")

func main():
    print("=== Generic Container Demo ===")
    demo_stack()
    demo_queue()
    demo_generic_helpers()
    print("")
    print("=== done ===")
