// exhaustive_matching.buff - v1.26 real-use-case (T15 batch 5).
//
// Pattern matching at scale: a 12-variant HTTP status enum + a data-carrying
// geometry enum, matched exhaustively with or-patterns, guards, destructuring,
// and catch-all. Exercises:
//   - large enums (12+ variants) and exhaustive coverage checking
//   - or-patterns grouping arms (`A | B`)
//   - match guards (`Variant(x) if x > 0`)
//   - positional struct/enum destructuring (`Rect(w, h)`)
//   - catch-all `_` arm
//
// Status: PURE BUFF. Match exhaustiveness checker (T27) and parser exercised
// via `buff check`. Some arm forms may be parse-only — see BUGS-FOUND.md.

// ---------------------------------------------------------------------------
// HTTP-style status codes. 12 variants across 5 classes — large enough to
// make exhaustive matching meaningful and to reward grouping.
// ---------------------------------------------------------------------------

enum HttpStatus {
    Continue,
    Ok,
    Created,
    NoContent,
    MovedPermanently,
    Found,
    BadRequest,
    Unauthorized,
    Forbidden,
    NotFound,
    InternalError,
    GatewayTimeout,
}

// Numeric class (1xx..5xx) used by the guard example below.

func http_class(status: HttpStatus) -> Int:
    match status:
        HttpStatus.Continue:
            return 100
        HttpStatus.Ok:
            return 200
        HttpStatus.Created:
            return 201
        HttpStatus.NoContent:
            return 204
        HttpStatus.MovedPermanently:
            return 301
        HttpStatus.Found:
            return 302
        HttpStatus.BadRequest:
            return 400
        HttpStatus.Unauthorized:
            return 401
        HttpStatus.Forbidden:
            return 403
        HttpStatus.NotFound:
            return 404
        HttpStatus.InternalError:
            return 500
        HttpStatus.GatewayTimeout:
            return 504

// Human-readable label. Demonstrates OR-PATTERNS: several variants collapse
// onto one label arm, and the final arm is still exhaustive on its own.

func status_label(status: HttpStatus) -> String:
    match status:
        HttpStatus.Continue:
            return "informational"
        HttpStatus.Ok | HttpStatus.Created | HttpStatus.NoContent:
            return "success"
        HttpStatus.MovedPermanently | HttpStatus.Found:
            return "redirection"
        HttpStatus.BadRequest | HttpStatus.Unauthorized | HttpStatus.Forbidden | HttpStatus.NotFound:
            return "client error"
        HttpStatus.InternalError | HttpStatus.GatewayTimeout:
            return "server error"

// Boolean category predicates. More or-pattern grouping, returning Bool.

func is_success(status: HttpStatus) -> Bool:
    match status:
        HttpStatus.Ok | HttpStatus.Created | HttpStatus.NoContent:
            return true
        _:
            return false

func is_client_error(status: HttpStatus) -> Bool:
    match status:
        HttpStatus.BadRequest | HttpStatus.Unauthorized | HttpStatus.Forbidden | HttpStatus.NotFound:
            return true
        _:
            return false

// ---------------------------------------------------------------------------
// Geometry enum with POSITIONAL DATA — exercises destructuring inside match
// arms plus guards.
// ---------------------------------------------------------------------------

enum Shape {
    Point,
    Circle(Double),
    Square(Double),
    Rectangle(Double, Double),
    Triangle(Double, Double, Double),
}

// Area via exhaustive destructuring. Each arm binds the embedded fields.

func area(shape: Shape) -> Double:
    match shape:
        Shape.Point:
            return 0.0
        Shape.Circle(r):
            return 3.14159 * r * r
        Shape.Square(s):
            return s * s
        Shape.Rectangle(w, h):
            return w * h
        Shape.Triangle(base, height, _):
            return 0.5 * base * height

// Perimeter, again exhaustive.

func perimeter(shape: Shape) -> Double:
    match shape:
        Shape.Point:
            return 0.0
        Shape.Circle(r):
            return 2.0 * 3.14159 * r
        Shape.Square(s):
            return 4.0 * s
        Shape.Rectangle(w, h):
            return 2.0 * (w + h)
        Shape.Triangle(a, b, c):
            return a + b + c

// Classification with a GUARD: a rectangle whose sides are equal is really
// a square. Guards refine a pattern without splitting it into a new variant.

func classify_shape(shape: Shape) -> String:
    match shape:
        Shape.Point:
            return "point"
        Shape.Circle(_):
            return "circle"
        Shape.Square(_):
            return "square"
        Shape.Rectangle(w, h) if w == h:
            return "square (degenerate rectangle)"
        Shape.Rectangle(_, _):
            return "rectangle"
        Shape.Triangle(_, _, _):
            return "triangle"

// Largest dimension across all shape kinds — uses binding + nested if.

func largest_side(shape: Shape) -> Double:
    match shape:
        Shape.Point:
            return 0.0
        Shape.Circle(r):
            return 2.0 * r
        Shape.Square(s):
            return s
        Shape.Rectangle(w, h):
            if w >= h:
                return w
            return h
        Shape.Triangle(a, b, c):
            let mut m = a
            if b > m:
                m = b
            if c > m:
                m = c
            return m

// ---------------------------------------------------------------------------
// Demo driver.
// ---------------------------------------------------------------------------

func show_status(status: HttpStatus) -> String:
    let code = http_class(status)
    let label = status_label(status)
    let ok = is_success(status)
    let client = is_client_error(status)
    return "${code} ${status} [${label}] success=${ok} client_error=${client}"

func demo_status():
    print("--- HttpStatus (12 variants, exhaustive) ---")
    let sample = [
        HttpStatus.Ok,
        HttpStatus.Created,
        HttpStatus.MovedPermanently,
        HttpStatus.BadRequest,
        HttpStatus.Unauthorized,
        HttpStatus.NotFound,
        HttpStatus.InternalError,
        HttpStatus.GatewayTimeout,
    ]
    for s in sample:
        print(show_status(s))

func demo_shapes():
    print("")
    print("--- Shape (destructuring + guards) ---")
    let shapes = [
        Shape.Point,
        Shape.Circle(5.0),
        Shape.Circle(4.0),
        Shape.Rectangle(3.0, 4.0),
        Shape.Rectangle(5.0, 5.0),
        Shape.Triangle(3.0, 4.0, 5.0),
    ]
    for s in shapes:
        let kind = classify_shape(s)
        let a = area(s)
        let p = perimeter(s)
        let side = largest_side(s)
        print("${kind}: area=${a}, perimeter=${p}, largest=${side}")

func main():
    print("=== Exhaustive Matching Demo ===")
    demo_status()
    demo_shapes()
    print("")
    print("=== done ===")
