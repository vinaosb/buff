// T13 example: rk4.buff - integrate exponential ODE.
//
// Solves dy/dt = y, y(0) = 1 using RK4.
// The exact solution is y(t) = e^t.
// At t=1, y ≈ 2.71828.

func main():
    let result = Science.ode.rk4(
        |t, y| y,
        1.0,    // initial y(0)
        0.0,    // t_start
        1.0,    // t_end
        0.001,  // step size
    )
    print("RK4 result at t=1:", result)
    print("Expected e^1:", 2.71828)
