// T8 example: hello.buff - basic Tensor creation + shape query.
//
// Demonstrates the EXPERIMENTAL Tensor prelude-type surface:
//   - Tensor.zeros(shape) creates a zero-filled tensor
//   - t.shape() returns the per-axis dimensions
//   - t.rank() returns the number of dimensions
//   - t.len() returns the total element count
//
// Per T8 spec line 1525-1529 acceptance scenario.
//
// MVP scope:
//   - dtype: f32 ONLY (f64/i64 deferred to v1.18+)
//   - rank: <= 4 (rank > 4 deferred to v1.18+)
//   - CPU-only via rayon (GPU dispatch deferred per T6 decision)

func main():
    let t = Tensor.zeros([3, 4])
    print("shape:", t.shape())
    print("rank:", t.rank())
    print("len:", t.len())
