{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "buff",
      "camelcase": "Buff",
      "title": "Buff",
      "scope": "source.buff",
      "file-types": ["buff"],
      "injection-regex": "^buff$",
      "class-name": "TreeSitterBuff",
      "highlights": "queries/highlights.scm",
      "folds": "queries/folds.scm",
      "indents": "queries/indents.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Buff grammar for tree-sitter (offside-rule; layout-sensitive language that transpiles to Rust).",
    "links": {
      "repository": "https://github.com/buff-lang/buff.git"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
