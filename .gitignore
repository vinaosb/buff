# Rust
target/
*.rs.bk

# Examples (build artifacts)
examples/**/*.rs
# Exception: the rust-vs-buff comparison library ships hand-written .rs (the
# "painful Rust" half of each side-by-side pair), NOT build output.
!examples/rust-vs-buff/**/*.rs

# Test fixtures (compile_to_rust writes <name>.rs side artifacts)
tests/fixtures/**/*.rs
# Exception: snapshot files ARE tracked as backward-compat contract
!tests/fixtures/**/*.snapshot.rs

# Buff
buff.lock

# Sisyphus evidence
.sisyphus/evidence/

# Snapshot new files
*.snap.new
*.pending-snap

# IDEs
.idea/
.vscode/

# Editors / VSCode extension (editors/vscode/)
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/.vscode-test/
editors/vscode/**/*.vsix

# OS
.DS_Store
Thumbs.db
