{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Buff",
    "scopeName": "source.buff",
    "fileTypes": ["buff"],
    "firstLineMatch": "^#!.*\\bbuff\\b",
    "patterns": [
        {"include": "#comments"},
        {"include": "#attributes"},
        {"include": "#keywords"},
        {"include": "#literals"},
        {"include": "#strings"},
        {"include": "#types"},
        {"include": "#functions"},
        {"include": "#punctuation"}
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.buff",
                    "begin": "//",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.comment.buff"}
                    },
                    "end": "$",
                    "patterns": [
                        {"include": "#string-interpolation"}
                    ]
                },
                {
                    "name": "comment.block.buff",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.comment.buff"}
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.comment.buff"}
                    }
                }
            ]
        },
        "string-interpolation": {
            "comment": "Reserved for shell-style ${} interpolation inside string literals; Buff itself uses {expr}.",
            "patterns": [
                {
                    "name": "string.interpolated.buff",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "meta.attribute.buff",
                    "match": "@[A-Za-z_][A-Za-z0-9_]*",
                    "captures": {
                        "0": {"name": "entity.other.attribute-name.buff"}
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Declaration keywords",
                    "name": "keyword.control.declaration.buff",
                    "match": "\\b(func|let|enum|trait|type|import|export|extern|spawn|extend|guard|defer)\\b"
                },
                {
                    "comment": "Control-flow keywords",
                    "name": "keyword.control.buff",
                    "match": "\\b(if|else|elif|for|while|return|break|continue|match|in)\\b"
                },
                {
                    "comment": "Operator-like keywords (import-as, cast)",
                    "name": "keyword.operator.buff",
                    "match": "\\b(as|from|crate)\\b"
                },
                {
                    "comment": "Storage modifiers",
                    "name": "storage.modifier.buff",
                    "match": "\\b(mut|async|extern|unsafe)\\b"
                },
                {
                    "comment": "Booleans are constants",
                    "name": "constant.language.boolean.buff",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "comment": "Booleans self",
                    "name": "variable.language.buff",
                    "match": "\\bself\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.buff",
                    "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?)?\\b"
                },
                {
                    "comment": "Character literal",
                    "name": "string.quoted.single.buff",
                    "match": "'([^'\\\\\\n]|\\\\.|\\\\u\\{[0-9a-fA-F]+\\})'"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "T93: Raw string literal r\"...\" and r#\"...\"# (Rust-style).",
                    "name": "string.quoted.other.buff",
                    "match": "br#*\"(?:[^\"\"]|(?!\"#*\"))*\"#*"
                },
                {
                    "comment": "T21: Triple-quoted raw string \"\"\"...\"\"\" (no escapes, no interpolation).",
                    "name": "string.quoted.triple.buff",
                    "begin": "\"\"\"",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.string.begin.buff"}
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.buff"}
                    }
                },
                {
                    "comment": "String literal with interpolation",
                    "name": "string.quoted.double.buff",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.string.begin.buff"}
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.buff"}
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.buff",
                            "match": "\\\\([^xuU]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|u\\{[0-9a-fA-F]+\\})"
                        },
                        {
                            "comment": "Interpolation: {expr}",
                            "name": "meta.interpolation.buff",
                            "begin": "\\{",
                            "beginCaptures": {
                                "0": {"name": "punctuation.section.interpolation.begin.buff"}
                            },
                            "end": "\\}",
                            "endCaptures": {
                                "0": {"name": "punctuation.section.interpolation.end.buff"}
                            },
                            "patterns": [
                                {"include": "$base"}
                            ]
                        }
                    ]
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "T13/T24: Generic type parameter list <T, U> — captures the angle brackets as generic punctuation and the inner PascalCase identifiers as types. Must run before the catch-all PascalCase rule and before the operator rule so < and > are not styled as comparison operators inside a type position.",
                    "name": "meta.generic.buff",
                    "begin": "(?<=\\b(?:Vector|Map|Set|Option|Result|Tensor|Matrix|Channel|Range|Tuple|Buffer|Stream|Iter|Iterator|Box|Arc|Rc|Cell|RefCell|HashMap|HashSet|BTreeMap|BTreeSet|VecDeque|LinkedList)\\s*)\\<",
                    "beginCaptures": {
                        "0": {"name": "punctuation.definition.generic.begin.buff"}
                    },
                    "end": "\\>",
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.generic.end.buff"}
                    },
                    "patterns": [
                        {"include": "#comments"},
                        {"include": "#keywords"},
                        {"include": "#literals"},
                        {"include": "#strings"},
                        {
                            "comment": "PascalCase identifiers are types",
                            "name": "entity.name.type.buff",
                            "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                        },
                        {
                            "comment": "lowercase identifiers used as type-variable names (T, U, V are uppercase so they hit the rule above; e, k, v inside Map<k,v> would too only if upper — otherwise style as variable)",
                            "name": "variable.parameter.type.buff",
                            "match": "\\b[a-z][A-Za-z0-9_]*\\b"
                        },
                        {
                            "name": "punctuation.separator.buff",
                            "match": ","
                        },
                        {
                            "name": "keyword.operator.buff",
                            "match": "\\="
                        }
                    ]
                },
                {
                    "comment": "PascalCase identifiers are types",
                    "name": "entity.name.type.buff",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "comment": "Function declaration: func <name>",
                    "match": "\\bfunc\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {"name": "entity.name.function.buff"}
                    }
                },
                {
                    "comment": "Function call sites",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {"name": "support.function.buff"}
                    }
                },
                {
                    "comment": "Method call: .method(...)",
                    "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "2": {"name": "entity.name.function.method.buff"}
                    }
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "comment": "Operators (longest-match-first within each run: ..= before .., .= before ., etc.). T84 ranges .. and ..= appear here so they are scoped as operators (not punctuation) and colour consistently with other arithmetic.",
                    "name": "keyword.operator.buff",
                    "match": "(\\.\\.=|\\.\\.|->|=>|\\+=|\\-=|\\*=|/=|%=|<<|>>|<=|>=|==|!=|&&|\\|\\||\\|>|\\?\\.|\\+|\\-|\\*|/|%|<|>|!|&|\\||\\^|~|=|\\?)"
                },
                {
                    "comment": "Punctuation: delimiters",
                    "name": "punctuation.separator.buff",
                    "match": "(\\.|,|:|;)"
                },
                {
                    "comment": "Punctuation: braces/brackets",
                    "name": "punctuation.section.brackets.buff",
                    "match": "(\\(|\\)|\\{|\\}|\\[|\\])"
                }
            ]
        }
    }
}
