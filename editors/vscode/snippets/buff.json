{
    "Function": {
        "prefix": "func",
        "body": [
            "func ${1:name}(${2:params})${3: -> ${4:ReturnType}}:",
            "    ${0:body}"
        ],
        "description": "Function declaration (layout-based body)"
    },
    "Generic Function": {
        "prefix": "func<",
        "body": [
            "func ${1:name}<${2:T}>(${3:params})${4: -> ${5:ReturnType}}:",
            "    ${0:body}"
        ],
        "description": "Generic function declaration (T13/T24 type params)"
    },
    "Async Function": {
        "prefix": "async func",
        "body": [
            "async func ${1:name}(${2:params})${3: -> ${4:ReturnType}}:",
            "    ${0:body}"
        ],
        "description": "Async function declaration"
    },
    "Let binding": {
        "prefix": "let",
        "body": [
            "let ${1:name} = ${0:value}"
        ],
        "description": "Immutable let binding"
    },
    "Let binding (typed)": {
        "prefix": "let:",
        "body": [
            "let ${1:name}: ${2:Type} = ${0:value}"
        ],
        "description": "Immutable let binding with an explicit type annotation"
    },
    "Let binding (generic type)": {
        "prefix": "let vector",
        "body": [
            "let ${1:name}: Vector<${2:Int}> = ${0:[]}"
        ],
        "description": "Let binding with a generic Vector<T> type annotation (T13/T24)"
    },
    "Let mutable": {
        "prefix": "let mut",
        "body": [
            "let mut ${1:name} = ${0:value}"
        ],
        "description": "Mutable let binding"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if ${1:condition}:",
            "    ${0:body}"
        ],
        "description": "If block (layout body)"
    },
    "If-Else": {
        "prefix": "if else",
        "body": [
            "if ${1:condition}:",
            "    ${2:then}",
            "else:",
            "    ${0:else}"
        ],
        "description": "If-Else block"
    },
    "Elif chain": {
        "prefix": "elif",
        "body": [
            "elif ${1:condition}:",
            "    ${0:body}"
        ],
        "description": "Elif branch"
    },
    "For-in": {
        "prefix": "for",
        "body": [
            "for ${1:item} in ${2:iterator}:",
            "    ${0:body}"
        ],
        "description": "For-in loop (layout body)"
    },
    "Match": {
        "prefix": "match",
        "body": [
            "match ${1:scrutinee}:",
            "    ${2:pattern} => ${3:value}",
            "    ${4:pattern} => ${5:value}${0:}"
        ],
        "description": "Match expression over a scrutinee"
    },
    "Match arm": {
        "prefix": "=>",
        "body": [
            "${1:pattern} => ${0:value}"
        ],
        "description": "Single match arm"
    },
    "Match Option": {
        "prefix": "match option",
        "body": [
            "match ${1:expr}:",
            "    Some(${2:value}) => ${3:handle_some}",
            "    None => ${0:handle_none}"
        ],
        "description": "Match over an Option<T> (Some / None)"
    },
    "Match Result": {
        "prefix": "match result",
        "body": [
            "match ${1:expr}:",
            "    Ok(${2:value}) => ${3:handle_ok}",
            "    Err(${4:err}) => ${0:handle_err}"
        ],
        "description": "Match over a Result<T, E> (Ok / Err)"
    },
    "Or-pattern arm": {
        "prefix": "or pattern",
        "body": [
            "${1:First} | ${2:Second} => ${0:value}"
        ],
        "description": "Match arm with an or-pattern (T13: A | B binds both to the same body)"
    },
    "Range for-loop (exclusive)": {
        "prefix": "for range",
        "body": [
            "for ${1:i} in ${2:0}..${3:n}:",
            "    ${0:body}"
        ],
        "description": "for-in over an exclusive range a..b (T84)"
    },
    "Range for-loop (inclusive)": {
        "prefix": "for range=",
        "body": [
            "for ${1:i} in ${2:0}..=${3:n}:",
            "    ${0:body}"
        ],
        "description": "for-in over an inclusive range a..=b (T84)"
    },
    "Range expression": {
        "prefix": "range",
        "body": [
            "${1:start}..${2:end}"
        ],
        "description": "Exclusive range expression a..b (T84)"
    },
    "Range expression (inclusive)": {
        "prefix": "range=",
        "body": [
            "${1:start}..=${2:end}"
        ],
        "description": "Inclusive range expression a..=b (T84)"
    },
    "Return": {
        "prefix": "return",
        "body": [
            "return ${0:value}"
        ],
        "description": "Return statement"
    },
    "Print": {
        "prefix": "print",
        "body": [
            "print(${1:\"${0:text}\"})"
        ],
        "description": "Print to stdout (prelude)"
    },
    "Struct-style enum variant": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name}:",
            "    ${2:Variant}${0:}"
        ],
        "description": "Enum declaration"
    },
    "Trait": {
        "prefix": "trait",
        "body": [
            "trait ${1:Name}:",
            "    ${0:body}"
        ],
        "description": "Trait declaration"
    },
    "Import": {
        "prefix": "import",
        "body": [
            "import ${1:name} from \"${0:module}\""
        ],
        "description": "Import declaration"
    },
    "Spawn": {
        "prefix": "spawn",
        "body": [
            "spawn ${0:task}"
        ],
        "description": "Spawn an async task (no await needed)"
    },
    "Defer": {
        "prefix": "defer",
        "body": [
            "defer:",
            "    ${0:cleanup}"
        ],
        "description": "Defer a cleanup block to run LIFO at scope exit (commit 2b12f75)"
    },
    "Generic Struct": {
        "prefix": "struct<",
        "body": [
            "struct ${1:Name}<${2:T}>:",
            "    ${0:field}"
        ],
        "description": "Generic struct declaration (T13/T24 type params)"
    }
}
