# T54 example: SIMD dot product vs scalar loop.
# Buff source (codegen-lowered via buff-lang-codegen-rust to buff_simd::*).
#
# Run via:
#   buff run examples/simd_dot_product.buff

func main():
    let a = Simd.from_array([1.0, 2.0, 3.0, 4.0])
    let b = Simd.from_array([5.0, 6.0, 7.0, 8.0])
    let simd_result = a.mul(b).sum()
    let scalar_result = 1.0 * 5.0 + 2.0 * 6.0 + 3.0 * 7.0 + 4.0 * 8.0
    print(simd_result)
    print(scalar_result)
    print(simd_result - scalar_result < 0.00001)
