// T54 example: SIMD math - lane-wise mul/div + horizontal min/max.
// Buff source (codegen-lowered via buff-lang-codegen-rust to buff_simd::*).
//
// Run via:
//   buff run examples/simd_math.buff

func main():
    let a = Simd.from_array([1.0, 4.0, 9.0, 16.0])
    let inv = Simd.splat(2.0)
    let halved = a.div(inv)
    let squared = a.mul(a)
    print(halved)
    print(squared)
    print(a.min())
    print(a.max())
    print(squared.sum())
