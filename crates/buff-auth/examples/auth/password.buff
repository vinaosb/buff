# T34 .buff example: password hash + verify roundtrip (FORWARD-DECL).
#
# Requires the coordinated PreludeType::Password + PreludeAssocFn::
# PasswordHash / PasswordVerify codegen lowering arms (this task,
# T34 finish).

from "auth" import Password

func main():
    plain = "correct horse battery staple"
    hash = Password.hash(plain: plain)
    print("hash: ${hash}")

    ok = Password.verify(plain: plain, hash: hash)
    print("verify correct: ${ok}")

    wrong = Password.verify(plain: "not the password", hash: hash)
    print("verify wrong: ${wrong} (expected false)")
