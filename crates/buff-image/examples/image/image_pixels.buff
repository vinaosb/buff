// T9 .buff example: pixel-level access (FORWARD-DECL).
//
// Requires the coordinated Type::Image codegen lowering arm (this task,
// T9 finish). The prelude registry entry `PreludeType::Image` +
// instance-method arms were added in the same T9 finish commit as this
// example. See crates/buff-image/AGENTS.md "RELATIONSHIP TO OTHER
// CRATES" for the wiring map.

from "image" import Image, Color

func main():
    img = Image.new(width: 100, height: 100, fill: Color.rgb(r: 255, g: 0, b: 0))
    print("created: ${img.width()}x${img.height()}")

    corner = img.get_pixel(x: 0, y: 0)
    print("corner pixel: r=${corner.r()} g=${corner.g()} b=${corner.b()}")

    for i in Range.new(start: 0, end: 100):
        img.set_pixel(x: i, y: i, color: Color.rgb(r: 0, g: 255, b: 0))

    mid = img.get_pixel(x: 50, y: 50)
    print("mid-diagonal pixel: r=${mid.r()} g=${mid.g()} b=${mid.b()}")

    img.save(path: "/tmp/buff_image_pixels.png")
    print("saved to /tmp/buff_image_pixels.png")
