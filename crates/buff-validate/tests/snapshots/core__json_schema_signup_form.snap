---
source: crates/buff-validate/tests/core.rs
expression: "serde_json::to_string_pretty(&schema).unwrap_or_default()"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "zip": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    }
  },
  "required": [
    "age",
    "email",
    "name",
    "zip"
  ],
  "additionalProperties": true
}
