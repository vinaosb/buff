{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "{name}",
  "version": "0.1.0",
  "identifier": "com.buff-lang.{name}",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "buff ui dev",
    "beforeBuildCommand": "buff ui build"
  },
  "app": {
    "windows": [
      {
        "title": "{name}",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
