// {name} - generated by `buff ui new --desktop`
// Tauri 2.0 desktop app wrapping a Buff-Wasm-Dioxus frontend.
//
// Build the Wasm bundle with `buff ui build --desktop` (requires
// the Tauri CLI: `cargo install tauri-cli`).
//
// The `@ui` attribute marks this as the UI entry point. The compiler
// emits a Dioxus component that the Tauri webview loads.

@ui
func main():
    let count = signal(0)

    render(
        button(
            onclick: move |_| count.set(count() + 1),
            "Increment (count: {count()})"
        )
    )
