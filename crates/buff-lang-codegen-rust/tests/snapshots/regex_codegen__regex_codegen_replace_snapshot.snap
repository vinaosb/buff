fn f() {
    let r: regex::Regex = regex::Regex::new("\\d".to_string())
        .unwrap_or_else(|_| regex::Regex::new("a^").unwrap());
    r.replace_all("a1b2".to_string(), "X".to_string()).to_string();
}
