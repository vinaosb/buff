fn f() {
    let p: Option<std::process::Child> = std::process::Command::new("ls".to_string())
        .args(vec![])
        .spawn()
        .ok();
    p.map(|mut c| { c.wait().map(|s| s.code().unwrap_or_default()).unwrap_or_default() })
        .unwrap_or_default();
}
