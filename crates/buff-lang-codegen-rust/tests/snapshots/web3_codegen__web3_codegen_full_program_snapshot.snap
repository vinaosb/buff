fn main() {
    let provider: buff_web3::Provider = buff_web3::Provider::new(
            &"https://eth-mainnet.alchemyapi.io/v2/KEY".to_string(),
        )
        .unwrap_or_default();
    provider.chain_id().unwrap_or_default() as i64;
    provider.clone().block_number().unwrap_or_default() as i64;
    provider
        .clone()
        .get_balance(&"0x0123456789012345678901234567890123456789".to_string())
        .unwrap_or_default() as i64;
    let wallet: buff_web3::Wallet = buff_web3::Wallet::from_private_key(
            &"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
                .to_string(),
        )
        .unwrap_or_default();
    let contract: buff_web3::Contract = buff_web3::Contract::new(
            &"0x0123456789012345678901234567890123456789".to_string(),
            &"[]".to_string(),
            wallet,
        )
        .unwrap_or_default();
    let m = contract.method(&"balanceOf".to_string()).unwrap_or_default();
    m.arg("_owner".to_string(), "0x00".to_string());
    m.clone().call;
    m.clone().send;
    {
        if let Ok(__buff_contents) = std::fs::read_to_string(".env") {
            for __buff_line in __buff_contents.lines() {
                let __buff_line = __buff_line.trim();
                if __buff_line.is_empty() || __buff_line.starts_with('#') {
                    continue;
                }
                if let Some((__buff_key, __buff_val)) = __buff_line.split_once('=') {
                    let __buff_k = __buff_key.trim().to_string();
                    let __buff_v = __buff_val.trim().to_string();
                    if !__buff_k.is_empty() && std::env::var(&__buff_k).is_err() {
                        unsafe {
                            std::env::set_var(&__buff_k, &__buff_v);
                        }
                    }
                }
            }
        }
    }
}
