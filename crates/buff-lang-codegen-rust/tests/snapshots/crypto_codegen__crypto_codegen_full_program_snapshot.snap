fn main() {
    let sha256hex: String = {
        use sha2::Digest;
        hex::encode(sha2::Sha256::digest("hello".to_string().as_bytes()))
    };
    let sha512hex: String = {
        use sha2::Digest;
        hex::encode(sha2::Sha512::digest("hello".to_string().as_bytes()))
    };
    let md5hex: String = hex::encode(md5::compute("hello".to_string().as_bytes()).0);
    let hmachex: String = {
        use hmac::Mac;
        hmac::Hmac::<sha2::Sha256>::new_from_slice("secret".to_string().as_bytes())
            .map(|mut mac| {
                mac.update("message".to_string().as_bytes());
                hex::encode(mac.finalize().into_bytes())
            })
            .unwrap_or_default()
    };
    {
        if let Ok(__buff_contents) = std::fs::read_to_string(".env") {
            for __buff_line in __buff_contents.lines() {
                let __buff_line = __buff_line.trim();
                if __buff_line.is_empty() || __buff_line.starts_with('#') {
                    continue;
                }
                if let Some((__buff_key, __buff_val)) = __buff_line.split_once('=') {
                    let __buff_k = __buff_key.trim().to_string();
                    let __buff_v = __buff_val.trim().to_string();
                    if !__buff_k.is_empty() && std::env::var(&__buff_k).is_err() {
                        unsafe {
                            std::env::set_var(&__buff_k, &__buff_v);
                        }
                    }
                }
            }
        }
    }
}
