fn f() {
    {
        let mut __rdr = csv::ReaderBuilder::new()
            .has_headers(false)
            .from_reader("a,b\n1,2\n".as_bytes());
        __rdr
            .records()
            .filter_map(|r| r.ok())
            .map(|r| r.iter().map(|f| f.to_string()).collect::<Vec<String>>())
            .collect::<Vec<Vec<String>>>()
    };
}
