// buff-lang-ast/common — FULL port with String fields (string coercion fix applied)
// Mirrors crates/buff-lang-ast/src/common.rs Ident struct.

struct Ident {
    name: String,
    start: Int,
    end: Int,
    source_id: Int,
}

func ident_new(name: String, start: Int, end: Int, source_id: Int) -> Ident:
    return Ident { name: name, start: start, end: end, source_id: source_id }

func main():
    let id = ident_new(name: "my_function", start: 0, end: 11, source_id: 1)
    print(id.name)
    print(id.start)
    print(id.end)
    print(id.source_id)
