// buff-template — Buff self-host port of lib.rs + error.rs
//
// Mirrors crates/buff-template/src/lib.rs (143 LOC) + src/error.rs (19 LOC).
// Pure-Rust MVP wrapping the `handlebars` crate. Runtime-only (no compile-time
// macros). Per T19 spec: `Template.from_path(path)`, `Template.from_string(source)`,
// `template.render(context)` returns String.
//
// Mapping notes (Rust → Buff):
//   - `Template.inner: handlebars::Handlebars<'static>` is OPAQUE upstream
//     (private field wrapping a third-party type). Buff has no FFI opaque
//     type, so we model the compiled template with a `source: String` stand-in
//     holding the registered template text. This mirrors how ast_rsx.buff
//     uses a local Span stand-in for the re-exported buff_lang_error::Span.
//   - `&str` params → `String` (Buff owns at the boundary).
//   - `Result<T, TemplateError>` return types are kept as-is (Buff has
//     first-class Result<T, E> via Ok / Err).
//   - Constructors become free functions per Buff convention §7
//     (`Type.new()` / `Type.from()` for true constructors; helper builders
//     are free functions named after the type).
//   - `Template::default()` becomes `template_default()` (an empty template
//     that renders to empty string).
//   - NOTE: string interpolation `${var}` currently emits a literal leading
//     `$` (pre-existing codegen divergence). This port avoids interpolation
//     and `+` concatenation (`String + String` is not implemented in Rust).
//     Each piece is printed separately in main() to exercise the type
//     plumbing without triggering either codegen path.

// ---------------------------------------------------------------------------
// (1) TemplateError — the single error type returned by every fallible op.
//
// Rust original (src/error.rs):
//   #[derive(Debug, Error)]
//   pub enum TemplateError {
//       Parse(String),
//       Render(String),
//       Panic,
//   }
// ---------------------------------------------------------------------------

enum TemplateError {
    // The template source string could not be parsed by handlebars.
    Parse(String),
    // The template rendered but the context was missing a referenced variable.
    Render(String),
    // A wrapper-internal panic was caught by `catch_unwind` (FFI guide R6).
    Panic,
}

// Variant tag for a TemplateError (mirrors the `#[error("...")]` prefix label).
// Returns a short lowercase tag identifying the variant kind.
func template_error_tag(err: TemplateError) -> String:
    match err {
        Parse(_) => "parse",
        Render(_) => "render",
        Panic => "panic",
    }

// Extract the human-readable payload string from a TemplateError.
// For Parse/Render this is the wrapped detail; for Panic it is a fixed label.
// Mirrors the payload portion of the `#[error("...")]` Display impl.
func template_error_payload(err: TemplateError) -> String:
    match err {
        Parse(msg) => msg,
        Render(msg) => msg,
        Panic => "internal error: template operation panicked",
    }

// ---------------------------------------------------------------------------
// (2) Template — a compiled HTML template, ready to render with a context.
//
// Rust original (src/lib.rs):
//   #[derive(Debug, Clone)]
//   pub struct Template {
//       inner: handlebars::Handlebars<'static>,
//   }
//
// Buff port: `inner` is opaque upstream (private handlebars::Handlebars
// registry). We expose the registered source text as `source: String` so
// the self-host port can construct + inspect instances end-to-end. The
// public method surface (from_string / from_path / render / default) maps
// to free functions below.
// ---------------------------------------------------------------------------

struct Template {
    // The registered template source text. Stand-in for the private
    // `handlebars::Handlebars<'static>` registry. The template is registered
    // under the name "__buff_template_main" upstream.
    source: String,
}

// ---------------------------------------------------------------------------
// Constructors + instance methods (free functions per Buff convention §7).
// ---------------------------------------------------------------------------

// Compile a template from a source string.
// Mirrors `Template::from_string(source: &str) -> Result<Self, TemplateError>`.
// The body is wrapped in `catch_unwind` upstream (FFI guide R6) so a panic
// in the parser becomes a stable `Err(TemplateError::Panic)`.
func template_from_string(source: String) -> Result<Template, TemplateError>:
    return Ok(Template { source: source })

// Load a template from a file path.
// Mirrors `Template::from_path<P: AsRef<Path>>(path: P) -> Result<Self, TemplateError>`.
// Upstream reads the file as UTF-8 then delegates to `from_string`.
func template_from_path(path: String) -> Result<Template, TemplateError>:
    // Upstream: std::fs::read_to_string(&path) -> Template::from_string(&source).
    // Buff self-host port: we model the path as the source stand-in (the
    // actual file I/O is a codegen-lowered extern — not exercised here).
    return Ok(Template { source: path })

// Render the template with the given JSON context.
// Mirrors `Template::render(&self, context_json: &str) -> Result<String, TemplateError>`.
// Upstream parses the JSON context then calls `handlebars::Handlebars::render`.
// Self-host port returns the registered source (the real handlebars render
// is a codegen-lowered extern — not exercised here). The `context_json` arg
// mirrors the upstream signature; it is threaded into the Ok payload via a
// no-op read (referenced once to keep the param live without triggering the
// string-interp codegen path).
func template_render(template: Template, context_json: String) -> Result<String, TemplateError>:
    if context_json == "":
        return Ok(template.source)
    return Ok(template.source)

// An empty template that renders to empty string.
// Mirrors `Template::default()` — direct construction to avoid recursion.
func template_default() -> Template:
    return Template { source: "" }

// ---------------------------------------------------------------------------
// main — exercise every type + constructor, print field values.
// (Each piece printed separately to avoid string interpolation / concat.)
// ---------------------------------------------------------------------------

func main():
    // --- TemplateError.Parse variant ---
    // (Enums don't impl Copy, so we construct fresh instances per call to
    // avoid borrow-of-moved-value errors. Each helper takes ownership.)
    print(template_error_tag(err: Parse("unexpected endfor without matching open")))
    print(template_error_payload(err: Parse("unexpected endfor without matching open")))

    // --- TemplateError.Render variant ---
    print(template_error_tag(err: Render("missing variable user.name")))
    print(template_error_payload(err: Render("missing variable user.name")))

    // --- TemplateError.Panic variant (unit) ---
    print(template_error_tag(err: Panic))
    print(template_error_payload(err: Panic))

    // --- Template.from_string ---
    // NOTE: handlebars `{{name}}` syntax uses curly braces that would trip
    // Buff's brace-in-string lexer check, so the registered template source
    // uses a placeholder without curly braces. The type plumbing is fully
    // exercised.
    let t1 = match template_from_string(source: "Hello $name!") {
        Ok(t) => t,
        Err(_) => Template { source: "" },
    }
    print(t1.source)

    // --- Template.from_path ---
    let t2 = match template_from_path(path: "templates/greeting.html") {
        Ok(t) => t,
        Err(_) => Template { source: "" },
    }
    print(t2.source)

    // --- Template.default ---
    let t3 = template_default()
    print(t3.source)

    // --- Template.render (success path on t1) ---
    // context_json is accepted to exercise the full signature; stand-in output
    // is just the source. We print the context separately for visibility.
    print("--- render t1 ---")
    let rendered = match template_render(template: t1, context_json: "name=Buff") {
        Ok(s) => s,
        Err(_) => "<error>",
    }
    print(rendered)
    print("--- end render t1 ---")

    // --- Template.render on default (empty source) ---
    let rendered_empty = match template_render(template: t3, context_json: "empty") {
        Ok(s) => s,
        Err(_) => "<error>",
    }
    print(rendered_empty)

    // --- Result Err path (synthetic) ---
    print(template_error_tag(err: Parse("synthetic parse failure")))
    print(template_error_payload(err: Parse("synthetic parse failure")))
