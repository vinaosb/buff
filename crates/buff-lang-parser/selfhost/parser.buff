// buff-lang-parser self-host port — Edition + ParseError + key types
// Mirrors crates/buff-lang-parser/src/options.rs + lib.rs public types

// Edition — parser edition selection (T57)
enum Edition {
    Standard,
    Scientific,
}

// ParseError — wraps a Diagnostic with source info
struct ParseError {
    message: String,
    start: Int,
    end: Int,
}

// TokenStream cursor state (simplified from stream.rs)
struct TokenStreamState {
    pos: Int,
    source_id: Int,
    matrix_row_depth: Int,
}

// Attribute on a declaration
struct Attribute {
    name: String,
    value: String,
}

func edition_default() -> Edition:
    let e: Edition = Standard
    return e

func edition_is_standard(ed: Edition) -> Bool:
    match ed {
        Standard => return true,
        Scientific => return false,
    }

func edition_is_scientific(ed: Edition) -> Bool:
    match ed {
        Standard => return false,
        Scientific => return true,
    }

func parse_error_new(msg: String, s: Int, e: Int) -> ParseError:
    return ParseError { message: msg, start: s, end: e }

func token_stream_state_new(src_id: Int) -> TokenStreamState:
    return TokenStreamState { pos: 0, source_id: src_id, matrix_row_depth: 0 }

func attribute_new(n: String, v: String) -> Attribute:
    return Attribute { name: n, value: v }

func main():
    // Edition tests
    let ed = edition_default()
    let is_std = edition_is_standard(ed: ed)
    print(is_std)

    print(edition_is_scientific(ed: Scientific))
    print(edition_is_standard(ed: Scientific))

    // ParseError test
    let pe = parse_error_new(msg: "unexpected token", s: 10, e: 15)
    print(pe.message)
    print(pe.start)
    print(pe.end)

    // TokenStreamState test
    let ts = token_stream_state_new(src_id: 1)
    print(ts.pos)
    print(ts.source_id)
    print(ts.matrix_row_depth)

    // Attribute test
    let attr = attribute_new(n: "deprecated", v: "use new_func instead")
    print(attr.name)
    print(attr.value)
