#!/bin/sh
# Pre-commit gate (ITER-16).
#
# 1. AGENTS.md metadata auto-refresh — preserved verbatim from the original
#    hook (cf22eab). The extension-cap block that guarded the debt-zero
#    waves was dead code (its counter file no longer exists) and was dropped.
# 2. Fast fmt check on staged crates via scripts/local-ci.ps1 (seconds).
#    Bypass with --no-verify (automation does); the pre-push gate and branch
#    protection on main still enforce everything downstream.

# --- AGENTS.md metadata refresh (kept from the old hook) ---
if git diff --cached --name-only | grep -q "^AGENTS.md$"; then
    :
else
    COMMIT_HASH=$(git rev-parse --short HEAD)
    BRANCH_NAME=$(git branch --show-current)
    if [ -f "AGENTS.md" ]; then
        sed -i "s/\*\*Commit:\*\* [a-f0-9]*/**Commit:** $COMMIT_HASH/" AGENTS.md
        # Pipe delimiter: branch names contain "/" (which trips MSYS sed
        # arg-munging on Windows) but can never contain "|".
        sed -i 's|\*\*Branch:\*\* `[^`]*`|**Branch:** `'"$BRANCH_NAME"'`|' AGENTS.md
        git add AGENTS.md
    fi
fi

# --- fast local gate: fmt on staged crates ---
powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-ci.ps1 -Scope Commit
exit $?
