// Buff self-host port of `crates/buff-lang-lexer/src/indent.rs` (T15).
//
// Indentation tracking for the offside rule. `IndentationTracker` maintains a
// stack of indentation levels and emits synthetic Indent / Dedent tokens when
// the indentation changes between lines.
//
// Conventions:
//   * Each tab counts as 4 columns (TAB_WIDTH).
//   * Mixing tabs and spaces in the same leading-whitespace run is an error.
//   * Blank lines and comment-only lines never trigger indent checks.
//
// FAITHFULNESS NOTES
//   * Rust's `Vec<usize>` stack becomes `Vector<Int>`.
//   * `usize` arithmetic maps to `Int`.
//   * `stack.last().copied().unwrap_or(0)` maps to a `peek()` helper returning
//     `Int` (Buff has no `copied`/`unwrap_or` chaining on `Option<Int>` in the
//     scanner hot loop; a tiny helper reads clearer).

// The number of columns represented by a single tab character.
// (Defined as the local `tab_width` inside `compute_level` — Buff has no
// module-level `let`; only func/enum/struct/import/export/extern/extend/trait
// are valid top-level declarations.)

// Tracks indentation levels and emits synthetic Indent/Dedent tokens.
struct IndentationTracker:
    // Stack of indent levels (in column units). Always starts with [0].
    stack: Vector<Int>

// Create a new tracker. The base indentation level is 0.
func indentation_tracker_new() -> IndentationTracker:
    let init = Vector.new()
    init.push(0)
    return IndentationTracker.new(stack: init)

// Top of the indent stack, or 0 if empty (defensive — the stack never empties
// in practice because the base 0 is never popped).
func tracker_peek(tracker: IndentationTracker) -> Int:
    if tracker.stack.len() == 0:
        return 0
    return tracker.stack[tracker.stack.len() - 1]

// Inspect the leading whitespace of a new line and return any synthetic tokens
// to emit.
//
//   * Returns [Indent] if the line is more indented than the previous one.
//   * Returns one or more [Dedent] tokens if the line is less indented.
//   * Returns [] if the level is unchanged.
//   * Returns mixed_tabs_spaces error if the leading whitespace mixes tabs/spaces.
//   * Returns a generic LexerError if the new level does not match any previous
//     level on the stack (inconsistent dedent).
func check_line(
        tracker: IndentationTracker,
        indent: String,
        source_id: SourceId,
        span_start: Int,
    ) -> Result<Vector<TokenKind>, LexerError>:
    let level = compute_level(indent, source_id, span_start)?
    return adjust_to_level(tracker, level, source_id, span_start, indent.len())

// Emit a Dedent token for every level remaining on the stack (except the base
// 0). Called once at end-of-input.
func finalize(tracker: IndentationTracker) -> Vector<TokenKind>:
    let tokens = Vector.new()
    for tracker.stack.len() > 1:
        tracker.stack.pop()
        tokens.push(TokenKind.Dedent)
    return tokens

func adjust_to_level(
        tracker: IndentationTracker,
        level: Int,
        source_id: SourceId,
        span_start: Int,
        indent_len: Int,
    ) -> Result<Vector<TokenKind>, LexerError>:
    let top = tracker_peek(tracker)
    let tokens = Vector.new()

    if level > top:
        tracker.stack.push(level)
        tokens.push(TokenKind.Indent)

    if level < top:
        for tracker_peek(tracker) > level:
            tracker.stack.pop()
            tokens.push(TokenKind.Dedent)
        if tracker_peek(tracker) != level:
            return Result.Err(lexer_error_new(
                "inconsistent indentation level",
                span_new(span_start, span_start + indent_len, source_id),
            ))
    return Result.Ok(tokens)

// Compute the column count for an indentation run.
//
// Tabs count as TAB_WIDTH columns each. Mixing tabs and spaces is rejected.
func compute_level(indent: String, source_id: SourceId, span_start: Int) -> Result<Int, LexerError>:
    let tab_width = 4
    if indent.len() == 0:
        return Result.Ok(0)
    let mut has_tab = false
    let mut has_space = false
    let mut idx = 0
    for idx < indent.len():
        let c = indent[idx]
        if c == '\t':
            has_tab = true
        else if c == ' ':
            has_space = true
        idx = idx + 1
    if has_tab && has_space:
        return Result.Err(lexer_error_mixed_tabs_spaces(span_new(span_start, span_start + indent.len(), source_id)))
    if has_tab:
        return Result.Ok(indent.len() * tab_width)
    return Result.Ok(indent.len())
