func stream_new(tokens: Vector<Token>, source_id: SourceId) -> TokenStream:
    return stream_with_edition(tokens, source_id, edition_default())

func stream_with_edition(tokens: Vector<Token>, source_id: SourceId, edition: Edition) -> TokenStream:
    return TokenStream.new(
        tokens: tokens,
        pos: 0,
        source_id: source_id,
        edition: edition,
        matrix_row_depth: 0,
    )

