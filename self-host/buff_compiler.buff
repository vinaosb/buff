// =============================================================================
// SECTION 10: Front-end entry points
// =============================================================================

// Compile the Buff front-end: lex source -> parse tokens -> emit AST as JSON.
//
// Returns a JSON-string representation of the parsed AST. In this P4.10
// proof-of-concept the lexer and parser are stubs, so the function returns
// a structural skeleton identifying the pipeline stages.
func compile_frontend(source: String) -> String:
    let sid = source_id_new(0)
    let lex_result = tokenize(source, sid)
    let tokens = match lex_result {
        Result.Ok(ts) => ts,
        Result.Err(le) => Vector.new(),
    }
    let parse_result = parse(tokens, sid)
    let ast_json = match parse_result {
        Result.Ok(decls) => frontend_render_decls(decls),
        Result.Err(pe) => frontend_render_error(pe),
    }
    return ast_json

// Render a vector of Decls as a JSON-like string.
func frontend_render_decls(decls: Vector<Decl>) -> String:
    let n = decls.len()
    return "\{\"kind\":\"Program\",\"decl_count\":" + n.to_string() + "\}"

// Render a ParseError as a JSON-like error string.
func frontend_render_error(pe: ParseError) -> String:
    return "\{\"kind\":\"Error\",\"message\":\"parse failed\"\}"

// =============================================================================
// SECTION 11: Main entry point
// =============================================================================

func main():
    let source = "func hello(): print(\"hello\")"
    let result = compile_frontend(source)
    print(result)
