// Buff self-host port of `crates/buff-lang-ast/src/expr.rs` (P4.4).
//
// Expression nodes for the Buff AST: [`Literal`], [`InterpPart`], [`Expr`],
// [`MatchArm`], and [`Pattern`]. Every variant of `Expr` carries a [`Span`]
// so diagnostics can point at the exact source range. Expressions own all
// their data (Buff has no lifetimes).
//
// Faithful 1:1 translation of the Rust reference. Translation decisions
// (deviations from Rust grammar, per porting-conventions §1):
//   * `#[derive(Debug, Clone, PartialEq)]` dropped — Buff auto-derives these
//     on every struct/enum (porting-conventions §8b).
//   * Rust struct-variant enum payloads (e.g. `Expr::BinaryOp { op, lhs, rhs,
//     span }`) → tuple variants (`BinaryOp(BinaryOp, Expr, Expr, Span)`) —
//     Buff enums lack struct variants. Field order is preserved; field names
//     are documented inline at each variant. Same decision as the ast-rsx
//     port (`self-host/ast-rsx/lib.buff`).
//   * `Box<Expr>` (recursive boxing) → `Expr` directly. Buff has no `Box`;
//     the runtime handles recursive owned data via Arc/COW at codegen time
//     (porting-conventions §7d). All `Box<Expr>` / `Box<TypeRef>` sites
//     translate to bare `Expr` / `TypeRef`.
//   * `impl fmt::Display for X` → free function `x_to_string(x: X) -> String`
//     (porting-conventions §8g — impl blocks become type-prefixed free
//     functions; Buff has no `fmt::Display` trait, so the closest idiom is a
//     free function returning `String`).
//   * `fmt::Formatter` / `write!` / `f.write_str(...)` → string concatenation
//     with `+`. Buff string building uses `let mut s = ""; s = s + "..."`.
//   * `for (i, x) in xs.iter().enumerate() { if i > 0 { sep } write!(x) }` →
//     manual indexed loop `for i < xs.len(): if i > 0: s = s + sep; s = s +
//     x_to_string(xs[i]); i = i + 1` (Buff has no `.iter().enumerate()` on
//     `Vector` in the prelude).
//   * `impl X { pub fn span(&self) -> Span }` → free function `x_span(x: X)
//     -> Span` (porting-conventions §8g).
//   * `&str` → `String` (owned). `usize`/`u64`/`i64`/`isize` → `Int`.
//     `f32` → `Float`. `f64` → `Double`. `u8` → `Byte`. `char` → `Char`.
//     `bool` → `Bool`. `Vec<T>` → `Vector<T>` (porting-conventions §7a, §7c).
//   * `Option<&str>` (borrowed return) → `Option<String>` (owned return) —
//     `Pattern::variant_name_key` clones the name into an owned `String`.
//   * Cross-file dependencies (`Span`, `Ident`, `Block`, `Param`, `TypeRef`,
//     `BinaryOp`, `UnaryOp`) declared as local stubs matching the shape the
//     Rust reference uses — they will be replaced by `import { ... } from
//     "..."` once the M7 monolith loader activates (porting-conventions §6d).
//     Each stub carries a comment naming its origin file. `BinaryOp` /
//     `UnaryOp` are ported in full here (simple unit enums) — their canonical
//     home is `self-host/ast/op.buff`; the duplication is removed when the
//     monolith lands.
//   * JSON serialization (`pub fn to_json(...) -> serde_json::Value`) is NOT
//     ported — Buff has no `serde_json::Value` equivalent in the prelude, and
//     the JSON dump path is a Rust-host concern (DR-014 §🟥 codegen-rust
//     wall). Documented inline at each skipped impl block.
//   * `#[cfg(test)] mod tests` omitted — test code, not pub API (porting-
//     conventions §5a — equivalence tests live in separate files).
//
// Numeric widths map to the natural Buff primitives:
//   i64          -> Int      (Literal::Int, Span byte offsets)
//   f32          -> Float    (Literal::Float)
//   f64          -> Double   (Literal::Double)
//   u8           -> Byte     (Literal::Byte)
//   char         -> Char     (Literal::Char)
//   bool         -> Bool     (Literal::Bool, Range::inclusive)
//   usize        -> Int      (Span byte offsets)

// ---------------------------------------------------------------------------
// Forward-declared cross-file stubs (replaced by `import` once M7 lands).
// ---------------------------------------------------------------------------

// Stub for `buff_lang_error::Span` — see `self-host/error/span.buff` (P3.3).
struct SourceId:
    value: Int

struct Span:
    start: Int
    end: Int
    source_id: SourceId

// Stub for `crates/buff-lang-ast/src/common.rs::Ident`.
//
// An identifier — a name plus its source location.
struct Ident:
    name: String
    span: Span

func ident_new(name: String, span: Span) -> Ident:
    return Ident.new(name: name, span: span)

func ident_to_string(i: Ident) -> String:
    return i.name

// Stub for `crates/buff-lang-ast/src/stmt.rs::Stmt`.
//
// Statement node — opaque here; the full definition lives in the (future)
// `self-host/ast/stmt.buff` port. The expression Display impls treat a
// `Stmt` as a black box and never inspect its fields, so an opaque
// placeholder satisfies the type-checker.
struct Stmt:
    _stub: Int

// Stub for `crates/buff-lang-ast/src/common.rs::Block`.
//
// A brace-delimited block of statements.
struct Block:
    stmts: Vector<Stmt>
    span: Span

// Stub Display for `Block` — placeholder until `common.buff` lands.
// Mirrors the Rust reference's `Block::fmt` shape (`{ stmt; stmt; ... }`).
// Note: the literal `{` and `}` are built via Char.to_string because Buff
// treats `{` inside a string literal as the start of an interpolation
// (`"...{expr}..."`); there is no `\{` escape, so the brace is built
// outside the string literal.
func block_to_string(b: Block) -> String:
    let open = Char.to_string('{')
    let close = Char.to_string('}')
    let mut s = open + " "
    let mut i = 0
    for i < b.stmts.len():
        if i > 0:
            s = s + "; "
        s = s + "<stmt>"
        i = i + 1
    if b.stmts.len() > 0:
        s = s + " "
    s = s + close
    return s

// Stub for `crates/buff-lang-ast/src/ty.rs::TypeRef`.
//
// A reference to a type — opaque here; the full enum lives in the (future)
// `self-host/ast/ty.buff` port. The expression Display impls treat a
// `TypeRef` as a black box, so an opaque placeholder satisfies the
// type-checker.
struct TypeRef:
    _stub: Int

// Stub Display for `TypeRef` — placeholder until `ty.buff` lands.
func typeref_to_string(t: TypeRef) -> String:
    return "<typeref>"

// Stub for `crates/buff-lang-ast/src/common.rs::Param`.
//
// A function parameter: `name: Type`, optionally with a default value
// `name: Type = expr` (T106).
//
// The `default_value` field carries the parsed default expression when the
// parameter was declared with `= expr`. Rust has NO native default-param
// support, so the codegen fills omitted trailing args at the CALL SITE
// (`fetch("x")` → `fetch("x", 30)` when `timeout` defaults to `30`) — it
// does NOT rely on Rust defaults. `Option.None` means the parameter is
// required (no default).
//
// This field is **additive** (T106): existing params without a default
// carry `Option.None`, so all prior `Param { ... }` construction sites
// just need `default_value: None` appended.
struct Param:
    name: Ident
    ty: TypeRef
    default_value: Option<Expr>
    is_comptime: Bool
    span: Span

// Stub Display for `Param` — placeholder until `common.buff` lands.
// Mirrors the Rust reference's `Param::fmt` (`[comptime ]name: ty[ = dv]`).
//
// NOTE: `is_comptime` is checked via a match (not `if p.is_comptime:`)
// because the Buff type-checker has a known gap where field access used
// directly as an `if` condition loses type information (returns Unknown).
// The `match b { true => ..., false => ... }` form is the workaround;
// field access bound through a `let` then matched works correctly.
func param_to_string(p: Param) -> String:
    let prefix = comptime_prefix(p.is_comptime)
    return prefix + ident_to_string(p.name) + ": " + typeref_to_string(p.ty) + param_default_suffix(p.default_value)

// Helper: render the optional `comptime ` prefix of a `Param`. Mirrors the
// Rust reference's `if self.is_comptime { f.write_str("comptime ")?; }`.
// Factored as a separate function so the caller avoids the
// `if <field access>:` type-inference gap (see note on `param_to_string`).
func comptime_prefix(b: Bool) -> String:
    return match b {
        true => "comptime ",
        false => "",
    }

// Helper: render the `= default_value` suffix of a `Param` (T106), or the
// empty string when no default is present. Mirrors the Rust reference's
// `if let Some(dv) = &self.default_value { write!(f, " = {dv}")?; }`.
func param_default_suffix(dv: Option<Expr>) -> String:
    return match dv {
        Some(e) => " = " + expr_to_string(e),
        None => "",
    }

// ---------------------------------------------------------------------------
// BinaryOp / UnaryOp (stub of `crates/buff-lang-ast/src/op.rs`).
//
// Pure data: binary and unary operator tags. No parsing, no precedence.
// Ported in full here because they are simple unit enums; the canonical
// home is `self-host/ast/op.buff`, which removes the duplication when the
// monolith loader lands.
// ---------------------------------------------------------------------------

// A binary operator (e.g. `+`, `==`, `+=`).
enum BinaryOp {
    // Arithetic
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    // Comparison
    Eq,
    Neq,
    Lt,
    Gt,
    Lte,
    Gte,
    // Logical
    And,
    Or,
    // Bitwise
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    // Assignment (compound included)
    Assign,
    AddAssign,
    SubAssign,
    MulAssign,
    DivAssign,
    ModAssign,
    // T101: Null coalescing `??` — lowers to `.unwrap_or()`.
    NullCoalesce,
}

// A unary operator (e.g. `-x`, `!x`, `~x`).
enum UnaryOp {
    // `-x` — numeric negation.
    Neg,
    // `!x` — logical NOT.
    Not,
    // `~x` — bitwise NOT.
    BitNot,
}

func binary_op_to_string(op: BinaryOp) -> String:
    return match op {
        // Arithmetic
        Add => "+",
        Sub => "-",
        Mul => "*",
        Div => "/",
        Mod => "%",
        // Comparison
        Eq => "==",
        Neq => "!=",
        Lt => "<",
        Gt => ">",
        Lte => "<=",
        Gte => ">=",
        // Logical
        And => "&&",
        Or => "||",
        // Bitwise
        BitAnd => "&",
        BitOr => "|",
        BitXor => "^",
        Shl => "<<",
        Shr => ">>",
        // Assignment
        Assign => "=",
        AddAssign => "+=",
        SubAssign => "-=",
        MulAssign => "*=",
        DivAssign => "/=",
        ModAssign => "%=",
        // T101
        NullCoalesce => "??",
    }

func unary_op_to_string(op: UnaryOp) -> String:
    return match op {
        Neg => "-",
        Not => "!",
        BitNot => "~",
    }

// ---------------------------------------------------------------------------
// Literal — a literal value embedded directly in the source.
// ---------------------------------------------------------------------------

// A literal value embedded directly in the source.
//
// NOTE: derives `PartialEq` but **not** `Eq` because `f32`/`f64` don't
// implement `Eq`. Same applies to any type that contains a `Literal`.
//
// # Migration notes (additive AST changes)
//
// ## T20 — `Literal::Decimal`
//
// `Literal::Decimal` was **added** in T20 (v0.5) to carry the raw text of a
// 128-bit fixed-point decimal literal (e.g. `99.90m`). It stores the source
// text verbatim as a `String` so the value never rounds through `f32`/`f64`
// — exactness is preserved all the way to the `rust_decimal_macros::dec!()`
// codegen call. `Type::Decimal` already existed in `buff-lang-types`; the
// literal variant closed the gap.
//
// ## T21 — `Literal::Char`
//
// `Literal::Char` was **added** in T21 (v0.5) to represent a single Unicode
// scalar value literal written with single quotes: `'A'`, `'é'`, `'🚀'`. It
// stores a Rust `char` (which is always exactly one scalar value, never a
// grapheme cluster). This is **additive**: no existing variant was renamed,
// reordered, or had its payload altered, so all prior `match` arms remain
// exhaustive. `Type::Char` was added in lockstep. `char` is `Copy + Eq`, so
// the `PartialEq`-but-not-`Eq` derivation rule is unaffected.
//
// ## T79 — `Literal::Regex`
//
// `Literal::Regex` was **added** in T79 (v0.5) to carry the raw pattern
// text of a regex literal written with slashes: `/\d+/`, `/\d{3}-\d{4}/`.
// It stores the source text BETWEEN the slashes (excluding both
// delimiters) so backslash classes survive verbatim (`/\d+/` →
// `Regex("\\d+")`). This is **additive**: no existing variant was renamed,
// reordered, or had its payload altered, so all prior `match` arms remain
// exhaustive.
//
// **Codegen is deferred in v0.5.** The generated Cargo project has no
// `regex` crate dependency (T32-style dep wiring is a separate v1.0 task),
// so emitting `Regex::new(...)` would fail to compile. As a documented
// stub, codegen lowers `Literal::Regex(p)` to the pattern string `"<p>"`
// (valid standalone Rust) so the pipeline stays green. Real
// `regex::Regex::new` lowering + Cargo-project dep injection arrives in v1.0.
// Inference treats the value as `Type::String` to match the stub.
enum Literal {
    // An integer literal, e.g. `42`. Stored as Int (Rust i64).
    Int(Int),
    // A 32-bit float literal, e.g. `3.14f`.
    Float(Float),
    // A 64-bit float literal, e.g. `99.9d`.
    Double(Double),
    // A boolean literal: `true` / `false`.
    Bool(Bool),
    // A string literal, e.g. `"hello"`.
    String(String),
    // A single byte literal, e.g. `0xFF`.
    Byte(Byte),
    // A single Unicode scalar value literal, e.g. 'A', 'é', '🚀' (T21).
    //
    // Always exactly one Char; never a grapheme cluster. The lexer rejects
    // '' (empty) and 'ab' (two scalar values).
    Char(Char),
    // A 128-bit fixed-point decimal literal, e.g. `99.90m` (T20).
    //
    // Stores the **raw source text** (without the trailing `m`/`M` suffix)
    // so the value is never rounded through f32/f64. Codegen emits this
    // verbatim as `rust_decimal_macros::dec!(<text>)`, preserving exactness.
    Decimal(String),
    // A regex literal, e.g. `/\d+/`, `/\d{3}-\d{4}/` (T79).
    //
    // Stores the raw source text BETWEEN the slashes (excluding both
    // delimiters). Backslash classes survive verbatim (`/\d+/` →
    // `Regex("\\d+")`); an escaped `\/` inside the pattern keeps its
    // backslash in the stored text.
    //
    // **Codegen is deferred in v0.5** — the generated Cargo project has no
    // `regex` crate dep, so codegen stubs this as a plain `String` literal
    // (valid standalone Rust). Real `regex::Regex::new(...)` lowering +
    // Cargo-project dep injection arrives in v1.0. Inference treats the
    // value as `Type::String` to match the stub.
    Regex(String),
}

// Render a `Literal` as its diagnostic string. Mirrors the Rust reference's
// `impl fmt::Display for Literal`.
func literal_to_string(l: Literal) -> String:
    return match l {
        Int(v) => "Int(" + int_to_string(v) + ")",
        Float(v) => "Float(" + float_to_string(v) + ")",
        Double(v) => "Double(" + double_to_string(v) + ")",
        Bool(v) => "Bool(" + bool_to_string(v) + ")",
        String(v) => "String(" + debug_quote(v) + ")",
        Byte(v) => "Byte(0x" + byte_hex(v) + ")",
        // T21: render the char in single quotes for visual distinction
        // from String (which uses double quotes) and Byte (0x..).
        Char(c) => "Char(" + char_debug(c) + ")",
        // Show the decimal text double-quoted (consistent with String)
        // so it's visually distinct from a bare number.
        Decimal(v) => "Decimal(" + debug_quote(v) + ")",
        // T79: show the regex pattern double-quoted with the `Regex`
        // prefix so it's visually distinct from a plain String.
        Regex(v) => "Regex(" + debug_quote(v) + ")",
    }

// ---------------------------------------------------------------------------
// InterpPart — one piece of a string-interpolation expression (T21).
// ---------------------------------------------------------------------------

// One piece of a string-interpolation expression (T21).
//
// An interpolation like `"Hello {name}, you are {age}!"` parses to:
//
// ```text
// StringInterp {
//     parts: vec![
//         InterpPart::Literal("Hello ".to_string()),
//         InterpPart::Expr(Box::new(Expr::Ident("name")), None),
//         InterpPart::Literal(", you are ".to_string()),
//         InterpPart::Expr(Box::new(Expr::Ident("age")), None),
//         InterpPart::Literal("!".to_string()),
//     ],
//     span: ...,
// }
// ```
//
// With format specifiers (T81), `${x:.2}` produces:
//
// ```text
// InterpPart::Expr(Box::new(Expr::Ident("x")), Some(".2".to_string()))
// ```
//
// Literal runs of zero or more `StringPart` tokens are collapsed into one
// `InterpPart::Literal` so adjacent strings stay readable. Adjacent
// expressions are kept separate (one `InterpPart::Expr` each).
//
// Tuple variant fields (Buff enums lack struct variants):
//   * `Literal(String text)`           — literal text run.
//   * `Expr(Expr e, Option<String> spec)` — embedded expression + optional
//     format specifier (T81). `spec` is the raw spec text after `:`
//     (e.g. `.2`, `?`, `>10`, `x`), passed through to Rust's
//     `format!("{spec}", ...)` unchanged — Buff does NOT interpret format
//     specifiers.
enum InterpPart {
    // A literal text run from the source string (no escapes processed yet).
    Literal(String),
    // An embedded expression `{expr}` or `{expr:spec}` (T81). Tuple fields:
    //   (Expr expr, Option<String> format_spec)
    // `format_spec` is the raw spec text after `:` (e.g. `.2`, `?`, `>10`,
    // `x`). It is passed through to Rust's `format!("{spec}", ...)`
    // unchanged — Buff does NOT interpret format specifiers.
    Expr(Expr, Option<String>),
}

// Render an `InterpPart` as its diagnostic string. Mirrors the Rust
// reference's `impl fmt::Display for InterpPart`.
func interp_part_to_string(p: InterpPart) -> String:
    return match p {
        Literal(s) => "Lit(" + debug_quote(s) + ")",
        Expr(e, spec) => interp_expr_to_string(e, spec),
    }

// Helper: InterpPart::Expr Display body, factored out so the `match` arm
// in `interp_part_to_string` stays a single expression (per the Buff rule
// that match arms must be expressions — a `match` inside an arm body would
// nest statement-shaped code).
func interp_expr_to_string(e: Expr, spec: Option<String>) -> String:
    let base = "Expr(" + expr_to_string(e)
    match spec {
        Some(s) => return base + ":" + s + ")",
        None => return base + ")",
    }

// ---------------------------------------------------------------------------
// Expr — a top-level expression. Every variant is annotated with its Span.
// ---------------------------------------------------------------------------

// A top-level expression. Every variant is annotated with its source `Span`.
//
// # Migration notes (additive AST changes)
//
// ## T23 — `Expr::ArrayLit` and `Expr::Index`
//
// Two variants were **added** in T23 (v0.5) to bring collection support online:
//
// - `Expr::ArrayLit` — a collection literal `[e1, e2, e3]` (or empty `[]`).
//   Lowers to Rust's `vec![...]` macro and infers type `Vector<T>` where `T`
//   is the element type (integer literals get auto-width via T22 range
//   analysis, so `[1, 2, 3]` -> `Vector<Int<8>>`). This is **additive**: no
//   existing variant was renamed, reordered, or had its payload altered.
//
//     - `Expr::Index` — an indexing expression `base[index]`. Lowers to Rust
//       `base[index as usize]` (the index is coerced to `usize`). String-literal
//       receivers are still rejected at parse time with the helpful T21 message
//       ("for strings use .chars() or .first()"); all other receivers produce an
//       `Expr::Index` node. This unblocks T99's deferred `args()[0]` and T21's
//       typed string-index rejection.
//
// Both variants derive the standard `Debug, Clone, PartialEq` (no `Eq` because
// the containing `Expr` already isn't `Eq` due to floats). All internal
// `match`es on `Expr` were extended with arms for the new variants: `span()`,
// `Display`, parser, type inference, and Rust codegen.
//
// ## T24 — `Expr::Index` generalized to multi-index
//
// The `Expr::Index` variant was **generalized** in T24 (v0.5) to carry a
// `Vec<Expr>` of indices instead of a single index, enabling 2-D matrix
// indexing `m[row, col]`. The shape changed from `{ base, index, span }` to
// `{ base, indices: Vec<Expr>, span }`. This is a **migration** (not purely
// additive — the field was renamed/retyped), so every `match`/construction
// site was updated: `span()`, `Display`, parser, type inference, Rust codegen,
// IR `collect_uses`, and the T23 `vector_codegen` test helper. Single-index
// `base[i]` still works (a one-element `indices` vec); it lowers identically
// to the pre-T24 form (`base[i as usize]`). Two-index `m[r, c]` lowers to the
// flat-storage Matrix access `m.data[(r * m.cols + c) as usize]`.
//
// This generalization is forward-compatible with N-dimensional indexing
// (tensors, v1.0+) — additional indices simply lengthen the vec.
//
// ## T25 — `Expr::MapLit`
//
// A new variant was **added** in T25 (v0.5) to carry a map/dictionary literal
// `{"k": v, ...}` (note: braces + colon-separated entries). The `entries` are
// a `Vec<(Expr, Expr)>` of `(key, value)` pairs (so each pair preserves the
// span-bearing Expr nodes). This is **additive**: no existing variant was
// renamed, reordered, or had its payload altered, so all prior `match` arms
// remain exhaustive. The variant carries a `span: Span` for diagnostics.
//
// Brace disambiguation (parser-side, see `parse_brace_primary`): a `{` at
// primary position can be a closure `{ params => expr }` (T23) or a map
// literal `{ key: value, ... }`. The parser uses speculative save/restore
// on the `TokenStream` position: it tries the closure shape first, and on
// failure rolls back and tries the map shape. Empty `{:}` is an empty map;
// bare `{}` is rejected (ambiguous with code blocks per layout).
//
// ## T30 — `Expr::Try` (the `?` postfix operator)
//
// A new variant was **added** in T30 (v0.5) to carry the error-propagation
// postfix operator `expr?`. The operand is boxed. This is **additive**: no
// existing variant was renamed, reordered, or had its payload altered, so
// all prior `match` arms remain exhaustive. The variant carries a
// `span: Span` for diagnostics.
//
// The parser fills this node from the `?` postfix position in `parse_postfix`
// (the lexer already produced a `TokenKind::Question` token — `?` was never
// a reserved keyword, so no lexer change was needed). Codegen lowers it to
// Rust's **native `?` operator** (`<expr>?`) — the cleanest mapping because
// the enclosing Buff function already lowers to a Rust function returning
// `Result<T, E>`, which is exactly what Rust's `?` requires. The explicit
// `match expr { Ok(v) => v, Err(e) => return Err(e) }` desugaring (the task's
// option (b)) is NOT used; native `?` is simpler and equally correct.
//
// ## T31 — `Expr::Spawn` (the `spawn <task>` async-spawn form)
//
// A new variant was **added** in T31 (v0.5) to carry Buff's async-spawn
// prefix operator: `spawn <expr>`. The lexer tokenises `spawn` as a
// reserved keyword (`TokenKind::KwSpawn`); it can never be an ordinary
// identifier, so the parser MUST treat it specially — it builds an
// `Expr::Spawn` node in `parse_primary`. The operand (the task to spawn)
// is boxed.
//
// This is **additive**: no existing variant was renamed, reordered, or had
// its payload altered, so all prior `match` arms remain exhaustive. The
// variant carries a `span: Span` for diagnostics.
//
// Codegen lowers `spawn expr` to Rust's `tokio::spawn(async move { expr })`,
// yielding a `tokio::task::JoinHandle<T>`. Buff's `Task<T>` is a thin alias
// for `JoinHandle<T>`; the auto-inserted `.await` (the only `.await` ever
// emitted) lands when the user calls `t.result()` (see T31 codegen rules).
// The `spawn` keyword does NOT propagate async-ness up the call graph on
// its own — but every well-formed Buff program that uses `spawn` does so
// inside an already-async function (the codegen warning for `block()`
// inside async is the only direct effect of mis-use).
enum Expr {
    // A literal: `42`, `"hi"`, `true`, …
    // Tuple fields: (Literal value, Span span).
    Literal(Literal, Span),
    // A bare identifier reference: `x`, `foo_bar`.
    // Tuple fields: (Ident ident, Span span).
    Ident(Ident, Span),
    // A binary operator application: `lhs op rhs`.
    // Tuple fields: (BinaryOp op, Expr lhs, Expr rhs, Span span).
    BinaryOp(BinaryOp, Expr, Expr, Span),
    // A unary operator application: `op operand`.
    // Tuple fields: (UnaryOp op, Expr operand, Span span).
    UnaryOp(UnaryOp, Expr, Span),
    // An `if` expression: `if cond { then } else { else }`.
    // Tuple fields: (Expr cond, Block then_block, Option<Block> else_block,
    // Span span).
    IfExpr(Expr, Block, Option<Block>, Span),
    // A free function call: `callee(args...)`.
    // Tuple fields: (Expr callee, Vector<Expr> args, Span span).
    FuncCall(Expr, Vector<Expr>, Span),
    // A method call: `receiver.method(args...)`.
    // Tuple fields: (Expr receiver, Ident method, Vector<Expr> args,
    // Span span).
    MethodCall(Expr, Ident, Vector<Expr>, Span),
    // A lambda / anonymous function.
    // Tuple fields: (Vector<Param> params, Block body,
    // Option<TypeRef> return_type, Span span).
    Lambda(Vector<Param>, Block, Option<TypeRef>, Span),
    // A struct literal: `TypeName { field: value, ... }`.
    // Tuple fields: (Ident type_name, Vector<(Ident, Expr)> fields,
    // Span span).
    StructInit(Ident, Vector<(Ident, Expr)>, Span),
    // A `match` expression: ` scrutinee match { arms... } `.
    // Tuple fields: (Expr scrutinee, Vector<MatchArm> arms, Span span).
    MatchExpr(Expr, Vector<MatchArm>, Span),
    // A suspension point in an async context (placeholder for future async work).
    // Tuple fields: (Expr inner, Span span).
    SuspendExpr(Expr, Span),
    // A collection literal: `[e1, e2, e3]` or `[]` (T23).
    //
    // Comma-separated elements; trailing comma allowed; empty literal allowed.
    // Lowers to Rust's `vec![...]` macro. The element type is inferred from
    // the elements — integer literals get auto-width via T22 range analysis
    // (`[1, 2, 3]` -> `Vector<Int<8>>`), so a `let v = [1, 2, 3]` binding
    // picks up a `Vec<i8>` Rust annotation automatically.
    //
    // This is **additive**: no existing variant was renamed or reordered.
    //
    // Tuple fields: (Vector<Expr> elements, Span span).
    ArrayLit(Vector<Expr>, Span),
    // An indexing expression: `base[index]` or `base[row, col]` (T23, T24).
    //
    // Carries **one or more** indices in a Vector so the same node shape serves
    // 1-D Vector indexing (`v[i]`) and 2-D Matrix indexing (`m[row, col]`).
    // The parser fills `indices` from the comma-separated list inside `[...]`.
    //
    // Codegen dispatches on the arity:
    // - 1 index → Rust `base[index as usize]` (Vector path, T23).
    // - 2 indices → Rust `base.data[(row * base.cols + col) as usize]`
    //   (flat-storage Matrix path, T24). The `data`/`cols` fields come from
    //   the builtin `Matrix<T>` struct the codegen emits when a program uses
    //   `Matrix.new(...)`.
    //
    // String-literal receivers are rejected at parse time (the T21 helpful
    // error); all other receivers build this node.
    //
    // **T24 migration note**: this variant previously held a single
    // `index: Expr` (T23). It was generalized to `indices: Vec<Expr>` so
    // the same node can carry a comma-separated index list. Every match site
    // was updated; single-index call sites now pass a one-element vec. This
    // change is forward-compatible with N-D indexing (tensors, v1.0+).
    //
    // Tuple fields: (Expr base, Vector<Expr> indices, Span span).
    Index(Expr, Vector<Expr>, Span),
    // A string interpolation: `"text {expr} more {expr2}"` (T21).
    //
    // Built from the lexer's `StringStart / StringPart / InterpStart / ...
    // InterpEnd / StringEnd` token stream. Each part is either literal text
    // or an arbitrary expression. Codegen lowers this to a Rust `format!(...)`
    // macro call with one `{}` per expression and comma-separated arguments.
    //
    // This is an **additive** change: no existing variant was renamed or
    // reordered. A simple `"abc"` (no `{...}`) still parses as
    // `Expr::Literal(Literal::String(_), _)`; only strings that actually
    // contain interpolation produce this variant.
    //
    // Tuple fields: (Vector<InterpPart> parts, Span span).
    StringInterp(Vector<InterpPart>, Span),
    // A map literal: `{"key": value, ...}` or `{:}` (empty) (T25).
    //
    // Comma-separated `(key, value)` entries; trailing comma allowed; empty
    // map spelled `{:}` (bare `{}` is rejected to avoid ambiguity with code
    // blocks). Lowers to Rust's `std::collections::HashMap::from([...])`
    // (fully-qualified, so no `use` import is needed in generated code).
    // Both key and value types are inferred from the first entry — literals
    // with mixed kinds fall back to the first entry's types.
    //
    // This is **additive**: no existing variant was renamed or reordered.
    //
    // Tuple fields: (Vector<(Expr, Expr)> entries, Span span).
    MapLit(Vector<(Expr, Expr)>, Span),
    // The error-propagation postfix operator `expr?` (T30).
    //
    // Wraps its operand. Codegen lowers this to Rust's **native `?`**
    // (`<expr>?`), which requires (and assumes) the enclosing function
    // returns a `Result<T, E>` — Buff functions that use `?` lower to
    // Rust functions returning `Result`, so this lines up directly. The
    // `?` operator propagates the `Err(e)` early (via `return Err(e)`)
    // and yields the unwrapped `Ok(v)` value.
    //
    // This is **additive** (T30): see the migration note on `Expr`.
    // Parsing happens in `parse_postfix` (the `?` token is
    // `TokenKind::Question`, already produced by the lexer — it is NOT a
    // reserved keyword).
    //
    // Tuple fields: (Expr expr, Span span).
    Try(Expr, Span),
    // The async-spawn prefix operator `spawn <expr>` (T31).
    //
    // Buff tokenises `spawn` as a reserved keyword (`TokenKind::KwSpawn`)
    // so it can never be parsed as an ordinary identifier. The parser
    // builds this node in `parse_primary` when it sees `KwSpawn` at a
    // primary position; the operand is the next expression (the task to
    // spawn).
    //
    // Codegen lowers `spawn expr` to Rust's
    // `tokio::spawn(async move { expr })`, yielding a
    // `tokio::task::JoinHandle<T>`. Buff's `Task<T>` type is a thin alias
    // for `JoinHandle<T>`; the only `.await` ever emitted is at the
    // `t.result()` site (see T31 codegen rules).
    //
    // This is **additive** (T31): see the migration note on `Expr`.
    //
    // Tuple fields: (Expr task, Span span).
    Spawn(Expr, Span),
    // A range expression: `start..end` (exclusive) or `start..=end` (inclusive) (T68).
    //
    // The `inclusive` flag distinguishes `..` (exclusive, `0..10` → `0..10`)
    // from `..=` (inclusive, `0..=10` → `0..=10`). Both bounds are full
    // expressions so `a + 1..b * 2` works. Range has lower precedence than
    // additive operators, so `a+1..b*2` parses as `(a+1)..(b*2)`.
    //
    // This is **additive** (T68): no existing variant was renamed, reordered,
    // or had its payload altered, so all prior `match` arms remain exhaustive.
    //
    // Tuple fields: (Expr start, Expr end, Bool inclusive, Span span).
    Range(Expr, Expr, Bool, Span),
    // A conditional binding: `if let PATTERN = EXPR { then } else { else }` (T72).
    //
    // The `pattern` is matched against `value`; on success the `then_block`
    // runs with the pattern's bindings in scope; on failure the optional
    // `else_block` runs (or the whole expression evaluates to `()` when no
    // `else` is present). Codegen lowers this to Rust's native `if let`
    // expression, so the borrow-checker enforces the binding lifetime for
    // free.
    //
    // This variant carries a single `let`-binding condition only (NOT a
    // let-chain — `if let a = x, let b = y` is T74, a separate task). The
    // `pattern` reuses the shared `Pattern` enum (Variant/Ident/Tuple/
    // Struct/...) that `match` arms and T71 destructuring already use, so
    // `if let Some(x) = opt` parses the `Some(x)` via the same
    // `parse_pattern` path as `match opt { Some(x) => ... }`.
    //
    // This is **additive** (T72): no existing variant was renamed, reordered,
    // or had its payload altered, so all prior `match` arms remain
    // exhaustive. See the migration-note block on `Expr` for the
    // established pattern.
    //
    // Tuple fields: (Pattern pattern, Expr value, Block then_block,
    // Option<Block> else_block, Span span).
    IfLet(Pattern, Expr, Block, Option<Block>, Span),
    // A tuple value literal: `(e1, e2, ...)` with 2+ members, e.g.
    // `("A", 42)` (T103).
    //
    // Each element is a full `Expr` so `(a + 1, foo(), [1, 2])` works.
    // The 2+-element rule lives at parse time: a single `(e)` is grouping
    // (returns the bare `e`), NOT an `Expr::TupleLit`. So this variant
    // always carries 2+ elements. A trailing comma `(a, b,)` is allowed
    // and lowered to the same shape as `(a, b)`. Element order is
    // preserved as written (Vector, never a HashMap — determinism).
    //
    // Codegen lowers `(e1, e2)` to Rust's native tuple `(e1, e2)`, so the
    // resulting type is a real Rust tuple `(T1, T2)`.
    //
    // This is **additive** (T103): no existing variant was renamed,
    // reordered, or had its payload altered, so all prior `match` arms
    // remain exhaustive. See the migration-note block on `Expr` for the
    // established pattern (T68 `Expr::Range` is the closest template).
    //
    // Tuple fields: (Vector<Expr> members, Span span).
    TupleLit(Vector<Expr>, Span),
    // A named call argument: `name: value` inside a call's arg list (T105).
    //
    // Appears ONLY as an element of `Expr::FuncCall::args` or
    // `Expr::MethodCall::args` — never as a stand-alone expression. The
    // parser builds this node when it sees the `Ident Colon Expr` shape at
    // an argument position; a pure positional arg stays its bare `Expr`
    // (no NamedArg wrapper). This is the LIGHTER additive design (option A
    // in the T105 spec): `Expr::FuncCall` / `Expr::MethodCall` keep
    // their `args: Vec<Expr>` shape; a NamedArg is just one Expr variant
    // that flows through the existing vec.
    //
    // **Mixed positional + named** is allowed (positional first, then
    // named — the common convention; Buff v0.5 also accepts named-before-
    // positional for parser simplicity, but the canonical form is
    // positional-first). Reorder to the callee's declared param order is
    // done at **codegen** time when the callee's signature is resolvable
    // in the same compilation unit; otherwise (foreign callee, method
    // dispatch) the value is emitted positionally in the order written
    // (see the codegen note in `lower_func_call_args` for the v0.5 scope).
    //
    // This is **additive** (T105): no existing variant was renamed,
    // reordered, or had its payload altered, so all prior `match` arms
    // remain exhaustive. See the migration-note block on `Expr` for the
    // established pattern (T68 `Expr::Range` / T103 `Expr::TupleLit` are
    // the closest templates).
    //
    // Tuple fields: (Ident name, Expr value, Span span).
    NamedArg(Ident, Expr, Span),
}

// Returns the `Span` associated with this expression.
// Mirrors the Rust reference's `impl Expr { pub fn span(&self) -> Span }`.
func expr_span(e: Expr) -> Span:
    return match e {
        Literal(_, s) => s,
        Ident(_, s) => s,
        BinaryOp(_, _, _, s) => s,
        UnaryOp(_, _, s) => s,
        IfExpr(_, _, _, s) => s,
        FuncCall(_, _, s) => s,
        MethodCall(_, _, _, s) => s,
        Lambda(_, _, _, s) => s,
        StructInit(_, _, s) => s,
        MatchExpr(_, _, s) => s,
        SuspendExpr(_, s) => s,
        ArrayLit(_, s) => s,
        Index(_, _, s) => s,
        StringInterp(_, s) => s,
        MapLit(_, s) => s,
        Try(_, s) => s,
        Spawn(_, s) => s,
        Range(_, _, _, s) => s,
        IfLet(_, _, _, _, s) => s,
        TupleLit(_, s) => s,
        NamedArg(_, _, s) => s,
    }

// Render an `Expr` as its diagnostic string. Mirrors the Rust reference's
// `impl fmt::Display for Expr`.
func expr_to_string(e: Expr) -> String:
    return match e {
        Literal(lit, _) => "Lit(" + literal_to_string(lit) + ")",
        Ident(ident, _) => "Ident(" + ident_to_string(ident) + ")",
        BinaryOp(op, lhs, rhs, _) => "BinaryOp(" + binary_op_to_string(op) + ", " + expr_to_string(lhs) + ", " + expr_to_string(rhs) + ")",
        UnaryOp(op, operand, _) => "UnaryOp(" + unary_op_to_string(op) + ", " + expr_to_string(operand) + ")",
        IfExpr(cond, then_block, else_block, _) => if_expr_to_string(cond, then_block, else_block),
        FuncCall(callee, args, _) => "Call(" + expr_to_string(callee) + ", " + join_exprs(args) + ")",
        MethodCall(receiver, method, args, _) => "MethodCall(" + expr_to_string(receiver) + "." + ident_to_string(method) + ", " + join_exprs(args) + ")",
        Lambda(params, body, return_type, _) => lambda_to_string(params, body, return_type),
        StructInit(type_name, fields, _) => struct_init_to_string(type_name, fields),
        MatchExpr(scrutinee, arms, _) => "Match(" + expr_to_string(scrutinee) + ", " + join_arms(arms) + ")",
        SuspendExpr(inner, _) => "Suspend(" + expr_to_string(inner) + ")",
        ArrayLit(elements, _) => "Array" + join_exprs_bracketed(elements),
        Index(base, indices, _) => "Index(" + expr_to_string(base) + ", " + join_exprs_bracketed(indices) + ")",
        StringInterp(parts, _) => "Interp" + join_interp_parts(parts),
        MapLit(entries, _) => "Map" + join_entries(entries),
        Try(expr, _) => "Try(" + expr_to_string(expr) + ")",
        Spawn(task, _) => "Spawn(" + expr_to_string(task) + ")",
        Range(start, end, inclusive, _) => range_to_string(start, end, inclusive),
        IfLet(pattern, value, then_block, else_block, _) => if_let_to_string(pattern, value, then_block, else_block),
        TupleLit(members, _) => "Tuple" + join_exprs_bracketed(members),
        NamedArg(name, value, _) => "Named(" + ident_to_string(name) + ": " + expr_to_string(value) + ")",
    }

// Helper: IfExpr Display body, factored out so the match arm stays a single
// expression. Mirrors the Rust reference's nested `match else_block`.
func if_expr_to_string(cond: Expr, then_block: Block, else_block: Option<Block>) -> String:
    let prefix = "If(" + expr_to_string(cond) + ", " + block_to_string(then_block)
    match else_block {
        Some(els) => return prefix + ", " + block_to_string(els) + ")",
        None => return prefix + ")",
    }

// Helper: Lambda Display body. Mirrors `Lambda(fn(p1, p2) -> T { body })`.
// Braces built via Char.to_string to avoid Buff's string-interpolation
// lexer treating `{` inside a string literal as `interp_start`.
func lambda_to_string(params: Vector<Param>, body: Block, return_type: Option<TypeRef>) -> String:
    let open = Char.to_string('{')
    let close = Char.to_string('}')
    let mut s = "Lambda(fn("
    let mut i = 0
    for i < params.len():
        if i > 0:
            s = s + ", "
        s = s + param_to_string(params[i])
        i = i + 1
    s = s + ")" + lambda_return_suffix(return_type) + " " + open + " " + block_body_to_string(body) + " " + close + ")"
    return s

// Helper: render the ` -> ReturnType` suffix of a `Lambda`, or the empty
// string when no return type is annotated. Mirrors the Rust reference's
// `if let Some(rt) = return_type { write!(f, " -> {rt}")?; }`.
func lambda_return_suffix(rt: Option<TypeRef>) -> String:
    return match rt {
        Some(t) => " -> " + typeref_to_string(t),
        None => "",
    }

// Helper: render the body of a Block without its surrounding braces — the
// Lambda Display wraps the body in its own braces, so we strip the Block's
// braces to avoid duplication. Mirrors the Rust reference's
// `write!(f, "{body}")` where `body: Block`'s `Display` already adds the
// braces; the Lambda wrapper is special-cased.
func block_body_to_string(b: Block) -> String:
    let mut s = ""
    let mut i = 0
    for i < b.stmts.len():
        if i > 0:
            s = s + "; "
        s = s + "<stmt>"
        i = i + 1
    return s

// Helper: StructInit Display body. Mirrors `StructInit(Type { f1: v1, f2: v2 })`.
// Braces are built via Char.to_string to avoid Buff's string-interpolation
// lexer treating `{` inside a string literal as `interp_start`.
func struct_init_to_string(type_name: Ident, fields: Vector<(Ident, Expr)>) -> String:
    let open = Char.to_string('{')
    let close = Char.to_string('}')
    let mut s = "StructInit(" + ident_to_string(type_name) + " " + open + " "
    let mut i = 0
    for i < fields.len():
        if i > 0:
            s = s + ", "
        let (n, v) = fields[i]
        s = s + ident_to_string(n) + ": " + expr_to_string(v)
        i = i + 1
    s = s + " " + close + ")"
    return s

// Helper: Range Display body. Mirrors `Range(start, end, incl|excl)`.
func range_to_string(start: Expr, end: Expr, inclusive: Bool) -> String:
    let kind = range_kind_label(inclusive)
    return "Range(" + expr_to_string(start) + ", " + expr_to_string(end) + ", " + kind + ")"

// Helper: Range inclusive/exclusive label.
func range_kind_label(inclusive: Bool) -> String:
    if inclusive:
        return "incl"
    return "excl"

// Helper: IfLet Display body. Mirrors `IfLet(PAT = VAL, then[, else])`.
func if_let_to_string(pattern: Pattern, value: Expr, then_block: Block, else_block: Option<Block>) -> String:
    let prefix = "IfLet(" + pattern_to_string(pattern) + " = " + expr_to_string(value) + ", " + block_to_string(then_block)
    match else_block {
        Some(els) => return prefix + ", " + block_to_string(els) + ")",
        None => return prefix + ")",
    }

// Helper: join a Vector<Expr> as `[e1, e2, e3]` (FuncCall/MethodCall args).
func join_exprs(xs: Vector<Expr>) -> String:
    let mut s = "["
    let mut i = 0
    for i < xs.len():
        if i > 0:
            s = s + ", "
        s = s + expr_to_string(xs[i])
        i = i + 1
    s = s + "]"
    return s

// Helper: join a Vector<Expr> as `[e1, e2, ...]` with brackets — used by
// ArrayLit, Index, and TupleLit Displays. Same shape as `join_exprs`.
func join_exprs_bracketed(xs: Vector<Expr>) -> String:
    return join_exprs(xs)

// Helper: join a Vector<MatchArm> as `[arm1, arm2, ...]`.
func join_arms(arms: Vector<MatchArm>) -> String:
    let mut s = "["
    let mut i = 0
    for i < arms.len():
        if i > 0:
            s = s + ", "
        s = s + match_arm_to_string(arms[i])
        i = i + 1
    s = s + "]"
    return s

// Helper: join a Vector<InterpPart> as `[part1, part2, ...]`.
func join_interp_parts(parts: Vector<InterpPart>) -> String:
    let mut s = "["
    let mut i = 0
    for i < parts.len():
        if i > 0:
            s = s + ", "
        s = s + interp_part_to_string(parts[i])
        i = i + 1
    s = s + "]"
    return s

// Helper: join a Vector<(Expr, Expr)> as `[k1: v1, k2: v2, ...]` (MapLit).
func join_entries(entries: Vector<(Expr, Expr)>) -> String:
    let mut s = "["
    let mut i = 0
    for i < entries.len():
        if i > 0:
            s = s + ", "
        let (k, v) = entries[i]
        s = s + expr_to_string(k) + ": " + expr_to_string(v)
        i = i + 1
    s = s + "]"
    return s

// ---------------------------------------------------------------------------
// JSON serialization (P0.1.2b) — DEFERRED.
// ---------------------------------------------------------------------------
//
// The Rust reference defines `impl Literal { pub fn to_json(&self) ->
// serde_json::Value }`, plus the same for `InterpPart`, `Expr`, `MatchArm`,
// and `Pattern`. These power `buff check --dump-ast` on the Rust host side.
//
// NOT ported here: Buff has no `serde_json::Value` equivalent in the
// prelude, and the JSON dump path is a Rust-host concern (DR-014 §🟥
// codegen-rust wall). The data definitions above are the public API; the
// JSON shape is re-derived from them by the host when needed.

// ---------------------------------------------------------------------------
// MatchArm — a single arm of a `match` expression.
// ---------------------------------------------------------------------------

// A single arm of a `match` expression.
//
// # Migration notes (additive AST changes)
//
// ## T40 — `guard` field
//
// A `guard: Option<Expr>` field was **added** in T40 (v1.25 language-features
// batch) to carry the optional `if <cond>` guard on a match arm
// (`match x { Some(v) if v > 0 => "positive", _ => "other" }`). This is a
// **migration** (a new field was inserted between `pattern` and `body`,
// before `span`) — every construction site was updated to pass
// `guard: None` for non-guarded arms. The Display impl renders ` if <cond>`
// between the pattern and the `=>`. The codegen lowers it to a Rust
// `syn::Arm { guard: Some(...) }`. The exhaustiveness checker treats a
// guarded arm as non-exhaustive for its variant (a guard can fail, so the
// arm does not unconditionally cover the variant — matching Rust's rule).
struct MatchArm:
    pattern: Pattern
    // The optional `if <cond>` guard (T40). `None` for an unguarded arm.
    // When `Some`, the arm matches only when BOTH the pattern matches AND
    // the guard expression evaluates to `true`.
    //
    // NOTE: field name `guard_expr` (not `guard`) because `guard` is a
    // reserved Buff keyword (T73 guard early-return statement). The Rust
    // original spells this field `guard`; the rename is the only deviation
    // from the Rust shape and is forced by the keyword collision.
    guard_expr: Option<Expr>
    body: Block
    span: Span

// Render a `MatchArm` as its diagnostic string. Mirrors the Rust
// reference's `impl fmt::Display for MatchArm`.
func match_arm_to_string(arm: MatchArm) -> String:
    return pattern_to_string(arm.pattern) + match_guard_prefix(arm.guard_expr) + " => " + block_to_string(arm.body)

// Helper: render the ` if <cond>` guard prefix of a `MatchArm` (T40), or
// the empty string when no guard is present. Mirrors the Rust reference's
// `if let Some(guard) = &self.guard { write!(f, " if {guard}")?; }`.
// (Parameter named `g` not `guard` — `guard` is a reserved Buff keyword.)
func match_guard_prefix(g: Option<Expr>) -> String:
    return match g {
        Some(e) => " if " + expr_to_string(e),
        None => "",
    }

// ---------------------------------------------------------------------------
// Pattern — a pattern usable inside a `MatchArm`.
// ---------------------------------------------------------------------------

// A pattern usable inside a `MatchArm`.
enum Pattern {
    // The wildcard `_`.
    Wildcard(Span),
    // A literal pattern: `1`, `"foo"`, `true`.
    Literal(Literal, Span),
    // A binding pattern: `x`.
    Ident(Ident, Span),
    // An enum variant pattern: `Option::Some(x)` or `Color::Rgb(r, g, b)`.
    // Tuple fields: (Ident enum_name, Ident variant,
    // Vector<Pattern> subpatterns, Span span).
    Variant(Ident, Ident, Vector<Pattern>, Span),
    // A tuple destructuring pattern: `(x, y)`, `(a, _, c)` (T71).
    Tuple(Vector<Pattern>, Span),
    // A struct destructuring pattern: `Point { x, y }` (T71) with optional
    // `..` rest (T41 — v1.25 language-features batch).
    //
    // Each entry is `(field_name, subpattern)`. Shorthand `Point { x, y }`
    // is parsed as `{ x: x, y: y }` — i.e. a field whose name equals its
    // binding. Field order is preserved as written (determinism: never use a
    // HashMap here).
    //
    // # Migration note (additive)
    //
    // ## T41 — `rest` field
    //
    // A `rest: bool` field was **added** in T41 to carry the `..` rest
    // pattern (`Point { x, .. }` — ignore all unmentioned fields). This is a
    // **migration** (a new field was appended after `span`) — every
    // construction site was updated to pass `rest: false` for non-rest
    // patterns. The Display impl renders ` , ..` before the closing brace
    // when `rest` is true. The codegen lowers it to a Rust `Pat::Struct`
    // with `rest: Some(..)`. The formatter round-trips it.
    //
    // Tuple fields: (Ident name, Vector<(Ident, Pattern)> fields, Span span,
    // Bool rest).
    Struct(Ident, Vector<(Ident, Pattern)>, Span, Bool),
    // An or-pattern: `Red | Green | Blue` (T39 — v1.25 language-features
    // batch).
    //
    // Two-or-more alternatives separated by `|`, matching when ANY
    // alternative matches. Mirrors Rust's or-pattern syntax 1:1. The
    // alternatives are themselves `Pattern`s, so nesting
    // (`Some(1 | 2)`, `Ok(Red) | Err(Blue)`) composes — each subpattern
    // position recursively calls `parse_pattern`, which itself accepts a
    // trailing `| ...` chain.
    //
    // Bindings across alternatives must agree (Rust requires the same set
    // of bindings in each arm of an or-pattern); Buff defers this check to
    // rustc (which enforces it at match lowering). The span covers the whole
    // `A | B | C` sequence.
    //
    // Tuple fields: (Vector<Pattern> alternatives, Span span).
    Or(Vector<Pattern>, Span),
}

// Returns the `Span` associated with this pattern (T27).
//
// Every variant carries its own `Span`; this accessor lets the match
// parser (and downstream diagnostics) treat patterns uniformly.
// Mirrors the Rust reference's `impl Pattern { pub fn span(&self) -> Span }`.
func pattern_span(p: Pattern) -> Span:
    return match p {
        Wildcard(s) => s,
        Literal(_, s) => s,
        Ident(_, s) => s,
        Variant(_, _, _, s) => s,
        Tuple(_, s) => s,
        Struct(_, _, s, _) => s,
        Or(_, s) => s,
    }

// Returns the canonical variant-name key this pattern would cover, if
// it could be a variant reference (T27).
//
// Used by the exhaustiveness checker to match arms against enum
// variants by NAME without needing to resolve the variant-vs-binding
// ambiguity upfront. Returns:
// - `Some(name)` for `Pattern::Ident(name)` and
//   `Pattern::Variant { variant: name, .. }` (the parser fills
//   `enum_name` with `""` for variant patterns it builds from source).
// - `None` for `Pattern::Wildcard` and `Pattern::Literal` (these never
//   cover a named variant).
//
// NOTE: Rust returns `Option<&str>` (borrowed); Buff returns `Option<String>`
// (owned) — Buff has no borrowed return values.
func pattern_variant_name_key(p: Pattern) -> Option<String>:
    return match p {
        Ident(name, _) => Some(name.name),
        Variant(_, variant, _, _) => Some(variant.name),
        Wildcard(_) => None,
        Literal(_, _) => None,
        Tuple(_, _) => None,
        Struct(_, _, _, _) => None,
        Or(_, _) => None,
    }

// Returns the identifiers bound by this pattern (T71).
//
// - `Ident(name)` → `[name]`
// - `Tuple(subs)` / `Variant { subpatterns, .. }` → bindings of each
//   sub-pattern (flattened, order preserved).
// - `Struct { fields, .. }` → bindings of each field's sub-pattern.
// - `Wildcard` / `Literal` → `[]` (they bind nothing).
//
// Used by inference, ownership analysis, and IR lowering to introduce
// the names a destructuring `let` brings into scope. Determinism is
// preserved by walking the source-order `Vector`s (never a HashMap).
func pattern_bindings(p: Pattern) -> Vector<Ident>:
    let out: Vector<Ident> = Vector.new()
    pattern_bindings_into(p, out)
    return out

// Helper: push all bindings of `p` into `out` in source order. Returns
// `out` so callers can chain. Factored out so each `match` arm body can
// call `pattern_bindings_into` on its sub-patterns without needing a fresh
// Vector (Buff has no `flat_map` on `Vector` in the prelude; the Rust
// original uses `subs.iter().flat_map(Pattern::bindings).collect()` — we
// expand that to a manual recursive walk).
func pattern_bindings_into(p: Pattern, out: Vector<Ident>) -> Vector<Ident>:
    return match p {
        Ident(name, _) => push_ident(out, name),
        Tuple(subs, _) => push_all_bindings(out, subs),
        Variant(_, _, subpatterns, _) => push_all_bindings(out, subpatterns),
        Struct(_, fields, _, _) => push_all_field_bindings(out, fields),
        Wildcard(_) => out,
        Literal(_, _) => out,
        Or(alts, _) => push_all_bindings(out, alts),
    }

// Helper: push a single `Ident` onto `out`, returning `out` for chaining.
// Mirrors Rust's `out.push(name); out` sequence.
func push_ident(out: Vector<Ident>, name: Ident) -> Vector<Ident>:
    out.push(name)
    return out

// Helper: walk a `Vector<Pattern>` and push every binding into `out`.
// Returns `out` for chaining. Mirrors Rust's
// `xs.iter().flat_map(Pattern::bindings).collect()` (the collect target is
// the same `out` vector, mutated in place).
func push_all_bindings(out: Vector<Ident>, xs: Vector<Pattern>) -> Vector<Ident>:
    let mut i = 0
    for i < xs.len():
        pattern_bindings_into(xs[i], out)
        i = i + 1
    return out

// Helper: walk a `Vector<(Ident, Pattern)>` and push every binding of
// each field's sub-pattern into `out`. Returns `out` for chaining.
// Mirrors Rust's `fields.iter().flat_map(|(_, p)| p.bindings()).collect()`.
func push_all_field_bindings(out: Vector<Ident>, fields: Vector<(Ident, Pattern)>) -> Vector<Ident>:
    let mut i = 0
    for i < fields.len():
        let (_fname, sub) = fields[i]
        pattern_bindings_into(sub, out)
        i = i + 1
    return out

// Render a `Pattern` as its diagnostic string. Mirrors the Rust
// reference's `impl fmt::Display for Pattern`.
func pattern_to_string(p: Pattern) -> String:
    return match p {
        Wildcard(_) => "_",
        Literal(lit, _) => literal_to_string(lit),
        Ident(name, _) => ident_to_string(name),
        Variant(enum_name, variant, subpatterns, _) => variant_to_string(enum_name, variant, subpatterns),
        Tuple(subs, _) => tuple_pattern_to_string(subs),
        Struct(name, fields, _, rest) => struct_pattern_to_string(name, fields, rest),
        Or(alts, _) => or_pattern_to_string(alts),
    }

// Helper: Variant pattern Display body. Mirrors `EnumName::Variant(sub1, sub2)`.
func variant_to_string(enum_name: Ident, variant: Ident, subpatterns: Vector<Pattern>) -> String:
    let mut s = ident_to_string(enum_name) + "::" + ident_to_string(variant)
    if subpatterns.len() > 0:
        s = s + "("
        let mut i = 0
        for i < subpatterns.len():
            if i > 0:
                s = s + ", "
            s = s + pattern_to_string(subpatterns[i])
            i = i + 1
        s = s + ")"
    return s

// Helper: Tuple pattern Display body. Mirrors `(sub1, sub2, ...)`.
func tuple_pattern_to_string(subs: Vector<Pattern>) -> String:
    let mut s = "("
    let mut i = 0
    for i < subs.len():
        if i > 0:
            s = s + ", "
        s = s + pattern_to_string(subs[i])
        i = i + 1
    s = s + ")"
    return s

// Helper: Struct pattern Display body. Mirrors `Name { f1: p1, f2: p2, .. }`.
// Braces are built via Char.to_string to avoid Buff's string-interpolation
// lexer treating `{` inside a string literal as `interp_start`.
func struct_pattern_to_string(name: Ident, fields: Vector<(Ident, Pattern)>, rest: Bool) -> String:
    let open = Char.to_string('{')
    let close = Char.to_string('}')
    let mut s = ident_to_string(name) + " " + open + " "
    let mut i = 0
    for i < fields.len():
        if i > 0:
            s = s + ", "
        let (fname, p) = fields[i]
        s = s + ident_to_string(fname) + ": " + pattern_to_string(p)
        i = i + 1
    // T41: render the `..` rest pattern before the closing brace.
    if rest:
        if fields.len() > 0:
            s = s + ", "
        s = s + ".."
    s = s + " " + close
    return s

// Helper: Or-pattern Display body. Mirrors `A | B | C`.
func or_pattern_to_string(alts: Vector<Pattern>) -> String:
    let mut s = ""
    let mut i = 0
    for i < alts.len():
        if i > 0:
            s = s + " | "
        s = s + pattern_to_string(alts[i])
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// Primitive render helpers (prelude trampolines).
// ---------------------------------------------------------------------------
//
// These mirror the number→string coercion Rust gets for free via
// `fmt::Display` and `{:?}` Debug formatting. Kept explicit so the file
// has zero hidden trait dispatch (matches the `token.buff` precedent).

// Render an `Int` as its decimal string.
func int_to_string(n: Int) -> String:
    return Int.to_string(n)

// Render a `Float` (f32) as its string.
func float_to_string(n: Float) -> String:
    return Float.to_string(n)

// Render a `Double` (f64) as its string.
func double_to_string(n: Double) -> String:
    return Double.to_string(n)

// Render a `Bool` as `true` / `false`.
func bool_to_string(b: Bool) -> String:
    if b:
        return "true"
    return "false"

// Debug-quote a string (Rust `{:?}` form): wrap in double quotes.
// The Rust reference uses `write!(f, "String({v:?})")` which produces
// `String("hi")` — this is the quote wrapper, used for any payload that
// renders in `{:?}` Debug form.
func debug_quote(s: String) -> String:
    return "\"" + s + "\""

// Render a `Byte` as 2-digit uppercase hex (no `0x` prefix — the caller
// adds it). Mirrors Rust's `{v:02X}` formatter.
func byte_hex(b: Byte) -> String:
    let n = Byte.to_int(b)
    return hex_upper2(n)

// Render the byte value of a `Char` in Debug ({:?}) form — Rust renders
// `'A'` for the char A. We approximate by wrapping the char in single
// quotes (the round-trip is faithful for printable ASCII; multi-byte
// emoji render as their literal scalar value in single quotes, matching
// the Rust char-Debug form for printable scalars).
func char_debug(c: Char) -> String:
    return "'" + Char.to_string(c) + "'"

// Helper: 2-digit uppercase hex of a number in [0, 255]. Used by `byte_hex`.
// Buff's prelude has no `format!("{:02X}", n)` formatter; we spell out the
// 16x16 lookup so the output is byte-equivalent to Rust's `{v:02X}`.
func hex_upper2(n: Int) -> String:
    let hi = hex_digit(n / 16)
    let lo = hex_digit(n % 16)
    return hi + lo

// Helper: single uppercase hex digit (0-15 → '0'..'F').
func hex_digit(n: Int) -> String:
    if n == 0:
        return "0"
    if n == 1:
        return "1"
    if n == 2:
        return "2"
    if n == 3:
        return "3"
    if n == 4:
        return "4"
    if n == 5:
        return "5"
    if n == 6:
        return "6"
    if n == 7:
        return "7"
    if n == 8:
        return "8"
    if n == 9:
        return "9"
    if n == 10:
        return "A"
    if n == 11:
        return "B"
    if n == 12:
        return "C"
    if n == 13:
        return "D"
    if n == 14:
        return "E"
    return "F"