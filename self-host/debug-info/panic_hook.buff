// Buff self-host port of `crates/buff-lang-debug-info/src/panic_hook.rs` (P3.4).
//
// Panic hook — install a `std::panic::set_hook` interceptor that remaps
// Rust backtraces to Buff source locations.
//
// # Lifecycle
//
// 1. **Codegen time**: [`build_source_map`] (capture.buff) +
//    [`serialize_to_string`] (format.buff) write a `.buffmap` sidecar
//    next to the compiled binary.
// 2. **Runtime init**: [`install_panic_hook`] is called once when the
//    Buff runtime initializes. It looks up the `.buffmap` path from
//    `BUFF_MAP_PATH` env var (falling back to `<current_exe>.buffmap`).
// 3. **On panic**: the hook walks the Rust backtrace, remaps each frame
//    to its Buff source location via [`remap_panic_backtrace`], and
//    prints the Buff trace to stderr. The full Rust trace is preserved
//    as an escape hatch — printed AFTER the Buff trace when
//    `RUST_BACKTRACE=1` is set.
//
// # Why not embed the source map in the binary?
//
// Two reasons:
//
// 1. **Sidecar files are debuggable**: users can `cat foo.buffmap` to
//    see the mappings, post-process them, share them with bug reports.
// 2. **No codegen bloat**: the Rust source generated by Buff stays
//    focused on the program logic; debug info lives in its own file.
//
// # `RUST_BACKTRACE=1` escape hatch
//
// The Buff trace is ALWAYS printed (the hook is installed transparently
// at runtime init). When `RUST_BACKTRACE=1` is also set, the FULL Rust
// backtrace is additionally printed AFTER the Buff trace so advanced
// users can drill into Rust internals when debugging interop issues.
//
// Faithful 1:1 translation of the Rust reference. This file is the
// primary YELLOW-crate surface of the debug-info port: every OS-level
// runtime facility the Rust original uses (`std::panic::set_hook`,
// `std::backtrace::Backtrace`, `std::sync::OnceLock`, `std::thread`,
// `std::io::stderr` + `writeln!`, `std::env::var` /
// `std::env::current_exe`) is declared as an `extern "C"` stub. The
// stubs link against `buff-lang-runtime` on the Rust side, which
// exposes `#[no_mangle] pub extern "C" fn ...` trampolines for each.
//
// Translation decisions:
//   * `static BUFF_MAP: OnceLock<Option<SourceMap>>` -> two extern
//     trampolines `buff_map_get() -> Option<SourceMap>` and
//     `buff_map_set(value: Option<SourceMap>)`. Buff has no module-level
//     mutable state (no `static` keyword); the global lives on the Rust
//     side inside `buff-lang-runtime` and is reached through these
//     accessors. The OnceLock semantics (set-once, get-cheaply) are
//     preserved by the Rust host.
//   * `std::panic::set_hook(Box::new(buff_panic_handler))` ->
//     `extern "C" from "buff_lang_runtime" func std_panic_set_hook(...)`.
//     The `PanicHookInfo` type is opaque on the Buff side — the Buff
//     port installs a Rust-side handler that delegates back into a
//     Buff function via `buff_panic_handler_entry`. The actual
//     `info.location()` / `info.payload()` / `info.payload.downcast_ref`
//     calls happen on the Rust side; the Buff-side `buff_panic_handler`
//     takes pre-extracted plain-data arguments (location: Option<...>,
//     payload: String, thread_name: String).
//   * `std::backtrace::Backtrace::capture()` + `.to_string()` ->
//     `extern "C" from "buff_lang_runtime" func backtrace_capture_to_string() -> String`.
//     The captured backtrace is returned as its string form directly —
//     the Buff port has no use for the opaque `Backtrace` handle (it
//     always calls `.to_string()` immediately after capture).
//   * `std::backtrace::Backtrace::force_capture()` -> same extern shape.
//   * `std::env::var("BUFF_MAP_PATH")` ->
//     `extern "C" from "buff_lang_runtime" func env_var(key: String) -> Option<String>`.
//     Rust's `Result<String, VarError>` collapses to `Option<String>`
//     (`Some(v)` when present, `None` on any error).
//   * `std::env::current_exe()` ->
//     `extern "C" from "buff_lang_runtime" func current_exe() -> Option<String>`.
//   * `path.exists()` -> `extern "C" from "buff_lang_runtime"
//     func path_exists(path: String) -> Bool`.
//   * `PathBuf::set_extension("buffmap")` -> the Rust original calls
//     this in-place; the Buff port models it as
//     `pathbuf_set_extension(path: String, ext: String) -> String` returning
//     the new path (Buff has no in-place mutation of String — strings
//     are immutable; the function returns the new value).
//   * `std::thread::current().name()` ->
//     `extern "C" from "buff_lang_runtime" func current_thread_name() -> Option<String>`.
//   * `std::io::stderr().lock()` + `writeln!(stderr, "...")` ->
//     `extern "C" from "buff_lang_runtime" func stderr_writeln(line: String)`.
//     The Rust `Write::writeln!` macro is the ONE form that does NOT
//     port (Buff has no macro system and no `Write` trait); each
//     `writeln!(stderr, "...")` call becomes a `stderr_writeln("...")`
//     call with the message pre-formatted on the Buff side.
//   * `format!("thread '{thread_name}' panicked at {payload_str}")` ->
//     string concatenation `"thread '" + thread_name + "' panicked at " + payload_str`
//     (porting §8a — Buff interpolation is `"foo {var}"` direct in the
//     literal, but the corpus style — see source_map.buff, suggest.buff
//     line 250 — favours `+` concatenation for clarity).
//   * `if let Some(loc) = location` -> `match location { Some(loc) => ..., None => ... }`
//     (porting §8e — Buff has no `if let`).
//   * `msg.downcast_ref::<&'static str>()` / `msg.downcast_ref::<String>()`
//     -> pre-extracted `payload: String` parameter (the Rust host's
//     panic-hook wrapper does the downcast and passes the resulting
//     `String` to the Buff entry point).
//   * `.as_ref()`, `.as_deref()` -> dropped (Buff has no references).
//   * `.and_then(|opt| opt.as_ref())` -> manual `match` chains.
//   * `.map(String::from)` -> dropped (Buff strings are already owned).
//   * `.unwrap_or_else(|| "<unnamed>".to_string())` -> `match` with a
//     default branch (porting §8a — `unwrap_or_else` is allowed since
//     it is not `unwrap()`/`expect()`; the Buff form is a named match).
//   * `#[cfg(test)] mod tests { ... }` -> dropped. Per porting §5a,
//     inline unit tests do not port.
//   * `usize` -> `Int` (porting §7a).
//
// Runtime intrinsics declared as extern stubs — actual linking deferred
// to the buff-lang-runtime crate. This is the central YELLOW-crate
// surface: panic hooks, backtrace capture, thread introspection, env
// vars, and stderr writing are all OS-level facilities Buff has no
// native syntax for.

import { SourceMap, source_map_is_empty, source_map_lookup_buff } from "lib"
import { read_from_file } from "format"

// =============================================================================
// Process-global state externs (BUFF_MAP OnceLock)
// =============================================================================
//
// The Rust original declares `static BUFF_MAP: OnceLock<Option<SourceMap>>`.
// Buff has no module-level mutable state — the global lives on the Rust
// side inside buff-lang-runtime and is reached through these accessors.

extern "C" from "buff_lang_runtime" func buff_map_get() -> Option<SourceMap>

extern "C" from "buff_lang_runtime" func buff_map_set(value: Option<SourceMap>)

// =============================================================================
// Panic-hook + backtrace externs
// =============================================================================
//
// The Rust host installs a real `std::panic::set_hook` that delegates
// into `buff_panic_handler_entry` (defined below). The host extracts
// `info.location()`, `info.payload()` (downcast to String), and
// `std::thread::current().name()` BEFORE calling the Buff entry point,
// so the Buff side receives plain data (no `PanicHookInfo` opaque handle).

extern "C" from "buff_lang_runtime" func std_panic_set_hook_install()

extern "C" from "buff_lang_runtime" func backtrace_capture_to_string() -> String

extern "C" from "buff_lang_runtime" func backtrace_force_capture_to_string() -> String

// =============================================================================
// Environment / process / thread externs
// =============================================================================

extern "C" from "buff_lang_runtime" func env_var(key: String) -> Option<String>

extern "C" from "buff_lang_runtime" func current_exe() -> Option<String>

extern "C" from "buff_lang_runtime" func current_thread_name() -> Option<String>

extern "C" from "buff_lang_runtime" func path_exists(path: String) -> Bool

extern "C" from "buff_lang_runtime" func pathbuf_set_extension(path: String, ext: String) -> String

// =============================================================================
// Stderr writer extern
// =============================================================================
//
// The Rust original uses `std::io::stderr().lock()` + `writeln!(...)`.
// Buff has no `Write` trait and no `writeln!` macro; each Rust
// `writeln!(stderr, "...")` call becomes a single `stderr_writeln("...")`
// extern call with the message pre-formatted on the Buff side.

extern "C" from "buff_lang_runtime" func stderr_writeln(line: String)

// =============================================================================
// install_panic_hook — runtime registration
// =============================================================================

// Install the Buff panic hook.
//
// Looks up the `.buffmap` path from the `BUFF_MAP_PATH` env var first,
// then falls back to `<current_exe>.buffmap`. When neither exists the
// hook is still installed but does nothing (defers to the default Rust
// panic message + backtrace).
//
// Calling this more than once is a no-op — `std::panic::set_hook`
// overwrites the previous hook, and the source map is cached in a
// [`OnceLock`] so repeated calls return cheaply.
func install_panic_hook():
    let map_path = resolve_buff_map_path()
    let map = load_buff_map_if_present(map_path)
    buff_map_set(map)
    std_panic_set_hook_install()

// Inner step: load the BuffMap from `map_path` if `Some`, else `None`.
// Extracted from `install_panic_hook` so the `Option.and_then` chain of
// the Rust original becomes a single named helper (Buff has no closure-
// based `and_then` on Option — porting §8c favours named helpers).
func load_buff_map_if_present(map_path: Option<String>) -> Option<SourceMap>:
    match map_path {
        None => return Option.None,
        Some(path) => return load_buff_map_from_path(path),
    }

// Inner step: try to read + deserialise the buffmap at `path`. On any
// I/O or JSON error, returns `None` (the Rust original uses `.ok()` on
// the `Result<SourceMap, _>` to the same effect — silently drop errors
// and fall back to no map).
func load_buff_map_from_path(path: String) -> Option<SourceMap>:
    let result = read_from_file(path)
    match result {
        Err(_msg) => return Option.None,
        Ok(map) => return Option.Some(map),
    }

// =============================================================================
// resolve_buff_map_path — find the sidecar file
// =============================================================================

// Resolve the `.buffmap` file path from `BUFF_MAP_PATH` or
// `<current_exe>.buffmap`.
//
// Returns `None` when neither path exists on disk. The path is NOT
// validated as a real `.buffmap` file here — that's deferred to the
// `format::read_from_file` call inside [`install_panic_hook`].
func resolve_buff_map_path() -> Option<String>:
    let env_result = env_var("BUFF_MAP_PATH")
    match env_result {
        Some(path_str) => return resolve_from_env_var(path_str),
        None => return resolve_from_current_exe(),
    }

// Inner step: check whether the env-var-provided path exists. If so,
// return it; otherwise fall through to the `<current_exe>.buffmap`
// branch. Extracted so the `match` chain stays single-expression.
func resolve_from_env_var(path_str: String) -> Option<String>:
    if path_exists(path_str):
        return Option.Some(path_str)
    return resolve_from_current_exe()

// Inner step: probe `<current_exe>.buffmap`. Returns `None` when the
// exe path itself is unavailable OR when no `.buffmap` sits next to it.
func resolve_from_current_exe() -> Option<String>:
    let exe_opt = current_exe()
    match exe_opt {
        None => return Option.None,
        Some(exe) => return resolve_from_exe_path(exe),
    }

// Inner step: given the current-exe path, build the `.buffmap` sibling
// and probe it. Mirrors the Rust `let mut buffmap = exe.clone();
// buffmap.set_extension("buffmap"); if buffmap.exists() { Some(buffmap) } else { None }`.
func resolve_from_exe_path(exe: String) -> Option<String>:
    let buffmap = pathbuf_set_extension(exe, "buffmap")
    if path_exists(buffmap):
        return Option.Some(buffmap)
    return Option.None

// =============================================================================
// buff_panic_handler_entry — Rust host calls this on panic
// =============================================================================
//
// The Rust host installs a real `std::panic::set_hook` closure that:
//   1. Extracts `info.location()` -> `(file: String, line: Int, col: Int)`
//      or `None`.
//   2. Extracts `info.payload()` and downcasts to `&'static str` or
//      `String` -> `String` (or `"Box<dyn Any>"` fallback).
//   3. Extracts `std::thread::current().name()` -> `Option<String>`.
//   4. Calls this function with the pre-extracted plain data.
//
// The Buff port therefore receives plain values and never touches the
// `PanicHookInfo` opaque handle directly. This is the FFI-safety pattern
// from `crates/buff-lang-ffi-guide/GUIDE.md` rule R1 (no raw pointers in
// the public surface).

// The actual panic handler installed by [`install_panic_hook`].
//
// Renders:
//
// 1. The standard `thread '<name>' panicked at <msg>` line + location,
//    with the Rust source path translated to the Buff source path when
//    a mapping exists.
// 2. A `Buff stack trace:` section with each Rust frame remapped to
//    its Buff source location (when a mapping exists).
// 3. When `RUST_BACKTRACE=1` is set, the full Rust backtrace printed
//    AFTER the Buff trace (escape hatch preserved).
func buff_panic_handler_entry(
    location: Option<(String, Int, Int)>,
    payload_str: String,
    thread_name_opt: Option<String>,
):
    let map_opt = buff_map_get()
    let thread_name = unwrap_thread_name(thread_name_opt)
    stderr_writeln("thread '" + thread_name + "' panicked at " + payload_str)
    render_location_or_skip(location, map_opt)
    render_buff_stack_trace(map_opt)
    render_full_rust_backtrace_if_enabled()

// Default thread name when `current_thread_name()` returns `None`.
// Mirrors the Rust `.unwrap_or_else(|| "<unnamed>".to_string())` (porting
// §8a — `unwrap_or_else` is allowed; the Buff form is a named match).
func unwrap_thread_name(opt: Option<String>) -> String:
    return match opt {
        Some(name) => name,
        None => "<unnamed>",
    }

// Render the `--> file:line:col` line. When both `location` and `map`
// are `Some`, translate the Rust location to a Buff location via the
// SourceMap; otherwise emit the Rust location verbatim; otherwise skip
// entirely. Extracted from `buff_panic_handler_entry` so the
// double-`Option` match of the Rust original reads as a single named
// helper.
func render_location_or_skip(location: Option<(String, Int, Int)>, map_opt: Option<SourceMap>):
    match location {
        None => skip_render(),
        Some(loc) => render_loc_with_map(loc, map_opt),
    }

// No-op marker for the `None` branch of `render_location_or_skip`'s
// outer match. Buff `match` arms must be single expressions — a
// "do-nothing" body needs a function-call shape.
func skip_render():
    return

// Inner step: render the `-->` line for the `(file, line, col)` triple,
// consulting the SourceMap (if any) for a Buff-location translation.
func render_loc_with_map(loc: (String, Int, Int), map_opt: Option<SourceMap>):
    let (rust_file, rust_line, rust_col) = loc
    match map_opt {
        None => stderr_writeln("  --> " + rust_file + ":" + rust_line.to_string() + ":" + rust_col.to_string()),
        Some(map) => render_loc_with_map_some(rust_file, rust_line, rust_col, map),
    }

// Inner step: when the SourceMap is present, try to translate the Rust
// line to a Buff location. On hit, render the Buff path:line:col; on
// miss, render the original Rust path:line:col.
func render_loc_with_map_some(rust_file: String, rust_line: Int, rust_col: Int, map: SourceMap):
    let buff_loc_opt = source_map_lookup_buff(map, rust_line)
    match buff_loc_opt {
        Some(buff_loc) => stderr_writeln(
            "  --> " + unwrap_buff_path(map) + ":" + buff_loc.line.to_string() + ":" + buff_loc.col.to_string(),
        ),
        None => stderr_writeln("  --> " + rust_file + ":" + rust_line.to_string() + ":" + rust_col.to_string()),
    }

// Extract the buff_file path from a SourceMap, falling back to
// `"<unknown>"` when not set. Mirrors the Rust `map.buff_file.as_ref()
// .map(|p| p.to_string_lossy().into_owned()).unwrap_or_else(|| "<unknown>".to_string())`.
func unwrap_buff_path(map: SourceMap) -> String:
    return match map.buff_file {
        Some(p) => p,
        None => "<unknown>",
    }

// =============================================================================
// Buff stack trace rendering
// =============================================================================

// Render the "Buff stack trace:" section. Walks the remapped BuffTrace
// (if non-empty) and prints each frame as `  <idx>: <name> (<file>:<line>:<col>)`.
// No-op when the trace is empty.
func render_buff_stack_trace(map_opt: Option<SourceMap>):
    let trace = remap_panic_backtrace(map_opt)
    if trace.frames.len() == 0:
        return
    stderr_writeln("")
    stderr_writeln("Buff stack trace:")
    let mut idx = 0
    for idx < trace.frames.len():
        let frame = trace.frames[idx]
        let name = unwrap_frame_name(frame.buff_name)
        stderr_writeln(
            "  " + idx.to_string() + ": " + name + " ("
            + trace.buff_file_display + ":" + frame.buff_line.to_string() + ":" + frame.buff_col.to_string() + ")",
        )
        idx = idx + 1

// Extract the frame name from `Option<String>`, falling back to
// `"<anonymous>"`. Mirrors the Rust `frame.buff_name.as_deref()
// .unwrap_or("<anonymous>")`.
func unwrap_frame_name(opt: Option<String>) -> String:
    return match opt {
        Some(n) => n,
        None => "<anonymous>",
    }

// =============================================================================
// RUST_BACKTRACE=1 escape hatch
// =============================================================================

// Render the full Rust backtrace when `RUST_BACKTRACE=1` is set; no-op
// otherwise. Preserves the escape hatch verbatim from the Rust original.
func render_full_rust_backtrace_if_enabled():
    let env_result = env_var("RUST_BACKTRACE")
    match env_result {
        Some(v) => render_full_rust_backtrace_if_one(v),
        None => skip_render(),
    }

// Inner step: emit the full Rust backtrace when the env-var value is
// exactly `"1"`. Extracted so the `match` on `env_var(...)` stays
// single-expression.
func render_full_rust_backtrace_if_one(v: String):
    if v == "1":
        stderr_writeln("")
        stderr_writeln("Full Rust backtrace (RUST_BACKTRACE=1):")
        stderr_writeln(backtrace_force_capture_to_string())
    else:
        skip_render()

// =============================================================================
// BuffTrace / BuffTraceFrame data types
// =============================================================================

// A remapped Buff stack trace.
//
// Built by [`remap_panic_backtrace`] from a Rust [`Backtrace`] snapshot
// plus the loaded [`SourceMap`]. Frames without a Buff mapping are
// dropped — only Buff-source frames appear in the trace.
struct BuffTrace:
    frames: Vector<BuffTraceFrame>
    buff_file_display: String

// One frame in a [`BuffTrace`].
struct BuffTraceFrame:
    buff_line: Int
    buff_col: Int
    buff_name: Option<String>
    rust_line: Int

// =============================================================================
// remap_panic_backtrace — Rust backtrace -> Buff stack trace
// =============================================================================

// Remap a Rust backtrace into a Buff stack trace.
//
// When `map` is `None` or empty, returns an empty [`BuffTrace`] (the
// caller's `RUST_BACKTRACE=1` escape hatch still surfaces the raw Rust
// trace via the panic handler's escape-hatch branch).
//
// The current implementation walks a fresh [`Backtrace::capture`]
// snapshot. A future enhancement could accept a pre-captured backtrace
// for `buff backtrace`-style offline use.
func remap_panic_backtrace(map_opt: Option<SourceMap>) -> BuffTrace:
    match map_opt {
        None => return BuffTrace.new(frames: [], buff_file_display: ""),
        Some(map) => return remap_panic_backtrace_with_map(map),
    }

// Inner step: remap with a non-empty SourceMap. Returns an empty trace
// when the SourceMap carries no line or function mappings; otherwise
// captures a fresh backtrace and walks it.
func remap_panic_backtrace_with_map(map: SourceMap) -> BuffTrace:
    if source_map_is_empty(map):
        return BuffTrace.new(frames: [], buff_file_display: "")
    let backtrace_str = backtrace_capture_to_string()
    let buff_file_display = unwrap_buff_path(map)
    let frames = collect_remapped_frames(backtrace_str, map)
    return BuffTrace.new(frames: frames, buff_file_display: buff_file_display)

// Walk the lines of a Rust backtrace string, look up each Rust line in
// the SourceMap, and emit a `BuffTraceFrame` for each hit. Mirrors the
// Rust `for rust_line in extract_rust_lines_from_backtrace(&trace_str)
// { if let Some(loc) = map.lookup_buff(rust_line) { frames.push(...) } }`
// loop.
func collect_remapped_frames(backtrace_str: String, map: SourceMap) -> Vector<BuffTraceFrame>:
    let frames: Vector<BuffTraceFrame> = []
    let rust_lines = extract_rust_lines_from_backtrace(backtrace_str)
    let mut i = 0
    for i < rust_lines.len():
        let rust_line = rust_lines[i]
        let loc_opt = source_map_lookup_buff(map, rust_line)
        match loc_opt {
            None => skip_frame(),
            Some(loc) => frames.push(BuffTraceFrame.new(
                buff_line: loc.line,
                buff_col: loc.col,
                buff_name: loc.name,
                rust_line: rust_line,
            )),
        }
        i = i + 1
    return frames

// No-op marker for the `None` branch of the per-frame `match` above.
// Buff `match` arms must be single expressions; a "skip this frame"
// body needs a function-call shape.
func skip_frame():
    return

// =============================================================================
// Backtrace-string line extraction
// =============================================================================

// Parse the backtrace string and extract the Rust line numbers.
//
// Looks for the pattern `<file>:<line>` where `<file>` ends with `.rs`.
// The backtrace crate formats frames with file paths + line numbers;
// this helper extracts just the line numbers from Rust-source frames.
func extract_rust_lines_from_backtrace(backtrace_str: String) -> Vector<Int>:
    let lines: Vector<Int> = []
    let frame_lines = string_lines(backtrace_str)
    let mut i = 0
    for i < frame_lines.len():
        let line = frame_lines[i]
        match extract_rust_line_from_frame(line) {
            None => skip_frame(),
            Some(rust_line) => lines.push(rust_line),
        }
        i = i + 1
    return lines

// Try to extract a Rust line number from a single backtrace frame line.
//
// Matches patterns like `<...>.rs:LINE` or `<...>.rs:LINE:COL`. Returns
// `None` for non-Rust frames (e.g. system libraries without `.rs`
// extensions).
func extract_rust_line_from_frame(line: String) -> Option<Int>:
    let rs_idx_opt = string_rfind(line, ".rs")
    match rs_idx_opt {
        None => return Option.None,
        Some(rs_idx) => return extract_rust_line_after_rs(line, rs_idx),
    }

// Inner step: given the index of the last `.rs` in `line`, slice the
// remainder after `.rs` and try to parse a `:LINE` prefix. Returns
// `None` when the remainder is empty or doesn't start with `:`.
func extract_rust_line_after_rs(line: String, rs_idx: Int) -> Option<Int>:
    let dot_rs_len = 3  // ".rs".len()
    let after_rs_opt = string_slice(line, rs_idx + dot_rs_len)
    match after_rs_opt {
        None => return Option.None,
        Some(after_rs) => return extract_rust_line_from_rest(after_rs),
    }

// Inner step: given the slice after `.rs`, check for a leading `:`
// followed by ASCII digits, and parse those digits as an integer.
// Returns `None` when the digits are absent or don't parse.
func extract_rust_line_from_rest(rest: String) -> Option<Int>:
    let stripped_opt = string_strip_prefix(rest, ":")
    match stripped_opt {
        None => return Option.None,
        Some(rest_after_colon) => return parse_leading_digits(rest_after_colon),
    }

// Walk the chars of `s`, collecting leading ASCII digits into a string
// and parsing the result. Returns `None` when the digit string is empty
// or doesn't parse as an integer. Mirrors the Rust
// `rest.chars().take_while(|c| c.is_ascii_digit()).collect::<String>()`
// followed by `.parse::<usize>().ok()`.
func parse_leading_digits(s: String) -> Option<Int>:
    let chars = string_chars(s)
    let mut digits = ""
    let mut i = 0
    for i < chars.len():
        let c = chars[i]
        if char_is_ascii_digit(c):
            digits = digits + char_to_string(c)
        else:
            i = chars.len()  // break out of the for-loop
        i = i + 1
    if digits == "":
        return Option.None
    return string_parse_int(digits)

// =============================================================================
// String + char extern trampolines
// =============================================================================
//
// The capture.buff port declares the same set of string externs; this
// file redeclares them so `buff check` resolves every symbol locally
// (Buff's import resolver is the M7 monolith, not yet active — until
// then each file redeclares its externs). The Rust host coalesces
// duplicate extern declarations transparently.

extern "C" from "buff_lang_runtime" func string_lines(source: String) -> Vector<String>

extern "C" from "buff_lang_runtime" func string_chars(s: String) -> Vector<Char>

extern "C" from "buff_lang_runtime" func string_rfind(s: String, needle: String) -> Option<Int>

extern "C" from "buff_lang_runtime" func string_slice(s: String, start: Int) -> Option<String>

extern "C" from "buff_lang_runtime" func string_strip_prefix(s: String, prefix: String) -> Option<String>

extern "C" from "buff_lang_runtime" func char_is_ascii_digit(c: Char) -> Bool

extern "C" from "buff_lang_runtime" func char_to_string(c: Char) -> String

extern "C" from "buff_lang_runtime" func string_parse_int(s: String) -> Option<Int>
