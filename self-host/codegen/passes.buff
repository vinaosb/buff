// Buff self-host port of `crates/buff-lang-codegen-rust/src/passes.rs` (T18, Track C).
//
// T77/T78: compiler optimization passes (AST-level, before codegen).
//
// These passes walk the Buff AST and transform it to eliminate dead code
// (T77) and propagate constants (T78). They are pure functions: they take
// `&[Decl]` and return `Vec<Decl>`, never mutating the input. The passes are
// applied via the caller chaining them before `generate_rust` so the default
// path is unchanged (backwards compatibility — existing callers and snapshot
// tests are unaffected).
//
// # Conservatism
//
// Both passes are deliberately conservative. They only transform code when
// the transformation is provably safe:
//
// - **DCE** only removes `let` bindings whose value is a **pure literal**
//   (no function/method calls, no I/O) and whose name is never referenced
//   anywhere in the enclosing function body. It only removes functions that
//   are **never called** AND not `main` AND not `@test`/`@bench` AND not
//   exported.
// - **Const-prop** only replaces a name with a literal when the binding is
//   `let x = <literal>`, x is **never assigned to** (`x = ...` or
//   `x += ...`), and every use of x is in a pure expression context.
//
// The Rust reference is 1287 LOC. The Buff port mirrors the public API
// surface (dead_code_elimination, constant_propagation).

// =============================================================================
// Forward declarations (opaque handles)
// =============================================================================

struct Decl:
    opaque_handle: Int

struct FuncDecl:
    opaque_handle: Int

struct ExportDecl:
    opaque_handle: Int

struct ExtendBlock:
    opaque_handle: Int

struct TraitDecl:
    opaque_handle: Int

struct Block:
    opaque_handle: Int

struct Stmt:
    opaque_handle: Int

struct Expr:
    opaque_handle: Int

struct Literal:
    opaque_handle: Int

struct Attribute:
    opaque_handle: Int

struct BTreeSet_String:
    opaque_handle: Int

struct BTreeMap_String_Literal:
    opaque_handle: Int

extern "Rust" {
    fn decl_as_func_decl(decl: Decl) -> Option<FuncDecl>
    fn decl_as_export_decl(decl: Decl) -> Option<ExportDecl>
    fn decl_as_extend_block(decl: Decl) -> Option<ExtendBlock>
    fn decl_as_trait_decl(decl: Decl) -> Option<TraitDecl>
    fn unwrap_func_decl(opt: Option<FuncDecl>) -> FuncDecl
    fn unwrap_export_decl(opt: Option<ExportDecl>) -> ExportDecl
    fn unwrap_extend_block(opt: Option<ExtendBlock>) -> ExtendBlock
    fn unwrap_trait_decl(opt: Option<TraitDecl>) -> TraitDecl
    fn func_decl_name(f: FuncDecl) -> String
    fn func_decl_body(f: FuncDecl) -> Block
    fn func_decl_attributes(f: FuncDecl) -> Vector<Attribute>
    fn func_decl_is_extern(f: FuncDecl) -> Bool
    fn attribute_name(a: Attribute) -> String
    fn export_decl_inner(e: ExportDecl) -> Decl
    fn extend_block_methods(e: ExtendBlock) -> Vector<FuncDecl>
    fn trait_decl_defaults(t: TraitDecl) -> Vector<FuncDecl>
    fn block_stmts(b: Block) -> Vector<Stmt>
    fn btreetap_string_new() -> BTreeSet_String
    fn btreetap_string_insert(set: BTreeSet_String, s: String)
    fn btreetap_string_contains(set: BTreeSet_String, s: String) -> Bool
    fn btreetap_string_literal_new() -> BTreeMap_String_Literal
    fn btreetap_string_literal_get(map: BTreeMap_String_Literal, k: String) -> Option<Literal>
    fn btreetap_string_literal_insert(map: BTreeMap_String_Literal, k: String, v: Literal)
}

// =============================================================================
// dead_code_elimination — T77: remove unused bindings + never-called fns
// =============================================================================
//
// Remove dead code from a slice of declarations. See the module-level docs
// for what is and isn't removed.

func dead_code_elimination(decls: Vector<Decl>) -> Vector<Decl>:
    let called_fns = collect_called_functions(decls)
    let exported_fns = collect_exported_fn_names(decls)
    let out = Vector.new()
    let mut i = 0
    for i < decls.len():
        let decl = decls.get(i)
        let opt_func = func_decl_from(decl)
        if opt_func != Option.None:
            let func = unwrap_func_decl(opt_func)
            if is_dead_function(func, called_fns, exported_fns):
                // Skip — dead function.
                i = i + 1
                continue
        out.push(eliminate_dead_bindings_in_decl(decl))
        i = i + 1
    return out

// is_dead_function — predicate: should this function be removed?
//
// Returns false (keep) when ANY of:
// - name == "main"
// - name in exported set
// - any attribute name in {"test", "bench", "should_panic", "ignore"}
// - name in called set
// - is_extern

func is_dead_function(func: FuncDecl, called: BTreeSet_String, exported: BTreeSet_String) -> Bool:
    let name = func_decl_name(func)
    if name == "main":
        return false
    if btreetap_string_contains(exported, name):
        return false
    let attrs = func_decl_attributes(func)
    let mut i = 0
    for i < attrs.len():
        let aname = attribute_name(attrs.get(i))
        if aname == "test" or aname == "bench" or aname == "should_panic" or aname == "ignore":
            return false
        i = i + 1
    if btreetap_string_contains(called, name):
        return false
    if func_decl_is_extern(func):
        return false
    return true

// func_decl_from — extract FuncDecl from a Decl (handles ExportDecl wrap).
func func_decl_from(decl: Decl) -> Option<FuncDecl>:
    let opt_f = decl_as_func_decl(decl)
    if opt_f != Option.None:
        return opt_f
    let opt_e = decl_as_export_decl(decl)
    if opt_e != Option.None:
        let e = unwrap_export_decl(opt_e)
        return decl_as_func_decl(export_decl_inner(e))
    return Option.None

// collect_exported_fn_names — names of fns inside `export` decls.
func collect_exported_fn_names(decls: Vector<Decl>) -> BTreeSet_String:
    let set = btreetap_string_new()
    let mut i = 0
    for i < decls.len():
        let decl = decls.get(i)
        let opt_e = decl_as_export_decl(decl)
        if opt_e != Option.None:
            let e = unwrap_export_decl(opt_e)
            let inner = export_decl_inner(e)
            let opt_f = decl_as_func_decl(inner)
            if opt_f != Option.None:
                let f = unwrap_func_decl(opt_f)
                btreetap_string_insert(set, func_decl_name(f))
        i = i + 1
    return set

// =============================================================================
// collect_called_functions — union of all free-fn call sites in the program
// =============================================================================
//
// Walk every FuncDecl body, every ExportDecl's inner FuncDecl body, every
// ExtendBlock's method bodies, and every TraitDecl's default-method bodies.
// At each Expr::FuncCall site, record the callee name.

func collect_called_functions(decls: Vector<Decl>) -> BTreeSet_String:
    let called = btreetap_string_new()
    let mut i = 0
    for i < decls.len():
        let decl = decls.get(i)
        let opt_f = decl_as_func_decl(decl)
        if opt_f != Option.None:
            let f = unwrap_func_decl(opt_f)
            collect_called_in_block(called, func_decl_body(f))
        else:
            let opt_e = decl_as_export_decl(decl)
            if opt_e != Option.None:
                let e = unwrap_export_decl(opt_e)
                let inner = export_decl_inner(e)
                let opt_fi = decl_as_func_decl(inner)
                if opt_fi != Option.None:
                    let fi = unwrap_func_decl(opt_fi)
                    collect_called_in_block(called, func_decl_body(fi))
            else:
                let opt_ext = decl_as_extend_block(decl)
                if opt_ext != Option.None:
                    let ext = unwrap_extend_block(opt_ext)
                    let methods = extend_block_methods(ext)
                    let mut j = 0
                    for j < methods.len():
                        collect_called_in_block(called, func_decl_body(methods.get(j)))
                        j = j + 1
                else:
                    let opt_t = decl_as_trait_decl(decl)
                    if opt_t != Option.None:
                        let t = unwrap_trait_decl(opt_t)
                        let defaults = trait_decl_defaults(t)
                        let mut k = 0
                        for k < defaults.len():
                            collect_called_in_block(called, func_decl_body(defaults.get(k)))
                            k = k + 1
        i = i + 1
    return called

func collect_called_in_block(called: BTreeSet_String, block: Block):
    let stmts = block_stmts(block)
    let mut i = 0
    for i < stmts.len():
        collect_called_in_stmt(called, stmts.get(i))
        i = i + 1

func collect_called_in_stmt(called: BTreeSet_String, stmt: Stmt):
    // (match stmt:
    //   LetDecl { value, .. } | LetPattern { value, .. } → collect_called_in_expr
    //   Assignment { target, value, .. } → { collect_called_in_expr(target);
    //                                         collect_called_in_expr(value) }
    //   ExprStmt(e, _) → collect_called_in_expr(e)
    //   Return(e, _) → walk_opt_expr(e)
    //   ... etc — every arm delegates to collect_called_in_expr)
    collect_called_in_stmt_impl(called, stmt)

func collect_called_in_expr(called: BTreeSet_String, expr: Expr):
    // (match expr:
    //   FuncCall(name, args, ..) → { called.insert(name); walk_args(args) }
    //   MethodCall(..) → walk_receiver_and_args
    //   Lambda(..) → walk_body
    //   ... etc — recursive walk)
    collect_called_in_expr_impl(called, expr)

// =============================================================================
// eliminate_dead_bindings_in_decl — strip dead `let <pure-literal>` bindings
// =============================================================================
//
// Within a function body, removes `let` bindings whose value is a pure
// literal (no fn/method calls) AND whose name is never referenced anywhere
// in the function body. Conservative: any shadowing, any assignment, any
// capture by a nested closure → keep the binding.

func eliminate_dead_bindings_in_decl(decl: Decl) -> Decl:
    return eliminate_dead_bindings_in_decl_impl(decl)

// =============================================================================
// constant_propagation — T78: replace names with literals where provably safe
// =============================================================================
//
// Walk every function body, find every `let x = <literal>` where x is never
// assigned to AND every use of x is in a pure expression context, then
// replace each use of x with the literal. Conservative.

func constant_propagation(decls: Vector<Decl>) -> Vector<Decl>:
    let out = Vector.new()
    let mut i = 0
    for i < decls.len():
        out.push(constant_propagation_in_decl(decls.get(i)))
        i = i + 1
    return out

func constant_propagation_in_decl(decl: Decl) -> Decl:
    return constant_propagation_in_decl_impl(decl)

// =============================================================================
// Implementation shims (extern bindings to AST mutators)
// =============================================================================
//
// The actual AST transformation is delegated to extern "Rust" bindings — the
// Buff port preserves the algorithm shape (build name→literal map from
// never-assigned `let <name> = <literal>` bindings, then walk + replace uses).

extern "Rust" {
    fn collect_called_in_stmt_impl(called: BTreeSet_String, stmt: Stmt)
    fn collect_called_in_expr_impl(called: BTreeSet_String, expr: Expr)
    fn eliminate_dead_bindings_in_decl_impl(decl: Decl) -> Decl
    fn constant_propagation_in_decl_impl(decl: Decl) -> Decl
}
