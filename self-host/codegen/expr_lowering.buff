// Implementation shims (extern bindings to syn constructors)
// =============================================================================

struct BinaryOp:
    opaque_handle: Int

struct UnaryOp:
    opaque_handle: Int

struct Pair_Expr_Expr:
    opaque_handle: Int

struct Pair_String_Expr:
    opaque_handle: Int

extern "Rust" {
    fn unwrap_expr(opt: Option<Expr>) -> Expr
    fn make_pat_ident(name: String) -> SynPat
    fn make_closure_expr(pats: Vector<SynPat>, body: SynExpr) -> SynExpr
    fn make_block_expr(block: SynBlock) -> SynExpr
    fn make_tuple_expr(k_e: SynExpr, v_e: SynExpr) -> SynExpr
    fn build_hashmap_from_expr(entries: Vector<SynExpr>) -> SynExpr
    fn build_vec_macro_expr(elements: Vector<SynExpr>) -> SynExpr
    fn build_hashset_from_expr(elements: Vector<SynExpr>) -> SynExpr
    fn make_field_value(name: String, value: SynExpr) -> FieldValue
    fn build_struct_init_expr(type_name: String, fields: Vector<FieldValue>) -> SynExpr
    fn build_tuple_n_expr(elements: Vector<SynExpr>) -> SynExpr
    fn str_lit_expr(s: String) -> SynExpr
    fn build_format_expr(parts: Vector<String>, exprs: Vector<SynExpr>) -> SynExpr
    fn lower_binary_op_impl(op: BinaryOp, lhs: SynExpr, rhs: SynExpr) -> Result<SynExpr, CodegenError>
    fn lower_unary_op_impl(op: UnaryOp, e: SynExpr) -> Result<SynExpr, CodegenError>
    fn lower_match_expr_impl(codegen: RustCodegen, scrut: Expr, arms: Vector<MatchArm>) -> Result<SynExpr, CodegenError>
    fn lower_if_expr_impl(codegen: RustCodegen, cond: Expr, then_block: Block, else_block_opt: Option<Block>) -> Result<SynExpr, CodegenError>
    fn lower_for_expr_impl(codegen: RustCodegen, pat: Pattern, iter: Expr, body: Block) -> Result<SynExpr, CodegenError>
    fn lower_while_expr_impl(codegen: RustCodegen, cond: Expr, body: Block) -> Result<SynExpr, CodegenError>
    fn pair_expr_expr_first(p: Pair_Expr_Expr) -> Expr
    fn pair_expr_expr_second(p: Pair_Expr_Expr) -> Expr
    fn pair_string_expr_first(p: Pair_String_Expr) -> String
    fn pair_string_expr_second(p: Pair_String_Expr) -> Expr
}

struct FieldValue:
    opaque_handle: Int
