// Buff self-host port of `crates/buff-lang-codegen-rust/src/rust_codegen/lowering_helpers.rs` (T18, Track C).
//
// T105a — expr/lowering syn builders (generic paths, calls, str coercion,
// math lowering) (mechanically extracted from rust_codegen.rs).
//
// Verbatim move from the parent — no logic changes. Child module of
// rust_codegen so it inherits the parent imports via `use super::*` (zero
// per-module import lists). Functions are `pub(super)` so the parent reaches
// them through the glob below.
//
// The Rust reference is 291 LOC. The Buff port mirrors the public API
// surface (make_generic_path_type, make_qualified_generic_path_type,
// float_repr, method_call_one_arg, rust_call_expr, str_lit_expr,
// coerce_str_arg_to_ref, lower_math_unary, lower_math_binary,
// splice_receiver_into_call).

// =============================================================================
// Opaque handles (forward declarations)
// =============================================================================

struct SynType:
    opaque_handle: Int

struct SynExpr:
    opaque_handle: Int

struct BuffExpr:
    opaque_handle: Int

struct CodegenError:
    opaque_handle: Int

struct BuffSpan:
    opaque_handle: Int

struct TokenStream:
    opaque_handle: Int

extern "Rust" {
    fn rust_path(name: String) -> SynType
    fn buff_span_dummy() -> BuffSpan
}

// =============================================================================
// make_generic_path_type — `Name<T, U, …>` (T25)
// =============================================================================
//
// Build a `Type::Path` with generic type arguments, e.g. `Option<T>`, `Vec<T>`.

func make_generic_path_type(name: String, args: Vector<SynType>) -> SynType:
    // (Build a one-segment path `name<args>` via PathSegment +
    //  AngleBracketedGenericArguments. The Punctuated construction is
    //  delegated to the extern shim.)
    return make_generic_path_type_impl(name, args)

// =============================================================================
// make_qualified_generic_path_type — `a::b::c<T, U, …>` (T25)
// =============================================================================
//
// Like `make_generic_path_type` but accepts a `::`-separated qualified path
// (e.g. `"std::collections::HashMap"`) and attaches the generic arguments to
// the LAST segment. Used by the T25 Map codegen so generated programs can
// reference `std::collections::HashMap<K, V>` without a `use` import
// (avoiding import management in v0.5).

func make_qualified_generic_path_type(qualified_name: String, args: Vector<SynType>) -> SynType:
    // (Split qualified_name on "::", build a Punctuated<PathSegment, ::> of
    //  segments where ONLY the LAST segment carries the AngleBracketed
    //  generic args; intermediate segments use PathArguments::None.)
    return make_qualified_generic_path_type_impl(qualified_name, args)

// =============================================================================
// float_repr — format a float so the f32/f64 suffix binds correctly
// =============================================================================
//
// Format a float so that it always has a decimal point or exponent (so the
// `f32`/`f64` suffix binds to a float literal, not an integer).

func float_repr(d: Double) -> String:
    let s = double_to_string(d)
    if string_contains(s, "."):
        return s
    if string_contains(s, "e"):
        return s
    if string_contains(s, "E"):
        return s
    if s == "inf":
        return s
    if s == "-inf":
        return s
    if s == "NaN":
        return s
    return s + ".0"

// =============================================================================
// method_call_one_arg — `recv.method(arg)`
// =============================================================================
//
// Build a `recv.method(arg)` single-argument method call. Used by the
// string-method codegen helpers (e.g. `s.chars().skip(n)`).

func method_call_one_arg(recv: SynExpr, method: String, arg: SynExpr) -> SynExpr:
    // (Build SynExpr::MethodCall with one-element Punctuated args, no
    //  turbofish.)
    return method_call_one_arg_impl(recv, method, arg)

// =============================================================================
// rust_call_expr — `<path>(args)` (T124b)
// =============================================================================
//
// Build a fully-qualified Rust associated-function call `<path>(args)` —
// used for prelude-type constructors like `chrono::Utc::now()` and
// `chrono::TimeDelta::days(n)`.
//
// The `qualified_path` is a `::`-separated string (e.g.
// `"chrono::Utc::now"`, `"chrono::TimeDelta::days"`). The args slice is
// lowered already — this helper just wraps them in a `syn::ExprCall` on the
// path expression.

func rust_call_expr(qualified_path: String, args: Vector<SynExpr>) -> SynExpr:
    // (Build SynExpr::Path(callee) where callee.path = rust_path(qualified_path);
    //  then SynExpr::Call with the args as a Punctuated<SynExpr, ,>.)
    return rust_call_expr_impl(qualified_path, args)

// =============================================================================
// str_lit_expr — Rust `&'static str` literal expression (T124b)
// =============================================================================
//
// Used by prelude-type parse/format codegen to pass strftime / parse format
// strings (`"%Y-%m-%d"`). Built via `syn::LitStr::new` so any embedded
// escapes survive correctly.

func str_lit_expr(text: String) -> SynExpr:
    // (SynExpr::Lit(Lit::Str(LitStr::new(text, call_site()))))
    return str_lit_expr_impl(text)

// =============================================================================
// coerce_str_arg_to_ref — borrow non-literal string args (T124b)
// =============================================================================
//
// Coerce a string-typed argument expression to `&str` when the underlying
// chrono API requires it.
//
// chrono's `DateTime::parse_from_rfc3339`, `NaiveDate::parse_from_str`, and
// `DateTime::format` all take `&str`. Buff string literals
// (`Expr::Literal(Literal::String(s))`) lower directly to a Rust `&'static
// str` literal — so no coercion is needed in that case. For non-literal arg
// expressions (idents referencing `String` bindings, interpolation results,
// ...) we wrap the lowered expression in a borrow `&<expr>` so Rust's Deref
// coercion turns `&String` into `&str`.
//
// Without this, `DateTime.parse(my_string_var)` would emit
// `chrono::DateTime::parse_from_rfc3339(my_string_var)` which fails to
// compile (expected `&str`, found `String`). The borrow turns it into
// `chrono::DateTime::parse_from_rfc3339(&my_string_var)` which works.

func coerce_str_arg_to_ref(lowered: SynExpr, orig: BuffExpr) -> SynExpr:
    // String literals lower to `&'static str` already — no borrow needed.
    if buff_expr_is_string_literal(orig):
        return lowered
    // Named-arg wrapper around a string literal — recurse into the value.
    if buff_expr_is_named_arg(orig):
        let value = buff_expr_named_arg_value(orig)
        return coerce_str_arg_to_ref(lowered, value)
    // Everything else (idents, interpolation, etc.) — borrow via `&<expr>`.
    return make_borrow_expr(lowered)

// =============================================================================
// lower_math_unary — Math.sqrt(16) → `(arg as f64).method()` (T124f)
// =============================================================================
//
// Lower a unary `Math.<method>(x)` call to `(<arg> as f64).<method>()`.
// Wraps the arg in an `as f64` cast so an Int arg like `Math.sqrt(16)` works
// as well as a Float arg like `Math.sqrt(2.0)` (matches the spec acceptance
// `Math.sqrt(16) -> 4.0`). The cast is built via `quote!` + parse2 so the
// resulting `syn::Expr` is a well-formed `Expr::MethodCall` on a cast
// subexpression (NOT a string-built hack — the single string producer
// remains `prettyplease::unparse`).
//
// Used for: sqrt / sin / cos / tan / abs / floor / ceil / round
// (8 unary Math methods — all take one arg and return Float).

func lower_math_unary(arg: SynExpr, method: String) -> Result<SynExpr, CodegenError>:
    // (let tokens = quote! { (#arg as f64).#method() };
    //  syn::parse2(tokens).map_err(codegen_parse_error("Math." + method)))
    return lower_math_unary_impl(arg, method)

// =============================================================================
// lower_math_binary — Math.min(a, b) → `(a as f64).method(b as f64)` (T124f)
// =============================================================================
//
// Lower a binary `Math.<method>(a, b)` call to
// `(<a> as f64).<method>(<b> as f64)`. Both args cast to `f64` because
// Rust's `f64::min` / `f64::max` take `f64` (and casting both keeps the
// lowering uniform with `Math.pow` which definitely needs both as f64).
//
// Used for: min / max (2 binary Math methods — both take two args and return
// Float).

func lower_math_binary(args: Vector<SynExpr>, method: String) -> Result<SynExpr, CodegenError>:
    // (let (a, b) = (args[0].clone(), args[1].clone());
    //  let tokens = quote! { (#a as f64).#method(#b as f64) };
    //  syn::parse2(tokens).map_err(codegen_parse_error("Math." + method)))
    return lower_math_binary_impl(args, method)

// =============================================================================
// splice_receiver_into_call — wire the receiver into a path::func(&recv, true)
// =============================================================================
//
// Take a token stream that calls a fully-qualified function with a single
// placeholder argument `__recv` and replace that placeholder with an actual
// lowered receiver expression.
//
// The `tokens` argument is expected to parse as a Rust function-call
// expression (e.g. `path::func(&__recv, true)`). We use `quote!` to splice
// the receiver in: we re-parse a small template that names `__recv` and then
// walk the resulting `ExprCall` to substitute the real receiver.
//
// This indirection is needed because `quote!` cannot easily splice into an
// arbitrary position inside a string-built token stream — we instead parse
// the template to a real `ExprCall`, then swap the first argument.

func splice_receiver_into_call(tokens: TokenStream, recv: SynExpr) -> Result<SynExpr, CodegenError>:
    // (Construct the call directly: build args = [&recv, true]; build
    //  ExprCall with func = Path(unicode_segmentation::UnicodeSegmentation::
    //  graphemes). The `tokens` argument is discarded — we rebuild from
    //  scratch to stay quote!-based.)
    return splice_receiver_into_call_impl(recv)

// =============================================================================
// Implementation shims (extern bindings to syn/quote constructors)
// =============================================================================
//
// The actual syn construction is delegated to extern "Rust" bindings.

extern "Rust" {
    fn double_to_string(d: Double) -> String
    fn string_contains(s: String, sub: String) -> Bool
    fn make_borrow_expr(inner: SynExpr) -> SynExpr
    fn buff_expr_is_string_literal(e: BuffExpr) -> Bool
    fn buff_expr_is_named_arg(e: BuffExpr) -> Bool
    fn buff_expr_named_arg_value(e: BuffExpr) -> BuffExpr
    fn make_generic_path_type_impl(name: String, args: Vector<SynType>) -> SynType
    fn make_qualified_generic_path_type_impl(name: String, args: Vector<SynType>) -> SynType
    fn method_call_one_arg_impl(recv: SynExpr, method: String, arg: SynExpr) -> SynExpr
    fn rust_call_expr_impl(path: String, args: Vector<SynExpr>) -> SynExpr
    fn str_lit_expr_impl(text: String) -> SynExpr
    fn lower_math_unary_impl(arg: SynExpr, method: String) -> Result<SynExpr, CodegenError>
    fn lower_math_binary_impl(args: Vector<SynExpr>, method: String) -> Result<SynExpr, CodegenError>
    fn splice_receiver_into_call_impl(recv: SynExpr) -> Result<SynExpr, CodegenError>
}
