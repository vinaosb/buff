// Buff self-host port of `crates/buff-lang-codegen-rust/src/rust_codegen/conv_helpers.rs` (T18, Track C).
//
// T105a — index-cast / arg-parse / typeref->Type conversion helpers
// (mechanically extracted from rust_codegen.rs).
//
// Verbatim move from the parent — no logic changes. Child module of
// rust_codegen so it inherits the parent imports via `use super::*` (zero
// per-module import lists). Functions are `pub(super)` so the parent reaches
// them through the glob below.
//
// The Rust reference is 140 LOC. The Buff port mirrors the public API
// surface (cast_to_usize, cast_to, make_int_lit_expr, make_binary_expr,
// ConvKind, parse_with_default, typeref_to_type).

// =============================================================================
// Opaque handles for syn / proc_macro2 types
// =============================================================================
//
// The codegen port threads syn AST nodes through extern bindings — the Buff
// code never inspects their interior, only threads them through the syn API.
// These struct declarations establish the handle types used in signatures.

struct SynExpr:
    opaque_handle: Int

struct SynBinOp:
    opaque_handle: Int

struct SynType:
    opaque_handle: Int

struct TypeRef:
    opaque_handle: Int

struct Type:
    opaque_handle: Int

// =============================================================================
// Forward declarations (opaque constructors consumed below)
// =============================================================================
//
// These are bound to the upstream syn/quote constructors. The full set lives
// in `syn_helpers.buff`; here we declare only the ones used by this module.

extern "Rust" {
    fn rust_path_type(name: String) -> SynType
    fn wrap_in_parens(e: SynExpr) -> SynExpr
    fn method_call_one_arg(receiver: SynExpr, method: String, arg: SynExpr) -> SynExpr
}

// =============================================================================
// cast_to_usize — `e as usize` with conditional parens (T23)
// =============================================================================
//
// Build a Rust `as usize` cast for a vector index. Unlike `cast_to`, this
// only wraps the operand in parens when it is a non-atomic expression
// (binary/unary/cast/range), so the common cases stay clean: `0 as usize`,
// `i as usize`. Compound indices like `a + b` become `(a + b) as usize` so
// the cast doesn't bind tighter than the `+`.

func cast_to_usize(e: SynExpr) -> SynExpr:
    // (matches! e { Binary | Unary | Cast | Range } → needs parens)
    let needs_parens = expr_needs_parens_for_cast(e)
    let operand = if needs_parens:
        wrap_in_parens(e)
    else:
        e
    return make_cast_expr(operand, rust_path_type("usize"))

// =============================================================================
// cast_to — generic `(e) as T`
// =============================================================================
//
// Build a Rust `as` cast: `(e) as T`. The receiver is parenthesised so
// compound expressions bind correctly (e.g. `(a + b) as f64` not `a + b as f64`).

func cast_to(e: SynExpr, target: String) -> SynExpr:
    return make_cast_expr(wrap_in_parens(e), rust_path_type(target))

// =============================================================================
// make_int_lit_expr — Rust integer-literal expression
// =============================================================================

func make_int_lit_expr(n: Int) -> SynExpr:
    // (SynExpr::Lit with Lit::Int(LitInt::new(&n.to_string(), call_site())))
    return make_int_lit_expr_impl(n)

// =============================================================================
// make_binary_expr — `lhs <op> rhs`
// =============================================================================

func make_binary_expr(op: SynBinOp, lhs: SynExpr, rhs: SynExpr) -> SynExpr:
    // (SynExpr::Binary with boxed left/op/right)
    return make_binary_expr_impl(op, lhs, rhs)

// =============================================================================
// ConvKind — discriminate numeric vs bool constructor prelude fns
// =============================================================================
//
// `Numeric` covers `Int(x)` / `Float(x)` — Rust emits `(x) as T`.
// `Bool` is separate because Rust has no `as bool` cast; the numeric→bool
// mapping is `x != 0`.

enum ConvKind {
    Numeric,
    Bool,
}

// =============================================================================
// parse_with_default — `x.parse::<T>().unwrap_or(default)`
// =============================================================================
//
// Build the expression for the string-arg branch of `Int(x)`/`Float(x)`/
// `Bool(x)`. Built via `quote!` so the turbofish `::<T>` and method chain are
// constructed without hand-formatted Rust.

func parse_with_default(arg: SynExpr, target: String, kind: ConvKind) -> SynExpr:
    // 1. Build `arg.parse::<target>()` as a method call with turbofish.
    let parse_call = make_parse_turbofish_call(arg, target)
    // 2. Pick the default literal: numerics → unsuffixed `0`, bool → `false`.
    let default_expr = match kind:
        ConvKind.Numeric:
            make_int_lit_expr(0)
        ConvKind.Bool:
            make_bool_lit_expr(false)
    // 3. `.unwrap_or(<default-lit>)` — single-arg method call on the parse.
    return method_call_one_arg(parse_call, "unwrap_or", default_expr)

// =============================================================================
// typeref_to_type — mirror of the private fn in buff_lang_types::infer
// =============================================================================
//
// Used by `RustCodegen.lower_func` to seed the TypeInferencer environment
// with function-parameter types so subsequent `let` bindings can refer to
// params and still get a useful inferred type.

func typeref_to_type(ty: TypeRef) -> Option<Type>:
    // (match ty:
    //   Named { name, .. } → match name.name.as_str() {
    //     "Int" → Some(Type::int_default())
    //     "Float" → Some(Type::float_default())
    //     "Double" → Some(Type::double())
    //     "Bool" → Some(Type::bool())
    //     "String" → Some(Type::string())
    //     "Char" → Some(Type::char())        // T21
    //     "Byte" → Some(Type::byte())
    //     "Decimal" → Some(Type::Decimal)
    //     "Void" → Some(Type::Void)
    //     _ → None
    //   }
    //   Union(members, _) → { let resolved = members.filter_map(typeref_to_type);
    //                         Some(Type::Union(resolved)) }   // T76
    //   _ → None)
    return typeref_to_type_impl(ty)

// =============================================================================
// Implementation shims (extern bindings to syn constructors)
// =============================================================================
//
// The actual syn construction is delegated to extern "Rust" bindings. The
// shapes are stable: the Buff port preserves the call sequences; the
// reference Rust implementation in `conv_helpers.rs` is the source of truth
// for what each shim does.

extern "Rust" {
    fn expr_needs_parens_for_cast(e: SynExpr) -> Bool
    fn make_cast_expr(operand: SynExpr, ty: SynType) -> SynExpr
    fn make_int_lit_expr_impl(n: Int) -> SynExpr
    fn make_bool_lit_expr(b: Bool) -> SynExpr
    fn make_binary_expr_impl(op: SynBinOp, lhs: SynExpr, rhs: SynExpr) -> SynExpr
    fn make_parse_turbofish_call(receiver: SynExpr, target: String) -> SynExpr
    fn typeref_to_type_impl(ty: TypeRef) -> Option<Type>
}
