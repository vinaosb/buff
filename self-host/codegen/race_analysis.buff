// Buff self-host port of `crates/buff-lang-codegen-rust/src/race_analysis.rs` (T18, Track C).
//
// Race detection for parallel closures (T41).
//
// Buff v1.0 introduces parallel combinators (`par_map`, `par_filter`,
// `par_reduce`) whose closures execute concurrently across multiple threads
// (backed by rayon inside `buff_lang_runtime::CpuDispatcher`). A closure
// that **mutates** a variable captured from the enclosing scope would race
// with itself across the worker threads — undefined behaviour at runtime.
// T41 is the **static detection** pass that rejects such programs at compile
// time.
//
// # Scope (T41 detect-only)
//
// This pass **detects and rejects** mutable capture in parallel closures. It
// does NOT transform racy code into atomics — that is T42's job (`AtomicI64`
// auto-insertion for `par_reduce` accumulators). For T41, every mutable
// capture in a parallel closure is a hard `ParallelMutabilityError`.
//
// # Rule
//
// For every closure passed as an argument to a parallel combinator
// (`par_map` / `par_filter` / `par_reduce`), the pass walks the closure body
// (recursing into nested closures) looking for any `Stmt::Assignment` whose
// target is a bare `Expr::Ident` naming a variable captured from the
// enclosing scope. If found, the pass returns an error.
//
// What counts as a CAPTURE (race-prone) vs a LOCAL (always-fine):
// - **Closure parameters** (`x` in `{ x => ... }`) — local, mutating is fine.
// - **`let` bindings INSIDE the closure body** — local, mutating is fine.
// - **Variables read or written inside the closure that are NOT bound by a
//   param or an inner `let`** — captured from the enclosing scope. Mutating
//   these in a parallel closure is a race.
//
// Immutable reads of captured variables are always fine.
//
// # What's NOT parallel
//
// Plain `.map` / `.filter` / `.reduce` (without the `par_` prefix) are
// **sequential** in Buff v1.0 codegen — they lower to
// `recv.into_iter().map(...).collect::<Vec<_>>()` (single-threaded). Mutating
// captures there is fine (no race); Rust's borrow checker would also permit
// it. The race detector ONLY flags calls to the `par_*` combinators.
//
// The Rust reference is 858 LOC. The Buff port mirrors the public API
// surface (ParallelMutabilityError, PARALLEL_COMBINATORS, is_assignment_op,
// analyze, analyze_with_exemptions).

// =============================================================================
// PARALLEL_COMBINATORS — method names that dispatch closures across workers
// =============================================================================
//
// Today this is the `par_*` family added by T39 on
// `buff_lang_runtime::CpuDispatcher`.
//
// **NOT in this set**: the plain `.map` / `.filter` / `.reduce` combinators
// — those lower to sequential `into_iter().map(...)` and are NOT races.
//
// Buff has no module-level `const`: expose the list via a function.

func parallel_combinators() -> Vector<String>:
    let out = Vector.new()
    out.push("par_map")
    out.push("par_filter")
    out.push("par_reduce")
    return out

// =============================================================================
// ParallelMutabilityError — data-race-via-mutable-capture error
// =============================================================================
//
// Carries the offending variable name and the span of the assignment site
// (so a rendered diagnostic can point at the exact line). The span is the
// `Stmt::Assignment::span`, NOT the closure span or the parallel-combinator
// call span — pointing at the mutation site is the most actionable for the
// user.

struct ParallelMutabilityError:
    // The captured variable name being mutated.
    variable: String
    // The span of the offending assignment statement.
    span: Span

// Construct a new error pointing at `span` (the mutation site).
func parallel_mutability_error_new(variable: String, span: Span) -> ParallelMutabilityError:
    return ParallelMutabilityError.new(variable: variable, span: span)

// The captured variable name being mutated.
func parallel_mutability_error_variable(err: ParallelMutabilityError) -> String:
    return err.variable

// The span of the offending assignment statement.
func parallel_mutability_error_span(err: ParallelMutabilityError) -> Span:
    return err.span

// =============================================================================
// into_diagnostic — build the user-facing Diagnostic
// =============================================================================
//
// Format: `ParallelMutability: cannot mutate captured variable `<name>`
// inside a parallel closure (data race)`.
//
// We use a stable, prefix-tagged message (NOT a Display impl on
// ParallelMutabilityError) so a downstream test harness that only has the
// CodegenError in hand can still detect the variant via substring match —
// CodegenError is a struct wrapping a single Diagnostic, not an enum, so
// there's no natural `kind()` discriminant without changing the upstream
// crate.

func parallel_mutability_error_into_diagnostic(err: ParallelMutabilityError) -> Diagnostic:
    let msg = "ParallelMutability: cannot mutate captured variable `" + err.variable + "` inside a parallel closure (data race)"
    let d = diagnostic_error(msg, err.span)
    d = diagnostic_with_note(d, "parallel closures (par_map/par_filter/par_reduce) run on multiple worker threads; mutating a captured variable races across workers")
    d = diagnostic_with_note(d, "hint: make the capture immutable, or use a local accumulator (a future task will auto-insert atomics for some patterns)")
    return d

// =============================================================================
// is_assignment_op — predicate: does this BinaryOp perform a write?
// =============================================================================
//
// `true` iff `op` performs a write to its LHS target.
//
// Covers both the plain assignment (`=`) and the five compound assignments
// (`+=`, `-=`, `*=`, `/=`, `%=`). Bitwise compound assignments (`<<=`,
// `>>=`, `&=`, `|=`, `^=`) are NOT in Buff's `BinaryOp` (see
// `crates/buff-lang-ast/src/op.rs`), so they're not listed here.

func is_assignment_op(op: BinaryOp) -> Bool:
    let kind = binary_op_kind(op)
    return kind == binary_op_kind_assign()
        or kind == binary_op_kind_add_assign()
        or kind == binary_op_kind_sub_assign()
        or kind == binary_op_kind_mul_assign()
        or kind == binary_op_kind_div_assign()
        or kind == binary_op_kind_mod_assign()

// =============================================================================
// analyze — top-level entry: walk Decls, return first detected race
// =============================================================================
//
// 1. Walk the entire program looking for `Expr::MethodCall` whose
//    `method.name` is in `PARALLEL_COMBINATORS`.
// 2. For each such call, for each `Expr::Lambda` argument, compute the
//    captured-variable set via `closure_captures` (a deterministic
//    `BTreeSet<String>`).
// 3. Walk the lambda body (recursing into nested closures, control flow,
//    and expressions) collecting every `Stmt::Assignment` whose `op` is an
//    assignment operator (`is_assignment_op`) and whose target is a bare
//    `Ident` whose name is in the captures set.
// 4. If any such mutation is found, return the first as a
//    `ParallelMutabilityError`.

func analyze(decls: Vector<Decl>) -> Result<None_, ParallelMutabilityError>:
    // (The recursive walker is in the Rust reference lines 200-700. The
    //  Buff port preserves the source-order walk + first-mutation-return
    //  semantics; the per-arm recursion is delegated to the extern shim.)
    return analyze_impl(decls, btreetap_string_new())

// =============================================================================
// analyze_with_exemptions — T42 hook: exempt atomics from race detection
// =============================================================================
//
// Same as `analyze`, but skips mutation sites whose variable is in the
// `exemptions` set. Consumed by `atomic_analysis` so an `AtomicI64`
// accumulator (already known to be race-free via atomic ops) does not trigger
// a `ParallelMutabilityError`.

func analyze_with_exemptions(decls: Vector<Decl>, exemptions: BTreeSet_String) -> Result<None_, ParallelMutabilityError>:
    return analyze_impl(decls, exemptions)

// =============================================================================
// Forward declarations + implementation shims
// =============================================================================

struct Decl:
    opaque_handle: Int

struct FuncDecl:
    opaque_handle: Int

struct Block:
    opaque_handle: Int

struct Stmt:
    opaque_handle: Int

struct Expr:
    opaque_handle: Int

struct Span:
    opaque_handle: Int

struct Diagnostic:
    opaque_handle: Int

struct BinaryOp:
    opaque_handle: Int

struct BTreeSet_String:
    opaque_handle: Int

struct None_:
    opaque_handle: Int

extern "Rust" {
    fn closure_captures(lambda: Expr) -> BTreeSet_String
    fn btreetap_string_new() -> BTreeSet_String
    fn btreetap_string_contains(set: BTreeSet_String, s: String) -> Bool
    fn binary_op_kind(op: BinaryOp) -> Int
    fn diagnostic_error(msg: String, span: Span) -> Diagnostic
    fn diagnostic_with_note(d: Diagnostic, note: String) -> Diagnostic
    fn analyze_impl(decls: Vector<Decl>, exemptions: BTreeSet_String) -> Result<None_, ParallelMutabilityError>
}

// Variant tags for BinaryOp (must match the Rust enum's discriminant order).
func binary_op_kind_assign() -> Int:
    return 0

func binary_op_kind_add_assign() -> Int:
    return 1

func binary_op_kind_sub_assign() -> Int:
    return 2

func binary_op_kind_mul_assign() -> Int:
    return 3

func binary_op_kind_div_assign() -> Int:
    return 4

func binary_op_kind_mod_assign() -> Int:
    return 5
