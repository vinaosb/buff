// =============================================================================
// Lookup
// =============================================================================

// Look up a prelude instance method by the (receiver type, method) pair.
//
// Returns Option.None when the combination is not a recognised prelude
// instance-method call (e.g. calling `.year()` on a String is invalid).
// The receiver type is the resolved Type of the value the method is
// called on (Type.Regex, Type.Url, ...). The Rust reference consults
// `instance_fn_return_type(recv, c, args)` to validate the (type, fn)
// pair — that matcher lives in prelude_return_types.buff.
func instance_fn_lookup(method: String, recv: Type) -> Option<PreludeInstanceFn>:
    let all = instance_fn_all()
    let mut i = 0
    for i < all.len():
        let c = all.get(i)
        if instance_fn_name(c) == method:
            // Validate via return-type matcher (None means invalid combo).
            let rt = instance_fn_return_type(c, recv, Vector.new())
            if rt != type_unknown():
                return Option.Some(c)
        i = i + 1
    return Option.None

// All recognised instance-method variants. Same shape as `assoc_fn_all()`
// in the sibling file. The full Rust reference enumerates every variant in
// a static slice; here we build the Vector at call time.
func instance_fn_all() -> Vector<PreludeInstanceFn>:
    let out = Vector.new()
    // DateTime family
    out.push(PreludeInstanceFn.Year)
    out.push(PreludeInstanceFn.Month)
    out.push(PreludeInstanceFn.Day)
    out.push(PreludeInstanceFn.Hour)
    out.push(PreludeInstanceFn.Minute)
    out.push(PreludeInstanceFn.Second)
    out.push(PreludeInstanceFn.Add)
    out.push(PreludeInstanceFn.Sub)
    out.push(PreludeInstanceFn.Elapsed)
    out.push(PreludeInstanceFn.ToIsoString)
    out.push(PreludeInstanceFn.FromIsoString)
    // Regex
    out.push(PreludeInstanceFn.Match)
    out.push(PreludeInstanceFn.Find)
    out.push(PreludeInstanceFn.Replace)
    out.push(PreludeInstanceFn.Captures)
    out.push(PreludeInstanceFn.IsMatch)
    // URL
    out.push(PreludeInstanceFn.Scheme)
    out.push(PreludeInstanceFn.Host)
    out.push(PreludeInstanceFn.Path_)
    out.push(PreludeInstanceFn.Query)
    out.push(PreludeInstanceFn.Port)
    out.push(PreludeInstanceFn.Username)
    out.push(PreludeInstanceFn.Password)
    // Path
    out.push(PreludeInstanceFn.Parent)
    out.push(PreludeInstanceFn.Extension)
    out.push(PreludeInstanceFn.Basename)
    out.push(PreludeInstanceFn.Exists_)
    out.push(PreludeInstanceFn.IsFile)
    out.push(PreludeInstanceFn.IsDir)
    out.push(PreludeInstanceFn.Join)
    // Process
    out.push(PreludeInstanceFn.Wait)
    out.push(PreludeInstanceFn.Pid)
    out.push(PreludeInstanceFn.Kill)
    // Networking
    out.push(PreludeInstanceFn.Send)
    out.push(PreludeInstanceFn.Recv)
    out.push(PreludeInstanceFn.Close)
    out.push(PreludeInstanceFn.SendTo)
    out.push(PreludeInstanceFn.RecvFrom)
    // Channel
    out.push(PreludeInstanceFn.TryRecv)
    out.push(PreludeInstanceFn.TrySend)
    // Data / media
    out.push(PreludeInstanceFn.Head)
    out.push(PreludeInstanceFn.Tail)
    out.push(PreludeInstanceFn.Save)
    out.push(PreludeInstanceFn.Open)
    out.push(PreludeInstanceFn.Resize)
    out.push(PreludeInstanceFn.At)
    out.push(PreludeInstanceFn.Put_)
    // ECS
    out.push(PreludeInstanceFn.Spawn_)
    out.push(PreludeInstanceFn.Insert)
    out.push(PreludeInstanceFn.Get_)
    out.push(PreludeInstanceFn.Remove_)
    out.push(PreludeInstanceFn.Despawn)
    // Reactive
    out.push(PreludeInstanceFn.Update)
    out.push(PreludeInstanceFn.Dispose)
    out.push(PreludeInstanceFn.Get_Value)
    // HTTP / validate / email
    out.push(PreludeInstanceFn.Get_Method)
    out.push(PreludeInstanceFn.Post)
    out.push(PreludeInstanceFn.Put_)
    out.push(PreludeInstanceFn.Delete)
    out.push(PreludeInstanceFn.Body)
    out.push(PreludeInstanceFn.Headers)
    out.push(PreludeInstanceFn.Validate_)
    out.push(PreludeInstanceFn.Send_)
    // Scrape
    out.push(PreludeInstanceFn.Select)
    out.push(PreludeInstanceFn.FindAll)
    out.push(PreludeInstanceFn.Text_)
    out.push(PreludeInstanceFn.Attr)
    // Xml
    out.push(PreludeInstanceFn.Root)
    out.push(PreludeInstanceFn.Find)
    // Geo
    out.push(PreludeInstanceFn.Distance)
    out.push(PreludeInstanceFn.Area)
    out.push(PreludeInstanceFn.Centroid)
    // Chat
    out.push(PreludeInstanceFn.Command)
    out.push(PreludeInstanceFn.Start)
    out.push(PreludeInstanceFn.Author)
    out.push(PreludeInstanceFn.Reply)
    // Web3
    out.push(PreludeInstanceFn.ChainId)
    out.push(PreludeInstanceFn.BlockNumber)
    out.push(PreludeInstanceFn.GetBalance)
    out.push(PreludeInstanceFn.Address)
    out.push(PreludeInstanceFn.Connect_)
    out.push(PreludeInstanceFn.SignMessage)
    out.push(PreludeInstanceFn.Method)
    out.push(PreludeInstanceFn.Call_)
    out.push(PreludeInstanceFn.Send_Transaction)
    // Crypto
    out.push(PreludeInstanceFn.PublicPem)
    out.push(PreludeInstanceFn.PrivatePem)
    // Actors
    out.push(PreludeInstanceFn.Tell)
    out.push(PreludeInstanceFn.Stop)
    out.push(PreludeInstanceFn.Alive)
    out.push(PreludeInstanceFn.Call_)
    // Collection + String
    out.push(PreludeInstanceFn.Push)
    out.push(PreludeInstanceFn.Pop)
    out.push(PreludeInstanceFn.Len)
    out.push(PreludeInstanceFn.Get_At)
    out.push(PreludeInstanceFn.Insert_)
    out.push(PreludeInstanceFn.Remove_At)
    out.push(PreludeInstanceFn.Contains_)
    out.push(PreludeInstanceFn.Sort)
    out.push(PreludeInstanceFn.Reverse)
    out.push(PreludeInstanceFn.Index)
    out.push(PreludeInstanceFn.IndexOf)
    out.push(PreludeInstanceFn.IsEmpty)
    out.push(PreludeInstanceFn.Clear)
    out.push(PreludeInstanceFn.ToVector)
    out.push(PreludeInstanceFn.Keys)
    out.push(PreludeInstanceFn.Values)
    out.push(PreludeInstanceFn.ToStr)
    out.push(PreludeInstanceFn.AsStr)
    out.push(PreludeInstanceFn.AsInt)
    out.push(PreludeInstanceFn.AsFloat)
    out.push(PreludeInstanceFn.AsBool)
    out.push(PreludeInstanceFn.StartsWith_)
    out.push(PreludeInstanceFn.EndsWith)
    out.push(PreludeInstanceFn.Substring)
    out.push(PreludeInstanceFn.SplitBy)
    out.push(PreludeInstanceFn.TrimLeft)
    out.push(PreludeInstanceFn.TrimRight)
    out.push(PreludeInstanceFn.ToLower)
    out.push(PreludeInstanceFn.ToUpper)
    out.push(PreludeInstanceFn.Add_)
    out.push(PreludeInstanceFn.Mul)
    out.push(PreludeInstanceFn.ToDecimal)
    return out
