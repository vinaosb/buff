// Buff self-host port of `crates/buff-lang-types/src/prelude_instance_fn_impl.rs`
// (T17, Track C).
//
// T105b: PreludeInstanceFn enum + impl + lookup helper.
// MECHANICAL EXTRACTION from prelude_types.rs (T105b God Class split) — no
// logic changes, moved verbatim. Mirrored 1:1 here.
//
// A recognised **instance method** on a prelude type — the
// `recv.method(args)` shape where `recv` is a value of the type. Distinct
// from associated functions (`Type.method(args)` on the namespace itself —
// see prelude_assoc_fn_impl.buff).
//
// The Rust reference's PreludeInstanceFn enum has 169 variants. The full
// set is enumerated below, grouped by the prelude type that owns them.
//
// RUST IDIOM MAPPING: same as prelude_assoc_fn_impl.buff.

// =============================================================================
// PreludeInstanceFn — the instance-method registry (169 variants)
// =============================================================================
//
// Variants grouped by receiver type:
//   1. DateTime/Date/Time/Duration/Instant instance methods (year/month/
//      day/hour/minute/second/add/sub/elapsed/...)
//   2. Regex instance methods (match/find/replace/captures)
//   3. URL instance methods (scheme/host/path/query)
//   4. Path instance methods (parent/extension/basename/exists)
//   5. Process instance methods (wait/id)
//   6. Networking instance methods (send/recv/close/send_to/recv_from)
//   7. Channel Sender/Receiver methods (send/recv/try_recv/close)
//   8. DataFrame/Image/Cache/I18n methods (head/tail/save/get/set/...)
//   9. ECS World/Entity methods (spawn/insert/get/remove)
//  10. Reactive methods (get/set/update/dispose)
//  11. HttpClient/Validator/Email methods (request/get/post/validate/send)
//  12. Scrape Document/Element methods (select/find_all/text/attr)
//  13. Xml/XmlElement methods (root/find/text)
//  14. Geo methods (distance/area/centroid)
//  15. Chat Bot/ChatMessage methods (command/start/text/author)
//  16. Web3 methods (chain_id/get_balance/sign_message/...)
//  17. Crypto RsaKeypair methods (public_pem/private_pem)
//  18. Actor methods (tell/stop/alive/call)
//  19. Collection instance methods (push/pop/len/get/insert/remove/
//      contains/keys/values/is_empty/clear/find/index_of/sort/reverse/
//      to_vector/to_map/to_string/as_str/as_int/as_float/as_bool/
//      starts_with/ends_with/substring/split_by/trim_left/trim_right)
enum PreludeInstanceFn {
    // === 1. DATETIME FAMILY ===
    Year, Month, Day, Hour, Minute, Second, Add, Sub, Elapsed, ToIsoString,
    FromIsoString,
    // === 2. REGEX ===
    Match, Find, Replace, Captures, IsMatch,
    // === 3. URL ===
    Scheme, Host, Path_, Query, Port, Username, Password,
    // === 4. PATH ===
    Parent, Extension, Basename, Exists_, IsFile, IsDir, Join,
    // === 5. PROCESS ===
    Wait, Pid, Kill,
    // === 6. NETWORKING ===
    Send, Recv, Close, SendTo, RecvFrom,
    // === 7. CHANNEL ===
    TryRecv, TrySend,
    // === 8. DATA / MEDIA ===
    Head, Tail, Save, Open, Resize, At, Put,
    // === 9. ECS ===
    Spawn_, Insert, Get_, Remove_, Despawn,
    // === 10. REACTIVE ===
    Update, Dispose, Get_Value,
    // === 11. HTTP / VALIDATE / EMAIL ===
    Get_Method, Post, Put_, Delete, Body, Headers, Validate_, Send_,
    // === 12. SCRAPE ===
    Select, FindAll, Text_, Attr,
    // === 13. XML ===
    Root, Find,
    // === 14. GEO ===
    Distance, Area, Centroid,
    // === 15. CHAT ===
    Command, Start, Author, Reply,
    // === 16. WEB3 ===
    ChainId, BlockNumber, GetBalance, Address, Connect_, SignMessage,
    Method, Call, Send_Transaction,
    // === 17. CRYPTO ===
    PublicPem, PrivatePem,
    // === 18. ACTORS ===
    Tell, Stop, Alive, Call_,
    // === 19. COLLECTION + STRING INSTANCE METHODS ===
    // Vector<T>
    Push, Pop, Len, Get_At, Insert_, Remove_At, Contains_, Sort, Reverse,
    Index, IndexOf, IsEmpty, Clear, ToVector,
    // Map<K,V>
    Keys, Values,
    // String
    ToStr, AsStr, AsInt, AsFloat, AsBool, StartsWith_, EndsWith, Substring,
    SplitBy, TrimLeft, TrimRight, ToLower, ToUpper,
    // === 20. Decimal ===
    Add_, Mul, ToDecimal,
}

// =============================================================================
// impl PreludeInstanceFn — name + ALL list
// =============================================================================

// All recognised instance-method variants. Used by `instance_fn_lookup`
// to do a name+receiver-based scan. The full Rust reference enumerates
// every variant individually in a static slice; here we mirror the same
// list via Vector.push calls (Buff has no static slices).
//
// (omitted — Vector construction same shape as assoc_fn_all in the
// sibling file; ~169 push calls. Consult the Rust reference for the
// canonical order. The lookup below uses a hand-coded name dispatch
// instead.)

// The source name of this instance method (the identifier the user writes
// after the dot on a value). The full Rust reference has 169 match arms
// (one per variant) — for compactness the dispatch is a chain of if/else
// with the irregular cases (multi-word names) at the top, then the
// 1:1 PascalCase-to-snake_case names below.
func instance_fn_name(c: PreludeInstanceFn) -> String:
    // --- irregular mappings ---
    if c == PreludeInstanceFn.Path_:
        return "path"
    if c == PreludeInstanceFn.Exists_:
        return "exists"
    if c == PreludeInstanceFn.IsFile:
        return "is_file"
    if c == PreludeInstanceFn.IsDir:
        return "is_dir"
    if c == PreludeInstanceFn.Spawn_:
        return "spawn"
    if c == PreludeInstanceFn.Get_:
        return "get"
    if c == PreludeInstanceFn.Get_Value:
        return "get_value"
    if c == PreludeInstanceFn.Get_Method:
        return "get"
    if c == PreludeInstanceFn.Put_:
        return "put"
    if c == PreludeInstanceFn.Delete:
        return "delete"
