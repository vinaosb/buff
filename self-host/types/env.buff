// Buff self-host port of `crates/buff-lang-types/src/env.rs` (T17, Track C).
//
// Symbol table mapping variable names to their inferred Type. A flat type
// environment: a map from variable name to its Type.
//
// v0.1 uses a single flat scope. Lexical scoping / shadowing semantics are
// layered on top in a later task (deferred per the Rust reference comments).
//
// RUST IDIOM MAPPING:
//   pub struct TypeEnv { bindings: HashMap<String, Type> }
//     -> struct TypeEnv: bindings: Map<String, Type>
//   impl TypeEnv { pub fn new() }       -> func type_env_new() -> TypeEnv
//   pub fn insert(&mut self, name, ty)  -> func type_env_insert(env, name, ty)
//                                          (Buff hides &mut; pass-by-reference
//                                          is automatic for struct values
//                                          captured by free fn — mutation
//                                          reflects in caller)
//   pub fn lookup(&self, name) -> Option<&Type>
//                                       -> func type_env_lookup(env, name) -> Option<Type>
//   pub fn remove(&mut self, name)      -> func type_env_remove(env, name)
//   pub fn is_empty(&self) -> bool      -> func type_env_is_empty(env) -> Bool

// A flat type environment: a Map from variable name to its Type. The
// `bindings` field is exposed (Buff has no `pub(crate)` visibility) so the
// inferencer can iterate when needed; direct mutation should go through the
// helpers below.
struct TypeEnv:
    bindings: Map<String, Type>

// Create an empty type environment.
func type_env_new() -> TypeEnv:
    return TypeEnv.new(bindings: Map.new())

// Bind (or re-bind) `name` to `ty`. A subsequent `type_env_lookup(name)`
// returns the new type.
func type_env_insert(env: TypeEnv, name: String, ty: Type):
    env.bindings.set(name, ty)

// Returns the type bound to `name`, if any. Option.None when no binding.
func type_env_lookup(env: TypeEnv, name: String) -> Option<Type>:
    return env.bindings.get(name)

// Removes the binding for `name`, if present. No-op when the name is not
// bound.
func type_env_remove(env: TypeEnv, name: String):
    env.bindings.remove(name)

// Returns true if the environment contains no bindings.
func type_env_is_empty(env: TypeEnv) -> Bool:
    return env.bindings.size() == 0
