    // UUID
    out.push(PreludeAssocFn.V4)
    out.push(PreludeAssocFn.V7)
    // Filesystem
    out.push(PreludeAssocFn.Create)
    out.push(PreludeAssocFn.Remove)
    out.push(PreludeAssocFn.Walk)
    out.push(PreludeAssocFn.Dir)
    // Hash / HMAC
    out.push(PreludeAssocFn.Sha256)
    out.push(PreludeAssocFn.Sha512)
    out.push(PreludeAssocFn.Md5)
    // OS / Process
    out.push(PreludeAssocFn.Spawn)
    out.push(PreludeAssocFn.Exit)
    out.push(PreludeAssocFn.Name)
    out.push(PreludeAssocFn.Arch)
    out.push(PreludeAssocFn.Hostname)
    out.push(PreludeAssocFn.Cpus)
    // Networking
    out.push(PreludeAssocFn.Connect)
    out.push(PreludeAssocFn.Bind)
    // Channel
    out.push(PreludeAssocFn.New)
    // Data / media
    out.push(PreludeAssocFn.FromFloat)
    out.push(PreludeAssocFn.Zeros)
    out.push(PreludeAssocFn.Ones)
    out.push(PreludeAssocFn.FromVec)
    out.push(PreludeAssocFn.Filled)
    out.push(PreludeAssocFn.FromCsv)
    out.push(PreludeAssocFn.FromJson)
    out.push(PreludeAssocFn.FromPath)
    out.push(PreludeAssocFn.FromBytes)
    out.push(PreludeAssocFn.WithLocale)
    out.push(PreludeAssocFn.WithSeed)
    out.push(PreludeAssocFn.FromSamples)
    out.push(PreludeAssocFn.Hann)
    out.push(PreludeAssocFn.Hamming)
