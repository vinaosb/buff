    out.push(PreludeAssocFn.Tokenize)
    out.push(PreludeAssocFn.Sentences)
    // I18n
    out.push(PreludeAssocFn.WithFallback)
    // Scrape / Markup
    out.push(PreludeAssocFn.FromHtml)
    out.push(PreludeAssocFn.FromStr)
    out.push(PreludeAssocFn.Serialize)
    out.push(PreludeAssocFn.Deserialize)
    out.push(PreludeAssocFn.Roundtrip)
    // Geo
    out.push(PreludeAssocFn.FromCoords)
    // Crypto-2
    out.push(PreludeAssocFn.FromPrivateKey)
    out.push(PreludeAssocFn.GenerateKey)
    out.push(PreludeAssocFn.GenerateNonce)
    out.push(PreludeAssocFn.Encrypt)
    out.push(PreludeAssocFn.Decrypt)
    out.push(PreludeAssocFn.GenerateKeypair)
    out.push(PreludeAssocFn.GeneratePrivate)
    out.push(PreludeAssocFn.PublicFromPrivate)
    out.push(PreludeAssocFn.DeriveShared)
    out.push(PreludeAssocFn.GenerateSalt)
    out.push(PreludeAssocFn.DeriveKey)
    // SIMD
    out.push(PreludeAssocFn.Splat)
    out.push(PreludeAssocFn.FromSlice)
    out.push(PreludeAssocFn.FromArray)
    // File / Http / Assert
    out.push(PreludeAssocFn.Read)
    out.push(PreludeAssocFn.Write)
    out.push(PreludeAssocFn.Exists)
    out.push(PreludeAssocFn.Append)
    out.push(PreludeAssocFn.HttpGet)
    out.push(PreludeAssocFn.HttpPost)
    out.push(PreludeAssocFn.AssertEqual)
    out.push(PreludeAssocFn.AssertNotEqual)
    out.push(PreludeAssocFn.AssertTrue)
    out.push(PreludeAssocFn.AssertFalse)
    out.push(PreludeAssocFn.AssertContains)
    return out

// The source name of this associated function (the identifier the user
// writes after the dot). The full Rust reference has 141 match arms (one
// per variant) — for compactness the dispatch is grouped: variant-name to
// lowercase first token, with hyphenation handled inline.
//
// NOTE: most variants map 1:1 to their snake_case source name (with the
// initial capital lowercased). A few need rewriting (e.g. ToUppercase ->
// "to_uppercase", Sha256 -> "sha256", V4 -> "v4", HttpGet -> "http_get").
// The full mapping is one arm per variant in the Rust reference; here we
// implement the same dispatch as a chain of if/else for the irregular
// cases plus a default that lowercases the first letter.
func assoc_fn_name(c: PreludeAssocFn) -> String:
    // --- irregular mappings (capitalisation / abbreviation expansion) ---
    if c == PreludeAssocFn.ToUppercase:
        return "to_uppercase"
    if c == PreludeAssocFn.ToLowercase:
        return "to_lowercase"
    if c == PreludeAssocFn.StartsWith:
        return "starts_with"
    if c == PreludeAssocFn.FromVec:
        return "from_vec"
    if c == PreludeAssocFn.FromCsv:
        return "from_csv"
    if c == PreludeAssocFn.FromJson:
        return "from_json"
    if c == PreludeAssocFn.FromPath:
        return "from_path"
    if c == PreludeAssocFn.FromBytes:
        return "from_bytes"
    if c == PreludeAssocFn.FromFloat:
        return "from_float"
    if c == PreludeAssocFn.FromHtml:
        return "from_html"
    if c == PreludeAssocFn.FromStr:
        return "from_str"
    if c == PreludeAssocFn.FromCoords:
        return "from_coords"
    if c == PreludeAssocFn.FromPrivateKey:
        return "from_private_key"
    if c == PreludeAssocFn.FromSlice:
        return "from_slice"
    if c == PreludeAssocFn.FromArray:
        return "from_array"
    if c == PreludeAssocFn.FromSamples:
        return "from_samples"
    if c == PreludeAssocFn.WithLocale:
        return "with_locale"
    if c == PreludeAssocFn.WithSeed:
        return "with_seed"
    if c == PreludeAssocFn.WithFallback:
        return "with_fallback"
    if c == PreludeAssocFn.LoadFile:
