    if c == PreludeAssocFn.AuthorizationUrl:
        return "authorization_url"
    if c == PreludeAssocFn.ExchangeCode:
        return "exchange_code"
    if c == PreludeAssocFn.DetectLanguage:
        return "detect_language"
    if c == PreludeAssocFn.HttpGet:
        return "http_get"
    if c == PreludeAssocFn.HttpPost:
        return "http_post"
    if c == PreludeAssocFn.AssertEqual:
        return "assert_equal"
    if c == PreludeAssocFn.AssertNotEqual:
        return "assert_not_equal"
    if c == PreludeAssocFn.AssertTrue:
        return "assert_true"
    if c == PreludeAssocFn.AssertFalse:
        return "assert_false"
    if c == PreludeAssocFn.AssertContains:
        return "assert_contains"
    if c == PreludeAssocFn.CompressDir:
        return "compress_dir"
    if c == PreludeAssocFn.Sha256:
        return "sha256"
    if c == PreludeAssocFn.Sha512:
        return "sha512"
    // --- regular 1:1 mappings (PascalCase name == source name) ---
    // The remaining ~85 variants map 1:1 (Now -> "now", Today -> "today",
    // Parse -> "parse", Format -> "format", Days -> "days", ..., Read ->
    // "read", Write -> "write", Exists -> "exists", Append -> "append",
    // Splat -> "splat", ...). Each is a single-line match arm in the Rust
    // reference; here a chain of if/else covers the same set.
    if c == PreludeAssocFn.Now:
        return "now"
    if c == PreludeAssocFn.Today:
        return "today"
    if c == PreludeAssocFn.Parse:
        return "parse"
