    if c == PreludeAssocFn.Enforce:
        return "enforce"
    if c == PreludeAssocFn.Stem:
        return "stem"
    if c == PreludeAssocFn.Tokenize:
        return "tokenize"
    if c == PreludeAssocFn.Sentences:
        return "sentences"
    if c == PreludeAssocFn.Serialize:
        return "serialize"
    if c == PreludeAssocFn.Deserialize:
        return "deserialize"
    if c == PreludeAssocFn.Roundtrip:
        return "roundtrip"
    if c == PreludeAssocFn.Encrypt:
        return "encrypt"
    if c == PreludeAssocFn.Decrypt:
        return "decrypt"
    if c == PreludeAssocFn.Splat:
        return "splat"
    if c == PreludeAssocFn.Read:
        return "read"
    if c == PreludeAssocFn.Write:
        return "write"
    if c == PreludeAssocFn.Exists:
        return "exists"
    if c == PreludeAssocFn.Append:
        return "append"
    return "<unknown>"

// =============================================================================
// Lookup
// =============================================================================

// Look up a prelude associated function by the (type, method) pair.
//
// Returns Option.None when the combination is not a recognised prelude
// associated-function call (e.g. `DateTime.sha256()` is invalid — DateTime
// has no sha256 method). This is the function the type inferencer + codegen
// consult to decide whether a `Type.method(args)` AST node is a prelude
// associated-function call.
//
// The Rust reference validates the (type, fn) pair against the
// `assoc_fn_return_type` match (a None return means invalid). The full
// return-type match lives in prelude_return_types.buff; this lookup returns
// Option.None when that match returns None.
func assoc_fn_lookup(type_name: String, method: String) -> Option<PreludeAssocFn>:
    let t = prelude_type_lookup(type_name)
    if t == Option.None:
        return Option.None
    let pt = unwrap_prelude_type(t)
    let all = assoc_fn_all()
    let mut i = 0
    for i < all.len():
        let c = all.get(i)
        if assoc_fn_name(c) == method:
            // Validate the (type, fn) pair is recognised by consulting the
            // return-type matcher (None means invalid combination).
            let rt = assoc_fn_return_type(pt, c, Vector.new())
            if rt != type_unknown():
                return Option.Some(c)
        i = i + 1
    return Option.None

// Unwrap helper — see prelude_assoc_const_impl.buff for the same shape.
func unwrap_prelude_type(opt: Option<PreludeType>) -> PreludeType:
    return match opt {
        Some(t) => t,
        None => PreludeType.DateTime,
    }
