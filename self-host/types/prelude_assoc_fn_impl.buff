// Buff self-host port of `crates/buff-lang-types/src/prelude_assoc_fn_impl.rs`
// (T17, Track C).
//
// T105b: PreludeAssocFn enum + impl + lookup helper.
// MECHANICAL EXTRACTION from prelude_types.rs (T105b God Class split) — no
// logic changes, moved verbatim. Mirrored 1:1 here.
//
// A recognised **associated function** on a prelude type — the
// `Type.method(args)` shape. Distinct from associated CONSTANTS
// (`Type.NAME` without parens — see prelude_assoc_const_impl.buff) and
// instance methods (`recv.method(args)` on a value of the type — see
// prelude_instance_fn_impl.buff).
//
// The Rust reference's PreludeAssocFn enum has 141 variants. The full set
// is enumerated below, grouped by category. The impl block has two methods:
//   - `name()` — the source identifier (DateTime.now -> "now")
//   - `ALL`    — the full variant list
// Plus one free function:
//   - `assoc_fn_lookup(type_name, method)` — returns the matching variant
//     or Option.None
//
// RUST IDIOM MAPPING:
//   pub enum PreludeAssocFn { ... } -> enum PreludeAssocFn { ... }
//   pub const ALL &[...]            -> func assoc_fn_all() -> Vector<PreludeAssocFn>
//   pub fn name(self)               -> func assoc_fn_name(c) -> String
//   pub fn assoc_fn_lookup(..)      -> func assoc_fn_lookup(..)

// =============================================================================
// PreludeAssocFn — the associated-function registry (141 variants)
// =============================================================================
//
// Variants are grouped by the prelude type that owns them:
//   1. DateTime / Date / Time family (Now / Today / Parse / Format)
//   2. Duration constructors (Days / Hours / Minutes / Seconds / Millis)
//   3. Log namespace (Debug / Info / Warn / Error)
//   4. Regex (Compile)
//   5. Toml / Yaml / Json / Csv (Stringify / Parse variants)
//   6. Math (Sqrt / Sin / Cos / Tan / Abs / Floor / Ceil / Round / Pow /
//      Min / Max / Int / Float)
//   7. Random (Choice / Shuffle)
//   8. Strings (Split / Join / Trim / Replace / Contains / StartsWith /
//      ToUppercase / ToLowercase)
//   9. Args / Env (List / Get / Set / Has / Load)
//  10. Base64 / Hex / URLEncode (Encode / Decode)
//  11. UUID (V4 / V7)
//  12. Path / Dir / Tempfile (Create / Remove / Walk / Dir)
//  13. Hash / HMAC (Sha256 / Sha512 / Md5)
//  14. OS / Process (Spawn / Exit / Name / Arch / Hostname / Cpus)
//  15. TCP / UDP / WebSocket / Channel (Connect / Bind / New)
//  16. Tensor / DataFrame / Image / Cache / I18n / Faker / Audio / DSP
//      (Zeros / Ones / FromVec / Filled / FromCsv / FromJson / FromPath /
//      FromBytes / WithLocale / WithSeed / FromSamples / Hann / Hamming /
//      Blackman)
//  17. Config / Observe (SetDefault / LoadFile / LoadEnv / LoadArgs /
//      GetInt / GetFloat / GetBool / Watch / Span / Counter / Histogram /
//      Gauge)
//  18. Audit / Fuzz / Validator / Archive (Bootstrap / Scan / Sign /
//      Verify / Keypair / Run / Bool / String / Bytes / CompressDir /
//      Extract)
//  19. Auth (PasswordHash / PasswordVerify / AuthorizationUrl /
//      ExchangeCode / Enforce)
//  20. NLP (DetectLanguage / Stem / Tokenize / Sentences)
//  21. I18n (WithFallback)
//  22. Scrape / Markup (FromHtml / FromStr / Serialize / Deserialize /
//      Roundtrip)
//  23. Geo (FromCoords)
//  24. Crypto-2 (FromPrivateKey / GenerateKey / GenerateNonce / Encrypt /
//      Decrypt / GenerateKeypair / GeneratePrivate / PublicFromPrivate /
//      DeriveShared / GenerateSalt / DeriveKey)
//  25. SIMD (Splat / FromSlice / FromArray)
//  26. Stdlib batch (Read / Write / Exists / Append / HttpGet / HttpPost /
//      AssertEqual / AssertNotEqual / AssertTrue / AssertFalse /
//      AssertContains)
enum PreludeAssocFn {
    // === 1. DATETIME FAMILY ===
    Now, Today, Parse, Format,
    Days, Hours, Minutes, Seconds, Millis,
    // === 3. LOG ===
    Debug, Info, Warn, Error,
    // === 4. REGEX ===
    Compile,
    // === 5. STRUCTURED DATA ===
    Stringify,
    // === 6. MATH ===
    Sqrt, Sin, Cos, Tan, Abs, Floor, Ceil, Round, Pow, Min, Max, Int, Float,
    // === 7. RANDOM ===
    Choice, Shuffle,
    // === 8. STRINGS ===
    Split, Join, Trim, Replace, Contains, StartsWith, ToUppercase, ToLowercase,
    // === 9. ARGS / ENV ===
    List, Get, Set, Has, Load,
    // === 10. ENCODING ===
    Encode, Decode,
    // === 11. UUID ===
    V4, V7,
    // === 12. FILESYSTEM ===
    Create, Remove, Walk, Dir,
    // === 13. HASH / HMAC ===
    Sha256, Sha512, Md5,
    // === 14. OS / PROCESS ===
    Spawn, Exit, Name, Arch, Hostname, Cpus,
    // === 15. NETWORKING ===
    Connect, Bind,
    // === 16. CHANNEL ===
    New,
    // === 17. DATA / MEDIA ===
    FromFloat, Zeros, Ones, FromVec, Filled, FromCsv, FromJson, FromPath,
    FromBytes, WithLocale, WithSeed, FromSamples, Hann, Hamming, Blackman,
    // === 18. CONFIG / OBSERVE ===
    SetDefault, LoadFile, LoadEnv, LoadArgs, GetInt, GetFloat, GetBool,
    Watch, Span, Counter, Histogram, Gauge,
    // === 19. AUDIT / FUZZ / VALIDATE / ARCHIVE ===
    Bootstrap, Scan, Sign, Verify, Keypair, Run, Bool, String, Bytes,
    CompressDir, Extract,
    // === 20. AUTH ===
    PasswordHash, PasswordVerify, AuthorizationUrl, ExchangeCode, Enforce,
    // === 21. NLP ===
    DetectLanguage, Stem, Tokenize, Sentences,
    // === 22. I18N ===
    WithFallback,
    // === 23. SCRAPE / MARKUP ===
    FromHtml, FromStr, Serialize, Deserialize, Roundtrip,
    // === 24. GEO ===
    FromCoords,
    // === 25. CRYPTO-2 ===
    FromPrivateKey, GenerateKey, GenerateNonce, Encrypt, Decrypt,
    GenerateKeypair, GeneratePrivate, PublicFromPrivate, DeriveShared,
    GenerateSalt, DeriveKey,
    // === 26. SIMD ===
    Splat, FromSlice, FromArray,
    // === 27. FILE / HTTP / ASSERT (stdlib batch) ===
    Read, Write, Exists, Append, HttpGet, HttpPost,
    AssertEqual, AssertNotEqual, AssertTrue, AssertFalse, AssertContains,
}

// =============================================================================
// impl PreludeAssocFn — name + ALL list
// =============================================================================

// All recognised associated-function variants, in declared order. Used by
// `assoc_fn_lookup` to do a name-based scan.
func assoc_fn_all() -> Vector<PreludeAssocFn>:
    let out = Vector.new()
    // DateTime family
    out.push(PreludeAssocFn.Now)
    out.push(PreludeAssocFn.Today)
    out.push(PreludeAssocFn.Parse)
    out.push(PreludeAssocFn.Format)
    // Duration constructors
    out.push(PreludeAssocFn.Days)
    out.push(PreludeAssocFn.Hours)
    out.push(PreludeAssocFn.Minutes)
    out.push(PreludeAssocFn.Seconds)
    out.push(PreludeAssocFn.Millis)
    // Log
    out.push(PreludeAssocFn.Debug)
    out.push(PreludeAssocFn.Info)
    out.push(PreludeAssocFn.Warn)
    out.push(PreludeAssocFn.Error)
    // Regex
    out.push(PreludeAssocFn.Compile)
    // Structured data
    out.push(PreludeAssocFn.Stringify)
    // Math
    out.push(PreludeAssocFn.Sqrt)
    out.push(PreludeAssocFn.Sin)
    out.push(PreludeAssocFn.Cos)
    out.push(PreludeAssocFn.Tan)
    out.push(PreludeAssocFn.Abs)
    out.push(PreludeAssocFn.Floor)
    out.push(PreludeAssocFn.Ceil)
    out.push(PreludeAssocFn.Round)
    out.push(PreludeAssocFn.Pow)
    out.push(PreludeAssocFn.Min)
    out.push(PreludeAssocFn.Max)
    out.push(PreludeAssocFn.Int)
    out.push(PreludeAssocFn.Float)
    // Random
    out.push(PreludeAssocFn.Choice)
    out.push(PreludeAssocFn.Shuffle)
    // Strings
    out.push(PreludeAssocFn.Split)
    out.push(PreludeAssocFn.Join)
    out.push(PreludeAssocFn.Trim)
    out.push(PreludeAssocFn.Replace)
    out.push(PreludeAssocFn.Contains)
    out.push(PreludeAssocFn.StartsWith)
    out.push(PreludeAssocFn.ToUppercase)
    out.push(PreludeAssocFn.ToLowercase)
    // Args / Env
    out.push(PreludeAssocFn.List)
    out.push(PreludeAssocFn.Get)
    out.push(PreludeAssocFn.Set)
    out.push(PreludeAssocFn.Has)
    out.push(PreludeAssocFn.Load)
    // Encoding
    out.push(PreludeAssocFn.Encode)
