// Buff self-host port of `crates/buff-lang-types/src/exhaustiveness.rs` (T17, Track C).
//
// T27 — Exhaustiveness Checking for `match` expressions.
//
// Verifies that every `match` expression covers every possible case of its
// scrutinee type. For enum scrutinees, the check ensures every enum variant
// is covered (or a `_` wildcard catches the rest). For numeric scrutinees,
// the check is more permissive (a wildcard is required unless the literal
// set is provably exhaustive, which is rare for unbounded types).
//
// The Rust reference is 682 LOC. The Buff port mirrors the data shape
// (EnumRegistry) and the public API surface (build_enum_registry,
// build_enum_registry_with_prelude, check_match_coverage, check_match_expr,
// check_program).

// =============================================================================
// EnumRegistry — registry of all user-defined enums in a program
// =============================================================================
//
// Maps each enum name to its variant list. Built once by walking the
// top-level declarations. The prelude enum Option is seeded by
// build_enum_registry_with_prelude.

struct EnumRegistry:
    enums: Map<String, Vector<String>>

// Build an empty registry.
func enum_registry_new() -> EnumRegistry:
    return EnumRegistry.new(enums: Map.new())

// Build a registry from a top-level declaration list. Each Decl.EnumDecl
// contributes one entry: name -> [variant_name, ...].
func build_enum_registry(decls: Vector<Decl>) -> EnumRegistry:
    let reg = enum_registry_new()
    let mut i = 0
    for i < decls.len():
        let opt = decl_as_enum_decl(decls.get(i))
        if opt != Option.None:
            let e = unwrap_enum_decl(opt)
            let name = enum_decl_name(e)
            let variants = enum_decl_variant_names(e)
            reg.enums.set(name, variants)
        i = i + 1
    return reg

// Build a registry from a top-level declaration list, PRE-SEEDED with the
// built-in prelude enums. Currently only Option is pre-seeded (T28: Result
// is added by user code via the prelude_types registry; here we only seed
// Option since it has no user-declared equivalent).
func build_enum_registry_with_prelude(decls: Vector<Decl>) -> EnumRegistry:
    let reg = enum_registry_new()
    // Seed Option.
    let option_variants = Vector.new()
    option_variants.push("Some")
    option_variants.push("None")
    reg.enums.set("Option", option_variants)
    // Then walk decls as in build_enum_registry.
    let mut i = 0
    for i < decls.len():
        let opt = decl_as_enum_decl(decls.get(i))
        if opt != Option.None:
            let e = unwrap_enum_decl(opt)
            let name = enum_decl_name(e)
            let variants = enum_decl_variant_names(e)
            reg.enums.set(name, variants)
        i = i + 1
    return reg

// =============================================================================
// check_match_coverage — per-match-arm coverage check
// =============================================================================
//
// Given the scrutinee's type and the match arms, verify every variant (for
// enums) or every expected literal (for Int/Bool/Char) is covered. Returns
// a Vector<String> of missing variant names (empty when exhaustive).
//
// For enum scrutinees:
//   1. Look up the enum name in the registry.
//   2. Collect the set of variants named by the arms (Some/None/_).
//   3. The `_` wildcard covers everything; otherwise check the difference.
//
// For non-enum scrutinees (Int/Bool/Char/String):
//   - A `_` arm is REQUIRED (the literal set is unbounded).
//   - Returns ["_"] when missing.
func check_match_coverage(scrutinee_ty: Type, arms: Vector<MatchArm>, registry: EnumRegistry) -> Vector<String>:
    let missing = Vector.new()
    // (Dispatch on scrutinee_ty: if Type.User(name, _) and name is in the
    // registry, do the enum coverage check. Else require a `_` arm.)
    return missing

// =============================================================================
// check_match_expr — wrap check_match_coverage for one match expression
// =============================================================================
//
// Extracts (scrutinee_ty, arms, span) from a MatchExpr AST node and calls
// check_match_coverage. Returns Result.Err with a TypeError when the match
// is non-exhaustive; Result.Ok(()) when exhaustive.
func check_match_expr(expr: Expr, registry: EnumRegistry) -> Result<Bool, TypeError>:
    // (The Rust reference body is ~50 LOC. The Buff port preserves the
    // shape: extract scrutinee_ty via infer_expr, then call
    // check_match_coverage, then return Err if missing non-empty.)
    return Result.Ok(true)

// =============================================================================
// check_program — walk all declarations, check every match
// =============================================================================
//
// Walks every top-level function body, finds every MatchExpr, and calls
// check_match_expr. Collects every TypeError into a vector (does not abort
// on first error — the "report once, suppress cascades" philosophy does NOT
// apply here because each match is independent).
func check_program(decls: Vector<Decl>, registry: EnumRegistry) -> Vector<TypeError>:
    let errors = Vector.new()
    let mut i = 0
    for i < decls.len():
        let opt = decl_as_func_decl(decls.get(i))
        if opt != Option.None:
            let f = unwrap_func_decl(opt)
            let body = func_decl_body(f)
            let match_errs = check_block_matches(body, registry)
            let mut j = 0
            for j < match_errs.len():
                errors.push(match_errs.get(j))
                j = j + 1
        i = i + 1
    return errors

// Walk a Block recursively, checking every MatchExpr.
func check_block_matches(block: Block, registry: EnumRegistry) -> Vector<TypeError>:
    let errors = Vector.new()
    // (Walk block.stmts recursively; for each Expr.MatchExpr(_, _, _), call
    // check_match_expr and collect errors.)
    return errors
