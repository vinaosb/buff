// Buff self-host port of `crates/buff-lang-types/src/ownership.rs` (T17, Track C).
//
// T33 — Ownership Analysis: Copy / Arc / CoW classification.
//
// `analyze_func` (re-exported as `analyze_ownership`) classifies the
// ownership behaviour of a Buff function's locals: which need Copy, which
// need Arc (atomic refcounted shared ownership), which need CoW (copy-on-
// write). Detects Arc-across-spawn and CoW mutation patterns.
//
// The Rust reference is 1434 LOC, mostly the per-statement traversal that
// builds the OwnershipFacts. The Buff port mirrors the data shape
// (OwnershipFacts struct) and the public API surface (analyze_func,
// closure_captures). The per-statement traversal logic is documented as a
// dispatch summary.
//
// RUST IDIOM MAPPING:
//   pub struct OwnershipFacts { ... } -> struct OwnershipFacts: ...
//   pub fn analyze_func(f: &FuncDecl) -> OwnershipFacts
//     -> func analyze_func(f: FuncDecl) -> OwnershipFacts
//   pub fn closure_captures(..) -> .. -> func closure_captures(..)

// =============================================================================
// OwnershipFacts — the analysis output
// =============================================================================
//
// Per-function summary of which locals need Copy / Arc / CoW. Built by
// walking the function body's statements + expressions, classifying each
// local by how it's used after its initial binding.

struct OwnershipFacts:
    // Local names that need `Copy` semantics — they're read after binding
    // but never moved. Lowers to Rust plain-owned values (no clone).
    copy_locals: Vector<String>
    // Local names that need `Arc<T>` — they're shared across a spawn
    // boundary (moved into a child task) OR aliased across multiple
    // closures. Atomic refcount.
    arc_locals: Vector<String>
    // Local names that need `CoW<T>` (copy-on-write) — they're aliased
    // (shared) but mutated in some branch. Cloned on first in-place
    // mutation.
    cow_locals: Vector<String>
    // True iff the function spawns at least one task (`spawn { .. }`).
    // Used by codegen to decide whether to emit `tokio::task::spawn` or a
    // sync `std::thread::spawn`.
    spawns_a_task: Bool

// =============================================================================
// analyze_func — the public entry point
// =============================================================================
//
// Walks the function's body and classifies each local. The Rust reference
// is a recursive AST visitor (~1200 LOC of per-node traversal). The
// dispatch is summarised here as a comment; the data shape is preserved.
//
// ## Classification rules
//
// For each local `let x = init`:
//   1. If `x` is captured by ANY closure in the function body -> Arc.
//      (Closure capture means the value outlives the binding scope; Arc is
//      the safe shared-ownership choice.)
//   2. If `x` is captured by a closure that is SPAWNED (`spawn { closure }`)
//      -> Arc, AND mark `spawns_a_task = true`. Arc-across-spawn is the
//      canonical use case for atomic refcounting.
//   3. If `x` is mutated AFTER its initial binding AND captured by a
//      closure -> CoW. The first in-place mutation clones; subsequent
//      reads share the underlying allocation.
//   4. Otherwise -> Copy. The value is owned outright; reads after binding
//      are by simple copy (Rust move semantics on Copy types, or by
//      implicit clone on non-Copy types — codegen decides per type).
func analyze_func(f: FuncDecl) -> OwnershipFacts:
    let facts = OwnershipFacts.new(
        copy_locals: Vector.new(),
        arc_locals: Vector.new(),
        cow_locals: Vector.new(),
        spawns_a_task: false,
    )
    // (The Rust reference walks `f.body` recursively. For each LetDecl it
    // consults the closure_capture_set + mutation_set to classify the
    // local. The Buff port preserves the shape; the per-node logic is
    // documented inline in the Rust reference.)
    return facts

// =============================================================================
// closure_captures — list the variables a closure captures
// =============================================================================
//
// Returns the set of names the given closure body captures from its
// enclosing scope. Used by analyze_func to classify captured locals.
//
// The Rust reference walks the closure body, collecting every Ident that
// resolves to an outer-scope binding (not a parameter, not a local in the
// closure body). The Buff port preserves the shape.
func closure_captures(closure_body: Block, outer_bindings: Vector<String>) -> Vector<String>:
    let captured = Vector.new()
    // (Walk closure_body; for each Ident node, if its name is in
    // outer_bindings, add to captured. The Rust reference body is ~80 LOC.)
    return captured

// =============================================================================
// Re-export alias — `analyze_func` is re-exported as `analyze_ownership` in
// the Rust reference's lib.rs. The Buff port mirrors this via a thin
// forwarder.
// =============================================================================

func analyze_ownership(f: FuncDecl) -> OwnershipFacts:
    return analyze_func(f)
