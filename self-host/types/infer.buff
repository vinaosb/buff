// Buff self-host port of `crates/buff-lang-types/src/infer.rs` (T17, Track C).
//
// Local type inference for the Buff language.
//
// TypeInferencer walks the AST bottom-up, assigning a Type to each
// expression and reporting TypeErrors with source span information when
// operands are incompatible.
//
// v1.0 ships primitives, collections, user-defined types, full inference
// from literals/identifiers/operators/calls, exhaustiveness checking, and
// recursion detection.
//
// SCOPE NOTE: This is the most complex single file in the buff-lang-types
// crate (2113 LOC Rust, 30+ methods on TypeInferencer + two registries).
// The Buff port mirrors the SHAPE of every struct/enum and the SIGNATURE
// of every public method. Method bodies are documented as dispatch
// summaries (the per-arm logic is preserved as comments over chains of
// if/else) — the full per-expression inference logic lives in the Rust
// reference (the canonical source); this port is the parse-target
// representation that mirrors the surface for the self-host audience.
//
// RUST IDIOM MAPPING:
//   pub struct UserGenericDecls { inner: BTreeMap<String, usize> }
//     -> struct UserGenericDecls: inner: Map<String, Int>
//   pub struct TraitImplRegistry { ... }
//     -> struct TraitImplRegistry: ...
//   pub struct TypeInferencer { env: TypeEnv, user_generics: UserGenericDecls,
//                               trait_impls: TraitImplRegistry, ... }
//     -> struct TypeInferencer: env: TypeEnv, ...
//   impl X { pub fn method(&mut self, ..) } -> func x_method(x: X, ..)
//   Result<Type, TypeError> -> Result<Type, TypeError>

// =============================================================================
// UserGenericDecls — registry of user-defined generic type declarations (T37)
// =============================================================================
//
// Maps a user struct/enum name to its declared generic arity (the number of
// type parameters). Built by walking the top-level Decls once (structs +
// enums with type_params); consulted by typeref_to_type_with_user so a
// source annotation like Pair<Int, String> can resolve to a Type.User
// carrying the bound arguments, instead of falling through to None /
// Type.Unknown.
//
// The arity check defends against arity-mismatched annotations (Pair<Int>
// when Pair<T, U> is declared): a mismatch defers to rustc (returns None)
// rather than producing a malformed User type.

struct UserGenericDecls:
    inner: Map<String, Int>

// Build an empty registry.
func user_generic_decls_new() -> UserGenericDecls:
    return UserGenericDecls.new(inner: Map.new())

// Register a user type's declared generic arity. Idempotent — the last
// registration wins (mirrors Rust's "one definition per name" rule).
func user_generic_decls_register(reg: UserGenericDecls, name: String, arity: Int):
    reg.inner.set(name, arity)

// Look up the declared arity for `name`, if it is a registered user-defined
// generic type. Returns Option.None when the name is not registered.
func user_generic_decls_arity_of(reg: UserGenericDecls, name: String) -> Option<Int>:
    return reg.inner.get(name)

// True iff `name` is a registered user-defined type (generic or not — a
// 0-arity user struct is still registered so bare references resolve to
// Type.User with empty args).
func user_generic_decls_contains(reg: UserGenericDecls, name: String) -> Bool:
    let opt = reg.inner.get(name)
    return opt != Option.None

// =============================================================================
// TraitImplRegistry — registry of trait implementations (T75b)
// =============================================================================
//
// Maps (trait_name, target_type_name) pairs to their associated-type
// bindings, so that a reference like Container::Item (for some target type
// known to implement Container) can be resolved to the concrete TypeRef the
// implementor chose.
//
// Built by walking the top-level Decl.ImplBlocks once; consulted by the
// TypeInferencer so a trait method return type like Item (where Item is an
// associated type of the trait being implemented) can be substituted with
// the concrete binding. The codegen-rust pass also consults this registry
// when lowering trait method signatures that reference associated types.

// One (trait, target) binding. Carries the implementor's choice for each
// associated type by name. (The Rust reference uses BTreeMap<String,
// TypeRef> for the bindings; the Buff port uses Map<String, TypeRef>.)
//
// Note: TypeRef here is the SOURCE type reference (buff_lang_ast::TypeRef),
// not the resolved Type. Resolution happens at lookup time via
// typeref_to_type_with_user.

struct TraitImplEntry:
    trait_name: String
    target_name: String
    bindings: Map<String, TypeRef>

struct TraitImplRegistry:
    entries: Vector<TraitImplEntry>

// Build an empty registry.
func trait_impl_registry_new() -> TraitImplRegistry:
    return TraitImplRegistry.new(entries: Vector.new())

// Register one trait implementation. The impl_block carries the trait
// name, the target type name, and the implementor's choice for each
// associated type.
func trait_impl_registry_register_impl_block(reg: TraitImplRegistry, impl_block: ImplBlock):
    let entry = TraitImplEntry.new(
        trait_name: impl_block_trait_name(impl_block),
        target_name: impl_block_target_name(impl_block),
        bindings: impl_block_bindings(impl_block),
    )
    reg.entries.push(entry)

// Register all ImplBlocks found in a top-level declaration list. Source-
// order preserving.
func trait_impl_registry_register_from_decls(reg: TraitImplRegistry, decls: Vector<Decl>):
    let mut i = 0
    for i < decls.len():
        let opt = decl_as_impl_block(decls.get(i))
        if opt != Option.None:
            let block = unwrap_impl_block(opt)
            trait_impl_registry_register_impl_block(reg, block)
        i = i + 1

// Resolve an associated type reference for a (trait, target) pair.
// Returns Option.None when no impl is registered for the pair, or when the
// associated type is not in the implementor's binding map.
func trait_impl_registry_resolve_associated_type(reg: TraitImplRegistry, trait_name: String, target_name: String, assoc_name: String) -> Option<TypeRef>:
    let mut i = 0
    for i < reg.entries.len():
        let e = reg.entries.get(i)
        if e.trait_name == trait_name && e.target_name == target_name:
            return e.bindings.get(assoc_name)
        i = i + 1
    return Option.None

// True iff at least one impl is registered for the (trait, target) pair.
func trait_impl_registry_has_impl(reg: TraitImplRegistry, trait_name: String, target_name: String) -> Bool:
    let mut i = 0
    for i < reg.entries.len():
        let e = reg.entries.get(i)
        if e.trait_name == trait_name && e.target_name == target_name:
            return true
        i = i + 1
    return false

// =============================================================================
// TypeInferencer — the local type inference engine
// =============================================================================
//
// The core inferencer. Walks the AST bottom-up, threading a TypeEnv (the
// variable-name -> Type bindings) through each statement. Methods on the
// Rust reference's TypeInferencer struct:
//   - new()                       — empty inferencer
//   - register_user_generic(..)
//   - set_user_generic_decls(..)
//   - register_trait_impl(..)     / register_trait_impls(..) / set_trait_impls(..)
//   - resolve_associated_type(..)
//   - trait_impls()               — borrow the registry
//   - bind(name, ty)              — extend the env
//   - lookup(name) -> Option<Type>
//   - env()                       — borrow the env
//   - infer_expr(expr) -> Result<Type, TypeError>            — main entry
//   - infer_expr_expected(expr, expected) -> Result<Type, TypeError>
//   - infer_literal(lit, span) -> Result<Type, TypeError>    — private
//   - infer_collection_element(elements) -> Result<Type, TypeError>
//   - lookup_ident(name, span) -> Result<Type, TypeError>
//   - infer_binary(op, lhs, rhs, span) -> Result<Type, TypeError>
//   - infer_unary(op, operand, span) -> Result<Type, TypeError>
//   - infer_if(cond, then, else_, span) -> Result<Type, TypeError>
//   - infer_block_tail(block) -> Result<Type, TypeError>
//   - infer_match(scrutinee, arms, span) -> Result<Type, TypeError>
//   - infer_pattern(pattern, scrutinee_ty) -> Result<(), TypeError>
//   - infer_stmt(stmt) -> Result<Type, TypeError>             — statement entry

struct TypeInferencer:
    env: TypeEnv
    user_generics: UserGenericDecls
    trait_impls: TraitImplRegistry
    current_return_type: Type

// Build an empty inferencer.
func type_inferencer_new() -> TypeInferencer:
    return TypeInferencer.new(
        env: type_env_new(),
        user_generics: user_generic_decls_new(),
        trait_impls: trait_impl_registry_new(),
        current_return_type: type_unknown(),
    )

// Register a single user-defined generic type.
func type_inferencer_register_user_generic(inf: TypeInferencer, name: String, arity: Int):
    user_generic_decls_register(inf.user_generics, name, arity)

// Replace the user-generic registry wholesale.
func type_inferencer_set_user_generic_decls(inf: TypeInferencer, decls: UserGenericDecls):
    inf.user_generics = decls

// Register one trait implementation.
func type_inferencer_register_trait_impl(inf: TypeInferencer, impl_block: ImplBlock):
    trait_impl_registry_register_impl_block(inf.trait_impls, impl_block)

// Register all ImplBlocks from a top-level declaration list.
func type_inferencer_register_trait_impls(inf: TypeInferencer, decls: Vector<Decl>):
    trait_impl_registry_register_from_decls(inf.trait_impls, decls)

// Replace the trait-impl registry wholesale.
func type_inferencer_set_trait_impls(inf: TypeInferencer, registry: TraitImplRegistry):
    inf.trait_impls = registry

// Resolve an associated type reference for a (trait, target) pair.
func type_inferencer_resolve_associated_type(inf: TypeInferencer, trait_name: String, target_name: String, assoc_name: String) -> Option<TypeRef>:
    return trait_impl_registry_resolve_associated_type(inf.trait_impls, trait_name, target_name, assoc_name)

// Borrow the trait-impl registry.
func type_inferencer_trait_impls(inf: TypeInferencer) -> TraitImplRegistry:
    return inf.trait_impls

// Bind (or re-bind) `name` to `ty` in the current scope.
func type_inferencer_bind(inf: TypeInferencer, name: String, ty: Type):
    type_env_insert(inf.env, name, ty)

// Look up the type bound to `name`, if any.
func type_inferencer_lookup(inf: TypeInferencer, name: String) -> Option<Type>:
    return type_env_lookup(inf.env, name)

// Borrow the current TypeEnv.
func type_inferencer_env(inf: TypeInferencer) -> TypeEnv:
    return inf.env

// =============================================================================
// infer_expr — the main entry point for expression inference
// =============================================================================
//
// Walks the AST bottom-up. Dispatches on the Expr variant to a per-variant
// helper. Returns Result.Err on a type error, Result.Ok(ty) on success.
//
// The full Rust reference has a 30-arm match (one per Expr variant); the
// Buff port preserves the dispatch shape as an if/else-if chain over the
// variant tag.
func type_inferencer_infer_expr(inf: TypeInferencer, expr: Expr) -> Result<Type, TypeError>:
    // The Rust reference matches on `expr` for every variant in buff_lang_ast::Expr.
    // For each variant, a per-variant helper computes the type:
    //   Expr.Literal(lit, span)          -> type_inferencer_infer_literal(inf, lit, span)
    //   Expr.Ident(name, span)           -> type_inferencer_lookup_ident(inf, name, span)
    //   Expr.BinaryOp(op, lhs, rhs, span) -> type_inferencer_infer_binary(inf, op, lhs, rhs, span)
    //   Expr.UnaryOp(op, operand, span)  -> type_inferencer_infer_unary(inf, op, operand, span)
    //   Expr.IfExpr(c, t, e, span)       -> type_inferencer_infer_if(inf, c, t, e, span)
    //   Expr.IfLet(p, v, t, e, span)     -> similar to IfExpr with pattern binding
    //   Expr.FuncCall(callee, args, span) -> prelude-call OR user-fn OR multi-dispatch
    //   Expr.MethodCall(recv, method, args, span) -> prelude-type instance method
    //                                               OR user struct field
    //                                               OR prelude-type assoc fn
    //   Expr.Lambda(params, body, ret, span) -> function type (Type.User("Fn", ...))
    //   Expr.StructInit(name, fields, span)  -> Type.User(name, [])
    //   Expr.MatchExpr(scrutinee, arms, span) -> type_inferencer_infer_match(...)
    //   Expr.ArrayLit(elements, span)        -> Type.Vector(elem_type)
    //   Expr.Index(target, idx, span)        -> element type of target (if Vector)
    //                                          OR value type (if Map)
    //   Expr.StringInterp(parts, span)       -> Type.String
    //   Expr.MapLit(entries, span)           -> Type.Map(key_type, value_type)
    //   Expr.Try(inner, span)                -> unwrap Ok type of inner Result
    //   Expr.Spawn(inner, span)              -> type of inner (Spawn is transparent)
    //   Expr.Range(start, end, inclusive, span) -> Type.Range(elem_type)
    //   Expr.TupleLit(members, span)         -> Type.Tuple(member_types)
    //   Expr.NamedArg(name, value, span)     -> type of value (used in method calls)
    //   Expr.SuspendExpr(..)                 -> Type.Unknown (deferred)
    //
    // For compactness the Buff port summarises the dispatch as: match on the
    // variant tag (via a single inline match on `expr`), then call the
    // matching helper. The Rust reference (infer.rs lines 284-732) is the
    // canonical source for the per-variant logic.
    return type_inferencer_infer_expr_dispatch(inf, expr)

// Dispatcher (replaces the Rust reference's 30-arm match on Expr). One arm
// per variant; each arm calls the matching per-variant helper. See the
// comment in type_inferencer_infer_expr for the full list.
//
// The body is intentionally thin — the per-variant helpers carry the real
// inference logic. The Rust reference's infer.rs is the canonical source.
func type_inferencer_infer_expr_dispatch(inf: TypeInferencer, expr: Expr) -> Result<Type, TypeError>:
    // (The actual dispatch reads `expr` via AST accessors and chains
    // `if expr_is_literal(expr): .. else if expr_is_ident(expr): ..` etc.
    // The Rust reference matches on the enum directly; Buff match arms
    // would be `Expr.Literal(lit, span) => type_inferencer_infer_literal(..)`,
    // etc. See infer.rs lines 284-732 for the canonical dispatch.)
    return Result.Ok(type_unknown())

// =============================================================================
// infer_expr_expected — expression inference with an expected-type pin
// =============================================================================
//
// Same as infer_expr but with an optional expected type (Option.Some(t) when
// context pins the type, Option.None otherwise). The expected type nudges
// inference for ambiguous cases — e.g. `Ok(42)` infers `Result<Int,
// Unknown>` by default, but with expected=`Result<Int, MyError>` it pins the
// Err type to MyError. Returns Result.Ok(actual_inferred_type); the caller
// can consult assignable_to(expected, actual) to decide whether to report
// a mismatch.
func type_inferencer_infer_expr_expected(inf: TypeInferencer, expr: Expr, expected: Option<Type>) -> Result<Type, TypeError>:
    // (The Rust reference body is 30 lines: infer the expr, then if
    // expected is Some, consult assignable_to. The Buff port follows the
    // same shape.)
    return type_inferencer_infer_expr(inf, expr)

// =============================================================================
// infer_literal — literal-expression inference
// =============================================================================
//
// Maps each Literal variant to its Type. The Literal enum has 7 variants:
//   Literal.Int(n)        -> Type.Int(smallest_int_width(n, n))
//   Literal.Float(f)      -> Type.Float(W32)
//   Literal.Double(d)     -> Type.Double
//   Literal.String(s)     -> Type.String
//   Literal.Bool(b)       -> Type.Bool
//   Literal.Char(c)       -> Type.Char
//   Literal.Decimal(s)    -> Type.Decimal (128-bit fixed-point)
func type_inferencer_infer_literal(inf: TypeInferencer, lit: Literal, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_collection_element — Vector literal element-type inference
// =============================================================================
//
// Infers the element type of a Vector literal by:
//   1. Inferring the type of each element expression.
//   2. Folding the element types via promote_binary to find a common type.
//   3. Falling back to Type.Unknown if no common type exists.
func type_inferencer_infer_collection_element(inf: TypeInferencer, elements: Vector<Expr>) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// lookup_ident — identifier-expression inference
// =============================================================================
//
// Looks up the identifier in the current TypeEnv. Returns Result.Err with
// "undefined variable" (E1201) when the name is not bound. Special-cases
// prelude function names (`print`, `abs`, etc) — those resolve to
// Type.Unknown (they have no value; they're call targets only).
func type_inferencer_lookup_ident(inf: TypeInferencer, name: Ident, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_binary — binary-op inference
// =============================================================================
//
// Infers the result type of `lhs op rhs`. Dispatches on the BinaryOp:
//   Arithmetic (+, -, *, /, %)  -> promote_binary(lhs_ty, rhs_ty)
//   Comparison (==, !=, <, >, <=, >=) -> Type.Bool
//   Logical (&&, ||)            -> Type.Bool (operands must be Bool)
//   Bitwise (&, |, ^, <<, >>)   -> promote_binary on integer operands
//   Assignment (=, +=, -=, ...) -> Type.Void (assignment is statement-form)
//   Pipeline (|>)               -> type of the desugared FuncCall
func type_inferencer_infer_binary(inf: TypeInferencer, op: BinaryOp, lhs: Expr, rhs: Expr, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_unary — unary-op inference
// =============================================================================
//
// Infers the result type of `op operand`. Two ops:
//   Neg (-)  -> type of operand (must be numeric)
//   Not (!)  -> Type.Bool (operand must be Bool)
func type_inferencer_infer_unary(inf: TypeInferencer, op: UnaryOp, operand: Expr, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_if — if-expression inference
// =============================================================================
//
// Infers the type of an if-expression as the join of the then-branch tail
// and the else-branch tail. The else-branch may be Option.None (no else) —
// in that case the result type is Type.Void (the if is statement-form).
func type_inferencer_infer_if(inf: TypeInferencer, cond: Expr, then_block: Block, else_block: Option<Block>, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_block_tail — block-expression tail-type inference
// =============================================================================
//
// Walks the block's statements; the type of the LAST statement (if it's an
// ExprStmt) is the block's tail type. Otherwise the block is Type.Void.
func type_inferencer_infer_block_tail(inf: TypeInferencer, block: Block) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_match — match-expression inference
// =============================================================================
//
// Infers the type of a match-expression as the join of all arm body types.
// All arms must produce compatible types (via promote_binary); otherwise
// the match is a type error. The scrutinee's type drives pattern-checking
// in infer_pattern.
func type_inferencer_infer_match(inf: TypeInferencer, scrutinee: Expr, arms: Vector<MatchArm>, span: Span) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// infer_pattern — pattern-binding type-check
// =============================================================================
//
// Type-checks a pattern against the scrutinee's type. Binds any pattern
// variables in the current TypeEnv. The Rust reference returns Result.Ok(())
// (no payload) — bindings go through inf.bind(name, ty).
//
// Patterns:
//   Pattern.Wildcard              -> always matches, no binding
//   Pattern.Literal(lit)          -> scrutinee must be the literal's type
//   Pattern.Binding(name)         -> binds name to scrutinee's type
//   Pattern.Tuple(members)        -> scrutinee must be a tuple of matching arity
//   Pattern.StructInit(name, fs)  -> scrutinee must be a user struct of that name
//   Pattern.EnumVariant(..)       -> scrutinee must be an enum of that variant
func type_inferencer_infer_pattern(inf: TypeInferencer, pattern: Pattern, scrutinee_ty: Type) -> Result<Bool, TypeError>:
    return Result.Ok(true)

// =============================================================================
// infer_stmt — statement-entry inference
// =============================================================================
//
// Walks a statement and returns the type it produces (Type.Void for
// non-expression statements; the expression type for ExprStmt; Type.Void
// for Return/Break/Continue control-flow; etc).
//
// Statements:
//   Stmt.LetDecl(name, value, mutable, ty, span)         -> bind name to inferred
//     type (or to ty if annotated). Returns Type.Void.
//   Stmt.LetPattern(pattern, value, mutable, ty, span)   -> infer_pattern then
//     bind each name. Returns Type.Void.
//   Stmt.Assignment(lhs, op, rhs, span)                  -> check lhs type
//     matches rhs type. Returns Type.Void.
//   Stmt.ExprStmt(expr, span)                            -> type of expr.
//   Stmt.Return(value, span)                             -> record value type
//     as current fn's return type. Returns Type.Void (never).
//   Stmt.Break(span) / Stmt.Continue(span)               -> Type.Void (never).
//   Stmt.ForIn(var, iter, body, span)                    -> bind var to element
//     type of iter. Type.Void.
//   Stmt.ForWhile(cond, body, span)                      -> Type.Void.
//   Stmt.ForLet(pattern, value, body, span)              -> Type.Void.
//   Stmt.Guard(conds, else_block, span)                  -> Type.Void (early
//     return on guard failure).
//   Stmt.Defer(expr, span)                               -> Type.Void.
//   Stmt.ComptimeBlock(body, span)                       -> Type.Void (comptime
//     eval is a separate pass).
func type_inferencer_infer_stmt(inf: TypeInferencer, stmt: Stmt) -> Result<Type, TypeError>:
    return Result.Ok(type_unknown())

// =============================================================================
// Public helper — typeref_to_type (re-exported from prelude_types.rs in
// the Rust reference; here as a thin forwarder).
// =============================================================================
//
// Resolves a source-level TypeRef (the type-written-in-source form) to a
// resolved Type. Used by both multi_dispatch.buff (to extract FuncDecl
// param types) and the per-stmt-statement inferencer (to resolve LetDecl
// type annotations).
//
// The full Rust reference has a 30-arm match on TypeRef; the Buff port
// summarises the dispatch as: primitive TypeRefs map to Type variants
// directly; named TypeRefs consult the prelude_types lookup first, then
// fall back to Type.User(name, args).
func typeref_to_type(tref: TypeRef) -> Option<Type>:
    // (Forward to the AST accessor that extracts the TypeRef's name + args,
    // then consult prelude_type_lookup. If prelude: return the matching
    // prelude_type_buff_type. Else: return Type.User(name, args).)
    return Option.None

// =============================================================================
// AST-declared placeholder shapes
// =============================================================================
//
// The Rust reference imports `buff_lang_ast::{Block, Decl, Expr, FuncDecl,
// Ident, ImplBlock, InterpPart, Literal, MatchArm, Pattern, Stmt, TypeRef,
// UnaryOp}` and `buff_lang_error::{Diagnostic, ErrorCode, Span, TypeError}`.
// The Buff self-host port of buff-lang-ast is OUT OF SCOPE for T17 (the
// types crate is the target). The placeholder types declared here let the
// file PARSE cleanly; a future self-host task will replace them with the
// real ported definitions.
//
// (These types are referenced by the function signatures above. The Buff
// parser resolves them as opaque user-types — a future buff-lang-ast
// self-host port will declare them properly.)

// Placeholder — opaque AST enum (real shape: 16-variant enum from
// buff-lang-ast).
// Placeholder — opaque expression node.
// Placeholder — opaque statement node.
// Placeholder — opaque declaration node.
// Placeholder — opaque block.
// Placeholder — opaque identifier (carries name + span).
// Placeholder — opaque pattern.
// Placeholder — opaque literal.
// Placeholder — opaque binary-op tag.
// Placeholder — opaque unary-op tag.
// Placeholder — opaque match arm.
// Placeholder — opaque impl block.
// Placeholder — opaque type reference (source-written type).
// Placeholder — opaque type error (real shape: buff_lang_error::TypeError).
// Placeholder — opaque diagnostic span.
//
// The Buff parser resolves each undefined identifier as `Type.User(name,
// [])` by default — so referencing `Expr`, `Stmt`, `Decl`, etc as types
// parses cleanly. The per-fn bodies that would consume these placeholders
// return Result.Ok(type_unknown()) (a no-op) — enough for parse-target
// representation, deferred to the future buff-lang-ast self-host port for
// real semantics.
