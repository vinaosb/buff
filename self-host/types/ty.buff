// =============================================================================
// Convenience width constructors (the Rust reference uses `IntWidth::W64`
// enum literals directly; these thin wrappers exist so callers in the wider
// self-host port don't repeat the enum qualifier when building match arms).
// =============================================================================

func int_width_w8() -> IntWidth:
    return IntWidth.W8

func int_width_w16() -> IntWidth:
    return IntWidth.W16

func int_width_w32() -> IntWidth:
    return IntWidth.W32

func int_width_w64() -> IntWidth:
    return IntWidth.W64

func int_width_w128() -> IntWidth:
    return IntWidth.W128

func float_width_w16() -> FloatWidth:
    return FloatWidth.W16

func float_width_w32() -> FloatWidth:
    return FloatWidth.W32

func float_width_w64() -> FloatWidth:
    return FloatWidth.W64

// =============================================================================
// fmt::Display for Type — render as the Buff surface name.
//
// Rust uses `fmt::Display`; Buff uses a free function `type_to_string` that
// returns a `String`. The rendering mirrors the Buff source surface (so
// diagnostics read naturally): `Int<64>`, `Vector<Float<32>>`, `DateTime`,
// etc. Nested types recurse via the same function.
// =============================================================================

func type_to_string(t: Type) -> String:
    match t {
        // --- Singletons (no payload) ---
        Type.Bool => return "Bool",
        Type.Double => return "Double",
        Type.String => return "String",
        Type.Char => return "Char",
        Type.Decimal => return "Decimal",
        Type.Unknown => return "Unknown",
        Type.Void => return "Void",
        Type.DateTime => return "DateTime",
        Type.Date => return "Date",
        Type.Time => return "Time",
        Type.Duration => return "Duration",
        Type.Instant => return "Instant",
        Type.Regex => return "Regex",
        Type.Url => return "URL",
        Type.Path => return "Path",
        Type.Process => return "Process",
        Type.Connection => return "Connection",
        Type.Socket => return "Socket",
        Type.WsConnection => return "WsConnection",
        Type.Sender => return "Sender",
        Type.Receiver => return "Receiver",
        Type.Image => return "Image",
        Type.Faker => return "Faker",
        Type.Cache => return "Cache",
        Type.I18n => return "I18n",
        Type.DataFrame => return "DataFrame",
        Type.Audio => return "AudioBuffer",
        Type.World => return "World",
        Type.Entity => return "Entity",
        Type.Template => return "Template",
        Type.HttpClient => return "HttpClient",
        Type.Validator => return "Validator",
        Type.Email => return "Email",
        Type.SmtpClient => return "SmtpClient",
        Type.Document => return "Document",
        Type.Element => return "Element",
        Type.Crawler => return "Crawler",
        Type.MsgPack => return "MsgPack",
        Type.Xml => return "Xml",
        Type.XmlElement => return "XmlElement",
        Type.Point => return "Point",
        Type.LineString => return "LineString",
        Type.Polygon => return "Polygon",
        Type.Text => return "Text",
        Type.Language => return "Language",
        Type.StemAlgorithm => return "StemAlgorithm",
        Type.Protobuf => return "Protobuf",
        Type.Message => return "Message",
        Type.Bot => return "Bot",
        Type.ChatMessage => return "ChatMessage",
        Type.Platform => return "Platform",
        Type.Provider => return "Provider",
        Type.Wallet => return "Wallet",
        Type.ConnectedWallet => return "ConnectedWallet",
        Type.Contract => return "Contract",
        Type.ContractMethod => return "ContractMethod",
        Type.AES => return "AES",
        Type.RSA => return "RSA",
        Type.ECDH => return "ECDH",
        Type.Argon2 => return "Argon2",
        Type.RsaKeypair => return "RsaKeypair",
        Type.Simd => return "Simd",
        Type.ActorSystem => return "ActorSystem",
        Type.ActorRef => return "ActorRef",
        Type.Supervisor => return "Supervisor",
        Type.ChildSpec => return "ChildSpec",
        Type.RestartStrategy => return "RestartStrategy",
        // --- Parameterised variants ---
        Type.Int(w) => return "Int<" + Int.to_string(int_width_bits(w)) + ">",
        Type.Bits(w) => return "Bits<" + Int.to_string(int_width_bits(w)) + ">",
        Type.Float(w) => return "Float<" + Int.to_string(float_width_bits(w)) + ">",
        Type.Vector(elem) => return "Vector<" + type_to_string(elem) + ">",
        Type.Matrix(elem) => return "Matrix<" + type_to_string(elem) + ">",
        Type.Option(inner) => return "Option<" + type_to_string(inner) + ">",
        Type.Map(key, value) => return "Map<" + type_to_string(key) + ", " + type_to_string(value) + ">",
        Type.Result(ok, err) => return "Result<" + type_to_string(ok) + ", " + type_to_string(err) + ">",
        Type.User(name, args) => return type_user_to_string(name, args),
        Type.DynamicDispatch(inner) => return "Box<dyn " + type_to_string(inner) + ">",
        Type.Range(elem) => return "Range<" + type_to_string(elem) + ">",
        Type.Union(members) => return type_union_to_string(members),
        Type.Tuple(members) => return type_tuple_to_string(members),
    }

// Render `User(name, args)` — bare name when args is empty, name<args...>
// when args is non-empty (mirrors `ast_typeref_to_syn` byte-identically).
func type_user_to_string(name: String, args: Vector<Type>) -> String:
    if args.len() == 0:
        return name
    let mut out = name + "<"
    let mut i = 0
    for i < args.len():
        if i > 0:
            out = out + ", "
        out = out + type_to_string(args.get(i))
        i = i + 1
    return out + ">"

// Render `A | B | C` for a union (T76).
func type_union_to_string(members: Vector<Type>) -> String:
    let mut out = ""
    let mut i = 0
    for i < members.len():
        if i > 0:
            out = out + " | "
        out = out + type_to_string(members.get(i))
        i = i + 1
    return out

// Render `(T, U, ...)` for a tuple (T103). Always 2+ members.
func type_tuple_to_string(members: Vector<Type>) -> String:
    let mut out = "("
    let mut i = 0
    for i < members.len():
        if i > 0:
            out = out + ", "
        out = out + type_to_string(members.get(i))
        i = i + 1
    return out + ")"
