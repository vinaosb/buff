// =============================================================================
// buff_type — the resolved Buff Type of a prelude type
// =============================================================================
//
// NAMESPACE-ONLY types return Type.Void (Log / Toml / Math / Random / Strings /
// Args / Env / Base64 / Hex / URLEncode / UUID / Yaml / Json / Csv / Dir /
// Tempfile / Hash / HMAC / OS / TCP / UDP / WebSocket / Channel / Tensor /
// Signal / Window / Spectrum / Audit / Config / Observe / Fuzz / Archive /
// Jwt / Password / Rbac / MsgPack / Protobuf / AES / RSA / ECDH / Argon2 /
// File / Http / Assert — the namespace itself is never a value, only its
// associated functions are callable).
//
// RUNTIME-VALUE types return their matching Type variant (DateTime / Date /
// Time / Duration / Instant / Regex / URL / Path / Process / DataFrame /
// Image / Faker / Cache / I18n / World / Entity / Signature / ReactiveSignal
// / ReactiveComputed / ReactiveEffect / Web / Database / HttpClient /
// Strategy / Validator / Text / OAuth2Client / Email / SmtpClient / Document
// / Element / Crawler / Xml / XmlElement / Point / LineString / Polygon /
// Language / StemAlgorithm / Message / Bot / ChatMessage / Platform /
// Provider / Wallet / ConnectedWallet / Contract / ContractMethod /
// RsaKeypair / Simd / ActorSystem / ActorRef / Supervisor / ChildSpec /
// RestartStrategy / Decimal / Range).

func prelude_type_buff_type(t: PreludeType) -> Type:
    match t {
        // 1. DateTime family — all runtime-value types
        PreludeType.DateTime => return type_datetime(),
        PreludeType.Date => return type_date(),
        PreludeType.Time => return type_time(),
        PreludeType.Duration => return type_duration(),
        PreludeType.Instant => return type_instant(),
        // 2. Free-fn namespaces — Log / Toml / Math / Random / Strings /
        // Args / Env are namespace-only (Void). Regex IS a runtime value.
        PreludeType.Log => return type_void(),
        PreludeType.Regex => return type_regex(),
        PreludeType.Toml => return type_void(),
        PreludeType.Math => return type_void(),
        PreludeType.Random => return type_void(),
        PreludeType.Strings => return type_void(),
        PreludeType.Args => return type_void(),
        PreludeType.Env => return type_void(),
        // 3. Encoding namespaces — Base64 / Hex / URLEncode / UUID are
        // namespace-only. URL IS a runtime value.
        PreludeType.Base64 => return type_void(),
        PreludeType.Hex => return type_void(),
        PreludeType.URLEncode => return type_void(),
        PreludeType.UUID => return type_void(),
        PreludeType.URL => return type_url(),
        // 4. Structured-data — Yaml / Json / Csv are namespace-only.
        PreludeType.Yaml => return type_void(),
        PreludeType.Json => return type_void(),
        PreludeType.Csv => return type_void(),
        // 5. Filesystem — Path IS a runtime value. Dir / Tempfile are
        // namespace-only.
        PreludeType.Path => return type_path(),
        PreludeType.Dir => return type_void(),
        PreludeType.Tempfile => return type_void(),
        // 6. Crypto namespaces — Hash / HMAC are namespace-only.
        PreludeType.Hash => return type_void(),
        PreludeType.HMAC => return type_void(),
        // 7. System / networking — OS is namespace-only. Process IS a
        // runtime value. TCP / UDP / WebSocket / Channel are namespace-only.
        PreludeType.OS => return type_void(),
        PreludeType.Process => return type_process(),
        PreludeType.TCP => return type_void(),
        PreludeType.UDP => return type_void(),
        PreludeType.WebSocket => return type_void(),
        PreludeType.Channel => return type_void(),
        // 8. Data / media — Tensor / Signal / Window / Spectrum are
        // namespace-only at the Buff Type level for MVP. DataFrame / Image
        // / Faker / Cache / I18n ARE runtime values.
        PreludeType.Tensor => return type_void(),
        PreludeType.Signal => return type_void(),
        PreludeType.Window => return type_void(),
        PreludeType.Spectrum => return type_void(),
        PreludeType.DataFrame => return type_dataframe(),
        PreludeType.Image => return type_image(),
        PreludeType.Faker => return type_faker(),
        PreludeType.Cache => return type_cache(),
        PreludeType.I18n => return type_i18n(),
        // 9. ECS — World / Entity are runtime values.
        PreludeType.World => return type_world(),
        PreludeType.Entity => return type_entity(),
        // 10. Audit / reactive / web — Signature / ReactiveSignal /
        // ReactiveComputed / ReactiveEffect / Web are runtime values.
        // Audit is namespace-only.
        PreludeType.Audit => return type_void(),
        PreludeType.Signature => return type_user("Signature", Vector.new()),
        PreludeType.ReactiveSignal => return type_user("ReactiveSignal", Vector.new()),
        PreludeType.ReactiveComputed => return type_user("ReactiveComputed", Vector.new()),
        PreludeType.ReactiveEffect => return type_user("ReactiveEffect", Vector.new()),
        PreludeType.Web => return type_user("Web", Vector.new()),
        // 11. Server types — Database / HttpClient / Strategy / Validator
        // are runtime values. Config / Observe / Fuzz / Archive are
        // namespace-only.
        PreludeType.Database => return type_user("Database", Vector.new()),
        PreludeType.HttpClient => return type_http_client(),
        PreludeType.Config => return type_void(),
        PreludeType.Observe => return type_void(),
        PreludeType.Fuzz => return type_void(),
        PreludeType.Strategy => return type_user("Strategy", Vector.new()),
        PreludeType.Validator => return type_validator(),
        PreludeType.Archive => return type_void(),
        // 12. Text / auth — Text / OAuth2Client / Email / SmtpClient are
        // runtime values. Jwt / Password / Rbac are namespace-only.
        PreludeType.Text => return type_text(),
        PreludeType.Jwt => return type_void(),
        PreludeType.OAuth2Client => return type_user("OAuth2Client", Vector.new()),
        PreludeType.Password => return type_void(),
        PreludeType.Rbac => return type_void(),
        PreludeType.Email => return type_email(),
        PreludeType.SmtpClient => return type_smtp_client(),
        // 13. Scrape / markup — Document / Element / Crawler / Xml /
        // XmlElement are runtime values. MsgPack is namespace-only.
        PreludeType.Document => return type_document(),
        PreludeType.Element => return type_element(),
        PreludeType.Crawler => return type_crawler(),
        PreludeType.Xml => return type_xml(),
        PreludeType.XmlElement => return type_xml_element(),
        PreludeType.MsgPack => return type_void(),
        // 14. Geo — Point / LineString / Polygon are runtime values.
        PreludeType.Point => return type_point(),
        PreludeType.LineString => return type_line_string(),
        PreludeType.Polygon => return type_polygon(),
        // 15. NLP — Language / StemAlgorithm are runtime values.
        PreludeType.Language => return type_language(),
        PreludeType.StemAlgorithm => return type_stem_algorithm(),
        // 16. Interop — Protobuf is namespace-only. Message is runtime.
        PreludeType.Protobuf => return type_void(),
        PreludeType.Message => return type_message(),
        // 17. Chat — Bot / ChatMessage / Platform are runtime values.
        PreludeType.Bot => return type_bot(),
        PreludeType.ChatMessage => return type_chat_message(),
        PreludeType.Platform => return type_platform(),
        // 18. Web3 — all five are runtime values.
        PreludeType.Provider => return type_provider(),
        PreludeType.Wallet => return type_wallet(),
        PreludeType.ConnectedWallet => return type_connected_wallet(),
        PreludeType.Contract => return type_contract(),
        PreludeType.ContractMethod => return type_contract_method(),
        // 19. Crypto-2 — AES / RSA / ECDH / Argon2 are namespace-only.
        // RsaKeypair is a runtime value.
        PreludeType.AES => return type_void(),
        PreludeType.RSA => return type_void(),
        PreludeType.ECDH => return type_void(),
        PreludeType.Argon2 => return type_void(),
        PreludeType.RsaKeypair => return type_rsa_keypair(),
        // 20. SIMD + actors — all six are runtime values.
        PreludeType.Simd => return type_simd(),
        PreludeType.ActorSystem => return type_actor_system(),
        PreludeType.ActorRef => return type_actor_ref(),
        PreludeType.Supervisor => return type_supervisor(),
        PreludeType.ChildSpec => return type_child_spec(),
        PreludeType.RestartStrategy => return type_restart_strategy(),
        // 21. Stdlib batch — File / Http / Assert are namespace-only.
        // Decimal / Range are runtime values.
        PreludeType.File => return type_void(),
        PreludeType.Http => return type_void(),
        PreludeType.Assert => return type_void(),
        PreludeType.Decimal => return type_decimal(),
        PreludeType.Range => return type_range(type_int_default()),
    }

// =============================================================================
// is_namespace_only — true iff buff_type() returns Type.Void
// =============================================================================
//
// The complement of "is runtime value". Used by codegen to decide whether
// to lower `Type.method(args)` as an associated-function call (namespace-
// only) or as an instance-method call on a real runtime value.

func prelude_type_is_namespace_only(t: PreludeType) -> Bool:
    let bt = prelude_type_buff_type(t)
    return bt == type_void()

// =============================================================================
// extern_crate — the Cargo crate name to record in codegen extern_crates
// =============================================================================
//
// Returns Option.Some(crate_name) for prelude types backed by a Rust crate
// (chrono, regex, url, etc), Option.None for std-only types (File / Assert /
// Math / Strings / Args / Env / Range / OS / Process use only std). The
// codegen layer records these so the generated Cargo.toml includes the
// matching dep.
//
// The Rust reference's full match has 102 arms (one per PreludeType variant).
// The full set is enumerated below — grouped by crate for readability.

func prelude_type_extern_crate(t: PreludeType) -> Option<String>:
    // --- chrono (datetime family) ---
    if t == PreludeType.DateTime:
        return Option.Some("chrono")
    if t == PreludeType.Date:
        return Option.Some("chrono")
    if t == PreludeType.Time:
        return Option.Some("chrono")
    if t == PreludeType.Duration:
        return Option.Some("chrono")
    // --- std-only (Instant / OS / Process / Args / Env / Math / Strings /
    // File / Assert / Range) ---
    if t == PreludeType.Instant:
        return Option.None
    if t == PreludeType.OS:
        return Option.None
    if t == PreludeType.Process:
        return Option.None
    if t == PreludeType.Args:
        return Option.None
    if t == PreludeType.Env:
        return Option.None
    if t == PreludeType.Math:
        return Option.None
    if t == PreludeType.Strings:
        return Option.None
    if t == PreludeType.File:
        return Option.None
    if t == PreludeType.Assert:
        return Option.None
    if t == PreludeType.Range:
        return Option.None
    // --- tracing ---
    if t == PreludeType.Log:
        return Option.Some("tracing")
    // --- regex ---
    if t == PreludeType.Regex:
        return Option.Some("regex")
    // --- toml / serde_yml / serde_json / csv ---
    if t == PreludeType.Toml:
        return Option.Some("toml")
    if t == PreludeType.Yaml:
        return Option.Some("serde_yml")
    if t == PreludeType.Json:
        return Option.Some("serde_json")
    if t == PreludeType.Csv:
        return Option.Some("csv")
    // --- rand ---
    if t == PreludeType.Random:
        return Option.Some("rand")
    // --- encoding (base64 / hex / urlencoding / uuid) ---
    if t == PreludeType.Base64:
        return Option.Some("base64")
    if t == PreludeType.Hex:
        return Option.Some("hex")
    if t == PreludeType.URLEncode:
        return Option.Some("urlencoding")
    if t == PreludeType.UUID:
        return Option.Some("uuid")
    if t == PreludeType.URL:
        return Option.Some("url")
    // --- filesystem ---
    if t == PreludeType.Path:
        return Option.None
    if t == PreludeType.Dir:
        return Option.None
    if t == PreludeType.Tempfile:
        return Option.Some("tempfile")
    // --- crypto (sha2 / hmac / md5) ---
    if t == PreludeType.Hash:
        return Option.Some("sha2")
    if t == PreludeType.HMAC:
        return Option.Some("hmac")
    // --- networking (tokio / tokio-tungstenite) ---
    if t == PreludeType.TCP:
        return Option.Some("tokio")
    if t == PreludeType.UDP:
        return Option.Some("tokio")
    if t == PreludeType.WebSocket:
        return Option.Some("tokio-tungstenite")
    if t == PreludeType.Channel:
        return Option.None
    // --- data / media (buff-* framework crates) ---
    if t == PreludeType.Tensor:
        return Option.Some("buff-tensor")
    if t == PreludeType.Signal:
        return Option.Some("buff-dsp")
    if t == PreludeType.Window:
        return Option.Some("buff-dsp")
    if t == PreludeType.Spectrum:
        return Option.Some("buff-dsp")
    if t == PreludeType.DataFrame:
        return Option.Some("buff-dataframe")
    if t == PreludeType.Image:
        return Option.Some("buff-image")
    if t == PreludeType.Faker:
        return Option.Some("buff-fake")
    if t == PreludeType.Cache:
        return Option.Some("buff-cache")
    if t == PreludeType.I18n:
        return Option.Some("buff-i18n")
    // --- ECS ---
    if t == PreludeType.World:
        return Option.Some("buff-ecs")
    if t == PreludeType.Entity:
        return Option.Some("buff-ecs")
    // --- audit / reactive / web ---
    if t == PreludeType.Audit:
        return Option.Some("buff-audit")
    if t == PreludeType.Signature:
        return Option.Some("buff-audit")
    if t == PreludeType.ReactiveSignal:
        return Option.Some("buff-reactive")
    if t == PreludeType.ReactiveComputed:
        return Option.Some("buff-reactive")
    if t == PreludeType.ReactiveEffect:
        return Option.Some("buff-reactive")
    if t == PreludeType.Web:
        return Option.Some("buff-web")
    // --- server types ---
    if t == PreludeType.Database:
        return Option.Some("buff-db")
    if t == PreludeType.HttpClient:
        return Option.Some("buff-http-client")
    if t == PreludeType.Config:
        return Option.Some("buff-config")
    if t == PreludeType.Observe:
        return Option.Some("buff-observe")
    if t == PreludeType.Fuzz:
        return Option.Some("buff-fuzz")
    if t == PreludeType.Strategy:
        return Option.Some("buff-fuzz")
    if t == PreludeType.Validator:
        return Option.Some("buff-validate")
    if t == PreludeType.Archive:
        return Option.Some("buff-archive")
    // --- text / auth ---
    if t == PreludeType.Text:
        return Option.Some("buff-nlp")
    if t == PreludeType.Jwt:
        return Option.Some("jsonwebtoken")
    if t == PreludeType.OAuth2Client:
        return Option.Some("buff-auth")
    if t == PreludeType.Password:
        return Option.Some("buff-auth")
    if t == PreludeType.Rbac:
        return Option.Some("buff-auth")
    if t == PreludeType.Email:
        return Option.Some("buff-email")
    if t == PreludeType.SmtpClient:
        return Option.Some("buff-email")
    // --- scrape / markup ---
    if t == PreludeType.Document:
        return Option.Some("buff-scrape")
    if t == PreludeType.Element:
        return Option.Some("buff-scrape")
    if t == PreludeType.Crawler:
        return Option.Some("buff-scrape")
    if t == PreludeType.Xml:
        return Option.Some("buff-xml")
    if t == PreludeType.XmlElement:
        return Option.Some("buff-xml")
    if t == PreludeType.MsgPack:
        return Option.Some("rmp")
    // --- geo ---
    if t == PreludeType.Point:
        return Option.Some("buff-geo")
    if t == PreludeType.LineString:
        return Option.Some("buff-geo")
    if t == PreludeType.Polygon:
        return Option.Some("buff-geo")
    // --- NLP ---
    if t == PreludeType.Language:
        return Option.Some("buff-nlp")
    if t == PreludeType.StemAlgorithm:
        return Option.Some("buff-nlp")
    // --- interop ---
    if t == PreludeType.Protobuf:
        return Option.Some("buff-protobuf")
    if t == PreludeType.Message:
        return Option.Some("buff-protobuf")
    // --- chat ---
    if t == PreludeType.Bot:
        return Option.Some("buff-chat")
    if t == PreludeType.ChatMessage:
        return Option.Some("buff-chat")
    if t == PreludeType.Platform:
        return Option.Some("buff-chat")
    // --- web3 ---
    if t == PreludeType.Provider:
        return Option.Some("buff-web3")
    if t == PreludeType.Wallet:
        return Option.Some("buff-web3")
    if t == PreludeType.ConnectedWallet:
        return Option.Some("buff-web3")
    if t == PreludeType.Contract:
        return Option.Some("buff-web3")
    if t == PreludeType.ContractMethod:
        return Option.Some("buff-web3")
    // --- crypto-2 ---
    if t == PreludeType.AES:
        return Option.Some("buff-crypto-extras")
    if t == PreludeType.RSA:
        return Option.Some("buff-crypto-extras")
    if t == PreludeType.ECDH:
        return Option.Some("buff-crypto-extras")
    if t == PreludeType.Argon2:
        return Option.Some("buff-crypto-extras")
    if t == PreludeType.RsaKeypair:
        return Option.Some("buff-crypto-extras")
    // --- SIMD + actors ---
    if t == PreludeType.Simd:
        return Option.Some("buff-simd")
    if t == PreludeType.ActorSystem:
        return Option.Some("buff-actors")
    if t == PreludeType.ActorRef:
        return Option.Some("buff-actors")
    if t == PreludeType.Supervisor:
        return Option.Some("buff-actors")
    if t == PreludeType.ChildSpec:
        return Option.Some("buff-actors")
    if t == PreludeType.RestartStrategy:
        return Option.Some("buff-actors")
    // --- stdlib batch (Http uses reqwest; Decimal uses rust_decimal) ---
    if t == PreludeType.Http:
        return Option.Some("reqwest")
    if t == PreludeType.Decimal:
        return Option.Some("rust_decimal")
    return Option.None

// =============================================================================
// Lookups (the public free functions)
// =============================================================================

// True iff `name` is a recognised prelude-type identifier (case-sensitive).
// Replaces Rust's `ALL.iter().any(|t| t.name() == name)`.
func is_prelude_type(name: String) -> Bool:
    let all = prelude_type_all()
    let mut i = 0
    for i < all.len():
        if prelude_type_name(all.get(i)) == name:
            return true
        i = i + 1
    return false

// Look up a prelude type by its source name. Returns Option.None when the
// name is not a recognised prelude type.
func prelude_type_lookup(name: String) -> Option<PreludeType>:
    let all = prelude_type_all()
    let mut i = 0
    for i < all.len():
        let t = all.get(i)
        if prelude_type_name(t) == name:
            return Option.Some(t)
        i = i + 1
    return Option.None
