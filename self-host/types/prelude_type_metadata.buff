// Buff self-host port of `crates/buff-lang-types/src/prelude_type_metadata.rs`
// (T17, Track C).
//
// T105b: PreludeType metadata impl + lookup helpers.
// MECHANICAL EXTRACTION from prelude_types.rs (T105b God Class split) — no
// logic changes, moved verbatim. The `impl PreludeType` block + the
// `is_prelude_type` / `prelude_type_lookup` free functions live here; the
// `pub enum PreludeType` definition stays in prelude_types.buff.
//
// RUST IDIOM MAPPING:
//   impl PreludeType { pub fn x(self).. } -> func prelude_type_x(t) ..
//   pub const ALL: &[PreludeType]       -> func prelude_type_all() -> Vector<PreludeType>
//   match self { A => Type::X, ... }    -> inline match { A => return type_x(), ... }
//   &str                                 -> String

// =============================================================================
// ALL — every prelude type in declared order
// =============================================================================
//
// Future v1.4+ tasks append variants here. The Rust reference uses a static
// slice; Buff uses a function that returns a fresh Vector each call (Buff
// has no static slices).

func prelude_type_all() -> Vector<PreludeType>:
    let out = Vector.new()
    // 1. DateTime family (T124b)
    out.push(PreludeType.DateTime)
    out.push(PreludeType.Date)
    out.push(PreludeType.Time)
    out.push(PreludeType.Duration)
    out.push(PreludeType.Instant)
    // 2. Free-fn namespaces (T124c-T124g)
    out.push(PreludeType.Log)
    out.push(PreludeType.Regex)
    out.push(PreludeType.Toml)
    out.push(PreludeType.Math)
    out.push(PreludeType.Random)
    out.push(PreludeType.Strings)
    out.push(PreludeType.Args)
    out.push(PreludeType.Env)
    // 3. Encoding namespaces (T124h)
    out.push(PreludeType.Base64)
    out.push(PreludeType.Hex)
    out.push(PreludeType.URLEncode)
    out.push(PreludeType.UUID)
    out.push(PreludeType.URL)
    // 4. URL + structured-data (T124i, T23)
    out.push(PreludeType.Yaml)
    out.push(PreludeType.Json)
    out.push(PreludeType.Csv)
    // 5. Filesystem (T124j)
    out.push(PreludeType.Path)
    out.push(PreludeType.Dir)
    out.push(PreludeType.Tempfile)
    // 6. Crypto (T124k)
    out.push(PreludeType.Hash)
    out.push(PreludeType.HMAC)
    // 7. System / networking (T124l, T124m, T2)
    out.push(PreludeType.OS)
    out.push(PreludeType.Process)
    out.push(PreludeType.TCP)
    out.push(PreludeType.UDP)
    out.push(PreludeType.WebSocket)
    out.push(PreludeType.Channel)
    // 8. Data / media (T8, T11, T7, T9, T37, T31, T44)
    out.push(PreludeType.Tensor)
    out.push(PreludeType.Signal)
    out.push(PreludeType.Window)
    out.push(PreludeType.Spectrum)
    out.push(PreludeType.DataFrame)
    out.push(PreludeType.Image)
    out.push(PreludeType.Faker)
    out.push(PreludeType.Cache)
    out.push(PreludeType.I18n)
    // 9. ECS (T12)
    out.push(PreludeType.World)
    out.push(PreludeType.Entity)
    // 10. Audit / reactive / web (T30, T56)
    out.push(PreludeType.Audit)
    out.push(PreludeType.Signature)
    out.push(PreludeType.ReactiveSignal)
    out.push(PreludeType.ReactiveComputed)
    out.push(PreludeType.ReactiveEffect)
    out.push(PreludeType.Web)
    // 11. Server types (T13, T33, T14)
    out.push(PreludeType.Database)
    out.push(PreludeType.HttpClient)
    out.push(PreludeType.Config)
    out.push(PreludeType.Observe)
    out.push(PreludeType.Fuzz)
    out.push(PreludeType.Strategy)
    out.push(PreludeType.Validator)
    out.push(PreludeType.Archive)
    // 12. Text / auth (T46, T15)
    out.push(PreludeType.Text)
    out.push(PreludeType.Jwt)
    out.push(PreludeType.OAuth2Client)
    out.push(PreludeType.Password)
    out.push(PreludeType.Rbac)
    out.push(PreludeType.Email)
    out.push(PreludeType.SmtpClient)
    // 13. Scrape / markup (T43, T50, T51)
    out.push(PreludeType.Document)
    out.push(PreludeType.Element)
    out.push(PreludeType.Crawler)
    out.push(PreludeType.Xml)
    out.push(PreludeType.XmlElement)
    out.push(PreludeType.MsgPack)
    // 14. Geo (T45)
    out.push(PreludeType.Point)
    out.push(PreludeType.LineString)
    out.push(PreludeType.Polygon)
    // 15. NLP (T46)
    out.push(PreludeType.Language)
    out.push(PreludeType.StemAlgorithm)
    // 16. Interop
    out.push(PreludeType.Protobuf)
    out.push(PreludeType.Message)
    // 17. Chat (T47)
    out.push(PreludeType.Bot)
    out.push(PreludeType.ChatMessage)
    out.push(PreludeType.Platform)
    // 18. Web3 (T48)
    out.push(PreludeType.Provider)
    out.push(PreludeType.Wallet)
    out.push(PreludeType.ConnectedWallet)
    out.push(PreludeType.Contract)
    out.push(PreludeType.ContractMethod)
    // 19. Crypto-2 (T49)
    out.push(PreludeType.AES)
    out.push(PreludeType.RSA)
    out.push(PreludeType.ECDH)
    out.push(PreludeType.Argon2)
    out.push(PreludeType.RsaKeypair)
    // 20. SIMD + actors (T54, T59)
    out.push(PreludeType.Simd)
    out.push(PreludeType.ActorSystem)
    out.push(PreludeType.ActorRef)
    out.push(PreludeType.Supervisor)
    out.push(PreludeType.ChildSpec)
    out.push(PreludeType.RestartStrategy)
    // 21. Stdlib batch (T25, T26, T89, T84)
    out.push(PreludeType.File)
    out.push(PreludeType.Http)
    out.push(PreludeType.Assert)
    out.push(PreludeType.Decimal)
    out.push(PreludeType.Range)
    return out

