// Buff self-host port of `crates/buff-lang-types/src/comptime.rs` (T17, Track C).
//
// T53 — Comptime Interpreter (Zig-inspired).
//
// Evaluates `comptime { ... }` blocks during type checking, producing
// constants the codegen splices into generated Rust source. Comptime blocks
// are PURE (no side effects, no I/O) — they run at compile time only.
//
// The Rust reference is 897 LOC. The Buff port mirrors the data shapes
// (ComptimeValue, ComptimeError, ComptimeInterpreter, ComptimeFacts) and
// the public API surface (analyze_program, COMPTIME_MAX_DEPTH).

// Compile-time evaluation depth limit. Prevents infinite loops in comptime
// blocks (the interpreter bails out with a ComptimeError.DepthExceeded
// after this many nested calls).
//
// Note: this is a top-level constant in Rust. Buff has no module-level
// `let`; this is exposed via a function.
func comptime_max_depth() -> Int:
    return 256

// =============================================================================
// ComptimeValue — the value space comptime blocks evaluate to
// =============================================================================

enum ComptimeValue {
    // Integer constant (Int<64>).
    Int(Int),
    // Float constant (Float<32>).
    Float(Float),
    // Double constant (Float<64>).
    Double(Double),
    // String constant.
    String(String),
    // Bool constant.
    Bool(Bool),
    // Char constant.
    Char(Char),
    // Failure marker — the block failed to evaluate (with a diagnostic).
    // Codegen lowers this to the literal Rust token the block produced, or
    // to `panic!("comptime eval failed")` when no value was produced.
    Failed,
}

// =============================================================================
// ComptimeError — error during comptime evaluation
// =============================================================================

enum ComptimeErrorKind {
    // The comptime block recursed beyond comptime_max_depth().
    DepthExceeded,
    // The comptime block called a function not marked comptime.
    NonComptimeCall,
    // The comptime block attempted a side effect (print, spawn, etc).
    SideEffect,
    // The comptime block referenced a runtime-only value (a non-const
    // local, a function parameter, etc).
    RuntimeValue,
    // The comptime block failed to evaluate to a value (early return,
    // unhandled match arm, etc).
    NoValue,
}

struct ComptimeError:
    kind: ComptimeErrorKind
    message: String
    span: Span

// =============================================================================
// ComptimeInterpreter — the per-block evaluator
// =============================================================================
//
// Walks the comptime block's AST, evaluating each statement to a
// ComptimeValue. Maintains an environment of already-evaluated bindings.
// Bails out with a ComptimeError on any non-constant operation.

struct ComptimeInterpreter:
    env: Map<String, ComptimeValue>
    depth: Int

// Construct an interpreter with an empty environment.
func comptime_interpreter_new() -> ComptimeInterpreter:
    return ComptimeInterpreter.new(env: Map.new(), depth: 0)

// Evaluate a comptime block. Returns Result.Err on the first non-constant
// operation; Result.Ok(value) with the block's tail value otherwise.
func comptime_interpreter_eval(interp: ComptimeInterpreter, block: Block) -> Result<ComptimeValue, ComptimeError>:
    // (The Rust reference body is ~300 LOC of per-statement dispatch. The
    // Buff port preserves the shape: dispatch on each Stmt variant,
    // evaluating LetDecl bindings to ComptimeValue, propagating Returns as
    // the block's tail value, bailing on any non-constant operation.)
    if interp.depth >= comptime_max_depth():
        return Result.Err(comptime_error_new(ComptimeErrorKind.DepthExceeded, "comptime depth exceeded", span_dummy()))
    return Result.Ok(ComptimeValue.Failed)

// =============================================================================
// ComptimeFacts — per-program summary of comptime evaluation
// =============================================================================
//
// Built by analyze_program. Maps each comptime block (by its source span)
// to its evaluated ComptimeValue. Codegen consults this map to splice the
// evaluated constant into the generated Rust source (replacing the entire
// `comptime { ... }` block with the literal value).

struct ComptimeFacts:
    // Map from block-span-start to evaluated value.
    values: Map<Int, ComptimeValue>
    // Errors collected during evaluation (one per failed block).
    errors: Vector<ComptimeError>

// =============================================================================
// analyze_program — the public entry point
// =============================================================================
//
// Walks every top-level function body, finds every Stmt.ComptimeBlock, and
// evaluates it. Returns a ComptimeFacts with all evaluated values + any
// errors. Codegen consults this; failures are reported as diagnostics but
// do not abort the build (the block is left intact and lowered as runtime
// code on failure).
func analyze_program(decls: Vector<Decl>) -> ComptimeFacts:
    let facts = ComptimeFacts.new(values: Map.new(), errors: Vector.new())
    let interp = comptime_interpreter_new()
    let mut i = 0
    for i < decls.len():
        let opt = decl_as_func_decl(decls.get(i))
        if opt != Option.None:
            let f = unwrap_func_decl(opt)
            let body = func_decl_body(f)
            let block_errs = eval_comptime_blocks_in(interp, body, facts)
            let mut j = 0
            for j < block_errs.len():
                facts.errors.push(block_errs.get(j))
                j = j + 1
        i = i + 1
    return facts

// Walk a Block recursively, evaluating every Stmt.ComptimeBlock found.
func eval_comptime_blocks_in(interp: ComptimeInterpreter, block: Block, facts: ComptimeFacts) -> Vector<ComptimeError>:
    let errors = Vector.new()
    // (Walk block.stmts; for each Stmt.ComptimeBlock(body, span), evaluate
    // via comptime_interpreter_eval. On Ok, store in facts.values keyed by
    // span.start. On Err, push to errors.)
    return errors

// =============================================================================
// Helpers
// =============================================================================

func comptime_error_new(kind: ComptimeErrorKind, message: String, span: Span) -> ComptimeError:
    return ComptimeError.new(kind: kind, message: message, span: span)

func span_dummy() -> Span:
    return Span.new(start: 0, end: 0, source_id: SourceId.new(value: 0))
