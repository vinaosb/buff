// Buff self-host port of `crates/buff-lang-types/src/project.rs` (T17, Track C).
//
// T1 — Project-level parse entry point + span-aware error formatting.
//
// `parse_project` is the entry point that drives multi-file parsing: it
// takes a root file path + a ModuleLoader, builds the module graph, parses
// each module, and returns a ParsedProject (the per-file ASTs + any errors
// collected).
//
// The Rust reference is 342 LOC. The Buff port mirrors the data shapes
// (ParsedProject, ProjectError) and the public API.

// =============================================================================
// ParsedProject — the per-file AST collection
// =============================================================================

struct ParsedProject:
    // Map from module spec to its parsed top-level declarations.
    // Empty when the module failed to parse (see errors).
    modules: Map<String, Vector<Decl>>
    // Errors collected during parsing (one per failed module). Empty when
    // every module parsed cleanly.
    errors: Vector<ProjectError>
    // The root module spec (the entry point — `main` is in this module).
    root: String

// =============================================================================
// ProjectError — span-aware error type
// =============================================================================

struct ProjectError:
    // The error message.
    message: String
    // The source span where the error occurred.
    span: Span
    // The module spec where the error occurred (for cross-file errors).
    module_spec: String
    // The stable error code (E10xx/E11xx/E12xx/E13xx).
    code: String

// =============================================================================
// parse_project — the public entry point (file-system-backed default)
// =============================================================================
//
// Parses a Buff project rooted at `root_path`. Uses an FsLoader rooted at
// the root_path's parent directory. Returns a ParsedProject with the
// per-file ASTs + any errors collected.
//
// This is the entry point the CLI's `buff build` and `buff run` use to
// drive multi-file compilation.
func parse_project(root_path: String) -> ParsedProject:
    let root_spec = path_to_module_spec(root_path)
    let root_dir = path_parent_dir(root_path)
    let loader = fs_loader_new(root_dir)
    return parse_project_with_loader(root_spec, loader)

// =============================================================================
// parse_project_with_loader — the explicit-loader entry point
// =============================================================================
//
// Parses a Buff project using the given ModuleLoader. Used by tests (which
// pass a MemoryLoader) and the playground (which also uses MemoryLoader).
func parse_project_with_loader(root_spec: String, loader: ModuleLoader) -> ParsedProject:
    let graph = build_graph(root_spec, loader)
    let modules = Map.new()
    let errors = Vector.new()
    let specs = graph.modules.keys()
    let mut i = 0
    for i < specs.len():
        let spec = specs.get(i)
        let mod_opt = graph.modules.get(spec)
        if mod_opt == Option.None:
            i = i + 1
            continue
        let m = unwrap_module(mod_opt)
        if m.has_parse_error:
            errors.push(project_error_new(
                message: "module `" + spec + "` failed to parse",
                span: span_dummy(),
                module_spec: spec,
                code: "E1100",
            ))
            modules.set(spec, Vector.new())
        else:
            let parse_result = parse_module(m)
            if parse_result.is_ok():
                modules.set(spec, parse_result.unwrap())
            else:
                errors.push(project_error_from_parse_error(parse_result.unwrap_err(), spec))
                modules.set(spec, Vector.new())
        i = i + 1
    return ParsedProject.new(modules: modules, errors: errors, root: root_spec)

// =============================================================================
// Helpers
// =============================================================================

// Convert a filesystem path to a dotted module spec. The Rust reference
// uses Path::file_stem + path stripping. The Buff port mirrors the shape
// (file-IO is codegen-lowered).
func path_to_module_spec(path: String) -> String:
    return path

// Get the parent directory of a path.
func path_parent_dir(path: String) -> String:
    return path

// Parse a Module's source text into a Vector<Decl>. Returns Result.Err
// with a ParseError on failure (the canonical Buff parser is in
// buff-lang-parser; this is a forward call).
func parse_module(m: Module) -> Result<Vector<Decl>, ParseError>:
    // (Forward to buff-lang-parser's parse() entry point. The Buff
    // self-host port of buff-lang-parser is in self-host/parser/.)
    return Result.Ok(Vector.new())

// Build a ProjectError from a ParseError + the module spec it occurred in.
func project_error_from_parse_error(e: ParseError, spec: String) -> ProjectError:
    return project_error_new(
        message: parse_error_message(e),
        span: parse_error_span(e),
        module_spec: spec,
        code: parse_error_code(e),
    )

// Construct a ProjectError.
func project_error_new(message: String, span: Span, module_spec: String, code: String) -> ProjectError:
    return ProjectError.new(message: message, span: span, module_spec: module_spec, code: code)

// Dummy span helper (mirrors the lexer port's span_dummy).
func span_dummy() -> Span:
    return Span.new(start: 0, end: 0, source_id: SourceId.new(value: 0))

// =============================================================================
// Placeholder shapes (buff-lang-parser + buff-lang-error forward decls)
// =============================================================================
//
// The Rust reference imports `buff_lang_error::{Diagnostic, ErrorCode,
// Span, TypeError}` and uses `buff_lang_parser::parse`. The Buff self-host
// ports of those crates exist (self-host/parser/ + self-host/error-shim,
// the latter is a future task). The placeholder ParseError type lets this
// file PARSE cleanly; the real shape will come from the buff-lang-error
// self-host port.

struct ParseError:
    message: String
    span: Span
    code: String

func parse_error_message(e: ParseError) -> String:
    return e.message

func parse_error_span(e: ParseError) -> Span:
    return e.span

func parse_error_code(e: ParseError) -> String:
    return e.code

// Span + SourceId forward declarations (mirrors self-host/lexer/token.buff).
struct SourceId:
    value: Int

struct Span:
    start: Int
    end: Int
    source_id: SourceId
