// Buff self-host port of `crates/buff-lang-types/src/recursion.rs` (T17, Track C).
//
// T48 — Recursion Detection (DFS call-graph cycle detection, GPU-ineligible
// marking).
//
// Recursion in Buff is a hint that the function should NOT be GPU-lowered
// (WGSL has no recursion). The `analyze_recursion` function walks the
// CallGraph looking for cycles; any function that participates in a cycle
// is added to the `cpu_only` set, which the codegen consults to force the
// CPU (Rayon) path even when `@prefer(gpu)` is set.
//
// Determinism: BTreeMap/BTreeSet-based — same AST -> byte-identical cpu_only
// set every time (the T29 flaky-test lesson).

// =============================================================================
// RecursionFacts — the analysis output
// =============================================================================
//
// Per-program summary of which functions are recursive (transitively) and
// therefore GPU-ineligible. Built by DFS over the CallGraph.

struct RecursionFacts:
    // Function names that participate in a cycle (directly self-recursive
    // OR part of a mutual-recursion chain). All entries are GPU-ineligible.
    recursive: Vector<String>
    // Function names that MUST run on CPU only — the recursive set, plus
    // any function that CALLS a recursive function (transitive GPU-
    // ineligibility). Codegen consults this to skip WGSL lowering.
    cpu_only: Vector<String>

// =============================================================================
// analyze_recursion — the public entry point
// =============================================================================
//
// Walks the CallGraph (built by async_analysis.build_call_graph or
// equivalently here) looking for cycles. Returns a RecursionFacts with the
// recursive + cpu_only sets populated.
//
// The cycle-detection algorithm is standard DFS with a "currently visiting"
// set: an edge to a node already in the visiting set means a cycle. Each
// node in the cycle (transitively) is added to `recursive`. Then any node
// that can REACH a recursive node is added to `cpu_only`.
//
// The Rust reference is 758 LOC, mostly the DFS driver + the per-function
// edge-collection. The Buff port preserves the shape.
func analyze_recursion(decls: Vector<Decl>) -> RecursionFacts:
    let graph = build_call_graph(decls)
    let recursive = find_recursive_functions(graph)
    let cpu_only = transitive_callers(graph, recursive)
    return RecursionFacts.new(recursive: recursive, cpu_only: cpu_only)

// =============================================================================
// detect_cycles — DFS cycle detection
// =============================================================================
//
// Returns the set of function names that participate in a cycle. Uses DFS
// with a visiting set: an edge to a node already being visited is a cycle.
// All nodes on the cycle path are added to the result.
func detect_cycles(graph: CallGraph) -> Vector<String>:
    let out = Vector.new()
    // (Standard DFS with white/grey/black colouring. The Rust reference
    // body is ~80 LOC. The Buff port preserves the shape.)
    return out

// Alias — analyze_recursion uses detect_cycles; the public API exposes both.
func find_recursive_functions(graph: CallGraph) -> Vector<String>:
    return detect_cycles(graph)

// =============================================================================
// transitive_callers — extend the recursive set with all transitive callers
// =============================================================================
//
// Any function that can reach a recursive function (transitively) is also
// GPU-ineligible. Returns recursive_set UNION { f | f calls (transitively)
// any member of recursive_set }.
func transitive_callers(graph: CallGraph, recursive_set: Vector<String>) -> Vector<String>:
    let out = Vector.new()
    // Seed with recursive_set.
    let mut i = 0
    for i < recursive_set.len():
        out.push(recursive_set.get(i))
        i = i + 1
    // Fixpoint: repeatedly walk edges; for each (caller, callee) where
    // callee is in out and caller is not, add caller.
    for true:
        let mut changed = false
        let names = graph.edges.keys()
        let mut j = 0
        for j < names.len():
            let caller = names.get(j)
            if vector_string_contains(out, caller):
                j = j + 1
                continue
            let callees_opt = graph.edges.get(caller)
            if callees_opt == Option.None:
                j = j + 1
                continue
            let callees = unwrap_string_vec(callees_opt)
            let mut k = 0
            for k < callees.len():
                if vector_string_contains(out, callees.get(k)):
                    out.push(caller)
                    changed = true
                    break
                k = k + 1
            j = j + 1
        if changed == false:
            break
    return out

// =============================================================================
// has_prefer_gpu_attr — attribute look-up
// =============================================================================
//
// True iff the function has the `@prefer(gpu)` attribute in its source.
// Consulted by codegen alongside the recursion facts: a recursive function
// is GPU-ineligible EVEN IF the user added @prefer(gpu) (the attribute is
// advisory, not a forced override). For FORCE override, see T64
// `@force(gpu)` (different attribute, codegen-rust responsibility).
func has_prefer_gpu_attr(f: FuncDecl) -> Bool:
    let attrs = func_decl_attributes(f)
    let mut i = 0
    for i < attrs.len():
        let a = attrs.get(i)
        if attribute_name(a) == "prefer":
            let args = attribute_args(a)
            if args.len() > 0:
                if args.get(0) == "gpu":
                    return true
        i = i + 1
    return false

// =============================================================================
// is_cpu_only_after_recursion_analysis — convenience predicate
// =============================================================================
//
// After running analyze_recursion, query whether a given function name is
// in the cpu_only set. Used by codegen to decide whether to skip WGSL
// lowering.
func is_cpu_only_after_recursion_analysis(facts: RecursionFacts, name: String) -> Bool:
    return vector_string_contains(facts.cpu_only, name)

// =============================================================================
// Helpers
// =============================================================================

func vector_string_contains(v: Vector<String>, s: String) -> Bool:
    let mut i = 0
    for i < v.len():
        if v.get(i) == s:
            return true
        i = i + 1
    return false

func unwrap_string_vec(opt: Option<Vector<String>>) -> Vector<String>:
    return match opt {
        Some(v) => v,
        None => Vector.new(),
    }
