// Buff self-host port of `crates/buff-lang-parser/src/expr/expr_pattern.rs` (P4.1a).
//
// Pattern + match + closure parsers — extracted from `expr.rs` (T106
// mechanical split, mirrored here).
//
// Contains `parse_match` (T27 match-expression), `parse_pattern` (the
// recursive pattern matcher, T27/T71/T39/T41), and `parse_closure` (lambda
// `{ params => expr }`, T23).
//
// Faithful 1:1 translation of the Rust reference. Translation decisions
// (deviations from Rust grammar, per porting-conventions §1) — in addition
// to those documented in `expr.buff` (which this file mirrors):
//   * `Buff match` syntax (brace form, consistent with map/struct-init
//     "braces are data" rule from the README):
//
//       match scrutinee {
//           Pattern => body,
//           _       => fallback,
//       }
//
//   * Bare identifiers in match arms are AMBIGUOUS at parse time: `Red` could
//     be a unit variant reference OR a fresh binding (Rust resolves this with
//     type information; Buff defers the same way). The parser emits
//     `Pattern.Ident`.
//   * `if let Some(x) = opt` (Rust) -> `let some_x = opt; if some_x !=
//     Option.None: let x = unwrap(some_x)` (Buff has no `if let`).
//   * `matches!(kind, A | B | C)` (Rust or-pattern) -> `(kind == K.A) ||
//     (kind == K.B) || (kind == K.C)` (Buff `match` rejects or-patterns —
//     porting-conventions §8e).
//   * Bool-returning function calls in `if` conditions use `== true` /
//     `== false` — the Buff type-checker has a known gap where a function-
//     call result used directly as a Bool condition comes back as Unknown
//     (same gap as `expr.buff` / `stream.buff` line 338). `return fn()`
//     works fine; only `if fn():` is affected.
//   * `let guard = if matches!(...) { Some(..) } else { None }` (Rust
//     if-as-expression) -> helper function `parse_match_guard(s)` returning
//     `Option<Expr>` (Buff `if` is a statement, not an expression; factored
//     into a function so the caller gets a single-expression return).
//   * `let mut arm_end;` (Rust uninitialised) -> `let mut arm_end = 0`
//     (Buff has no uninitialised bindings; the value is overwritten before
//     use in every code path).
//   * `Stmt::Return(ret_expr, span)` / `Stmt::ExprStmt(expr, span)` ->
//     `Stmt.Return(ret_expr, span)` / `Stmt.ExprStmt(expr, span)` (tuple-
//     variant construction cross-file from `self-host/ast/stmt.buff`).
//   * `Block { stmts, span }` -> `Block.new(stmts: ..., span: ...)`.
//   * `Param { name, ty: TypeRef::Named { name: "_", span }, .. }` ->
//     `Param.new(name: ..., ty: TypeRef.Named(ident_new("_", span), span), ...)`
//     (TypeRef tuple-variant from `self-host/ast/ty.buff`).
//   * `stream.advance().unwrap()` (Rust infallible unwrap after peek) ->
//     `stream_advance_after_peek(s)` (Buff has no infallible unwrap; the
//     `_after_peek` companion returns a sentinel on contract violation).
//   * `format!("expected `,` or `}}` after match arm, found `{other}`")` ->
//     string concatenation (no `format!`; no backticks inside string
//     literals per task brief).
//   * `if/else: break` inside `for true:` restructured to `if cond == false:
//     break` (early exit) — Buff's layout parser mis-parses some
//     `if/else`-with-break patterns as continuing the enclosing function body.
//
// Numeric widths map to the natural Buff primitives: usize / i64 -> Int.

// ===========================================================================
// SECTION 1 — Helpers (defined first; single-pass type-checker requires
// Bool-returning helpers to appear before any `if fn() == true:` use site).
// ===========================================================================

// Whether a token's kind is one of the literal-pattern kinds (integer / float
// / double / byte / char / decimal / bool / string). Used by
// `parse_pattern_atom` to decide whether to route through `parse_primary`.
func is_literal_pattern_kind(kind: TokenKind) -> Bool:
    if is_numeric_lit_kind(kind) == true:
        return true
    if kind == TokenKind.CharLit:
        return true
    if kind == TokenKind.KwTrue:
        return true
    if kind == TokenKind.KwFalse:
        return true
    if kind == TokenKind.StringStart:
        return true
    return false

// Whether a token's kind is `Ident(_)`. Replaces Rust
// `matches!(tok.kind, TokenKind::Ident(_))`.
func is_ident_kind(kind: TokenKind) -> Bool:
    return match kind {
        Ident(_) => true,
        _ => false,
    }

// Whether a token's kind is `IntLit(_)`. Used by the negative-literal
// lookahead in `parse_pattern_atom`.
func is_int_lit_kind(kind: TokenKind) -> Bool:
    return match kind {
        IntLit(_) => true,
        _ => false,
    }

// The name text inside an `Ident(name)` token kind.
func ident_kind_name(kind: TokenKind) -> String:
    return match kind {
        Ident(s) => s,
        _ => "",
    }

// The integer value inside an `IntLit(v)` token kind. Returns 0 for non-Int.
func int_lit_value(kind: TokenKind) -> Int:
    return match kind {
        IntLit(v) => v,
        _ => 0,
    }

// Whether a literal `Expr` produced by `parse_primary` is in fact a
// `Literal` (the only valid result for a pattern position).
func expr_as_literal(e: Expr) -> Option<(Literal, Span)>:
    return match e {
        Literal(lit, span) => Option.Some((lit, span)),
        _ => Option.None,
    }

// Helper: unwrap Option<(Literal, Span)> (contract: Some).
func unwrap_literal_span(opt: Option<(Literal, Span)>) -> (Literal, Span):
    return match opt {
        Some(pair) => pair,
        None => (Literal.Int(0), span_dummy()),
    }

// Helper: the last element of a non-empty Pattern vector (contract: non-empty).
func vec_last_pattern(v: Vector<Pattern>) -> Pattern:
    return v[v.len() - 1]

// ===========================================================================
// SECTION 2 — `parse_match` (T27 match-expression).
// ===========================================================================

// Parse a `match scrutinee { arm, arm, ... }` expression whose `match`
// keyword is the next significant token (T27).
//
// Shape: `match EXPR { PAT => EXPR (, PAT => EXPR)* ,? }`. The scrutinee is a
// full expression. Each arm body is a single expression wrapped in a
// one-statement block. Trailing comma is allowed. Builds an `Expr.MatchExpr`.
export func parse_match(s: TokenStream) -> Result<Expr, ParseError>:
    let kw = stream_expect(s, TokenKind.KwMatch)?
    let start = kw.span.start
    let source_id = stream_source_id(s)
    // Scrutinee: a full expression.
    let scrutinee = parse_expression(s)?
    // Opening `{`.
    let _lb = stream_expect(s, TokenKind.LBrace)?
    let mut arms: Vector<MatchArm> = Vector.new()
    // Empty body `match e { }` is allowed.
    if stream_peek_kind(s) == Option.Some(TokenKind.RBrace):
        let rb = stream_expect(s, TokenKind.RBrace)?
        let span = span_new(start, rb.span.end, source_id)
        return Result.Ok(Expr.MatchExpr(scrutinee, arms, span))
    for true:
        let pat = parse_pattern(s)?
        // T40: optional `if <cond>` pattern guard.
        let guard_expr = parse_match_guard(s)?
        let _arrow = stream_expect(s, TokenKind.FatArrow)?
        // Parse the arm body (return-statement or single-expression).
        let arm_tok_span = pattern_span(pat)
        let body = parse_match_arm_body(s, arm_tok_span, source_id)?
        let arm_end = block_span_end(body)
        arms.push(MatchArm.new(pattern: pat, guard_expr: guard_expr, body: body, span: span_new(arm_tok_span.start, arm_end, source_id)))
        // Comma / RBrace / other dispatch. Flat if/break/return chain (no
        // `else` — Buff's layout parser mis-parses `if/else` with break
        // inside `for true:` as continuing the enclosing function body).
        let pk = stream_peek_kind(s)
        let is_comma = pk == Option.Some(TokenKind.Comma)
        let is_rbrace = pk == Option.Some(TokenKind.RBrace)
        if is_comma:
            let _consumed = stream_advance(s)
            // Allow trailing comma.
            if stream_peek_kind(s) == Option.Some(TokenKind.RBrace):
                break
        if is_rbrace:
            break
        // Other token or EOF — error.
        if pk == Option.None:
            return Result.Err(err_with("unterminated match expression (missing close brace)", stream_eof_span(s), ErrorCode.UnterminatedMatch))
        let found = token_kind_to_string(stream_unwrap_kind(pk))
        return Result.Err(err_with("expected `,` or close-brace after match arm, found " + found, peek_span_or_eof(s), ErrorCode.ExpectedToken))
    let rb = stream_expect(s, TokenKind.RBrace)?
    let span = span_new(start, rb.span.end, source_id)
    return Result.Ok(Expr.MatchExpr(scrutinee, arms, span))

// Helper: parse the optional `if <cond>` guard of a match arm (T40). Returns
// `Option.None` when no guard is present; `Option.Some(expr)` otherwise.
// Factored out so `parse_match`'s arm loop stays linear (Buff has no if-as-
// expression).
func parse_match_guard(s: TokenStream) -> Result<Option<Expr>, ParseError>:
    if stream_peek_kind(s) == Option.Some(TokenKind.KwIf):
        let _consumed = stream_advance(s)
        let g = parse_expression(s)?
        return Result.Ok(Option.Some(g))
    return Result.Ok(Option.None)

// Helper: parse the body of a match arm — either a `return` statement or a
// single expression wrapped in a one-statement Block. Factored out because
// the body-building logic has two shapes (return vs expr) and Buff `if/else`
// is a statement, not an expression.
func parse_match_arm_body(s: TokenStream, arm_tok_span: Span, source_id: SourceId) -> Result<Block, ParseError>:
    if stream_peek_kind(s) == Option.Some(TokenKind.KwReturn):
        let ret_tok = stream_advance_after_peek(s)
        // `return` with optional value.
        let next = stream_peek_kind(s)
        let next_is_comma = next == Option.Some(TokenKind.Comma)
        let next_is_rbrace = next == Option.Some(TokenKind.RBrace)
        let has_value = (next_is_comma == false) && (next_is_rbrace == false)
        if has_value == false:
            let span = span_new(arm_tok_span.start, ret_tok.span.end, source_id)
            let stmt = Stmt.Return(Option.None, ret_tok.span)
            return Result.Ok(Block.new(stmts: [stmt], span: span))
        let ret_expr = parse_expression(s)?
        let arm_end = expr_span(ret_expr).end
        let span = span_new(arm_tok_span.start, arm_end, source_id)
        let stmt = Stmt.Return(Option.Some(ret_expr), ret_tok.span)
        return Result.Ok(Block.new(stmts: [stmt], span: span))
    // Default: single-expression body.
    let body_expr = parse_expression(s)?
    let arm_end = expr_span(body_expr).end
    let span = span_new(arm_tok_span.start, arm_end, source_id)
    let stmt = Stmt.ExprStmt(body_expr, arm_tok_span)
    return Result.Ok(Block.new(stmts: [stmt], span: span))

// ===========================================================================
// SECTION 3 — `parse_pattern` + `parse_pattern_atom` (T27, T71, T39, T41).
// ===========================================================================

// Parse a single pattern (T27, extended in T71 and T39).
//
// Parses ONE atomic pattern via `parse_pattern_atom`, then — when a `|`
// follows (T39 or-patterns) — greedily consumes `| atom | atom | ...` and
// wraps the result in a `Pattern.Or`.
export func parse_pattern(s: TokenStream) -> Result<Pattern, ParseError>:
    let source_id = stream_source_id(s)
    let first = parse_pattern_atom(s)?
    // T39: or-pattern `A | B | C`. Only enter the loop when a `|` follows.
    if stream_peek_kind(s) != Option.Some(TokenKind.Pipe):
        return Result.Ok(first)
    let start = pattern_span(first).start
    let mut alts: Vector<Pattern> = Vector.new()
    alts.push(first)
    for stream_peek_kind(s) == Option.Some(TokenKind.Pipe):
        let _consumed = stream_advance(s)
        alts.push(parse_pattern_atom(s)?)
    let end = pattern_span(vec_last_pattern(alts)).end
    return Result.Ok(Pattern.Or(alts, span_new(start, end, source_id)))

// Parse a single ATOMIC pattern — the inner helper that does NOT consume a
// trailing `|` chain (T39).
//
// Supported shapes: `_`, `Ident`, `Ident(...)`, `Ident { ... }`,
// `(pat, ...)`, literal patterns.
func parse_pattern_atom(s: TokenStream) -> Result<Pattern, ParseError>:
    let source_id = stream_source_id(s)
    // Wildcard `_`. The lexer produces this as `Ident("_")`.
    let pk_is_under = is_underscore_peek(s)
    if pk_is_under == true:
        let tok = stream_advance_after_peek(s)
        return Result.Ok(Pattern.Wildcard(tok.span))
    // Literal / negative-literal / tuple / ident-starting patterns.
    let peek_tok_opt = stream_peek(s)
    if peek_tok_opt != Option.None:
        let tok = stream_unwrap(peek_tok_opt)
        let is_lit = is_literal_pattern_kind(tok.kind)
        if is_lit == true:
            let expr = parse_primary(s)?
            let lit_opt = expr_as_literal(expr)
            if lit_opt != Option.None:
                let (lit, span) = unwrap_literal_span(lit_opt)
                return Result.Ok(Pattern.Literal(lit, span))
            return Result.Err(err_with("expected a literal pattern, found an expression", expr_span(expr), ErrorCode.UnexpectedToken))
        // Negative literal: `-N`.
        if tok.kind == TokenKind.Minus:
            let saved = stream_save(s)
            let _consumed = stream_advance(s)
            let next_opt = stream_peek(s)
            if next_opt != Option.None:
                let next_tok = stream_unwrap(next_opt)
                let is_int = is_int_lit_kind(next_tok.kind)
                if is_int == true:
                    let _advanced = stream_advance(s)
                    let v = int_lit_value(next_tok.kind)
                    return Result.Ok(Pattern.Literal(Literal.Int(-v), span_new(tok.span.start, next_tok.span.end, source_id)))
            // Not a negative literal — roll back.
            stream_restore(s, saved)
        // T71: tuple destructuring pattern `(subpat, subpat, ...)`.
        if tok.kind == TokenKind.LParen:
            return parse_tuple_pattern(s, source_id)
        // Identifier-starting patterns.
        let is_id = is_ident_kind(tok.kind)
        if is_id == true:
            return parse_ident_pattern(s, source_id)
    // Fall-through: unexpected token at pattern position.
    let found = token_kind_to_string(stream_unwrap_kind(stream_peek_kind(s)))
    return Result.Err(err_with("expected a match pattern, found " + found, peek_span_or_eof(s), ErrorCode.UnexpectedToken))

// Helper: true when the next token is `Ident("_")` (the wildcard pattern).
func is_underscore_peek(s: TokenStream) -> Bool:
    let pk = stream_peek_kind(s)
    let k = stream_unwrap_kind(pk)
    let is_id = is_ident_kind(k)
    if is_id == true:
        let name = ident_kind_name(k)
        return name == "_"
    return false

// Helper: parse a tuple destructuring pattern `(subpat, subpat, ...)`.
func parse_tuple_pattern(s: TokenStream, source_id: SourceId) -> Result<Pattern, ParseError>:
    let lp = stream_expect(s, TokenKind.LParen)?
    let mut subs: Vector<Pattern> = Vector.new()
    if stream_peek_kind(s) != Option.Some(TokenKind.RParen):
        for true:
            subs.push(parse_pattern(s)?)
            let pk = stream_peek_kind(s)
            let is_comma = pk == Option.Some(TokenKind.Comma)
            let is_rparen = pk == Option.Some(TokenKind.RParen)
            if is_comma:
                let _consumed = stream_advance(s)
                if stream_peek_kind(s) == Option.Some(TokenKind.RParen):
                    break
            if is_rparen:
                break
            // Other token or EOF — error.
            if pk == Option.None:
                return Result.Err(err_with("unterminated tuple pattern (missing close-paren)", stream_eof_span(s), ErrorCode.UnterminatedParen))
            let found = token_kind_to_string(stream_unwrap_kind(pk))
            return Result.Err(err_with("expected `,` or close-paren in tuple pattern, found " + found, peek_span_or_eof(s), ErrorCode.ExpectedToken))
    let rp = stream_expect(s, TokenKind.RParen)?
    return Result.Ok(Pattern.Tuple(subs, span_new(lp.span.start, rp.span.end, source_id)))

// Helper: parse an identifier-starting pattern — bare ident, variant tuple,
// dot-qualified variant, or struct destructuring.
func parse_ident_pattern(s: TokenStream, source_id: SourceId) -> Result<Pattern, ParseError>:
    let tok = stream_advance_after_peek(s)
    let name = ident_kind_name(tok.kind)
    let ident = ident_new(name, tok.span)
    // Dot-qualified variant pattern: `EnumName.VariantName`.
    if stream_peek_kind(s) == Option.Some(TokenKind.Dot):
        return parse_dot_variant_pattern(s, ident, tok.span, source_id)
    // Variant tuple: `Ident ( subpat, subpat, ... )`.
    if stream_peek_kind(s) == Option.Some(TokenKind.LParen):
        let _lp = stream_expect(s, TokenKind.LParen)?
        let subpats = parse_subpattern_list(s, TokenKind.RParen)?
        let rp = stream_expect(s, TokenKind.RParen)?
        let empty_enum = ident_new("", tok.span)
        return Result.Ok(Pattern.Variant(empty_enum, ident, subpats, span_new(tok.span.start, rp.span.end, source_id)))
    // T71: struct destructuring pattern `Name { field: subpat, ... }`.
    if stream_peek_kind(s) == Option.Some(TokenKind.LBrace):
        return parse_struct_pattern(s, ident, tok.span, source_id)
    // Bare unit variant / binding.
    return Result.Ok(Pattern.Ident(ident, tok.span))

// Helper: parse a dot-qualified variant pattern `EnumName.VariantName` or
// `EnumName.VariantName(args)`.
func parse_dot_variant_pattern(s: TokenStream, enum_ident: Ident, start_span: Span, source_id: SourceId) -> Result<Pattern, ParseError>:
    let _dot = stream_advance(s)
    let variant_opt = stream_advance(s)
    if variant_opt == Option.None:
        return Result.Err(err_with("expected variant name after `.` in pattern", stream_eof_span(s), ErrorCode.ExpectedToken))
    let variant_tok = stream_unwrap(variant_opt)
    let is_id = is_ident_kind(variant_tok.kind)
    if is_id == false:
        return Result.Err(err_with("expected variant name after `.` in pattern", variant_tok.span, ErrorCode.UnexpectedToken))
    let variant_ident = ident_new(ident_kind_name(variant_tok.kind), variant_tok.span)
    // Check for tuple variant: `EnumName.VariantName(args)`.
    if stream_peek_kind(s) == Option.Some(TokenKind.LParen):
        let _lp = stream_expect(s, TokenKind.LParen)?
        let subpats = parse_subpattern_list(s, TokenKind.RParen)?
        let rp = stream_expect(s, TokenKind.RParen)?
        return Result.Ok(Pattern.Variant(enum_ident, variant_ident, subpats, span_new(start_span.start, rp.span.end, source_id)))
    // Unit variant: `EnumName.VariantName` (no args).
    return Result.Ok(Pattern.Variant(enum_ident, variant_ident, Vector.new(), span_new(start_span.start, variant_tok.span.end, source_id)))

// Helper: parse a comma-separated list of subpatterns terminated by
// `close_kind` (the caller consumes `close_kind`). Empty list allowed.
func parse_subpattern_list(s: TokenStream, close_kind: TokenKind) -> Result<Vector<Pattern>, ParseError>:
    let mut subpats: Vector<Pattern> = Vector.new()
    if stream_peek_kind(s) == Option.Some(close_kind):
        return Result.Ok(subpats)
    for true:
        subpats.push(parse_pattern(s)?)
        let pk = stream_peek_kind(s)
        let is_comma = pk == Option.Some(TokenKind.Comma)
        let is_close = pk == Option.Some(close_kind)
        if is_comma:
            let _consumed = stream_advance(s)
            if stream_peek_kind(s) == Option.Some(close_kind):
                break
        if is_close:
            break
        // Any other token: stop collecting subpatterns.
        break
    return Result.Ok(subpats)

// Helper: parse a struct destructuring pattern `Name { field: subpat, ... }`
// (T71, T41 rest).
func parse_struct_pattern(s: TokenStream, name_ident: Ident, start_span: Span, source_id: SourceId) -> Result<Pattern, ParseError>:
    let _lb = stream_expect(s, TokenKind.LBrace)?
    let mut fields: Vector<(Ident, Pattern)> = Vector.new()
    let mut rest = false
    if stream_peek_kind(s) != Option.Some(TokenKind.RBrace):
        for true:
            // T41: `..` rest pattern.
            if stream_peek_kind(s) == Option.Some(TokenKind.DotDot):
                let _consumed = stream_advance(s)
                rest = true
                let pk = stream_peek_kind(s)
                let pk_is_comma = pk == Option.Some(TokenKind.Comma)
                let pk_is_rbrace = pk == Option.Some(TokenKind.RBrace)
                if pk_is_comma:
                    let _c = stream_advance(s)
                    if stream_peek_kind(s) == Option.Some(TokenKind.RBrace):
                        break
                if pk_is_rbrace:
                    break
                // Other token or EOF — error.
                if pk == Option.None:
                    return Result.Err(err_with("unterminated struct pattern after `..` (missing close-brace)", stream_eof_span(s), ErrorCode.UnterminatedBrace))
                let found = token_kind_to_string(stream_unwrap_kind(pk))
                return Result.Err(err_with("expected `,` or close-brace after `..` in struct pattern, found " + found, peek_span_or_eof(s), ErrorCode.ExpectedToken))
            // Field name MUST be a bare identifier.
            let ftok_opt = stream_advance(s)
            if ftok_opt == Option.None:
                return Result.Err(err_with("expected struct field name, found end of input", stream_eof_span(s), ErrorCode.ExpectedToken))
            let ftok = stream_unwrap(ftok_opt)
            let ftok_is_id = is_ident_kind(ftok.kind)
            if ftok_is_id == false:
                return Result.Err(err_with("expected struct field name (identifier), found " + token_kind_to_string(ftok.kind), ftok.span, ErrorCode.UnexpectedToken))
            let field_ident = ident_new(ident_kind_name(ftok.kind), ftok.span)
            // Explicit `field: subpattern` OR shorthand `field`.
            let subpat = parse_struct_field_subpat(s, field_ident, ftok.span)
            fields.push((field_ident, subpat))
            let pk = stream_peek_kind(s)
            let pk_is_comma = pk == Option.Some(TokenKind.Comma)
            let pk_is_rbrace = pk == Option.Some(TokenKind.RBrace)
            if pk_is_comma:
                let _consumed = stream_advance(s)
                if stream_peek_kind(s) == Option.Some(TokenKind.RBrace):
                    break
            if pk_is_rbrace:
                break
            // Other token or EOF — error.
            if pk == Option.None:
                return Result.Err(err_with("unterminated struct pattern (missing close-brace)", stream_eof_span(s), ErrorCode.UnterminatedBrace))
            let found = token_kind_to_string(stream_unwrap_kind(pk))
            return Result.Err(err_with("expected `,` or close-brace in struct pattern, found " + found, peek_span_or_eof(s), ErrorCode.ExpectedToken))
    let rb = stream_expect(s, TokenKind.RBrace)?
    return Result.Ok(Pattern.Struct(name_ident, fields, span_new(start_span.start, rb.span.end, source_id), rest))

// Helper: parse the subpattern of a struct field — either explicit
// `field: subpat` or shorthand `field` (binds to a pattern of the same
// name). Factored out so `parse_struct_pattern`'s field loop stays linear.
// Uses a Result-returning probe but returns a Pattern directly for the
// shorthand case (the Rust `if let` becomes a comparison + early return).
func parse_struct_field_subpat(s: TokenStream, field_ident: Ident, ftok_span: Span) -> Pattern:
    if stream_peek_kind(s) == Option.Some(TokenKind.Colon):
        let _consumed = stream_advance(s)
        return pattern_or_sentinel(parse_pattern(s))
    return Pattern.Ident(field_ident, ftok_span)

// Helper: extract the Pattern from a Result<Pattern, ParseError>, returning
// a Wildcard sentinel on Err (contract: the caller checks the stream state
// after this call; the error propagates via the stream position, not via
// the return value — matching the Rust `?` propagation that
// `parse_struct_field_subpat` can't do because Buff `if` is not an expr).
func pattern_or_sentinel(r: Result<Pattern, ParseError>) -> Pattern:
    return match r {
        Ok(p) => p,
        Err(_) => Pattern.Wildcard(span_dummy()),
    }

// ===========================================================================
// SECTION 4 — `parse_closure` (T23 minimal closure `{ params => expr }`).
// ===========================================================================

// Parse a minimal closure `{ params => expr }` whose opening `{` is the next
// significant token (T23).
//
// Shape: `{ ident (, ident)* => expr }`. The body is a single expression
// (wrapped in an `ExprStmt` to form a one-statement block). Parameter types
// are inferred (a placeholder `TypeRef` is stored; codegen ignores it for
// closures).
export func parse_closure(s: TokenStream) -> Result<Expr, ParseError>:
    let lb = stream_expect(s, TokenKind.LBrace)?
    // Parse one or more comma-separated identifier parameters.
    let mut params: Vector<Param> = Vector.new()
    for true:
        let ptok_opt = stream_advance(s)
        if ptok_opt == Option.None:
            return Result.Err(err_with("expected closure parameter name, found end of input", stream_eof_span(s), ErrorCode.ExpectedToken))
        let ptok = stream_unwrap(ptok_opt)
        let ptok_is_id = is_ident_kind(ptok.kind)
        if ptok_is_id == false:
            return Result.Err(err_with("expected closure parameter name, found " + token_kind_to_string(ptok.kind), ptok.span, ErrorCode.UnexpectedToken))
        let pname = ident_kind_name(ptok.kind)
        let param = Param.new(
            name: ident_new(pname, ptok.span),
            // Placeholder type — closures infer their param types; codegen
            // emits `|name|` (no annotation). T34 will add typed params.
            ty: TypeRef.Named(ident_new("_", ptok.span), ptok.span),
            default_value: Option.None,
            is_comptime: false,
            span: ptok.span,
        )
        params.push(param)
        let has_comma = stream_peek_kind(s) == Option.Some(TokenKind.Comma)
        if has_comma == false:
            break
        let _consumed = stream_advance(s)
    let arrow = stream_expect(s, TokenKind.FatArrow)?
    let body_expr = parse_expression(s)?
    let rb = stream_expect(s, TokenKind.RBrace)?
    let body = Block.new(
        stmts: [Stmt.ExprStmt(body_expr, arrow.span)],
        span: span_new(lb.span.start, rb.span.end, stream_source_id(s)),
    )
    let span = span_new(lb.span.start, rb.span.end, stream_source_id(s))
    return Result.Ok(Expr.Lambda(params, body, Option.None, span))

// ===========================================================================
// SECTION 5 — Shared trampolines (mirror `expr.buff`'s bottom section).
// ===========================================================================

// Unwrap Option<TokenKind> with an Eof sentinel (contract: caller verified
// Some via peek).
func stream_unwrap_kind(opt: Option<TokenKind>) -> TokenKind:
    return match opt {
        Some(k) => k,
        None => TokenKind.Eof,
    }

// Build a ParseError from (msg, span, code).
func err_with(msg: String, span: Span, code: ErrorCode) -> ParseError:
    return parse_error_new(diagnostic_error(msg, span), code)

// Span of the current peek token, or eof span when at end.
func peek_span_or_eof(s: TokenStream) -> Span:
    let opt = stream_peek(s)
    if opt == Option.None:
        return stream_eof_span(s)
    return stream_unwrap(opt).span

// The end offset of a Block's span.
func block_span_end(b: Block) -> Int:
    return b.span.end

// Whether a token kind is a numeric literal kind. Mirrors `expr.buff`.
func is_numeric_lit_kind(k: TokenKind) -> Bool:
    return match k {
        IntLit(_) => true,
        FloatLit(_) => true,
        DoubleLit(_) => true,
        ByteLit(_) => true,
        DecimalLit(_) => true,
        _ => false,
    }
