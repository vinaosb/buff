// Buff self-host port of `crates/buff-eval/src/lib.rs` (P3.5).
//
// `buff-eval` — a thin evaluation engine over the existing Buff compiler
// primitives (`tokenize`, `parse`, `TypeInferencer`, `generate_rust`).
//
// Shared rustc-invoke helpers (T35)
//
// The `rustc_invoke` helpers are re-used from the narrow
// `buff-lang-pipeline` sibling crate (P0.26 audit-remediation arch-003).
// Pre-P0.26 these helpers were pulled in via a cross-crate `#[path]`
// include from `buff-lang-cli/src/rustc_invoke.rs`; the sibling-crate
// extraction moved them into `buff-lang-pipeline` so this crate can use
// a normal Cargo dependency instead. The helpers are the single source
// of truth for PATH probes, Cranelift detection, target-installed
// checks, and common rustc flag configuration. `buff-lang-pipeline` is
// a pure sibling crate (no `clap` / `tokio` / `reqwest`) so the eval
// crate's dependency footprint is unchanged.
//
// Purpose
//
// T125-prep extracts a reusable evaluation API consumed by the REPL
// (T125a/b/c), the Jupyter kernel (T129b), and the Bufflings tutorial
// runner (T138c). This crate adds NO new compilation logic — it wires
// the existing lexer/parser/types/codegen-rust crates into a clean
// eval/eval_line/type_of surface with captured stdout.
//
// Pipeline
//
// Each `evaluator_eval` / `evaluator_eval_line` call composes a
// full Buff program from the accumulated state + the new snippet, then
// runs the existing compile-to-Rust → rustc → spawn-and-capture pipeline:
//
// ```text
//  snippet
//     |
//     v  classify (parse_expression / parse)
//  SnippetKind { Expr | BodyStmt | TopLevelDecl | FullProgram }
//     |
//     v  compose accumulated state into a single Buff source
//  full_source : String
//     |
//     v  buff_lang_lexer::tokenize  →  buff_lang_parser::parse
//                                 |
//                       buff_lang_codegen_rust::generate_rust
//                                 |
//                          String (formatted Rust source)
//     |
//     v  write to <temp dir>/eval-<pid>-<n>.rs
//  rustc --edition 2021 -O <rs> -o <exe>
//     |
//     v  Command::new(<exe>).output()   (stdout/stderr captured)
//  (stdout, stderr, exit_code)
//     |
//     v  EvalResult
// ```
//
// State accumulation
//
// `let` bindings and `func` declarations persist across calls so a REPL
// session can build up state incrementally. The accumulated source is
// held verbatim (re-parsed each call) so the codegen pass always sees a
// self-contained program. The `type_of` introspection path runs the
// `TypeInferencer` over the same accumulated source so its env stays
// in sync with what a real evaluation would see.
//
// Stdout capture
//
// Buff's `print` lowers to Rust's `println!`, which writes to the
// compiled program's stdout. We spawn the program via
// `std::process::Command::output`, which captures the child's stdout
// into a `Vector<Byte>` without ever touching the parent process's stdout.
// The captured bytes are surfaced as `EvalResult.stdout`. Consumers
// (Jupyter, Bufflings) depend on this — they format the captured buffer
// into their own display surfaces instead of inheriting process stdio.
//
// No panics
//
// Every fallible operation (lex/parse/codegen/rustc/run) is threaded
// through `EvalResult.diagnostic`. There are no `unwrap`/`expect`/
// `panic!`/`unimplemented!`/`todo!` calls outside test code.
//
// YELLOW-crate handling (P0.4 verdict)
//
// This crate is YELLOW because its runtime path depends on facilities
// Buff has no native binding for: filesystem access (temp .rs files +
// compiled exe), subprocess spawning (rustc invocation + running the
// compiled binary), process-wide atomic counters (unique temp-file
// stems), environment-variable reads (BUFF_EVAL_BACKEND /
// BUFF_EVAL_SCCACHE / BUFF_EVAL_TARGET), compile-time target probes
// (`cfg!(target_os = "linux")`), and the compiler-internal crates
// themselves (lexer / parser / types / codegen-rust / pipeline). Per
// porting-conventions §9, every one of these is a runtime intrinsic
// that stays in the Rust host. They are declared here as `extern`
// stubs whose bodies live in `crates/buff-eval/src/lib.rs` (the
// untouched Rust original).
//
// Faithful 1:1 translation of the Rust reference. Translation decisions
// (deviations forced by Buff grammar or the YELLOW-crate extern
// boundary, per conventions §1):
//   * `pub fn foo()` -> `export func foo()` per §0.
//   * `impl EvalResult { pub fn bar(&self) }` -> free function
//     `eval_result_bar(r: EvalResult)` per §8g (impl-as-free-functions).
//   * `impl Evaluator { pub fn bar(&mut self, src: &str) }` -> free
//     function `evaluator_bar(ev: Evaluator, src: String)` taking the
//     receiver as the first parameter. Buff mutates struct fields in
//     place via `ev.field = ...` (per §7b — the `&mut self` of a Rust
//     method is implicit; the stream.buff / token.buff corpus ports
//     follow the same convention).
//   * `Vec<T>` -> `Vector<T>` (HARD rule, §7c).
//   * `&str` -> `String`, `i32`/`i64`/`usize`/`u64` -> `Int`,
//     `bool` -> `Bool` per §7a.
//   * `Option<&T>` -> `Option<T>` (owned clone) per §7b.
//   * `PathBuf` / `&Path` -> `String` (Buff has no dedicated Path type;
//     paths are opaque strings threaded through extern stubs).
//   * `static STEM_COUNTER: AtomicU64` + `fetch_add` -> extern
//     `atomic_counter_next() -> Int` (process-wide atomics are runtime
//     intrinsics).
//   * `std::env::var(name)` -> extern `env_var(name) -> Option<String>`.
//   * `std::env::temp_dir()` -> extern `env_temp_dir() -> String`.
//   * `std::env::consts::EXE_EXTENSION` -> extern `env_exe_extension()
//     -> String` (compile-time host constant; read at runtime via FFI).
//   * `std::fs::write` / `std::fs::remove_file` / `std::fs::create_dir_all`
//     -> extern `fs_write` / `fs_remove_file` / `fs_create_dir_all`
//     returning `Option<String>` (None = ok, Some(msg) = error).
//   * `std::process::id()` -> extern `process_id() -> Int`.
//   * `std::process::Command::new(prog).arg(a).env(k,v).output()` ->
//     extern `process_spawn(prog, args, env) -> Option<SpawnResult>`
//     (single FFI boundary; returns None on spawn failure).
//   * `cfg!(target_os = "linux")` -> extern `target_is_linux() -> Bool`
//     (compile-time host probe is a runtime intrinsic from the port's
//     point of view).
//   * Compiler-internal crates (buff_lang_lexer::tokenize,
//     buff_lang_parser::{parse, parse_expression},
//     buff_lang_codegen_rust::generate_rust,
//     buff_lang_types::TypeInferencer, buff_lang_pipeline::rustc_invoke::*,
//     buff_lang_ast::Decl/Stmt/Expr, buff_lang_error::Diagnostic/Span/SourceId)
//     -> opaque extern types + extern func stubs (Buff self-host has
//     no lexer/parser/types/codegen-rust yet per DR-014 — those are the
//     heaviest crates, still in progress).
//   * `#[allow(clippy::result_large_err)]` dropped (Buff has no lint
//     machinery) per §8f.
//   * `#[derive(Debug, Clone, PartialEq)]` dropped (Buff auto-derives
//     these on every struct/enum) per §8b.
//   * `#[must_use]` / `#[default]` / `#[allow(dead_code)]` dropped
//     per §8f.
//   * `#[cfg(test)] mod tests { ... }` -> top-level `test_*` free
//     functions per §5d. Tests use the @test attribute where
//     applicable; complex assertion ladders use early-return Bool
//     witnesses.
//   * Rust `match kind { A | B => .., .. }` or-patterns and multi-
//     statement match arms -> expanded to `if/else if` chains with `==`
//     on enum values + free-function helpers per §8e (Buff match arms
//     are single expressions, reject or-patterns, reject qualified
//     patterns, reject statement bodies).
//   * Rust `while` -> `for cond:` per §8d (`while` is NOT a Buff
//     keyword).
//   * Rust backtick code spans in doc comments (`tokenize`, `parse`,
//     etc.) -> single quotes per task MUST DO (Buff strings do not
//     support backtick characters).
//   * No `_async` suffix anywhere in the original; none introduced.
//   * Buff constructors `Type.new()` / `Type.from()` only per §2b —
//     the Rust `Evaluator::new()` / `EvalResult::err()` /
//     `EvalResult::ok()` constructors become free functions
//     `evaluator_new` / `eval_result_err` / `eval_result_ok` whose
//     bodies call `Type.new(...)`.
//
// Numeric width mapping (per §7a):
//   i32 / i64 / usize / u64 -> Int   (PID, exit codes, counter)
//   bool -> Bool
//   (no f32 / f64 / u8 / char in this file's public surface)

// ---------------------------------------------------------------------------
// Extern stubs: runtime intrinsics (filesystem, subprocess, atomics, env).
// Bodies live in `crates/buff-eval/src/lib.rs` (Rust host, untouched). Per
// the P0.4 YELLOW-crate verdict, these stay in Rust — Buff has no native
// binding for the OS process model.
// ---------------------------------------------------------------------------

// Read an environment variable. None when unset or invalid UTF-8.
extern "C" from "buff_eval_host" func env_var(name: String) -> Option<String>

// The OS temp directory (e.g. /tmp on Linux, %TEMP% on Windows).
extern "C" from "buff_eval_host" func env_temp_dir() -> String

// The platform's executable extension (".exe" on Windows, "" on Unix).
extern "C" from "buff_eval_host" func env_exe_extension() -> String

// True iff the host target OS is Linux (compile-time probe).
extern "C" from "buff_eval_host" func target_is_linux() -> Bool

// The current process's PID.
extern "C" from "buff_eval_host" func process_id() -> Int

// Atomically increment and return the next process-wide counter value
// (mirrors `STEM_COUNTER.fetch_add(1, Ordering::Relaxed)` in the Rust
// host — the static AtomicU64 lives there because Buff has no
// process-wide mutable statics).
extern "C" from "buff_eval_host" func atomic_counter_next() -> Int

// Write `contents` to the file at `path`. None on success,
// Some(error_message) on failure.
extern "C" from "buff_eval_host" func fs_write(path: String, contents: String) -> Option<String>

// Delete the file at `path`. None on success, Some(error_message) on
// failure (including "file not found" — caller ignores).
extern "C" from "buff_eval_host" func fs_remove_file(path: String) -> Option<String>

// Recursively create the directory at `path`. None on success (incl.
// already-exists). Some(error_message) on failure.
extern "C" from "buff_eval_host" func fs_create_dir_all(path: String) -> Option<String>

// Result of spawning a subprocess: captured stdout, stderr, and exit
// code (None when the OS killed the process with a signal).
struct SpawnResult:
    stdout: String
    stderr: String
    exit_code: Option<Int>

// Spawn `prog` with `args` and the extra `env` vars, wait for it to
// finish, and return its captured stdout/stderr/exit. Returns None on
// spawn failure (executable not found, permission denied, etc).
extern "C" from "buff_eval_host" func process_spawn(prog: String, args: Vector<String>, env: Map<String, String>) -> Option<SpawnResult>

// ---------------------------------------------------------------------------
// Extern stubs: compiler-internal types + functions. The Buff self-host
// port has no lexer/parser/types/codegen-rust yet (per DR-014 those are the
// heaviest crates, still in progress). These signatures describe the
// contract; the Rust host provides the bodies.
// ---------------------------------------------------------------------------

// Opaque-handle stand-ins for compiler-internal types. The Buff port
// threads them as opaque Int handles; field access goes through extern
// accessors declared below. Matches the `debug-info/capture.buff` pattern
// (`struct Decl: opaque_handle: Int`). The Buff self-host has no
// lexer/parser/types/codegen-rust yet (DR-014 — those are the heaviest
// crates, still in progress).
struct Token:
    opaque_handle: Int

struct Decl:
    opaque_handle: Int

struct Stmt:
    opaque_handle: Int

struct Expr:
    opaque_handle: Int

struct Type:
    opaque_handle: Int

struct TypeInferencer:
    opaque_handle: Int

struct Diagnostic:
    opaque_handle: Int

struct Span:
    opaque_handle: Int

struct SourceId:
    opaque_handle: Int

struct TokenizeFailure:
    opaque_handle: Int

struct ParseError:
    opaque_handle: Int

struct CodegenError:
    opaque_handle: Int

struct TypeError:
    opaque_handle: Int

// Construct a SourceId from a raw integer (mirrors the Rust tuple-struct
// SourceId(pub u32)). Full self-host detail lives in
// `self-host/error/span.buff`.
extern "C" from "buff_eval_host" func source_id_new(value: Int) -> SourceId

// Construct a dummy Span (zero-length, source_id 0) for synthetic errors.
extern "C" from "buff_eval_host" func span_dummy() -> Span

// Construct an error-level Diagnostic with a message + span.
extern "C" from "buff_eval_host" func diagnostic_error(message: String, span: Span) -> Diagnostic

// Extract the Diagnostic carried by a tokenize failure.
extern "C" from "buff_eval_host" func tokenize_failure_diagnostic(f: TokenizeFailure) -> Diagnostic

// Extract the Diagnostic carried by a parse error.
extern "C" from "buff_eval_host" func parse_error_diagnostic(e: ParseError) -> Diagnostic

// Extract the Diagnostic carried by a codegen error.
extern "C" from "buff_eval_host" func codegen_error_diagnostic(e: CodegenError) -> Diagnostic

// buff_lang_lexer::tokenize — byte-scanner entry point. Returns Ok(tokens)
// or Err(TokenizeFailure with .diagnostic).
extern "C" from "buff_eval_host" func tokenize(source: String, source_id: SourceId) -> Result<Vector<Token>, TokenizeFailure>

// buff_lang_parser::{parse, parse_expression} — recursive-descent entry points.
extern "C" from "buff_eval_host" func parse(tokens: Vector<Token>, source_id: SourceId) -> Result<Vector<Decl>, ParseError>

// Parse a single expression (strict — requires all tokens consumed).
extern "C" from "buff_eval_host" func parse_expression(tokens: Vector<Token>, source_id: SourceId) -> Result<Expr, ParseError>

// buff_lang_codegen_rust::generate_rust — AST -> Rust source.
extern "C" from "buff_eval_host" func generate_rust(decls: Vector<Decl>) -> Result<String, CodegenError>

// buff_lang_types::TypeInferencer — type-inference engine.
extern "C" from "buff_eval_host" func type_inferencer_new() -> TypeInferencer

// Infer the type of a statement, populating the inferencer's env. Used
// by `evaluator_type_of` to walk all-but-last stmts before inferring the
// trailing expression.
extern "C" from "buff_eval_host" func type_inferencer_infer_stmt(inf: TypeInferencer, stmt: Stmt) -> Result<Type, TypeError>

// Infer the type of an expression against the inferencer's accumulated env.
extern "C" from "buff_eval_host" func type_inferencer_infer_expr(inf: TypeInferencer, expr: Expr) -> Result<Type, TypeError>

// buff_lang_ast accessors — the Buff port cannot pattern-match on opaque
// extern enums, so the small set of node-inspection primitives the eval
// crate needs are surfaced as extern predicates / extractors.

// Classify a Decl as a FuncDecl and return its body statements. Returns
// None when the decl is some other variant.
extern "C" from "buff_eval_host" func decl_func_body_stmts(d: Decl) -> Option<Vector<Stmt>>

// Classify a Stmt as an ExprStmt and return its inner Expr. Returns
// None when the stmt is some other variant.
extern "C" from "buff_eval_host" func stmt_as_expr(s: Stmt) -> Option<Expr>

// `true` iff `expr` is an ExprStmt-trailing expression eligible for
// `type_of` inference.
// (Rust: `stmts.last()` is `Some(Stmt::ExprStmt(e, _))`.)
extern "C" from "buff_eval_host" func stmt_is_expr_stmt(s: Stmt) -> Bool

// `true` iff `expr` is a `print(...)` / `println(...)` call. Mirrors the
// Rust `is_print_call` predicate over Expr::FuncCall { callee: Ident(name) }.
extern "C" from "buff_eval_host" func expr_is_print_call(e: Expr) -> Bool

// buff_lang_pipeline::rustc_invoke — shared rustc-invocation helpers (T35).
extern "C" from "buff_eval_host" func rustc_invoke_on_path(name: String) -> Bool

extern "C" from "buff_eval_host" func rustc_invoke_cranelift_available() -> Bool

extern "C" from "buff_eval_host" func rustc_invoke_target_is_installed(triple: String) -> Bool

// Configure a rustc Command with edition + opt flags + linker flags +
// Cranelift + debuginfo + cross-target. Returns Ok(SpawnCmd) on success,
// Err(msg) on configuration failure (e.g. unknown target).
//
// The Rust original passes `&mut Command` by reference; the Buff port
// restructures as a pure function returning a configured `SpawnCmd`
// descriptor that the caller feeds to `process_spawn`. The translation
// is mechanical: the host-side `configure_rustc_command` reads the
// SpawnCmd, populates a `Command`, and runs it.
struct SpawnCmd:
    opaque_handle: Int
    program: String
    args: Vector<String>

extern "C" from "buff_eval_host" func rustc_invoke_configure_rustc_command(
    opt_flags: Vector<String>,
    linker_flags: Vector<String>,
    use_cranelift: Bool,
    debuginfo: String,
    target: Option<String>,
) -> Result<SpawnCmd, String>

// ---------------------------------------------------------------------------
// T2: Fast-linker selection (mirrors buff_lang_cli::pipeline::LinkerChoice).
// Kept inline to avoid pulling clap/tokio transitively into the eval crate.
// ---------------------------------------------------------------------------

// Fast-linker selection for the eval crate's rustc invocation.
//
// Mirrors `buff_lang_cli::pipeline::LinkerChoice` without depending on the
// CLI crate. See AGENTS.md: "Keep the two copies in sync manually."
enum EvalLinker {
    // Auto-detect: probe PATH for mold (Linux) → rust-lld → system default.
    Auto,
    // Use rustc's default system linker (no `-C link-arg=-fuse-ld` flag).
    //
    // Mirrors `LinkerChoice::System` in the CLI so the two stay in sync,
    // but the eval surface currently only ever constructs `Auto`. Kept for
    // API parity + the `resolve_eval_linker_flags` match arm; allow dead
    // code until the eval linker-flag override is exposed.
    System,
}

// Resolve an EvalLinker to rustc `-C link-arg=-fuse-ld` flags.
//
// Returns an empty vec for `EvalLinker.System` (let rustc pick its
// default). For `EvalLinker.Auto`, probes PATH for mold (Linux) →
// rust-lld → lld → system default (silent fallback).
func resolve_eval_linker_flags(linker: EvalLinker) -> Vector<String>:
    if linker == EvalLinker.Auto:
        // mold is Linux-only in practice.
        if target_is_linux(), on_path("mold"):
            return ["-C", "link-arg=-fuse-ld=mold"]
        if on_path("rust-lld") || on_path("lld"):
            return ["-C", "link-arg=-fuse-ld=lld"]
        return []
    // EvalLinker.System — let rustc pick its default.
    return []

// Returns `true` when `name` (an executable basename) is found on `PATH`.
// Delegates to the shared `rustc_invoke::on_path` (T35).
func on_path(name: String) -> Bool:
    return rustc_invoke_on_path(name)

// ---------------------------------------------------------------------------
// T4: Cranelift dev backend (mirrors buff_lang_cli::pipeline::BackendChoice).
// Kept inline to avoid pulling clap/tokio transitively into the eval crate.
// ---------------------------------------------------------------------------

// Returns `true` when `sccache` is installed and on `PATH` (T9).
//
// Mirrors `buff_lang_cli::compile_speed::sccache_available` without
// depending on the CLI crate. sccache wraps rustc invocations to cache
// compiled artefacts across projects. Opt-in via `BUFF_EVAL_SCCACHE=1`
// env var (no CLI surface in eval).
func sccache_available() -> Bool:
    return on_path("sccache")

// Probe whether the Cranelift codegen backend is available (T4).
//
// Delegates to the shared `rustc_invoke::cranelift_available` (T35).
func cranelift_available() -> Bool:
    return rustc_invoke_cranelift_available()

// Decide whether to set `CARGO_PROFILE_DEV_CODEGEN_BACKEND=cranelift` on
// the spawned rustc process for an eval call (T4).
//
// `buff-eval` has no CLI surface (it is consumed in-process by REPL /
// Jupyter / Bufflings), so the backend choice is driven by an env var
// instead of a flag:
//
// - `BUFF_EVAL_BACKEND=cranelift` → opt in. Probes via
//   `cranelift_available`; sets the env var on the rustc `Command`
//   when the probe succeeds, falls back silently to LLVM otherwise.
// - Any other value (or unset) → LLVM (rustc default). No probe, no
//   env var, no overhead.
//
// This mirrors the CLI's `--backend=cranelift` opt-in nature without
// requiring a plumbing change through REPL/Jupyter/Bufflings. The env
// var is read fresh on every `run_full_program` call so a user can
// toggle it mid-session (`:set`-style commands in a future REPL
// revision would just `set_var("BUFF_EVAL_BACKEND", ...)`).
//
// Returns `true` when the caller should set the env var on the rustc
// `Command`.
func should_eval_use_cranelift() -> Bool:
    let v = env_var("BUFF_EVAL_BACKEND")
    if v == Option.None:
        return false
    let val = option_unwrap_or(v, "")
    if string_eq_ignore_ascii_case(val, "cranelift"):
        return cranelift_available()
    return false

// Read the cross-compilation target from the `BUFF_EVAL_TARGET` env var
// (T112).
//
// Returns `None` when unset or empty (native compilation). The env var
// is read fresh on every `run_full_program` call so a user can toggle it
// mid-session.
func eval_target() -> Option<String>:
    let v = env_var("BUFF_EVAL_TARGET")
    if v == Option.None:
        return Option.None
    let val = option_unwrap_or(v, "")
    let trimmed = string_trim(val)
    if string_is_empty(trimmed):
        return Option.None
    return Option.Some(trimmed)

// Probe whether a rustc target triple is installed (T112).
//
// Delegates to the shared `rustc_invoke::target_is_installed` (T35).
func eval_target_is_installed(triple: String) -> Bool:
    return rustc_invoke_target_is_installed(triple)

// Re-export of the resolved Type so consumers can refer to it as
// `buff_eval::ResolvedType` without depending on `buff-lang-types` directly.
// (Modelled as the opaque extern `Type` declared above — Buff's `extern
// type` IS the re-export spelling for cross-crate type aliases.)

// Result of evaluating a Buff snippet.
//
// All fallible phases (lex, parse, codegen, rustc, exec) surface their
// errors through `EvalResult.diagnostic` rather than `Result<>` — the
// caller checks `diagnostic.is_some()` to detect failure. `value`,
// `stdout`, and `stderr` are always populated (to empty strings when the
// pipeline failed before producing output), so partial output from a
// runtime panic is still observable.
struct EvalResult {
    // The evaluated value of a bare-expression snippet, captured by
    // wrapping the expression in `print(...)` and reading the spawned
    // program's stdout. None for statements / declarations / errors.
    //
    // The value is the captured stdout `trim`-ed of surrounding
    // whitespace (so `print(2 + 3)` → "5", not "5\n").
    value: Option<String>,
    // Everything the spawned program wrote to its stdout, verbatim.
    // This is where Buff's `print` output lands.
    stdout: String,
    // Everything the spawned program wrote to its stderr, verbatim.
    // Includes Rust panic messages from runtime errors.
    stderr: String,
    // The diagnostic for any pipeline error (lex / parse / codegen /
    // rustc / spawn failure). None on clean evaluation.
    diagnostic: Option<Diagnostic>,
    // The spawned program's exit code. None if the program never ran
    // (compile error) or the OS did not report a code (signal death).
    exit_code: Option<Int>,
}

// `true` when the pipeline reached a successful program execution.
// Mirrors `diagnostic.is_none() && exit_code == Some(0)` but is the
// idiomatic "did it work?" predicate.
func eval_result_is_ok(r: EvalResult) -> Bool:
    if r.diagnostic != Option.None:
        return false
    if r.exit_code != Option.Some(0):
        return false
    return true

// Construct an error result with the given diagnostic and empty
// captured output. Convenience for the error paths.
func eval_result_err(diagnostic: Diagnostic) -> EvalResult:
    return EvalResult.new(
        value: Option.None,
        stdout: "",
        stderr: "",
        diagnostic: Option.Some(diagnostic),
        exit_code: Option.None,
    )

// Construct a successful result with the given captured output.
func eval_result_ok(stdout: String, stderr: String, exit_code: Option<Int>, value: Option<String>) -> EvalResult:
    return EvalResult.new(
        value: value,
        stdout: stdout,
        stderr: stderr,
        diagnostic: Option.None,
        exit_code: exit_code,
    )

// A reusable Buff evaluator that accumulates `let` bindings and `func`
// declarations across calls.
//
// Clone is NOT derived because the evaluator owns mutable session state
// that callers usually want to keep singular. Consumers wanting a fork
// can construct a fresh `evaluator_new()`.
struct Evaluator {
    // Accumulated source for top-level declarations (e.g. `func helper()
    // -> Int: ...`). Stored verbatim so the next call can compose a fresh
    // self-contained program.
    top_level_src: String,
    // Accumulated source for body statements inside the synthetic `main`
    // (e.g. `let x = 42`). Each entry is one Buff source line (or block)
    // already stripped of leading indentation — `compose_program_body`
    // re-indents when emitting.
    body_stmts_src: String,
}

// Construct a fresh evaluator with no accumulated state.
func evaluator_new() -> Evaluator:
    return Evaluator.new(top_level_src: "", body_stmts_src: "")

// Evaluate a full Buff source snippet.
//
// The snippet may be:
//
// - a bare expression (`2 + 3`) — the spawned program prints its
//   value, surfaced as `EvalResult.value` and `EvalResult.stdout`,
// - a body statement (`let x = 42`) — accumulated into the session
//   state, no value returned,
// - a top-level declaration (`func helper(): ...`) — accumulated into
//   the session state, no value returned,
// - a full Buff program (`func main(): print("hi")`) — evaluated
//   verbatim; not accumulated (the caller owns `main`).
//
// State persists across `evaluator_eval` and `evaluator_eval_line` calls.
// The Rust `&mut self` becomes in-place field mutation per porting-conventions
// §7b (`ev.top_level_src = ...`).
func evaluator_eval(ev: Evaluator, source: String) -> EvalResult:
    return evaluator_evaluate(ev, source)

// Evaluate a single Buff line, incrementally accumulating `let`
// bindings and `func` declarations.
//
// Functionally identical to `evaluator_eval` — the `eval` / `eval_line`
// split documents intent (`eval` for whole snippets, `eval_line`
// for one-statement-at-a-time REPL input). Both share the same
// classification + composition + compile + run path.
func evaluator_eval_line(ev: Evaluator, line: String) -> EvalResult:
    return evaluator_evaluate(ev, line)

// Type-introspect `expr` against the accumulated environment.
//
// Returns `None` on any lex/parse/inference error (no diagnostic is
// surfaced — the caller treats `None` as "type unknown"). The
// accumulated state is consulted but NOT modified, so a `type_of`
// query has no side effects on subsequent `evaluator_eval` calls.
func evaluator_type_of(ev: Evaluator, expr: String) -> Option<Type>:
    // Compose a synthetic program whose main body runs the accumulated
    // statements and then evaluates the queried expression as the
    // trailing ExprStmt. Walk all-but-last through the inferencer to
    // populate env, then infer the trailing expr's type.
    let body = indent_lines(ev.body_stmts_src)
    let composed = type_of_compose(body, expr)
    let id = source_id_new(0)
    let tokens = match tokenize(composed, id) {
        Ok(t) => t,
        Err(_) => return Option.None,
    }
    let decls = match parse(tokens, id) {
        Ok(d) => d,
        Err(_) => return Option.None,
    }
    if decls.len() != 1:
        return Option.None
    let maybe_stmts = decl_func_body_stmts(decls[0])
    if maybe_stmts == Option.None:
        return Option.None
    let stmts = option_unwrap(maybe_stmts)
    if stmts.len() == 0:
        return Option.None
    let inf = type_inferencer_new()
    // Walk all-but-last to populate env. The trailing stmt is the
    // expression whose type we want.
    let last_idx = stmts.len() - 1
    for i in range(last_idx):
        let _ = type_inferencer_infer_stmt(inf, stmts[i])
    let trailing = stmts[last_idx]
    let maybe_expr = stmt_as_expr(trailing)
    if maybe_expr == Option.None:
        return Option.None
    let trailing_expr = option_unwrap(maybe_expr)
    let inferred = type_inferencer_infer_expr(inf, trailing_expr)
    return match inferred {
        Ok(ty) => Option.Some(ty),
        Err(_) => Option.None,
    }

// Compose the synthetic `func __typecheck__():` body for `type_of`.
// Extracted from `evaluator_type_of` to keep the parent function's body
// flat (Buff match arms are single expressions; helper extraction avoids
// multi-statement arms).
func type_of_compose(body: String, expr: String) -> String:
    if string_is_empty(body):
        return "func __typecheck__():\n    " + expr + "\n"
    return "func __typecheck__():\n" + body + "    " + expr + "\n"

// Shared driver for `evaluator_eval` / `evaluator_eval_line`.
//
// Rust original is one big `match classify(snippet)` with multi-statement
// arms. Buff match arms are single expressions (§8e), so the body is
// restructured as an explicit `let kind = classify(snippet)` followed
// by `if/else if` chains that dispatch on `kind` via `==` on the enum
// variants (Buff enums derive structural equality).
func evaluator_evaluate(ev: Evaluator, snippet: String) -> EvalResult:
    let kind = classify(snippet)
    if kind == SnippetKind.Empty:
        return eval_result_ok("", "", Option.Some(0), Option.None)
    if kind == SnippetKind.FullProgram:
        // User provided their own `main` — evaluate verbatim. We do
        // NOT accumulate full programs into session state because
        // the user owns `main`; a later `evaluator_eval_line` would produce
        // a duplicate `main` and a rustc error.
        let src = snippetkind_full_program_src(kind)
        return run_full_program(src)
    if kind == SnippetKind.TopLevelDecl:
        // Accumulate the decl, then run the composed program.
        let src = snippetkind_top_level_decl_src(kind)
        append_top_level(ev, src)
        let composed = compose_program_body(ev, Option.None)
        return run_full_program(composed)
    if kind == SnippetKind.BodyStmt:
        // Accumulate the body stmt, then run the composed program.
        let src = snippetkind_body_stmt_src(kind)
        append_body_stmt(ev, src)
        let composed = compose_program_body(ev, Option.None)
        return run_full_program(composed)
    // SnippetKind.BareExpr — do NOT accumulate (state unchanged).
    // Wrap as `print(<expr>)` to capture the value, unless the
    // expression is itself a `print(...)` call (which returns
    // Void — wrapping would yield `print(print(...))` and a
    // rustc type error).
    let expr_src = snippetkind_bare_expr_src(kind)
    let is_print = snippetkind_bare_expr_is_print(kind)
    let contribution = bare_expr_contribution(expr_src, is_print)
    let composed = compose_program_body(ev, Option.Some(contribution))
    let result = run_full_program(composed)
    // If the run succeeded and the snippet was NOT a print call,
    // surface the trimmed stdout as the evaluated value.
    return finalize_bare_expr_result(result, is_print)

// Build the body contribution for a bare-expression snippet. Wraps the
// expression in `print(...)` unless it is already a print call (which
// returns Void and would type-error if wrapped again).
func bare_expr_contribution(expr_src: String, is_print: Bool) -> String:
    if is_print:
        return expr_src
    return "print(" + expr_src + ")"

// Set `result.value` to the trimmed stdout when the snippet was not a
// print call AND the run succeeded. Mirrors the Rust
// `if !is_print && result.diagnostic.is_none()` block.
func finalize_bare_expr_result(result: EvalResult, is_print: Bool) -> EvalResult:
    if is_print:
        return result
    if result.diagnostic != Option.None:
        return result
    result.value = Option.Some(string_trim(result.stdout))
    return result

// Append a top-level declaration source string to the accumulated
// state, ensuring a trailing newline separator.
func append_top_level(ev: Evaluator, src: String):
    if string_is_empty(ev.top_level_src) == false, string_ends_with(ev.top_level_src, "\n") == false:
        ev.top_level_src = ev.top_level_src + "\n"
    ev.top_level_src = ev.top_level_src + src
    if string_ends_with(ev.top_level_src, "\n") == false:
        ev.top_level_src = ev.top_level_src + "\n"

// Append a body statement source string to the accumulated state,
// ensuring a trailing newline separator.
func append_body_stmt(ev: Evaluator, src: String):
    if string_is_empty(ev.body_stmts_src) == false, string_ends_with(ev.body_stmts_src, "\n") == false:
        ev.body_stmts_src = ev.body_stmts_src + "\n"
    ev.body_stmts_src = ev.body_stmts_src + src
    if string_ends_with(ev.body_stmts_src, "\n") == false:
        ev.body_stmts_src = ev.body_stmts_src + "\n"

// Compose a full Buff program from the accumulated state, optionally
// appending a trailing contribution (already an un-indented Buff
// statement source like `print(x + 8)` or `let y = 10`).
func compose_program_body(ev: Evaluator, trailing: Option<String>) -> String:
    let out = compose_program_top_level(ev)
    let out2 = out + "func main():\n"
    let body = indent_lines(ev.body_stmts_src)
    let out3 = out2 + body
    if trailing == Option.None:
        return out3
    let t = option_unwrap(trailing)
    let indented = indent_lines(t)
    let out4 = out3 + indented
    if string_ends_with(indented, "\n"):
        return out4
    return out4 + "\n"

// Emit the accumulated top-level declarations verbatim (no indentation),
// with a guaranteed trailing newline separator. Empty when no top-level
// decls have been accumulated.
func compose_program_top_level(ev: Evaluator) -> String:
    if string_is_empty(ev.top_level_src):
        return ""
    if string_ends_with(ev.top_level_src, "\n"):
        return ev.top_level_src
    return ev.top_level_src + "\n"

// Classification of a user-supplied snippet.
//
// Produced by `classify` — drives the accumulation + composition
// strategy in `evaluator_evaluate`.
enum SnippetKind {
    // Whitespace-only input — no-op.
    Empty,
    // A bare expression (`2 + 3`). Carries the original source string
    // and a flag indicating whether the expression is itself a
    // `print(...)` / `println(...)` call (Void-returning — must NOT be
    // wrapped again).
    BareExpr(String, Bool),
    // A body statement (`let x = 42`). Carries the original source.
    BodyStmt(String),
    // A top-level declaration (`func helper(): ...`). Carries the
    // original source.
    TopLevelDecl(String),
    // A full Buff program with its own `func main(): ...`. Evaluated
    // verbatim; not accumulated.
    FullProgram(String),
}

// Classify a snippet by trying each parser entry point in turn.
//
// Strategy:
// 1. Trim-test for empty input.
// 2. Tokenize. If lex fails, fall back to BodyStmt (we can't say more).
// 3. Try `parse_expression` (strict — requires all tokens consumed).
//    If Ok, it's a `SnippetKind.BareExpr`.
// 4. Try `parse`. If Ok:
//    - If any decl is `func main`, it's a `SnippetKind.FullProgram`.
//    - Otherwise it's a `SnippetKind.TopLevelDecl`.
// 5. Else, fall back to `SnippetKind.BodyStmt` (most likely a `let`
//    or `print(...)` line, neither of which is a top-level form).
func classify(snippet: String) -> SnippetKind:
    if string_is_empty(string_trim(snippet)):
        return SnippetKind.Empty
    let id = source_id_new(0)
    let tokens = match tokenize(snippet, id) {
        Ok(t) => t,
        Err(_) => return SnippetKind.BodyStmt(snippet),
    }
    // Try as a single expression (strict — requires all tokens consumed).
    let as_expr = parse_expression(tokens, id)
    if as_expr != Result.Err(parse_expression_err_sentinel()):
        let expr = result_unwrap(as_expr)
        let is_print = expr_is_print_call(expr)
        return SnippetKind.BareExpr(string_trim(snippet), is_print)
    // Try as a top-level program.
    let as_decls = parse(tokens, id)
    if as_decls != Result.Err(parse_err_sentinel()):
        let decls = result_unwrap(as_decls)
        if decls_any_func_main(decls):
            return SnippetKind.FullProgram(snippet)
        return SnippetKind.TopLevelDecl(snippet)
    // Fall back: treat as a body statement (let, assignment, print line).
    return SnippetKind.BodyStmt(snippet)

// `true` iff any Decl in `decls` is a `func main` declaration. Mirrors the
// Rust `decls.iter().any(|d| matches!(d, Decl::FuncDecl(f) if f.name.name == "main"))`.
// The Buff port cannot pattern-match on the opaque extern Decl enum, so
// the predicate is exposed as an extern accessor.
extern "C" from "buff_eval_host" func decls_any_func_main(decls: Vector<Decl>) -> Bool

// `true` if `expr` is a `print(...)` / `println(...)` call.
//
// Such expressions return `Void` in Buff's prelude, so wrapping them
// again as `print(print(...))` would yield a rustc type error. The
// caller emits them as a statement instead.
//
// (Rust: `if let Expr::FuncCall { callee, .. } = expr { if let
// Expr::Ident(name, _) = callee.as_ref() { return name.name == "print"
// || name.name == "println" } } false`. Buff cannot pattern-match on
// the opaque extern Expr enum, so this delegates to the host-side
// predicate `expr_is_print_call`.)
func is_print_call(expr: Expr) -> Bool:
    return expr_is_print_call(expr)

// Indent every line of `src` by 4 spaces. Empty input → empty output.
// Trailing newline is preserved.
func indent_lines(src: String) -> String:
    if string_is_empty(src):
        return ""
    let lines = string_split_inclusive(src, "\n")
    let out = string_with_capacity(string_len(src) + string_count_lines(src) * 4)
    indent_lines_emit_each(lines, out)
    return out

// Iterate `lines` (each ending in `\n` except possibly the last) and
// append each to `out`, prefixing 4 spaces unless the line is blank.
// Helper extracted from `indent_lines` because Buff `for x in iter:`
// takes an iterator and the body needs to mutate `out` in place.
func indent_lines_emit_each(lines: Vector<String>, out: String):
    for i in range(lines.len()):
        let line = lines[i]
        if line == "\n" || string_is_empty(line):
            // Preserve blank lines without indent (Buff fmt rule).
            string_push_str(out, "\n")
        else:
            string_push_str(out, "    ")
            string_push_str(out, line)

// Run the full Buff source through the compile-and-spawn pipeline.
//
// Returns an `EvalResult` populated with the spawned program's stdout
// / stderr / exit code on success, or a diagnostic on any pipeline
// error (lex / parse / codegen / rustc / spawn).
func run_full_program(source: String) -> EvalResult:
    let source_id = source_id_new(0)
    let tokens = match tokenize(source, source_id) {
        Ok(t) => t,
        Err(e) => return eval_result_err(tokenize_failure_diagnostic(e)),
    }
    let decls = match parse(tokens, source_id) {
        Ok(d) => d,
        Err(e) => return eval_result_err(parse_error_diagnostic(e)),
    }
    let rust_source = match generate_rust(decls) {
        Ok(s) => s,
        Err(e) => return eval_result_err(codegen_error_diagnostic(e)),
    }

    // Acquire unique temp paths. Use a process-wide counter + PID so
    // parallel test processes don't collide.
    let dir = temp_dir_for_eval()
    let stem = unique_stem()
    let rust_path = dir + "/" + stem + ".rs"
    let exe_name = with_exe_extension(stem)
    let exe_path = dir + "/" + exe_name

    // Write the .rs file. If this fails, surface as a diagnostic.
    let write_err = fs_write(rust_path, rust_source)
    if write_err != Option.None:
        let msg = option_unwrap(write_err)
        return eval_result_err(diagnostic_error(
            "eval: failed to write temp rust file '" + rust_path + "': " + msg,
            span_dummy(),
        ))

    // rustc invocation: edition 2021 + -O (debug mode = fast compile, no
    // LTO). Mirrors pipeline.rs `BuildMode::Debug` exactly.
    // T2: auto-detect fast linker (mold → rust-lld → system default).
    // T3: line-tables-only debuginfo (-C debuginfo=1) for backtraces.
    // T4: opt-in Cranelift dev backend via BUFF_EVAL_BACKEND=cranelift
    // (probe + set CARGO_PROFILE_DEV_CODEGEN_BACKEND env var on the
    // child rustc process — scoped to the subprocess, no parent leak).
    // T9: opt-in sccache via BUFF_EVAL_SCCACHE=1 env var. When set AND
    // sccache is on PATH, sets RUSTC_WRAPPER=sccache on the child rustc
    // process. Falls back silently when sccache is missing.
    // T112: cross-compilation target via BUFF_EVAL_TARGET env var.
    // When set, verifies the target is installed via `rustup target list
    // --installed` and passes `--target <triple>` to rustc.
    let env_map = run_full_program_build_env()
    let linker_flags = resolve_eval_linker_flags(EvalLinker.Auto)
    let target = eval_target()
    if target != Option.None:
        let triple = option_unwrap(target)
        if eval_target_is_installed(triple) == false:
            let _ = fs_remove_file(rust_path)
            return eval_result_err(diagnostic_error(
                "Target '" + triple + "' is not installed.\nRun: rustup target add " + triple,
                span_dummy(),
            ))
    let configured = rustc_invoke_configure_rustc_command(
        ["-O"],
        linker_flags,
        should_eval_use_cranelift(),
        "debuginfo=1",
        target,
    )
    if configured != Result.Ok(configured_ok_sentinel()):
        let err_msg = result_unwrap_err(configured)
        let _ = fs_remove_file(rust_path)
        return eval_result_err(diagnostic_error(err_msg, span_dummy()))

    // T35: rustc_invoke returns a configured SpawnCmd; we feed it through
    // process_spawn (the Buff port's single FFI boundary for subprocess
    // execution).
    let _spawn_cmd = result_unwrap(configured)
    let rustc_args = ["--edition", "2021", rust_path, "-o", exe_path]
    let compile_out = process_spawn("rustc", rustc_args, env_map)
    if compile_out == Option.None:
        let _ = fs_remove_file(rust_path)
        return eval_result_err(diagnostic_error(
            "eval: failed to invoke 'rustc'",
            span_dummy(),
        ))
    let compile_result = option_unwrap(compile_out)
    if spawn_result_success(compile_result) == false:
        let _ = fs_remove_file(rust_path)
        let _ = fs_remove_file(exe_path)
        return EvalResult.new(
            value: Option.None,
            stdout: "",
            stderr: compile_result.stderr,
            diagnostic: Option.Some(diagnostic_error(
                "eval: 'rustc' exited non-zero (see stderr for rustc diagnostics)",
                span_dummy(),
            )),
            exit_code: compile_result.exit_code,
        )

    // Run the compiled exe, capturing stdout/stderr.
    let run_out = process_spawn(exe_path, [], Map.new())
    if run_out == Option.None:
        let _ = fs_remove_file(rust_path)
        let _ = fs_remove_file(exe_path)
        return eval_result_err(diagnostic_error(
            "eval: failed to spawn compiled program",
            span_dummy(),
        ))
    let run_result = option_unwrap(run_out)
    let stdout = run_result.stdout
    let stderr = run_result.stderr
    let exit_code = run_result.exit_code

    // Best-effort cleanup. The compiled program files are useless after
    // we've captured their output.
    let _ = fs_remove_file(rust_path)
    let _ = fs_remove_file(exe_path)

    if exit_code != Option.Some(0):
        // Runtime panic / non-zero exit. Surface as a diagnostic so the
        // caller sees a structured error; stderr carries the panic msg.
        return EvalResult.new(
            value: Option.None,
            stdout: stdout,
            stderr: stderr,
            diagnostic: Option.Some(diagnostic_error(
                "eval: program exited with code " + exit_code_describe(exit_code),
                span_dummy(),
            )),
            exit_code: exit_code,
        )

    return eval_result_ok(stdout, stderr, exit_code, Option.None)

// Build the env-var map for the rustc subprocess. Honors
// `BUFF_EVAL_SCCACHE=1` (sets `RUSTC_WRAPPER=sccache`) and
// `BUFF_EVAL_BACKEND=cranelift` (sets
// `CARGO_PROFILE_DEV_CODEGEN_BACKEND=cranelift`). Both are opt-in.
func run_full_program_build_env() -> Map<String, String>:
    let env_map = Map.new()
    if env_var("BUFF_EVAL_SCCACHE") == Option.Some("1") && sccache_available():
        map_insert(env_map, "RUSTC_WRAPPER", "sccache")
    if should_eval_use_cranelift():
        map_insert(env_map, "CARGO_PROFILE_DEV_CODEGEN_BACKEND", "cranelift")
    return env_map

// Render an exit-code Option as a display string ("0", "<signal>" for None).
// Mirrors the Rust
// `exit_code.map(|c| c.to_string()).unwrap_or_else(|| "<signal>".to_string())`.
func exit_code_describe(exit_code: Option<Int>) -> String:
    if exit_code == Option.None:
        return "<signal>"
    let c = option_unwrap(exit_code)
    return int_to_string(c)

// Return the per-eval temp directory (`<tmp>/buff-eval`), creating it
// if missing. Failure to create is silent — the caller's `fs_write`
// will surface the error path with full context.
func temp_dir_for_eval() -> String:
    let dir = env_temp_dir() + "/buff-eval"
    let _ = fs_create_dir_all(dir)
    return dir

// Build a unique stem like `eval-<pid>-<n>`.
func unique_stem() -> String:
    let n = atomic_counter_next()
    let pid = process_id()
    return "eval-" + int_to_string(pid) + "-" + int_to_string(n)

// Apply the platform's executable extension to `path` (`.exe` on
// Windows, no-op on Unix). Mirrors `buff_lang_cli::pipeline::
// with_exe_extension` without taking a dep on the CLI crate (which
// would pull in `clap` / `tokio` etc. for a single helper).
func with_exe_extension(path: String) -> String:
    let ext = env_exe_extension()
    if string_is_empty(ext):
        return path
    if string_ends_with(path, "." + ext):
        return path
    return path + "." + ext

// ---------------------------------------------------------------------------
// Smoke tests — exercise the public API end-to-end. The acceptance
// scenarios (expression eval, state accumulation, type introspection,
// stdout capture, error handling) live in `tests/eval_tests.rs`.
// ---------------------------------------------------------------------------

// Test: classify() identifies empty, bare-expression, and body-statement
// snippets. Mirrors the Rust `#[test] fn classify_empty_and_bare_expr_and_body_stmt`.
func test_classify_empty_and_bare_expr_and_body_stmt() -> Bool:
    let k0 = classify("")
    if k0 != SnippetKind.Empty:
        return false
    let k1 = classify("   \n  ")
    if k1 != SnippetKind.Empty:
        return false
    // Bare expr: tokenize + parse_expression succeeds.
    let k2 = classify("2 + 3")
    if k2 == SnippetKind.BareExpr("2 + 3", false):
        return true
    // Body stmt: `let` is not a top-level form, falls through to BodyStmt.
    let k3 = classify("let x = 42")
    if k3 == SnippetKind.BodyStmt(_):
        return true
    return false

// Test: classify() distinguishes top-level decls (no `main`) from full
// programs (with `main`). Mirrors the Rust
// `#[test] fn classify_top_level_decl_and_full_program`.
func test_classify_top_level_decl_and_full_program() -> Bool:
    // Top-level decl: function WITHOUT name "main".
    let k_top = classify("func helper():\n    return 1")
    if k_top == SnippetKind.TopLevelDecl(_):
        return true
    // Full program: function WITH name "main".
    let k_full = classify("func main():\n    print(\"hi\")")
    if k_full == SnippetKind.FullProgram(_):
        return true
    return false

// Test: indent_lines prepends 4 spaces to every non-blank line and
// preserves trailing newlines / blank lines. Mirrors the Rust
// `#[test] fn indent_lines_prepends_four_spaces`.
func test_indent_lines_prepends_four_spaces() -> Bool:
    if indent_lines("") != "":
        return false
    if indent_lines("let x = 1\n") != "    let x = 1\n":
        return false
    if indent_lines("let x = 1\nlet y = 2\n") != "    let x = 1\n    let y = 2\n":
        return false
    // Blank lines stay blank (Buff fmt rule).
    if indent_lines("\n") != "\n":
        return false
    return true

// Test: evaluator's compose_program_body indents accumulated state and
// appends the trailing contribution. Mirrors the Rust
// `#[test] fn evaluator_compose_program_body_indents_accumulated`.
func test_evaluator_compose_program_body_indents_accumulated() -> Bool:
    let ev = evaluator_new()
    append_body_stmt(ev, "let x = 42")
    let composed = compose_program_body(ev, Option.Some("print(x)"))
    if string_contains(composed, "func main():\n") == false:
        return false
    if string_contains(composed, "    let x = 42\n") == false:
        return false
    if string_contains(composed, "    print(x)\n") == false:
        return false
    return true

// Test: evaluator accumulates both top-level decls and body stmts.
// Mirrors the Rust `#[test] fn evaluator_appends_top_level_and_body`.
func test_evaluator_appends_top_level_and_body() -> Bool:
    let ev = evaluator_new()
    append_top_level(ev, "func helper():\n    return 1")
    append_body_stmt(ev, "let x = 2")
    let composed = compose_program_body(ev, Option.None)
    if string_contains(composed, "func helper():\n    return 1\n") == false:
        return false
    if string_contains(composed, "func main():\n    let x = 2\n") == false:
        return false
    return true

// Test: is_print_call detects `print(...)` / `println(...)` calls and
// rejects non-print expressions. Mirrors the Rust
// `#[test] fn is_print_call_detects_print_and_println`.
func test_is_print_call_detects_print_and_println() -> Bool:
    // print(...) — bare call expression.
    let id = source_id_new(0)
    let toks1 = match tokenize("print(42)", id) {
        Ok(t) => t,
        Err(_) => return false,
    }
    let expr1 = match parse_expression(toks1, id) {
        Ok(e) => e,
        Err(_) => return false,
    }
    if is_print_call(expr1) == false:
        return false
    // println(...) — same.
    let toks2 = match tokenize("println(42)", id) {
        Ok(t) => t,
        Err(_) => return false,
    }
    let expr2 = match parse_expression(toks2, id) {
        Ok(e) => e,
        Err(_) => return false,
    }
    if is_print_call(expr2) == false:
        return false
    // Non-print call (e.g. user-defined foo(...)) — false.
    // (We can't easily parse a non-prelude call here without a
    // supporting decl, so test the negative case with a bare ident
    // expression.)
    let toks3 = match tokenize("x", id) {
        Ok(t) => t,
        Err(_) => return false,
    }
    let expr3 = match parse_expression(toks3, id) {
        Ok(e) => e,
        Err(_) => return false,
    }
    if is_print_call(expr3) == true:
        return false
    return true

// Test: EvalResult ok/err helpers populate the right fields. Mirrors the
// Rust `#[test] fn eval_result_ok_and_err_helpers`.
func test_eval_result_ok_and_err_helpers() -> Bool:
    let ok = eval_result_ok("out", "", Option.Some(0), Option.Some("5"))
    if eval_result_is_ok(ok) == false:
        return false
    if ok.value != Option.Some("5"):
        return false
    let err = eval_result_err(diagnostic_error("boom", span_dummy()))
    if eval_result_is_ok(err) == true:
        return false
    if err.diagnostic == Option.None:
        return false
    return true

// Test: with_exe_extension is a no-op on Unix (empty EXE_EXTENSION) and
// appends `.exe` on Windows. Mirrors the Rust
// `#[test] fn with_exe_extension_unix_passthrough_or_windows_appends`.
func test_with_exe_extension_unix_passthrough_or_windows_appends() -> Bool:
    let p = "eval-1"
    let ext = env_exe_extension()
    let with_ext = with_exe_extension(p)
    if string_is_empty(ext):
        return with_ext == p
    return with_ext == "eval-1." + ext

// ---------------------------------------------------------------------------
// Prelude-string-helper extern stubs. The Rust original calls into
// `String::push_str` / `String::ends_with` / `str::trim` etc. directly
// (Rust stdlib); Buff's prelude String surface is narrower, so the
// helpers the eval crate needs are surfaced as extern trampolines back
// to the Rust stdlib.
// ---------------------------------------------------------------------------

extern "C" from "buff_eval_host" func string_is_empty(s: String) -> Bool

extern "C" from "buff_eval_host" func string_trim(s: String) -> String

extern "C" from "buff_eval_host" func string_ends_with(s: String, suffix: String) -> Bool

extern "C" from "buff_eval_host" func string_split_inclusive(s: String, delim: String) -> Vector<String>

extern "C" from "buff_eval_host" func string_with_capacity(capacity: Int) -> String

extern "C" from "buff_eval_host" func string_push_str(s: String, other: String)

extern "C" from "buff_eval_host" func string_len(s: String) -> Int

extern "C" from "buff_eval_host" func string_count_lines(s: String) -> Int

extern "C" from "buff_eval_host" func string_contains(haystack: String, needle: String) -> Bool

extern "C" from "buff_eval_host" func string_eq_ignore_ascii_case(a: String, b: String) -> Bool

extern "C" from "buff_eval_host" func int_to_string(n: Int) -> String

// Option/Result helpers — Buff's prelude may not surface infallible
// unwrap accessors, so the eval crate's few infallible-unwrap sites
// (where the caller has already verified Some/Ok) go through these
// trampolines. CONTRACT: caller verified Some/Ok first; violation
// yields a zero value, NOT a panic.

extern "C" from "buff_eval_host" func option_unwrap(opt: Option<Bool>) -> Bool

extern "C" from "buff_eval_host" func option_unwrap_or(opt: Option<String>, default: String) -> String

// Sentinel comparisons used by `classify` to detect
// `Result::Err` from `parse_expression` / `parse`. The Rust original
// uses `if let Ok(x) = ... { ... }`; the Buff port's match-arms-as-
// expressions idiom + opaque extern error types requires a typed
// sentinel to compare against. CONTRACT: these return distinct opaque
// values per call (the host never constructs them at runtime — they
// exist only so the port can spell `Result.Err(...)` comparisons).
extern "C" from "buff_eval_host" func parse_expression_err_sentinel() -> ParseError

extern "C" from "buff_eval_host" func parse_err_sentinel() -> ParseError

extern "C" from "buff_eval_host" func configured_ok_sentinel() -> SpawnCmd

extern "C" from "buff_eval_host" func result_unwrap(r: Result<Bool, String>) -> Bool

extern "C" from "buff_eval_host" func result_unwrap_err(r: Result<SpawnCmd, String>) -> String

extern "C" from "buff_eval_host" func spawn_result_success(r: SpawnResult) -> Bool

// Insert a (key, value) pair into a Map<String, String>. The Buff prelude
// Map surface may not surface an in-place insert; this extern trampoline
// mutates the map in place (the caller passes the map as the first arg
// and the insertion is observable after the call returns).
extern "C" from "buff_eval_host" func map_insert(m: Map<String, String>, key: String, value: String)

// SnippetKind payload extractors — Buff match arms cannot destructure
// tuple variants in single-expression position portably across the
// prebuilt binary, so the payload reads go through these helpers
// (the parent function already verified the variant via `==` on the
// kind enum).

extern "C" from "buff_eval_host" func snippetkind_full_program_src(k: SnippetKind) -> String

extern "C" from "buff_eval_host" func snippetkind_top_level_decl_src(k: SnippetKind) -> String

extern "C" from "buff_eval_host" func snippetkind_body_stmt_src(k: SnippetKind) -> String

extern "C" from "buff_eval_host" func snippetkind_bare_expr_src(k: SnippetKind) -> String

extern "C" from "buff_eval_host" func snippetkind_bare_expr_is_print(k: SnippetKind) -> Bool
